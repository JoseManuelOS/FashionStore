# Supabase Configuration
# Get these from your Supabase project: Settings > API

# Public URL (safe to expose on client)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (server-side only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cloudinary Configuration
# Get these from your Cloudinary dashboard: https://cloudinary.com/console

# Cloud Name (safe to expose on client)
PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Upload Preset (create one in Settings > Upload > Upload presets)
# Make sure to set it as "unsigned" for client-side uploads
PUBLIC_CLOUDINARY_UPLOAD_PRESET=fashionstore_products

# Site URL (used in email links)
PUBLIC_SITE_URL=https://j4o0084kg0ssoo0wc0ocw0g8.victoriafp.online
