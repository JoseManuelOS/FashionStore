---
import PublicLayout from "../../layouts/PublicLayout.astro";

export const prerender = false;
---

<PublicLayout title="Mis Favoritos | FashionMarket">
  <div class="container-custom py-12">
    <div
      id="loading-state"
      class="flex items-center justify-center min-h-[60vh]"
    >
      <div class="text-center">
        <div
          class="w-16 h-16 mx-auto mb-4 rounded-full bg-gradient-to-br from-neon-cyan to-neon-fuchsia flex items-center justify-center animate-pulse"
        >
          <svg
            class="w-8 h-8 text-dark-500 animate-spin"
            fill="none"
            viewBox="0 0 24 24"
          >
            <circle
              class="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              stroke-width="4"></circle>
            <path
              class="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
            ></path>
          </svg>
        </div>
        <p class="text-zinc-400">Cargando...</p>
      </div>
    </div>

    <div id="main-content" class="hidden">
      <nav class="flex items-center gap-2 text-sm text-zinc-500 mb-8">
        <a href="/" class="hover:text-neon-cyan transition-colors">Inicio</a>
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"></path></svg
        >
        <a href="/cuenta" class="hover:text-neon-cyan transition-colors"
          >Mi Cuenta</a
        >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"></path></svg
        >
        <span class="text-white">Favoritos</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <div class="lg:col-span-1">
          <div
            class="bg-dark-400/50 backdrop-blur-xl border border-white/10 rounded-2xl p-6 sticky top-24"
          >
            <div class="text-center mb-6 pb-6 border-b border-white/10">
              <div
                id="user-avatar"
                class="w-20 h-20 rounded-full mx-auto mb-4 bg-gradient-to-br from-neon-cyan to-neon-fuchsia flex items-center justify-center"
              >
                <span id="user-initial" class="text-2xl font-bold text-dark-500"
                  >U</span
                >
              </div>
              <h2 id="user-name" class="text-white font-semibold text-lg">
                Usuario
              </h2>
              <p id="user-email" class="text-zinc-400 text-sm"></p>
            </div>
            <nav class="space-y-1">
              <a
                href="/cuenta"
                class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:text-white hover:bg-white/5 transition-colors"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                  ></path></svg
                >
                Mi Perfil
              </a>
              <a
                href="/cuenta/pedidos"
                class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:text-white hover:bg-white/5 transition-colors"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg
                >
                Mis Pedidos
              </a>
              <a
                href="/cuenta/favoritos"
                class="flex items-center gap-3 px-4 py-3 rounded-xl bg-neon-cyan/10 text-neon-cyan font-medium"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                  ></path></svg
                >
                Favoritos
              </a>
            </nav>
          </div>
        </div>

        <div class="lg:col-span-3">
          <h1 class="text-3xl font-display font-bold text-white mb-8">
            Mis Favoritos
          </h1>

          <div
            id="empty-state"
            class="bg-dark-400/50 backdrop-blur-xl border border-white/10 rounded-2xl p-12 text-center"
          >
            <div
              class="w-20 h-20 rounded-full bg-dark-300 flex items-center justify-center mx-auto mb-6"
            >
              <svg
                class="w-10 h-10 text-zinc-500"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                ></path></svg
              >
            </div>
            <h3 class="text-xl font-semibold text-white mb-2">
              No tienes favoritos aún
            </h3>
            <p class="text-zinc-400 mb-6">
              Guarda tus productos favoritos para encontrarlos fácilmente.
            </p>
            <a
              href="/productos"
              class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-neon-cyan to-neon-cyan-light text-dark-500 font-semibold rounded-xl hover:shadow-lg hover:shadow-neon-cyan/25 transition-all duration-200"
            >
              Explorar productos
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg
              >
            </a>
          </div>

          <div
            id="favorites-grid"
            class="hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
          >
          </div>
        </div>
      </div>
    </div>
  </div>
</PublicLayout>

<script>
  import { createClient } from "@supabase/supabase-js";

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL || "",
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY || "",
  );

  let currentUserId: string | null = null;

  async function init() {
    const loadingState = document.getElementById("loading-state");
    const mainContent = document.getElementById("main-content");
    const emptyState = document.getElementById("empty-state");
    const favoritesGrid = document.getElementById("favorites-grid");

    // Timeout para evitar carga infinita
    const timeout = setTimeout(() => {
      console.log("Timeout reached, showing content");
      loadingState?.classList.add("hidden");
      mainContent?.classList.remove("hidden");
      emptyState?.classList.remove("hidden");
    }, 8000);

    try {
      const { data: { session }, error: sessionError } = await supabase.auth.getSession();

      if (sessionError || !session?.user) {
        clearTimeout(timeout);
        window.location.href = "/auth/login?redirect=/cuenta/favoritos";
        return;
      }

      const user = session.user;
      currentUserId = user.id;
      const userName = user.user_metadata?.full_name || user.user_metadata?.name || "Usuario";
      const userEmail = user.email || "";
      const avatarUrl = user.user_metadata?.avatar_url || user.user_metadata?.picture || null;

      const userNameEl = document.getElementById("user-name");
      const userEmailEl = document.getElementById("user-email");
      const userInitialEl = document.getElementById("user-initial");
      
      if (userNameEl) userNameEl.textContent = userName;
      if (userEmailEl) userEmailEl.textContent = userEmail;
      if (userInitialEl) userInitialEl.textContent = userName.charAt(0).toUpperCase();

      if (avatarUrl) {
        const avatarEl = document.getElementById("user-avatar");
        if (avatarEl) {
          avatarEl.innerHTML = `<img src="${avatarUrl}" alt="Avatar" class="w-full h-full rounded-full object-cover border-2 border-neon-cyan/50" />`;
        }
      }

      // Mostrar contenido principal
      clearTimeout(timeout);
      loadingState?.classList.add("hidden");
      mainContent?.classList.remove("hidden");

      // Cargar favoritos
      const { data: favorites, error } = await supabase
        .from("customer_favorites")
        .select(`
          id,
          product_id,
          products:product_id (
            id, name, slug, price, original_price, is_offer, discount_percent,
            images:product_images(image_url)
          )
        `)
        .eq("customer_id", user.id);

      if (error) {
        console.log("Error loading favorites:", error.message);
        emptyState?.classList.remove("hidden");
        return;
      }

      if (!favorites || favorites.length === 0) {
        emptyState?.classList.remove("hidden");
        return;
      }

      emptyState?.classList.add("hidden");

      if (favoritesGrid) {
        favoritesGrid.innerHTML = favorites
          .map((fav: any) => {
            const product = fav.products;
            if (!product) return "";

            const mainImage = product.images?.[0]?.image_url || "https://placehold.co/400x500/0d0d14/06b6d4?text=Producto";
            const price = new Intl.NumberFormat("es-ES", {
              style: "currency",
              currency: "EUR",
            }).format(product.price);

            return `
            <div class="bg-dark-400/50 backdrop-blur-xl border border-white/10 rounded-2xl overflow-hidden group" data-product-id="${product.id}">
              <a href="/productos/${product.slug}" class="block relative aspect-square">
                <img src="${mainImage}" alt="${product.name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                ${product.is_offer ? '<div class="absolute top-3 left-3"><span class="badge-offer">Oferta</span></div>' : ""}
                <button class="remove-favorite absolute top-3 right-3 w-10 h-10 rounded-full bg-red-500/20 backdrop-blur flex items-center justify-center text-red-500 hover:bg-red-500/30 transition-colors" data-id="${product.id}">
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" /></svg>
                </button>
              </a>
              <div class="p-4">
                <h3 class="text-white font-medium truncate">${product.name}</h3>
                <p class="text-neon-cyan font-semibold mt-2">${price}</p>
              </div>
            </div>
          `;
          })
          .join("");

        favoritesGrid.classList.remove("hidden");

        // Añadir handlers para eliminar favoritos
        document.querySelectorAll(".remove-favorite").forEach((btn) => {
          btn.addEventListener("click", async (e) => {
            e.preventDefault();
            e.stopPropagation();

            const button = btn as HTMLButtonElement;
            const productId = button.dataset.id;
            if (!productId || !currentUserId) return;

            // Deshabilitar botón y mostrar loading
            button.disabled = true;
            const originalContent = button.innerHTML;
            button.innerHTML = `<svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>`;

            try {
              const { error } = await supabase
                .from("customer_favorites")
                .delete()
                .eq("customer_id", currentUserId)
                .eq("product_id", productId);

              if (error) {
                console.error("Error removing favorite:", error);
                button.disabled = false;
                button.innerHTML = originalContent;
                return;
              }

              const card = document.querySelector(`[data-product-id="${productId}"]`);
              if (card) {
                card.classList.add("opacity-0", "scale-95", "transition-all", "duration-300");
                setTimeout(() => {
                  card.remove();
                  if (favoritesGrid?.children.length === 0) {
                    favoritesGrid.classList.add("hidden");
                    emptyState?.classList.remove("hidden");
                  }
                }, 300);
              }
            } catch (err) {
              console.error("Error:", err);
              button.disabled = false;
              button.innerHTML = originalContent;
            }
          });
        });
      }
    } catch (error) {
      console.error("Error initializing favorites:", error);
      loadingState?.classList.add("hidden");
      mainContent?.classList.remove("hidden");
      emptyState?.classList.remove("hidden");
    }
  }

  // Inicializar cuando el DOM esté listo
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
