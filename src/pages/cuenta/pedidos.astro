---
import PublicLayout from "../../layouts/PublicLayout.astro";

export const prerender = false;
---

<PublicLayout title="Mis Pedidos | FashionMarket">
  <div class="container-custom py-12">
    <div
      id="loading-state"
      class="flex items-center justify-center min-h-[60vh]"
    >
      <div class="text-center">
        <div
          class="w-16 h-16 mx-auto mb-4 rounded-full bg-gradient-to-br from-neon-cyan to-neon-fuchsia flex items-center justify-center animate-pulse"
        >
          <svg
            class="w-8 h-8 text-dark-500 animate-spin"
            fill="none"
            viewBox="0 0 24 24"
          >
            <circle
              class="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              stroke-width="4"></circle>
            <path
              class="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
            ></path>
          </svg>
        </div>
        <p class="text-zinc-400">Cargando...</p>
      </div>
    </div>

    <div id="main-content" class="hidden">
      <nav class="flex items-center gap-2 text-sm text-zinc-500 mb-8">
        <a href="/" class="hover:text-neon-cyan transition-colors">Inicio</a>
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"></path></svg
        >
        <a href="/cuenta" class="hover:text-neon-cyan transition-colors"
          >Mi Cuenta</a
        >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"></path></svg
        >
        <span class="text-white">Mis Pedidos</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <div class="lg:col-span-1">
          <div
            class="bg-dark-400/50 backdrop-blur-xl border border-white/10 rounded-2xl p-6 sticky top-24"
          >
            <div class="text-center mb-6 pb-6 border-b border-white/10">
              <div
                id="user-avatar"
                class="w-20 h-20 rounded-full mx-auto mb-4 bg-gradient-to-br from-neon-cyan to-neon-fuchsia flex items-center justify-center"
              >
                <span id="user-initial" class="text-2xl font-bold text-dark-500"
                  >U</span
                >
              </div>
              <h2 id="user-name" class="text-white font-semibold text-lg">
                Usuario
              </h2>
              <p id="user-email" class="text-zinc-400 text-sm"></p>
            </div>
            <nav class="space-y-1">
              <a
                href="/cuenta"
                class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:text-white hover:bg-white/5 transition-colors"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                  ></path></svg
                >
                Mi Perfil
              </a>
              <a
                href="/cuenta/pedidos"
                class="flex items-center gap-3 px-4 py-3 rounded-xl bg-neon-cyan/10 text-neon-cyan font-medium"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg
                >
                Mis Pedidos
              </a>
              <a
                href="/cuenta/favoritos"
                class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:text-white hover:bg-white/5 transition-colors"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                  ></path></svg
                >
                Favoritos
              </a>
            </nav>
          </div>
        </div>

        <div class="lg:col-span-3">
          <h1 class="text-3xl font-display font-bold text-white mb-8">
            Mis Pedidos
          </h1>

          <div
            id="empty-state"
            class="hidden bg-dark-400/50 backdrop-blur-xl border border-white/10 rounded-2xl p-12 text-center"
          >
            <div
              class="w-20 h-20 rounded-full bg-dark-300 flex items-center justify-center mx-auto mb-6"
            >
              <svg
                class="w-10 h-10 text-zinc-500"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg
              >
            </div>
            <h3 class="text-xl font-semibold text-white mb-2">
              No tienes pedidos aún
            </h3>
            <p class="text-zinc-400 mb-6">
              Cuando realices tu primera compra, aparecerá aquí.
            </p>
            <a
              href="/productos"
              class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-neon-cyan to-neon-cyan-light text-dark-500 font-semibold rounded-xl hover:shadow-lg hover:shadow-neon-cyan/25 transition-all duration-200"
            >
              Explorar productos
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg
              >
            </a>
          </div>

          <div id="orders-list" class="hidden space-y-4"></div>
        </div>
      </div>
    </div>
  </div>
</PublicLayout>

<script>
  import { createClient } from "@supabase/supabase-js";

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL || "",
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY || "",
  );

  const statusLabels: Record<string, { label: string; color: string }> = {
    pending: { label: "Pendiente", color: "bg-yellow-500/20 text-yellow-400" },
    paid: { label: "Pagado", color: "bg-blue-500/20 text-blue-400" },
    shipped: { label: "Enviado", color: "bg-purple-500/20 text-purple-400" },
    delivered: { label: "Entregado", color: "bg-green-500/20 text-green-400" },
    cancelled: { label: "Cancelado", color: "bg-red-500/20 text-red-400" },
  };

  async function init() {
    const loadingState = document.getElementById("loading-state");
    const mainContent = document.getElementById("main-content");
    const emptyState = document.getElementById("empty-state");
    const ordersList = document.getElementById("orders-list");

    // Timeout para evitar carga infinita
    const timeout = setTimeout(() => {
      console.log("Timeout reached, showing content");
      loadingState?.classList.add("hidden");
      mainContent?.classList.remove("hidden");
      emptyState?.classList.remove("hidden");
    }, 8000);

    try {
      const { data: { session }, error: sessionError } = await supabase.auth.getSession();

      if (sessionError || !session?.user) {
        clearTimeout(timeout);
        window.location.href = "/auth/login?redirect=/cuenta/pedidos";
        return;
      }

      const user = session.user;
      const userName = user.user_metadata?.full_name || user.user_metadata?.name || "Usuario";
      const userEmail = user.email || "";
      const avatarUrl = user.user_metadata?.avatar_url || user.user_metadata?.picture || null;

      const userNameEl = document.getElementById("user-name");
      const userEmailEl = document.getElementById("user-email");
      const userInitialEl = document.getElementById("user-initial");
      
      if (userNameEl) userNameEl.textContent = userName;
      if (userEmailEl) userEmailEl.textContent = userEmail;
      if (userInitialEl) userInitialEl.textContent = userName.charAt(0).toUpperCase();

      if (avatarUrl) {
        const avatarEl = document.getElementById("user-avatar");
        if (avatarEl) {
          avatarEl.innerHTML = `<img src="${avatarUrl}" alt="Avatar" class="w-full h-full rounded-full object-cover border-2 border-neon-cyan/50" />`;
        }
      }

      // Mostrar contenido principal
      clearTimeout(timeout);
      loadingState?.classList.add("hidden");
      mainContent?.classList.remove("hidden");

      // Cargar pedidos
      let finalOrders: any[] = [];
      
      // Intentar RPC primero
      const { data: orders, error } = await supabase.rpc("get_my_orders");

      if (!error && orders) {
        finalOrders = orders;
      } else {
        console.log("RPC failed, trying direct query:", error?.message);
        // Fallback a query directa
        const { data: directOrders, error: directError } = await supabase
          .from("orders")
          .select("*")
          .eq("customer_id", user.id)
          .order("created_at", { ascending: false });

        if (!directError && directOrders) {
          finalOrders = directOrders;
        }
      }

      if (!finalOrders || finalOrders.length === 0) {
        emptyState?.classList.remove("hidden");
        return;
      }

      if (ordersList) {
        ordersList.innerHTML = finalOrders
          .map((order: any) => {
            const date = new Date(order.created_at).toLocaleDateString("es-ES", {
              year: "numeric",
              month: "long",
              day: "numeric",
            });
            const total = new Intl.NumberFormat("es-ES", {
              style: "currency",
              currency: "EUR",
            }).format(order.total_price);
            const status = statusLabels[order.status] || {
              label: order.status,
              color: "bg-zinc-500/20 text-zinc-400",
            };
            const itemsText = order.total_items ? `${order.total_items} artículos` : "Ver detalles";
            const quantityText = order.total_quantity ? `${order.total_quantity} unidades` : "";

            return `
            <div class="bg-dark-400/50 backdrop-blur-xl border border-white/10 rounded-2xl p-6 hover:border-white/20 transition-colors">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
                <div>
                  <p class="text-white font-medium">Pedido #${order.id.slice(0, 8).toUpperCase()}</p>
                  <p class="text-zinc-400 text-sm">${date}</p>
                </div>
                <span class="inline-flex px-3 py-1 rounded-full text-xs font-medium ${status.color} w-fit">
                  ${status.label}
                </span>
              </div>
              
              <div class="flex flex-col sm:flex-row sm:items-center justify-between pt-4 border-t border-white/10 gap-4">
                <div class="flex items-center gap-4 text-sm text-zinc-400">
                  <span class="flex items-center gap-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
                    ${itemsText}
                  </span>
                  ${quantityText ? `
                  <span class="flex items-center gap-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14" /></svg>
                    ${quantityText}
                  </span>` : ""}
                </div>
                <div class="flex items-center justify-between sm:gap-4">
                  <p class="text-white font-semibold text-lg">${total}</p>
                </div>
              </div>
            </div>
          `;
          })
          .join("");

        ordersList.classList.remove("hidden");
      }
    } catch (error) {
      console.error("Error initializing orders:", error);
      loadingState?.classList.add("hidden");
      mainContent?.classList.remove("hidden");
      emptyState?.classList.remove("hidden");
    }
  }

  // Inicializar cuando el DOM esté listo
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
