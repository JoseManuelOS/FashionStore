      </div>
    `;
  }

  // Toggle function for expanding/collapsing orders
  (window as any).toggleOrder = function (orderId: string) {
    const content = document.getElementById(`${orderId}-content`);
    const arrow = document.getElementById(`${orderId}-arrow`);
    const container = document.getElementById(`${orderId}-container`);

    if (content && arrow && container) {
      const isHidden = content.classList.contains("hidden");

      if (isHidden) {
        content.classList.remove("hidden");
        arrow.classList.add("rotate-180");
        container.classList.add("border-neon-cyan/50");
      } else {
        content.classList.add("hidden");
        arrow.classList.remove("rotate-180");
        container.classList.remove("border-neon-cyan/50");
      }
    }
  };

  async function init() {
    const loadingState = document.getElementById("loading-state");
    const mainContent = document.getElementById("main-content");
    const emptyState = document.getElementById("empty-state");
    const ordersList = document.getElementById("orders-list");

    const timeout = setTimeout(() => {
      loadingState?.classList.add("hidden");
      mainContent?.classList.remove("hidden");
      emptyState?.classList.remove("hidden");
    }, 8000);

    try {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession();

      if (sessionError || !session?.user) {
        clearTimeout(timeout);
        window.location.href = "/auth/login?redirect=/cuenta/pedidos";
        return;
      }

      const user = session.user;
      const userName =
        user.user_metadata?.full_name || user.user_metadata?.name || "Usuario";
      const userEmail = user.email || "";
      const avatarUrl =
        user.user_metadata?.avatar_url || user.user_metadata?.picture || null;

      // Update user info
      const userNameEl = document.getElementById("user-name");
      const userEmailEl = document.getElementById("user-email");
      const userInitialEl = document.getElementById("user-initial");

      if (userNameEl) userNameEl.textContent = userName;
      if (userEmailEl) userEmailEl.textContent = userEmail;
      if (userInitialEl)
        userInitialEl.textContent = userName.charAt(0).toUpperCase();

      if (avatarUrl) {
        const avatarEl = document.getElementById("user-avatar");
        if (avatarEl) {
          avatarEl.innerHTML = `<img src="${avatarUrl}" alt="Avatar" class="w-full h-full rounded-full object-cover border-2 border-neon-cyan/50" />`;
        }
      }

      clearTimeout(timeout);
      loadingState?.classList.add("hidden");
      mainContent?.classList.remove("hidden");

      // Get orders via API (bypasses RLS issues)
      const accessToken = session.access_token;

      const response = await fetch("/api/orders/my-orders", {
        method: "GET",
        headers: {
          Authorization: `Bearer ${accessToken}`,
          "Content-Type": "application/json",
        },
      });

      if (!response.ok) {
        console.error("Error fetching orders:", await response.text());
        emptyState?.classList.remove("hidden");
        return;
      }

      const { orders } = await response.json();

      if (!orders || orders.length === 0) {
        emptyState?.classList.remove("hidden");
        return;
      }

      if (ordersList) {
        ordersList.innerHTML = orders
          .map((order: any, index: number) => renderOrder(order, index))
          .join("");
        ordersList.classList.remove("hidden");
      }
    } catch (error) {
      console.error("Error initializing orders:", error);
      loadingState?.classList.add("hidden");
      mainContent?.classList.remove("hidden");
      emptyState?.classList.remove("hidden");
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }

  // Store access token for API calls
  let accessToken = "";

  // Update accessToken when session is available
  supabase.auth.getSession().then(({ data: { session } }) => {
    if (session) {
      accessToken = session.access_token;
    }
  });

  // Cancel Order Modal Functions
  let currentCancelOrderId: string | null = null;
  let currentCancelDisplayId: string | null = null;

  (window as any).openCancelModal = function (
    orderId: string,
    displayId: string,
  ) {
    currentCancelOrderId = orderId;
    currentCancelDisplayId = displayId;
    const modal = document.getElementById("cancel-modal");
    if (modal) {
      modal.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    }
  };

  (window as any).closeCancelModal = function () {
    const modal = document.getElementById("cancel-modal");
    if (modal) {
      modal.classList.add("hidden");
      document.body.style.overflow = "";
    }
    currentCancelOrderId = null;
    currentCancelDisplayId = null;
  };

  (window as any).confirmCancelOrder = async function () {
    if (!currentCancelOrderId) return;

    const btn = document.getElementById(
      "cancel-confirm-btn",
    ) as HTMLButtonElement;
    const originalText = btn?.innerHTML;

    if (btn) {
      btn.disabled = true;
      btn.innerHTML = `
        <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        Procesando...
      `;
    }

    try {
      const response = await fetch("/api/orders/cancel", {
        method: "POST",
        headers: {
          Authorization: `Bearer ${accessToken}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ orderId: currentCancelOrderId }),
      });

      const data = await response.json();

      if (response.ok && data.success) {
        // Show success message
        (window as any).closeCancelModal();
        showToast(
          "Pedido cancelado correctamente. El stock ha sido restaurado.",
          "success",
        );
        // Reload orders
        setTimeout(() => window.location.reload(), 1500);
      } else {
        showToast(data.message || "Error al cancelar el pedido", "error");
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = originalText || "Confirmar Cancelación";
        }
      }
    } catch (error: any) {
      console.error("Error cancelling order:", error);
      showToast("Error de conexión. Inténtalo de nuevo.", "error");
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = originalText || "Confirmar Cancelación";
      }
    }
  };

  // Return Modal Functions
  let currentReturnOrderId: string | null = null;

  // Track orders that have had a return requested (persists in sessionStorage)
  const returnRequestedKey = "fashionmarket_return_requested";
  const returnRequestedOrders: Set<string> = new Set(
    JSON.parse(sessionStorage.getItem(returnRequestedKey) || "[]")
  );

  function markReturnRequested(orderId: string) {
    returnRequestedOrders.add(orderId);
    sessionStorage.setItem(returnRequestedKey, JSON.stringify([...returnRequestedOrders]));
  }

  // Update the order card in the DOM to reflect a new status
  function updateOrderCardStatus(orderId: string, newStatus: string) {
    const uniqueId = `order-${orderId}`;
    const container = document.getElementById(`${uniqueId}-container`);
    if (!container) return;

    const statusBadge = container.querySelector('[class*="rounded-full"][class*="text-xs"]');
    if (statusBadge) {
      const config: Record<string, {label: string, color: string}> = {
        return_requested: {
          label: "Devolución Solicitada",
          color: "bg-orange-500/20 text-orange-400 border-orange-500/30",
        },
        returned: {
          label: "Devuelto",
          color: "bg-pink-500/20 text-pink-400 border-pink-500/30",
        },
      };
      const statusInfo = config[newStatus];
      if (statusInfo) {
        statusBadge.className = `inline-flex px-2 py-0.5 rounded-full text-xs font-medium border ${statusInfo.color} mt-1`;
        statusBadge.textContent = statusInfo.label;
      }
    }

    // Update the expanded content progress bar if visible
    const expandedContent = document.getElementById(`${uniqueId}-content`);
    if (expandedContent) {
      const progressSection = expandedContent.querySelector('.mt-4.p-3');
      if (progressSection && newStatus === 'return_requested') {
        progressSection.className = 'mt-4 p-3 bg-orange-500/10 border border-orange-500/20 rounded-xl';
        progressSection.innerHTML = `
          <div class="flex items-center justify-center gap-2">
            <svg class="w-5 h-5 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path></svg>
            <p class="text-orange-400 text-sm font-medium">Devolución solicitada - En proceso de revisión</p>
          </div>
        `;
      }
    }
  }

  function showReturnSuccessState() {
    const modalContent = document.getElementById("return-modal-content");
    if (!modalContent) return;
    modalContent.innerHTML = `
      <div style="text-align:center; padding: 32px 0;">
        <div style="width:64px; height:64px; margin:0 auto 16px; border-radius:50%; background:rgba(34,197,94,0.2); display:flex; align-items:center; justify-content:center;">
          <svg style="width:32px;height:32px;color:#4ade80;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        </div>
        <h3 style="font-size:20px; font-weight:700; color:white; margin:0 0 8px;">¡Solicitud Enviada!</h3>
        <p style="color:#a1a1aa; margin:0 0 24px;">Hemos enviado las instrucciones de devolución a tu email.</p>
        <p style="color:#71717a; font-size:13px; margin:0 0 20px;">¿No recibiste el email? Puedes reenviarlo.</p>
        <div style="display:flex; flex-direction:column; gap:12px; align-items:center;">
          <button id="resend-return-btn" onclick="resendReturnEmail()" style="display:inline-flex; align-items:center; gap:8px; padding:10px 20px; background:#27272a; color:#d4d4d8; border-radius:12px; border:1px solid rgba(255,255,255,0.1); font-size:14px; font-weight:500; cursor:pointer;">
            <svg style="width:16px;height:16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            Reenviar instrucciones por email
          </button>
          <button onclick="closeReturnModal()" style="padding:10px 24px; background:#06b6d4; color:#000; border-radius:12px; font-weight:600; font-size:15px; cursor:pointer;">
            Cerrar
          </button>
        </div>
      </div>
    `;
  }

  (window as any).openReturnModal = function (
    orderId: string,
    displayId: string,
  ) {
    currentReturnOrderId = orderId;
    const modal = document.getElementById("return-modal");
    if (modal) {
      modal.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    }
    // If already requested, show resend state directly
    if (returnRequestedOrders.has(orderId)) {
      showReturnSuccessState();
    }
  };

  (window as any).closeReturnModal = function () {
    const modal = document.getElementById("return-modal");
    if (modal) {
      modal.classList.add("hidden");
      document.body.style.overflow = "";
    }
    currentReturnOrderId = null;
  };

  (window as any).confirmReturnRequest = async function () {
    if (!currentReturnOrderId) return;

    const btn = document.getElementById(
      "return-confirm-btn",
    ) as HTMLButtonElement;
    const originalText = btn?.innerHTML;

    if (btn) {
      btn.disabled = true;
      btn.innerHTML = `
        <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        Enviando...
      `;
    }

    try {
      const response = await fetch("/api/orders/request-return", {
        method: "POST",
        headers: {
          Authorization: `Bearer ${accessToken}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ orderId: currentReturnOrderId }),
      });

      const data = await response.json();

      if (response.ok && data.success) {
        // Mark this order as having a return requested (persists in sessionStorage)
        if (currentReturnOrderId) markReturnRequested(currentReturnOrderId);
        // Update the order card in the DOM to reflect the new status
        updateOrderCardStatus(currentReturnOrderId, "return_requested");
        // Update modal to show success with resend option
        showReturnSuccessState();
      } else {
        showToast(data.message || "Error al procesar la solicitud", "error");
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = originalText || "Confirmar Solicitud";
        }
      }
    } catch (error: any) {
      console.error("Error requesting return:", error);
      showToast("Error de conexión. Inténtalo de nuevo.", "error");
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = originalText || "Confirmar Solicitud";
      }
    }
  };

  // Resend return email function
  (window as any).resendReturnEmail = async function () {
    if (!currentReturnOrderId) return;

    const btn = document.getElementById("resend-return-btn") as HTMLButtonElement;
    const originalText = btn?.innerHTML;

    if (btn) {
      btn.disabled = true;
      btn.innerHTML = `
        <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        Reenviando...
      `;
    }

    try {
      const response = await fetch("/api/orders/request-return", {
        method: "POST",
        headers: {
          Authorization: `Bearer ${accessToken}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ orderId: currentReturnOrderId, resend: true }),
      });

      const data = await response.json();

      if (response.ok && data.success) {
        showToast("Instrucciones de devolución reenviadas a tu email", "success");
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = `
            <svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            ¡Email reenviado!
          `;
          setTimeout(() => {
            if (btn) btn.innerHTML = originalText || "Reenviar instrucciones por email";
          }, 3000);
        }
      } else {
        showToast(data.message || "Error al reenviar el email", "error");
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = originalText || "Reenviar instrucciones por email";
        }
      }
    } catch (error: any) {
      console.error("Error resending return email:", error);
      showToast("Error de conexión. Inténtalo de nuevo.", "error");
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = originalText || "Reenviar instrucciones por email";
      }
    }
  };

  // Request Invoice Function
  (window as any).requestInvoice = async function (orderId: string, displayId: string) {
    const btn = document.getElementById(`invoice-btn-${orderId}`) as HTMLButtonElement;
    if (!btn) return;

    const originalText = btn.innerHTML;

    btn.disabled = true;
    btn.innerHTML = `
      <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      Enviando factura...
    `;

    try {
      const response = await fetch("/api/orders/request-invoice", {
        method: "POST",
        headers: {
          Authorization: `Bearer ${accessToken}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ orderId }),
      });

      const data = await response.json();

      if (response.ok && data.success) {
        showToast(`Factura enviada a ${data.email}`, "success");
        btn.disabled = false;
        btn.innerHTML = `
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          ¡Factura enviada!
        `;
        setTimeout(() => {
          btn.innerHTML = originalText;
        }, 4000);
      } else {
        showToast(data.error || "Error al solicitar la factura", "error");
        btn.disabled = false;
        btn.innerHTML = originalText;
      }
    } catch (error: any) {
      console.error("Error requesting invoice:", error);
      showToast("Error de conexión. Inténtalo de nuevo.", "error");
      btn.disabled = false;
      btn.innerHTML = originalText;
    }
  };

  // Toast notification helper
  function showToast(message: string, type: "success" | "error") {
    const toast = document.createElement("div");
    toast.className = `fixed bottom-4 right-4 px-6 py-3 rounded-xl shadow-lg z-50 flex items-center gap-3 animate-in slide-in-from-right ${
      type === "success"
        ? "bg-green-500/90 text-white"
        : "bg-red-500/90 text-white"
    }`;
    toast.innerHTML = `
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        ${
          type === "success"
            ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>'
            : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>'
        }
      </svg>
      <span class="font-medium">${message}</span>
    `;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 4000);
  }
</script>

