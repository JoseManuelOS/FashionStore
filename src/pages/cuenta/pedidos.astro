---
import PublicLayout from "../../layouts/PublicLayout.astro";

export const prerender = false;
---

<PublicLayout title="Mis Pedidos | FashionMarket">
  <div class="container-custom py-12">
    <div
      id="loading-state"
      class="flex items-center justify-center min-h-[60vh]"
    >
      <div class="text-center">
        <div
          class="w-16 h-16 mx-auto mb-4 rounded-full bg-gradient-to-br from-neon-cyan to-neon-fuchsia flex items-center justify-center animate-pulse"
        >
          <svg
            class="w-8 h-8 text-dark-500 animate-spin"
            fill="none"
            viewBox="0 0 24 24"
          >
            <circle
              class="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              stroke-width="4"></circle>
            <path
              class="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
            ></path>
          </svg>
        </div>
        <p class="text-zinc-400">Cargando...</p>
      </div>
    </div>

    <div id="main-content" class="hidden">
      <nav class="flex items-center gap-2 text-sm text-zinc-500 mb-8">
        <a href="/" class="hover:text-neon-cyan transition-colors">Inicio</a>
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"></path>
        </svg>
        <a href="/cuenta" class="hover:text-neon-cyan transition-colors"
          >Mi Cuenta</a
        >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"></path>
        </svg>
        <span class="text-white">Mis Pedidos</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <!-- Sidebar -->
        <div class="lg:col-span-1">
          <div
            class="bg-dark-400/50 backdrop-blur-xl border border-white/10 rounded-2xl p-6 sticky top-24"
          >
            <div class="text-center mb-6 pb-6 border-b border-white/10">
              <div
                id="user-avatar"
                class="w-20 h-20 rounded-full mx-auto mb-4 bg-gradient-to-br from-neon-cyan to-neon-fuchsia flex items-center justify-center"
              >
                <span id="user-initial" class="text-2xl font-bold text-dark-500"
                  >U</span
                >
              </div>
              <h2 id="user-name" class="text-white font-semibold text-lg">
                Usuario
              </h2>
              <p id="user-email" class="text-zinc-400 text-sm"></p>
            </div>
            <nav class="space-y-1">
              <a
                href="/cuenta"
                class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:text-white hover:bg-white/5 transition-colors"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                  ></path>
                </svg>
                Mi Perfil
              </a>
              <a
                href="/cuenta/pedidos"
                class="flex items-center gap-3 px-4 py-3 rounded-xl bg-neon-cyan/10 text-neon-cyan font-medium"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                </svg>
                Mis Pedidos
              </a>
              <a
                href="/cuenta/favoritos"
                class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:text-white hover:bg-white/5 transition-colors"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                  ></path>
                </svg>
                Favoritos
              </a>
            </nav>
          </div>
        </div>

        <!-- Main Content -->
        <div class="lg:col-span-3">
          <h1 class="text-3xl font-display font-bold text-white mb-8">
            Mis Pedidos
          </h1>

          <!-- Empty State -->
          <div
            id="empty-state"
            class="hidden bg-dark-400/50 backdrop-blur-xl border border-white/10 rounded-2xl p-12 text-center"
          >
            <div
              class="w-20 h-20 rounded-full bg-dark-300 flex items-center justify-center mx-auto mb-6"
            >
              <svg
                class="w-10 h-10 text-zinc-500"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-white mb-2">
              No tienes pedidos aún
            </h3>
            <p class="text-zinc-400 mb-6">
              Cuando realices tu primera compra, aparecerá aquí.
            </p>
            <a
              href="/productos"
              class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-neon-cyan to-neon-cyan-light text-dark-500 font-semibold rounded-xl hover:shadow-lg hover:shadow-neon-cyan/25 transition-all duration-200"
            >
              Explorar productos
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>
          </div>

          <!-- Orders List -->
          <div id="orders-list" class="hidden space-y-6"></div>
        </div>
      </div>
    </div>
  </div>
</PublicLayout>

<script>
  import { createClient } from "@supabase/supabase-js";

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL || "",
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY || "",
  );

  // Estado del pedido y configuración de la barra de progreso
  const orderSteps = [
    { key: "pending", label: "Pendiente", icon: "1" },
    { key: "paid", label: "Pagado", icon: "2" },
    { key: "processing", label: "Preparando", icon: "3" },
    { key: "shipped", label: "Enviado", icon: "4" },
    { key: "delivered", label: "Entregado", icon: "5" },
  ];

  const statusConfig: Record<
    string,
    { label: string; color: string; step: number }
  > = {
    pending: {
      label: "Pendiente",
      color: "bg-yellow-500/20 text-yellow-400 border-yellow-500/30",
      step: 0,
    },
    paid: {
      label: "Pagado",
      color: "bg-blue-500/20 text-blue-400 border-blue-500/30",
      step: 1,
    },
    processing: {
      label: "Preparando",
      color: "bg-orange-500/20 text-orange-400 border-orange-500/30",
      step: 2,
    },
    shipped: {
      label: "Enviado",
      color: "bg-purple-500/20 text-purple-400 border-purple-500/30",
      step: 3,
    },
    delivered: {
      label: "Entregado",
      color: "bg-green-500/20 text-green-400 border-green-500/30",
      step: 4,
    },
    cancelled: {
      label: "Cancelado",
      color: "bg-red-500/20 text-red-400 border-red-500/30",
      step: -1,
    },
  };

  function formatCurrency(amount: number): string {
    return new Intl.NumberFormat("es-ES", {
      style: "currency",
      currency: "EUR",
    }).format(amount);
  }

  function formatDate(dateString: string): string {
    return new Date(dateString).toLocaleDateString("es-ES", {
      year: "numeric",
      month: "long",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });
  }

  function renderProgressBar(status: string): string {
    const config = statusConfig[status] || statusConfig.pending;
    const currentStep = config.step;

    if (status === "cancelled") {
      return `
        <div class="mt-4 p-3 bg-red-500/10 border border-red-500/20 rounded-xl">
          <p class="text-red-400 text-sm text-center font-medium">Este pedido ha sido cancelado</p>
        </div>
      `;
    }

    return `
      <div class="mt-6">
        <h4 class="text-white font-medium text-sm mb-4">Estado del pedido</h4>
        <div class="flex items-center justify-between relative">
          <!-- Progress line background -->
          <div class="absolute top-5 left-6 right-6 h-0.5 bg-dark-300 rounded-full"></div>
          <!-- Progress line filled -->
          <div class="absolute top-5 left-6 h-0.5 bg-gradient-to-r from-neon-cyan to-neon-cyan-light rounded-full transition-all duration-500" style="width: calc(${Math.max(0, (currentStep / (orderSteps.length - 1)) * 100)}% - 48px)"></div>
          
          ${orderSteps
            .map((step, index) => {
              const isCompleted = index <= currentStep;
              const isCurrent = index === currentStep;
              return `
              <div class="flex flex-col items-center z-10 flex-1">
                <div class="${isCompleted ? "bg-neon-cyan text-dark-500" : "bg-dark-300 text-zinc-500"} ${isCurrent ? "ring-2 ring-neon-cyan/40" : ""} w-10 h-10 rounded-full flex items-center justify-center text-sm font-semibold transition-all duration-300">
                  ${isCompleted ? `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>` : index + 1}
                </div>
                <span class="text-xs mt-2 ${isCompleted ? "text-neon-cyan font-medium" : "text-zinc-500"} text-center">${step.label}</span>
              </div>
            `;
            })
            .join("")}
        </div>
      </div>
    `;
  }

  function renderOrderItems(items: any[]): string {
    if (!items || items.length === 0) {
      return '<p class="text-zinc-500 text-sm italic">Detalles del pedido no disponibles</p>';
    }

    return `
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4">
        ${items
          .map((item) => {
            const imageUrl =
              item.product_image ||
              "https://placehold.co/80x80/1a1a2e/00d4ff?text=Producto";
            return `
            <div class="flex items-center gap-3 bg-dark-300/50 rounded-xl p-3 hover:bg-dark-300/70 transition-colors">
              <img 
                src="${imageUrl}" 
                alt="${item.product_name}"
                class="w-16 h-16 object-cover rounded-lg bg-dark-400 flex-shrink-0"
                onerror="this.src='https://placehold.co/80x80/1a1a2e/00d4ff?text=Producto'"
              />
              <div class="flex-1 min-w-0">
                <h4 class="text-white font-medium text-sm truncate">${item.product_name}</h4>
                <div class="flex items-center gap-2 text-xs text-zinc-400 mt-1">
                  ${item.size ? `<span class="px-2 py-0.5 bg-dark-400 rounded">Talla: ${item.size}</span>` : ""}
                  <span>×${item.quantity}</span>
                </div>
                <p class="text-neon-cyan font-semibold text-sm mt-1">${formatCurrency(item.price_at_purchase)}</p>
              </div>
            </div>
          `;
          })
          .join("")}
      </div>
    `;
  }

  function renderOrderPreview(items: any[]): string {
    if (!items || items.length === 0) {
      return '<span class="text-zinc-500 text-sm">Sin productos</span>';
    }

    const maxShow = 3;
    const remaining = items.length - maxShow;

    return `
      <div class="flex items-center gap-2">
        <div class="flex -space-x-2">
          ${items
            .slice(0, maxShow)
            .map((item) => {
              const imageUrl =
                item.product_image ||
                "https://placehold.co/40x40/1a1a2e/00d4ff?text=P";
              return `
              <img 
                src="${imageUrl}" 
                alt="${item.product_name}"
                class="w-10 h-10 object-cover rounded-lg border-2 border-dark-400 bg-dark-400"
                onerror="this.src='https://placehold.co/40x40/1a1a2e/00d4ff?text=P'"
                title="${item.product_name}"
              />
            `;
            })
            .join("")}
          ${
            remaining > 0
              ? `
            <div class="w-10 h-10 rounded-lg border-2 border-dark-400 bg-dark-300 flex items-center justify-center text-xs text-zinc-400 font-medium">
              +${remaining}
            </div>
          `
              : ""
          }
        </div>
        <span class="text-zinc-400 text-sm hidden sm:inline">${items.length} producto${items.length > 1 ? "s" : ""}</span>
      </div>
    `;
  }

  function renderOrder(order: any, index: number): string {
    const status = statusConfig[order.status] || statusConfig.pending;
    const date = formatDate(order.created_at);
    const total = formatCurrency(order.total_price);
    const orderId = order.order_number
      ? order.order_number
      : order.id.slice(0, 8).toUpperCase();
    const uniqueId = `order-${order.id}`;

    return `
      <div class="bg-dark-400/50 backdrop-blur-xl border border-white/10 rounded-2xl overflow-hidden hover:border-neon-cyan/30 transition-all duration-300" id="${uniqueId}-container">
        <!-- Collapsed Header (clickable) -->
        <div 
          class="p-4 sm:p-5 cursor-pointer select-none hover:bg-white/5 transition-colors"
          onclick="toggleOrder('${uniqueId}')"
        >
          <div class="flex items-center justify-between gap-4">
            <!-- Left: Order info + Products preview -->
            <div class="flex items-center gap-4 flex-1 min-w-0">
              <!-- Order Number -->
              <div class="flex-shrink-0">
                <h3 class="text-white font-bold text-base sm:text-lg">#${orderId}</h3>
                <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium border ${status.color} mt-1">
                  ${status.label}
                </span>
              </div>
              
              <!-- Products Preview -->
              <div class="hidden sm:block">
                ${renderOrderPreview(order.items || [])}
              </div>
            </div>
            
            <!-- Right: Price + Arrow -->
            <div class="flex items-center gap-3 flex-shrink-0">
              <div class="text-right">
                <p class="text-white font-bold text-lg sm:text-xl">${total}</p>
                <p class="text-zinc-500 text-xs">${new Date(order.created_at).toLocaleDateString("es-ES")}</p>
              </div>
              <svg 
                id="${uniqueId}-arrow" 
                class="w-5 h-5 text-zinc-400 transition-transform duration-300" 
                fill="none" 
                stroke="currentColor" 
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>
          </div>
          
          <!-- Mobile Products Preview -->
          <div class="sm:hidden mt-3">
            ${renderOrderPreview(order.items || [])}
          </div>
        </div>

        <!-- Expanded Content (hidden by default) -->
        <div id="${uniqueId}-content" class="hidden border-t border-white/10">
          <!-- Header with date -->
          <div class="p-6 bg-gradient-to-r from-dark-400/50 to-dark-500/50 border-b border-white/10">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div>
                <div class="flex items-center gap-3 flex-wrap">
                  <h3 class="text-white font-bold text-lg">Pedido #${orderId}</h3>
                  <span class="inline-flex px-3 py-1 rounded-full text-xs font-medium border ${status.color}">
                    ${status.label}
                  </span>
                </div>
                <p class="text-zinc-400 text-sm mt-1">${date}</p>
              </div>
              <div class="text-left sm:text-right">
                <p class="text-zinc-400 text-sm">Total del pedido</p>
                <p class="text-white font-bold text-2xl bg-gradient-to-r from-neon-cyan to-neon-fuchsia bg-clip-text text-transparent">${total}</p>
              </div>
            </div>
            
            <!-- Progress Bar -->
            ${renderProgressBar(order.status)}
          </div>

          <!-- Products -->
          <div class="p-6">
            <h4 class="text-white font-semibold mb-3 flex items-center gap-2">
              <svg class="w-5 h-5 text-neon-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
              </svg>
              Productos (${order.items?.length || 0})
            </h4>
            ${renderOrderItems(order.items || [])}
          </div>

          <!-- Shipping Address -->
          ${
            order.shipping_address
              ? `
            <div class="px-6 pb-6">
              <h4 class="text-white font-semibold mb-2 flex items-center gap-2">
                <svg class="w-5 h-5 text-neon-fuchsia" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                Dirección de envío
              </h4>
              <p class="text-zinc-400 text-sm whitespace-pre-line bg-dark-300/50 rounded-xl p-3">${order.shipping_address}</p>
            </div>
          `
              : ""
          }
        </div>
      </div>
    `;
  }

  // Toggle function for expanding/collapsing orders
  (window as any).toggleOrder = function (orderId: string) {
    const content = document.getElementById(`${orderId}-content`);
    const arrow = document.getElementById(`${orderId}-arrow`);
    const container = document.getElementById(`${orderId}-container`);

    if (content && arrow && container) {
      const isHidden = content.classList.contains("hidden");

      if (isHidden) {
        content.classList.remove("hidden");
        arrow.classList.add("rotate-180");
        container.classList.add("border-neon-cyan/50");
      } else {
        content.classList.add("hidden");
        arrow.classList.remove("rotate-180");
        container.classList.remove("border-neon-cyan/50");
      }
    }
  };

  async function init() {
    const loadingState = document.getElementById("loading-state");
    const mainContent = document.getElementById("main-content");
    const emptyState = document.getElementById("empty-state");
    const ordersList = document.getElementById("orders-list");

    const timeout = setTimeout(() => {
      loadingState?.classList.add("hidden");
      mainContent?.classList.remove("hidden");
      emptyState?.classList.remove("hidden");
    }, 8000);

    try {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession();

      if (sessionError || !session?.user) {
        clearTimeout(timeout);
        window.location.href = "/auth/login?redirect=/cuenta/pedidos";
        return;
      }

      const user = session.user;
      const userName =
        user.user_metadata?.full_name || user.user_metadata?.name || "Usuario";
      const userEmail = user.email || "";
      const avatarUrl =
        user.user_metadata?.avatar_url || user.user_metadata?.picture || null;

      // Update user info
      const userNameEl = document.getElementById("user-name");
      const userEmailEl = document.getElementById("user-email");
      const userInitialEl = document.getElementById("user-initial");

      if (userNameEl) userNameEl.textContent = userName;
      if (userEmailEl) userEmailEl.textContent = userEmail;
      if (userInitialEl)
        userInitialEl.textContent = userName.charAt(0).toUpperCase();

      if (avatarUrl) {
        const avatarEl = document.getElementById("user-avatar");
        if (avatarEl) {
          avatarEl.innerHTML = `<img src="${avatarUrl}" alt="Avatar" class="w-full h-full rounded-full object-cover border-2 border-neon-cyan/50" />`;
        }
      }

      clearTimeout(timeout);
      loadingState?.classList.add("hidden");
      mainContent?.classList.remove("hidden");

      // Get orders via API (bypasses RLS issues)
      const accessToken = session.access_token;

      const response = await fetch("/api/orders/my-orders", {
        method: "GET",
        headers: {
          Authorization: `Bearer ${accessToken}`,
          "Content-Type": "application/json",
        },
      });

      if (!response.ok) {
        console.error("Error fetching orders:", await response.text());
        emptyState?.classList.remove("hidden");
        return;
      }

      const { orders } = await response.json();

      if (!orders || orders.length === 0) {
        emptyState?.classList.remove("hidden");
        return;
      }

      if (ordersList) {
        ordersList.innerHTML = orders
          .map((order: any, index: number) => renderOrder(order, index))
          .join("");
        ordersList.classList.remove("hidden");
      }
    } catch (error) {
      console.error("Error initializing orders:", error);
      loadingState?.classList.add("hidden");
      mainContent?.classList.remove("hidden");
      emptyState?.classList.remove("hidden");
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
