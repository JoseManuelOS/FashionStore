---
import PublicLayout from "../../layouts/PublicLayout.astro";

export const prerender = false;
---

<PublicLayout title="Mi Perfil | FashionMarket">
    <div class="container-custom py-12">
        <!-- Estado de carga -->
        <div
            id="loading-state"
            class="flex items-center justify-center min-h-[60vh]"
        >
            <div class="text-center">
                <div class="relative w-20 h-20 mx-auto mb-6">
                    <div class="absolute inset-0 rounded-full bg-gradient-to-br from-neon-cyan to-neon-fuchsia opacity-20 animate-ping"></div>
                    <div class="relative w-20 h-20 rounded-full bg-gradient-to-br from-neon-cyan to-neon-fuchsia flex items-center justify-center">
                        <svg class="w-10 h-10 text-dark-500 animate-spin" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    </div>
                </div>
                <p class="text-zinc-400 text-lg">Cargando tu perfil...</p>
            </div>
        </div>

        <!-- Contenido principal -->
        <div id="main-content" class="hidden">
            <!-- Breadcrumb -->
            <nav class="flex items-center gap-2 text-sm text-zinc-500 mb-8">
                <a href="/" class="hover:text-neon-cyan transition-colors">Inicio</a>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
                <span class="text-white">Mi Perfil</span>
            </nav>

            <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
                <!-- Sidebar -->
                <div class="lg:col-span-1">
                    <div class="bg-dark-400/50 backdrop-blur-xl border border-white/10 rounded-2xl p-6 sticky top-24">
                        <!-- Avatar y nombre -->
                        <div class="text-center mb-6 pb-6 border-b border-white/10">
                            <div class="relative inline-block">
                                <div
                                    id="user-avatar"
                                    class="w-24 h-24 rounded-full mx-auto mb-4 bg-gradient-to-br from-neon-cyan to-neon-fuchsia flex items-center justify-center ring-4 ring-neon-cyan/20"
                                >
                                    <span id="user-initial" class="text-3xl font-bold text-dark-500">U</span>
                                </div>
                                <div class="absolute bottom-4 right-0 w-6 h-6 bg-green-500 rounded-full border-4 border-dark-400"></div>
                            </div>
                            <h2 id="user-name" class="text-white font-semibold text-xl mb-1">Usuario</h2>
                            <p id="user-email" class="text-zinc-400 text-sm"></p>
                        </div>
                        
                        <!-- Navegación -->
                        <nav class="space-y-2">
                            <a href="/cuenta" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-gradient-to-r from-neon-cyan/20 to-neon-fuchsia/10 text-neon-cyan font-medium border border-neon-cyan/30">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                </svg>
                                Mi Perfil
                            </a>
                            <a href="/cuenta/pedidos" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:text-white hover:bg-white/5 transition-all duration-200">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                                </svg>
                                Mis Pedidos
                            </a>
                            <a href="/cuenta/favoritos" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:text-white hover:bg-white/5 transition-all duration-200">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                                </svg>
                                Favoritos
                            </a>
                        </nav>
                    </div>
                </div>

                <!-- Contenido principal -->
                <div class="lg:col-span-3 space-y-6">
                    <!-- Header -->
                    <div class="flex items-center justify-between">
                        <div>
                            <h1 class="text-3xl font-display font-bold text-white mb-2">Mi Perfil</h1>
                            <p class="text-zinc-400">Administra tu información personal y dirección de envío</p>
                        </div>
                    </div>

                    <!-- Mensaje de éxito/error global -->
                    <div id="global-message" class="hidden">
                        <div id="success-toast" class="hidden p-4 bg-green-500/10 border border-green-500/30 rounded-xl text-green-400 text-sm flex items-center gap-3">
                            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            <span id="success-text">Cambios guardados correctamente</span>
                        </div>
                        <div id="error-toast" class="hidden p-4 bg-red-500/10 border border-red-500/30 rounded-xl text-red-400 text-sm flex items-center gap-3">
                            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                            <span id="error-text">Ha ocurrido un error</span>
                        </div>
                    </div>

                    <!-- Información personal -->
                    <div class="bg-dark-400/50 backdrop-blur-xl border border-white/10 rounded-2xl overflow-hidden">
                        <div class="px-6 py-4 border-b border-white/10 bg-white/5">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-neon-cyan/20 flex items-center justify-center">
                                    <svg class="w-5 h-5 text-neon-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                    </svg>
                                </div>
                                <div>
                                    <h3 class="text-lg font-semibold text-white">Información Personal</h3>
                                    <p class="text-sm text-zinc-400">Tu información básica de cuenta</p>
                                </div>
                            </div>
                        </div>
                        <form id="profile-form" class="p-6 space-y-6">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div class="space-y-2">
                                    <label for="name" class="block text-sm font-medium text-zinc-300">
                                        Nombre completo
                                    </label>
                                    <div class="relative">
                                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                            <svg class="w-5 h-5 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                            </svg>
                                        </div>
                                        <input
                                            type="text"
                                            id="name"
                                            name="name"
                                            placeholder="Tu nombre completo"
                                            class="w-full pl-12 pr-4 py-3 bg-dark-500 border border-white/10 rounded-xl text-white placeholder-zinc-500 focus:border-neon-cyan focus:ring-2 focus:ring-neon-cyan/20 transition-all duration-200"
                                        />
                                    </div>
                                </div>
                                <div class="space-y-2">
                                    <label for="email" class="block text-sm font-medium text-zinc-300">
                                        Correo electrónico
                                    </label>
                                    <div class="relative">
                                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                            <svg class="w-5 h-5 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                                            </svg>
                                        </div>
                                        <input
                                            type="email"
                                            id="email"
                                            readonly
                                            class="w-full pl-12 pr-4 py-3 bg-dark-500/50 border border-white/5 rounded-xl text-zinc-400 cursor-not-allowed"
                                        />
                                    </div>
                                    <p class="text-xs text-zinc-500 flex items-center gap-1">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                                        </svg>
                                        El email no se puede cambiar
                                    </p>
                                </div>
                                <div class="space-y-2">
                                    <label for="phone" class="block text-sm font-medium text-zinc-300">
                                        Teléfono
                                    </label>
                                    <div class="relative">
                                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                            <svg class="w-5 h-5 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                                            </svg>
                                        </div>
                                        <input
                                            type="tel"
                                            id="phone"
                                            name="phone"
                                            placeholder="+34 600 000 000"
                                            class="w-full pl-12 pr-4 py-3 bg-dark-500 border border-white/10 rounded-xl text-white placeholder-zinc-500 focus:border-neon-cyan focus:ring-2 focus:ring-neon-cyan/20 transition-all duration-200"
                                        />
                                    </div>
                                </div>
                            </div>
                            <div class="flex justify-end pt-4 border-t border-white/5">
                                <button
                                    type="submit"
                                    id="save-profile-btn"
                                    class="px-6 py-3 bg-gradient-to-r from-neon-cyan to-neon-cyan-light text-dark-500 font-semibold rounded-xl hover:shadow-lg hover:shadow-neon-cyan/25 transition-all duration-200 flex items-center gap-2"
                                >
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                    </svg>
                                    Guardar información
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Direcciones de Envío -->
                    <div class="bg-dark-400/50 backdrop-blur-xl border border-white/10 rounded-2xl overflow-hidden">
                        <div class="px-6 py-4 border-b border-white/10 bg-white/5">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl bg-neon-fuchsia/20 flex items-center justify-center">
                                        <svg class="w-5 h-5 text-neon-fuchsia" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                        </svg>
                                    </div>
                                    <div>
                                        <h3 class="text-lg font-semibold text-white">Direcciones de Envío</h3>
                                        <p class="text-sm text-zinc-400">Gestiona tus direcciones guardadas</p>
                                    </div>
                                </div>
                                <button
                                    id="add-address-btn"
                                    class="px-4 py-2 bg-gradient-to-r from-neon-fuchsia to-neon-fuchsia-light text-white rounded-xl hover:shadow-lg hover:shadow-neon-fuchsia/25 transition-all duration-200 flex items-center gap-2 text-sm font-medium"
                                >
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                    </svg>
                                    Nueva dirección
                                </button>
                            </div>
                        </div>
                        
                        <!-- Lista de direcciones -->
                        <div id="addresses-list" class="p-6 space-y-4">
                            <div class="text-center py-8 text-zinc-500">
                                <svg class="w-12 h-12 mx-auto mb-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                </svg>
                                <p>Cargando direcciones...</p>
                            </div>
                        </div>

                        <!-- Formulario para añadir/editar dirección (oculto por defecto) -->
                        <div id="address-form-container" class="hidden border-t border-white/10 p-6">
                            <form id="address-form" class="space-y-6">
                                <input type="hidden" id="address-id" name="address_id" />
                                
                                <div class="space-y-2">
                                    <label for="address-label" class="block text-sm font-medium text-zinc-300">
                                        Etiqueta *
                                    </label>
                                    <input
                                        type="text"
                                        id="address-label"
                                        name="label"
                                        required
                                        placeholder="Ej: Casa, Trabajo, Casa de mis padres"
                                        class="w-full px-4 py-3 bg-dark-500 border border-white/10 rounded-xl text-white placeholder-zinc-500 focus:border-neon-fuchsia focus:ring-2 focus:ring-neon-fuchsia/20 transition-all duration-200"
                                    />
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <div class="space-y-2">
                                        <label for="address-fullname" class="block text-sm font-medium text-zinc-300">
                                            Nombre completo *
                                        </label>
                                        <input
                                            type="text"
                                            id="address-fullname"
                                            name="full_name"
                                            required
                                            placeholder="Juan Pérez"
                                            class="w-full px-4 py-3 bg-dark-500 border border-white/10 rounded-xl text-white placeholder-zinc-500 focus:border-neon-fuchsia focus:ring-2 focus:ring-neon-fuchsia/20 transition-all duration-200"
                                        />
                                    </div>
                                    <div class="space-y-2">
                                        <label for="address-phone" class="block text-sm font-medium text-zinc-300">
                                            Teléfono
                                        </label>
                                        <input
                                            type="tel"
                                            id="address-phone"
                                            name="phone"
                                            placeholder="+34 600 000 000"
                                            class="w-full px-4 py-3 bg-dark-500 border border-white/10 rounded-xl text-white placeholder-zinc-500 focus:border-neon-fuchsia focus:ring-2 focus:ring-neon-fuchsia/20 transition-all duration-200"
                                        />
                                    </div>
                                </div>

                                <div class="space-y-2">
                                    <label for="address-street" class="block text-sm font-medium text-zinc-300">
                                        Calle y número *
                                    </label>
                                    <input
                                        type="text"
                                        id="address-street"
                                        name="street"
                                        required
                                        placeholder="Calle Mayor 123, 2º B"
                                        class="w-full px-4 py-3 bg-dark-500 border border-white/10 rounded-xl text-white placeholder-zinc-500 focus:border-neon-fuchsia focus:ring-2 focus:ring-neon-fuchsia/20 transition-all duration-200"
                                    />
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <div class="space-y-2">
                                        <label for="address-city" class="block text-sm font-medium text-zinc-300">
                                            Ciudad *
                                        </label>
                                        <input
                                            type="text"
                                            id="address-city"
                                            name="city"
                                            required
                                            placeholder="Madrid"
                                            class="w-full px-4 py-3 bg-dark-500 border border-white/10 rounded-xl text-white placeholder-zinc-500 focus:border-neon-fuchsia focus:ring-2 focus:ring-neon-fuchsia/20 transition-all duration-200"
                                        />
                                    </div>
                                    <div class="space-y-2">
                                        <label for="address-postal" class="block text-sm font-medium text-zinc-300">
                                            Código Postal *
                                        </label>
                                        <input
                                            type="text"
                                            id="address-postal"
                                            name="postal_code"
                                            required
                                            placeholder="28001"
                                            maxlength="10"
                                            class="w-full px-4 py-3 bg-dark-500 border border-white/10 rounded-xl text-white placeholder-zinc-500 focus:border-neon-fuchsia focus:ring-2 focus:ring-neon-fuchsia/20 transition-all duration-200"
                                        />
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <div class="space-y-2">
                                        <label for="address-province" class="block text-sm font-medium text-zinc-300">
                                            Provincia *
                                        </label>
                                        <input
                                            type="text"
                                            id="address-province"
                                            name="province"
                                            required
                                            placeholder="Madrid"
                                            class="w-full px-4 py-3 bg-dark-500 border border-white/10 rounded-xl text-white placeholder-zinc-500 focus:border-neon-fuchsia focus:ring-2 focus:ring-neon-fuchsia/20 transition-all duration-200"
                                        />
                                    </div>
                                    <div class="space-y-2">
                                        <label for="address-country" class="block text-sm font-medium text-zinc-300">
                                            País *
                                        </label>
                                        <select
                                            id="address-country"
                                            name="country"
                                            required
                                            class="w-full px-4 py-3 bg-dark-500 border border-white/10 rounded-xl text-white focus:border-neon-fuchsia focus:ring-2 focus:ring-neon-fuchsia/20 transition-all duration-200"
                                        >
                                            <option value="ES">España</option>
                                            <option value="PT">Portugal</option>
                                            <option value="FR">Francia</option>
                                            <option value="IT">Italia</option>
                                            <option value="DE">Alemania</option>
                                            <option value="GB">Reino Unido</option>
                                            <option value="NL">Países Bajos</option>
                                            <option value="BE">Bélgica</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="flex items-center gap-3 p-4 bg-neon-fuchsia/5 border border-neon-fuchsia/20 rounded-xl">
                                    <input
                                        type="checkbox"
                                        id="address-default"
                                        name="is_default"
                                        class="w-4 h-4 text-neon-fuchsia bg-dark-500 border-white/20 rounded focus:ring-neon-fuchsia/50"
                                    />
                                    <label for="address-default" class="text-sm text-zinc-300">
                                        Usar como dirección predeterminada
                                    </label>
                                </div>

                                <div class="flex gap-3 pt-4 border-t border-white/5">
                                    <button
                                        type="button"
                                        id="cancel-address-btn"
                                        class="flex-1 px-6 py-3 border border-white/20 text-zinc-300 rounded-xl hover:bg-white/5 transition-all duration-200"
                                    >
                                        Cancelar
                                    </button>
                                    <button
                                        type="submit"
                                        id="save-address-btn"
                                        class="flex-1 px-6 py-3 bg-gradient-to-r from-neon-fuchsia to-neon-fuchsia-light text-white font-semibold rounded-xl hover:shadow-lg hover:shadow-neon-fuchsia/25 transition-all duration-200 flex items-center justify-center gap-2"
                                    >
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                        </svg>
                                        Guardar dirección
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Zona de sesión -->
                    <div class="bg-dark-400/50 backdrop-blur-xl border border-white/10 rounded-2xl overflow-hidden">
                        <div class="px-6 py-4 border-b border-white/10 bg-white/5">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-red-500/20 flex items-center justify-center">
                                    <svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                                    </svg>
                                </div>
                                <div>
                                    <h3 class="text-lg font-semibold text-white">Sesión</h3>
                                    <p class="text-sm text-zinc-400">Gestiona tu sesión actual</p>
                                </div>
                            </div>
                        </div>
                        <div class="p-6">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-zinc-300 mb-1">¿Quieres cerrar tu sesión?</p>
                                    <p class="text-sm text-zinc-500">Tendrás que volver a iniciar sesión para acceder a tu cuenta</p>
                                </div>
                                <button
                                    id="logout-btn"
                                    class="px-5 py-2.5 border border-red-500/50 text-red-400 rounded-xl hover:bg-red-500/10 transition-all duration-200 flex items-center gap-2"
                                >
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                                    </svg>
                                    Cerrar sesión
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</PublicLayout>

<script>
    import { createClient } from "@supabase/supabase-js";

    const supabase = createClient(
        import.meta.env.PUBLIC_SUPABASE_URL || "",
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY || "",
    );

    interface CustomerAddress {
        id: string;
        label: string;
        full_name: string;
        phone?: string;
        street: string;
        city: string;
        postal_code: string;
        province: string;
        country: string;
        is_default: boolean;
    }

    let currentUserId: string | null = null;
    let editingAddressId: string | null = null;

    // Función para mostrar mensajes toast
    function showToast(type: 'success' | 'error', message: string) {
        const globalMessage = document.getElementById('global-message');
        const successToast = document.getElementById('success-toast');
        const errorToast = document.getElementById('error-toast');
        const successText = document.getElementById('success-text');
        const errorText = document.getElementById('error-text');

        globalMessage?.classList.remove('hidden');
        
        if (type === 'success') {
            successToast?.classList.remove('hidden');
            errorToast?.classList.add('hidden');
            if (successText) successText.textContent = message;
        } else {
            errorToast?.classList.remove('hidden');
            successToast?.classList.add('hidden');
            if (errorText) errorText.textContent = message;
        }

        setTimeout(() => {
            globalMessage?.classList.add('hidden');
            successToast?.classList.add('hidden');
            errorToast?.classList.add('hidden');
        }, 4000);
    }

    // Obtener nombre del país
    function getCountryName(code: string): string {
        const countries: Record<string, string> = {
            'ES': 'España', 'PT': 'Portugal', 'FR': 'Francia',
            'IT': 'Italia', 'DE': 'Alemania', 'GB': 'Reino Unido',
            'NL': 'Países Bajos', 'BE': 'Bélgica'
        };
        return countries[code] || code;
    }

    // Cargar direcciones
    async function loadAddresses() {
        if (!currentUserId) return;

        const listEl = document.getElementById('addresses-list');
        if (!listEl) return;

        try {
            const { data: addresses, error } = await supabase
                .from('customer_addresses')
                .select('*')
                .eq('customer_id', currentUserId)
                .order('is_default', { ascending: false })
                .order('created_at', { ascending: false });

            if (error) throw error;

            if (!addresses || addresses.length === 0) {
                listEl.innerHTML = `
                    <div class="text-center py-8 text-zinc-500">
                        <svg class="w-12 h-12 mx-auto mb-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                        </svg>
                        <p class="mb-2">No tienes direcciones guardadas</p>
                        <p class="text-sm">Haz clic en "Nueva dirección" para añadir una</p>
                    </div>
                `;
                return;
            }

            listEl.innerHTML = addresses.map((addr: any) => `
                <div class="p-4 bg-dark-500/50 border ${addr.is_default ? 'border-neon-fuchsia/30 bg-neon-fuchsia/5' : 'border-white/10'} rounded-xl hover:border-white/20 transition-all duration-200">
                    <div class="flex items-start justify-between gap-4">
                        <div class="flex-1">
                            <div class="flex items-center gap-2 mb-2">
                                <h4 class="text-white font-semibold">${addr.label}</h4>
                                ${addr.is_default ? '<span class="px-2 py-0.5 bg-neon-fuchsia/20 text-neon-fuchsia text-xs rounded-full">Predeterminada</span>' : ''}
                            </div>
                            <p class="text-zinc-300 text-sm mb-1">${addr.full_name}</p>
                            ${addr.phone ? `<p class="text-zinc-400 text-sm mb-2">${addr.phone}</p>` : ''}
                            <p class="text-zinc-400 text-sm">
                                ${addr.street}<br/>
                                ${addr.postal_code} ${addr.city}, ${addr.province}<br/>
                                ${getCountryName(addr.country)}
                            </p>
                        </div>
                        <div class="flex flex-col gap-2">
                            <button
                                onclick="window.editAddress('${addr.id}')"
                                class="p-2 text-neon-cyan hover:bg-neon-cyan/10 rounded-lg transition-colors"
                                title="Editar"
                            >
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                </svg>
                            </button>
                            ${!addr.is_default ? `
                                <button
                                    onclick="window.setDefaultAddress('${addr.id}')"
                                    class="p-2 text-zinc-400 hover:text-white hover:bg-white/10 rounded-lg transition-colors"
                                    title="Marcar como predeterminada"
                                >
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                    </svg>
                                </button>
                            ` : ''}
                            <button
                                onclick="window.deleteAddress('${addr.id}')"
                                class="p-2 text-red-400 hover:bg-red-500/10 rounded-lg transition-colors"
                                title="Eliminar"
                            >
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            `).join('');

        } catch (error) {
            console.error('Error loading addresses:', error);
            showToast('error', 'Error al cargar las direcciones');
        }
    }

    // Mostrar formulario de dirección
    function showAddressForm(address?: any) {
        const formContainer = document.getElementById('address-form-container');
        const form = document.getElementById('address-form') as HTMLFormElement;
        
        if (!formContainer || !form) return;

        // Reset form
        form.reset();
        editingAddressId = address?.id || null;

        // Fill form if editing
        if (address) {
            (document.getElementById('address-id') as HTMLInputElement).value = address.id;
            (document.getElementById('address-label') as HTMLInputElement).value = address.label;
            (document.getElementById('address-fullname') as HTMLInputElement).value = address.full_name;
            (document.getElementById('address-phone') as HTMLInputElement).value = address.phone || '';
            (document.getElementById('address-street') as HTMLInputElement).value = address.street;
            (document.getElementById('address-city') as HTMLInputElement).value = address.city;
            (document.getElementById('address-postal') as HTMLInputElement).value = address.postal_code;
            (document.getElementById('address-province') as HTMLInputElement).value = address.province;
            (document.getElementById('address-country') as HTMLSelectElement).value = address.country;
            (document.getElementById('address-default') as HTMLInputElement).checked = address.is_default;
        }

        formContainer.classList.remove('hidden');
        formContainer.scrollIntoView({ behavior: 'smooth' });
    }

    // Ocultar formulario
    function hideAddressForm() {
        const formContainer = document.getElementById('address-form-container');
        const form = document.getElementById('address-form') as HTMLFormElement;
        
        if (!formContainer || !form) return;

        formContainer.classList.add('hidden');
        form.reset();
        editingAddressId = null;
    }

    // Funciones globales
    (window as any).editAddress = async (id: string) => {
        const { data: address } = await supabase
            .from('customer_addresses')
            .select('*')
            .eq('id', id)
            .single();
        
        if (address) showAddressForm(address);
    };

    (window as any).setDefaultAddress = async (id: string) => {
        try {
            const { error } = await supabase
                .from('customer_addresses')
                .update({ is_default: true })
                .eq('id', id);

            if (error) throw error;

            showToast('success', 'Dirección marcada como predeterminada');
            await loadAddresses();
        } catch (error) {
            console.error('Error setting default:', error);
            showToast('error', 'Error al cambiar la dirección predeterminada');
        }
    };

    (window as any).deleteAddress = async (id: string) => {
        if (!confirm('¿Estás seguro de que quieres eliminar esta dirección?')) return;

        try {
            const { error } = await supabase
                .from('customer_addresses')
                .delete()
                .eq('id', id);

            if (error) throw error;

            showToast('success', 'Dirección eliminada correctamente');
            await loadAddresses();
        } catch (error) {
            console.error('Error deleting address:', error);
            showToast('error', 'Error al eliminar la dirección');
        }
    };

    async function init() {
        const loadingState = document.getElementById("loading-state");
        const mainContent = document.getElementById("main-content");

        const timeout = setTimeout(() => {
            loadingState?.classList.add("hidden");
            showToast('error', 'La carga está tardando demasiado. Por favor, recarga la página.');
        }, 10000);

        try {
            const { data: { session }, error: sessionError } = await supabase.auth.getSession();

            if (sessionError) {
                clearTimeout(timeout);
                console.error('Error getting session:', sessionError);
                window.location.href = "/auth/login?redirect=/cuenta";
                return;
            }

            if (!session?.user) {
                clearTimeout(timeout);
                window.location.href = "/auth/login?redirect=/cuenta";
                return;
            }

            const user = session.user;
            currentUserId = user.id;
            const userName = user.user_metadata?.full_name || user.user_metadata?.name || "Usuario";
            const userEmail = user.email || "";
            const avatarUrl = user.user_metadata?.avatar_url || user.user_metadata?.picture || null;

            // Actualizar UI
            const userNameEl = document.getElementById("user-name");
            const userEmailEl = document.getElementById("user-email");
            const userInitialEl = document.getElementById("user-initial");
            const nameInput = document.getElementById("name") as HTMLInputElement;
            const emailInput = document.getElementById("email") as HTMLInputElement;

            if (userNameEl) userNameEl.textContent = userName;
            if (userEmailEl) userEmailEl.textContent = userEmail;
            if (userInitialEl) userInitialEl.textContent = userName.charAt(0).toUpperCase();
            if (nameInput) nameInput.value = userName;
            if (emailInput) emailInput.value = userEmail;

            if (avatarUrl) {
                const avatarEl = document.getElementById("user-avatar");
                if (avatarEl) {
                    avatarEl.innerHTML = `<img src="${avatarUrl}" alt="Avatar" class="w-full h-full rounded-full object-cover" />`;
                }
            }

            // Cargar teléfono
            const { data: customerData } = await supabase
                .from('customers')
                .select('phone')
                .eq('id', user.id)
                .single();

            if (customerData) {
                const phoneInput = document.getElementById('phone') as HTMLInputElement;
                if (phoneInput && customerData.phone) {
                    phoneInput.value = customerData.phone;
                }
            }

            // Cargar direcciones
            await loadAddresses();

            clearTimeout(timeout);
            loadingState?.classList.add("hidden");
            mainContent?.classList.remove("hidden");

        } catch (error) {
            clearTimeout(timeout);
            console.error('Error initializing profile:', error);
            loadingState?.classList.add("hidden");
            showToast('error', 'Error al cargar el perfil. Por favor, recarga la página.');
        }
    }

    // Inicializar
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }

    // Cerrar sesión
    document.getElementById("logout-btn")?.addEventListener("click", async () => {
        try {
            await supabase.auth.signOut();
            window.location.href = "/";
        } catch (error) {
            showToast('error', 'Error al cerrar sesión');
        }
    });

    // Guardar información personal
    document.getElementById("profile-form")?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const btn = document.getElementById('save-profile-btn') as HTMLButtonElement;
        const originalText = btn.innerHTML;
        
        btn.disabled = true;
        btn.innerHTML = `
            <svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            Guardando...
        `;

        try {
            const formData = new FormData(e.target as HTMLFormElement);
            const name = formData.get("name") as string;
            const phone = formData.get("phone") as string;

            const { error: authError } = await supabase.auth.updateUser({ 
                data: { full_name: name } 
            });

            if (authError) throw authError;

            const { data: { user } } = await supabase.auth.getUser();
            if (user) {
                const { error: customerError } = await supabase
                    .from('customers')
                    .update({ 
                        full_name: name,
                        phone: phone,
                        updated_at: new Date().toISOString()
                    })
                    .eq('id', user.id);

                if (customerError) throw customerError;
            }

            const userNameEl = document.getElementById("user-name");
            const userInitialEl = document.getElementById("user-initial");
            if (userNameEl) userNameEl.textContent = name;
            if (userInitialEl) userInitialEl.textContent = name.charAt(0).toUpperCase();

            showToast('success', 'Información personal actualizada correctamente');
        } catch (error) {
            console.error('Error saving profile:', error);
            showToast('error', 'Error al guardar la información');
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalText;
        }
    });

    // Añadir nueva dirección
    document.getElementById("add-address-btn")?.addEventListener("click", () => {
        showAddressForm();
    });

    // Cancelar formulario
    document.getElementById("cancel-address-btn")?.addEventListener("click", () => {
        hideAddressForm();
    });

    // Guardar dirección
    document.getElementById("address-form")?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const btn = document.getElementById('save-address-btn') as HTMLButtonElement;
        const originalText = btn.innerHTML;
        
        btn.disabled = true;
        btn.innerHTML = `
            <svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            Guardando...
        `;

        try {
            const formData = new FormData(e.target as HTMLFormElement);
            
            const addressData = {
                customer_id: currentUserId,
                label: formData.get("label") as string,
                full_name: formData.get("full_name") as string,
                phone: formData.get("phone") as string || null,
                street: formData.get("street") as string,
                city: formData.get("city") as string,
                postal_code: formData.get("postal_code") as string,
                province: formData.get("province") as string,
                country: formData.get("country") as string,
                is_default: (document.getElementById('address-default') as HTMLInputElement).checked,
            };

            if (editingAddressId) {
                // Update
                const { error } = await supabase
                    .from('customer_addresses')
                    .update(addressData)
                    .eq('id', editingAddressId);

                if (error) throw error;
                showToast('success', 'Dirección actualizada correctamente');
            } else {
                // Insert
                console.log('Intentando insertar dirección:', addressData);
                
                const { data, error } = await supabase
                    .from('customer_addresses')
                    .insert(addressData)
                    .select();

                if (error) {
                    console.error('Error detallado:', error);
                    throw error;
                }
                
                console.log('Dirección insertada:', data);
                showToast('success', 'Dirección añadida correctamente');
            }

            hideAddressForm();
            await loadAddresses();
        } catch (error: any) {
            console.error('Error saving address:', error);
            const errorMsg = error?.message || error?.details || 'Error desconocido';
            showToast('error', `Error al guardar: ${errorMsg}`);
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalText;
        }
    });
</script>
