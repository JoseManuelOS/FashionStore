---
import PublicLayout from "../layouts/PublicLayout.astro";
import {
    getProducts,
    formatPrice,
    getSetting,
    getProductMainImage,
} from "../lib/supabase";

// SSG - Generate at build time
export const prerender = true;

// Fetch offer products
let products: any[] = [];
let offersEnabled = false;

try {
    products = await getProducts({ isOffer: true });
    const offersSetting = await getSetting("offers_enabled");
    offersEnabled = offersSetting === true || offersSetting === "true";
} catch (e) {
    console.error("Error fetching offers:", e);
}
---

<PublicLayout
    title="Ofertas Flash"
    description="Aprovecha nuestras ofertas especiales en moda masculina premium"
>
    <section
        class="py-12 md:py-16 bg-gradient-to-br from-red-600 to-orange-500"
    >
        <div class="container-custom">
            <!-- Header -->
            <div class="text-center mb-12">
                <span
                    class="inline-block px-4 py-2 bg-white/20 rounded-full text-white text-sm font-medium mb-4"
                >
                    ⚡ Tiempo Limitado
                </span>
                <h1 class="text-4xl md:text-5xl font-serif text-white mb-4">
                    Ofertas Flash
                </h1>
                <p class="text-white/80 max-w-lg mx-auto">
                    Aprovecha estos precios especiales antes de que se agoten
                </p>
            </div>

            {
                !offersEnabled ? (
                    <div class="text-center py-16 bg-white/10 rounded-xl backdrop-blur">
                        <svg
                            class="w-16 h-16 mx-auto text-white/50 mb-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1"
                                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                            />
                        </svg>
                        <h3 class="text-xl font-medium text-white mb-2">
                            Las ofertas volverán pronto
                        </h3>
                        <p class="text-white/70 mb-6">
                            Suscríbete para ser el primero en enterarte
                        </p>
                        <a
                            href="/productos"
                            class="inline-block px-6 py-3 bg-white text-red-600 font-semibold rounded-lg hover:bg-cream-100 transition-colors"
                        >
                            Ver todos los productos
                        </a>
                    </div>
                ) : products.length > 0 ? (
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                        {products.map((product) => (
                            <a
                                href={`/productos/${product.slug}`}
                                class="group bg-white rounded-xl overflow-hidden shadow-elegant-lg hover:scale-[1.02] transition-transform"
                            >
                                <div class="relative aspect-[4/5] bg-cream-200 overflow-hidden">
                                    <img
                                        src={getProductMainImage(product)}
                                        alt={product.name}
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                        loading="lazy"
                                    />
                                    <span class="absolute top-3 left-3 px-3 py-1 bg-red-500 text-white text-xs font-bold rounded-full">
                                        🔥 OFERTA
                                    </span>
                                    {product.stock <= 5 &&
                                        product.stock > 0 && (
                                            <span class="absolute top-3 right-3 px-2 py-1 bg-amber-500 text-white text-xs font-bold rounded">
                                                ¡Últimas {product.stock}!
                                            </span>
                                        )}
                                </div>
                                <div class="p-4">
                                    {product.category && (
                                        <span class="text-xs text-brand-charcoal-400 uppercase tracking-wide">
                                            {product.category.name}
                                        </span>
                                    )}
                                    <h3 class="font-medium text-brand-charcoal-700 mt-1 group-hover:text-brand-navy-500 transition-colors">
                                        {product.name}
                                    </h3>
                                    <p class="font-serif text-xl text-red-600 mt-2">
                                        {formatPrice(product.price)}
                                    </p>
                                </div>
                            </a>
                        ))}
                    </div>
                ) : (
                    <div class="text-center py-16 bg-white/10 rounded-xl backdrop-blur">
                        <svg
                            class="w-16 h-16 mx-auto text-white/50 mb-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1"
                                d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
                            />
                        </svg>
                        <h3 class="text-xl font-medium text-white mb-2">
                            No hay ofertas activas
                        </h3>
                        <p class="text-white/70 mb-6">
                            Vuelve pronto, añadimos nuevas ofertas regularmente
                        </p>
                        <a
                            href="/productos"
                            class="inline-block px-6 py-3 bg-white text-red-600 font-semibold rounded-lg hover:bg-cream-100 transition-colors"
                        >
                            Ver todos los productos
                        </a>
                    </div>
                )
            }
        </div>
    </section>
</PublicLayout>
