---
import PublicLayout from "../layouts/PublicLayout.astro";
import {
    getProducts,
    formatPrice,
    getSetting,
    getProductMainImage,
} from "../lib/supabase";

export const prerender = true;

let products: any[] = [];
let offersEnabled = false;

try {
    products = await getProducts({ isOffer: true });
    const offersSetting = await getSetting("offers_enabled");
    offersEnabled = offersSetting === true || offersSetting === "true";
} catch (e) {
    console.error("Error fetching offers:", e);
}
---

<PublicLayout
    title="Ofertas Flash"
    description="Aprovecha nuestras ofertas especiales en moda masculina premium"
>
    <!-- Hero -->
    <section class="relative py-20 overflow-hidden">
        <!-- Animated Background -->
        <div class="absolute inset-0">
            <div
                class="absolute inset-0 bg-gradient-to-br from-neon-fuchsia/20 via-dark-500 to-neon-purple/10"
            >
            </div>
            <div
                class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-neon-fuchsia/10 rounded-full blur-[150px] animate-pulse"
            >
            </div>
            <div
                class="absolute inset-0 opacity-20"
                style="background-image: radial-gradient(circle at 2px 2px, rgba(217, 70, 239, 0.2) 1px, transparent 0); background-size: 40px 40px;"
            >
            </div>
        </div>

        <div class="container-custom relative z-10">
            <div class="text-center">
                <span
                    class="inline-flex items-center gap-2 px-4 py-2 bg-neon-fuchsia/10 border border-neon-fuchsia/30 rounded-full text-neon-fuchsia text-sm font-medium mb-6"
                >
                    <span
                        class="w-2 h-2 rounded-full bg-neon-fuchsia animate-pulse"
                    ></span>
                    Tiempo Limitado
                </span>
                <h1 class="text-4xl sm:text-5xl md:text-7xl font-display text-white mb-6 break-words">
                    Ofertas <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-neon-fuchsia to-neon-purple"
                        >Flash</span
                    >
                </h1>
                <p class="text-xl text-zinc-400 max-w-xl mx-auto">
                    Aprovecha estos precios especiales antes de que desaparezcan
                </p>
            </div>
        </div>
    </section>

    <!-- Products -->
    <section class="py-16">
        <div class="container-custom">
            {
                !offersEnabled ? (
                    <div class="text-center py-20 glass-card max-w-2xl mx-auto">
                        <div class="w-20 h-20 mx-auto mb-6 rounded-2xl bg-neon-fuchsia/10 flex items-center justify-center">
                            <svg
                                class="w-10 h-10 text-neon-fuchsia"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.5"
                                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                                />
                            </svg>
                        </div>
                        <h3 class="text-2xl font-display text-white mb-3">
                            Las ofertas volverán pronto
                        </h3>
                        <p class="text-zinc-500 mb-8 max-w-md mx-auto">
                            Suscríbete a nuestra newsletter para ser el primero
                            en enterarte de las próximas ofertas
                        </p>
                        <a href="/productos" class="btn-primary">
                            <span>Ver todos los productos</span>
                        </a>
                    </div>
                ) : products.length > 0 ? (
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                        {products.map((product) => (
                            <a
                                href={`/productos/${product.slug}`}
                                class="product-card group"
                            >
                                <div class="relative aspect-[4/5] bg-dark-400 overflow-hidden">
                                    <img
                                        src={getProductMainImage(product)}
                                        alt={product.name}
                                        class="product-image w-full h-full object-cover"
                                        loading="lazy"
                                    />
                                    <div class="absolute top-3 left-3">
                                        <span class="badge-offer">
                                            Oferta
                                        </span>
                                    </div>
                                    {product.stock <= 5 &&
                                        product.stock > 0 && (
                                            <div class="absolute top-3 right-3">
                                                <span class="px-2 py-1 bg-dark-500/80 backdrop-blur text-neon-cyan text-xs font-medium rounded">
                                                    ¡Últimas {product.stock}!
                                                </span>
                                            </div>
                                        )}
                                    <div class="absolute inset-0 bg-gradient-to-t from-dark-600 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
                                </div>
                                <div class="p-5">
                                    {product.category && (
                                        <span class="text-xs text-zinc-500 uppercase tracking-wider">
                                            {product.category.name}
                                        </span>
                                    )}
                                    <h3 class="font-medium text-white mt-1 group-hover:text-neon-fuchsia transition-colors">
                                        {product.name}
                                    </h3>
                                    <p class="font-display text-2xl text-neon-fuchsia mt-2">
                                        {formatPrice(product.price)}
                                    </p>
                                </div>
                            </a>
                        ))}
                    </div>
                ) : (
                    <div class="text-center py-20 glass-card max-w-2xl mx-auto">
                        <svg
                            class="w-16 h-16 mx-auto text-zinc-600 mb-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1"
                                d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
                            />
                        </svg>
                        <h3 class="text-2xl font-display text-white mb-3">
                            No hay ofertas activas
                        </h3>
                        <p class="text-zinc-500 mb-8">
                            Vuelve pronto, añadimos nuevas ofertas regularmente
                        </p>
                        <a href="/productos" class="btn-primary">
                            <span>Ver todos los productos</span>
                        </a>
                    </div>
                )
            }
        </div>
    </section>
</PublicLayout>
