---
import PublicLayout from "../../layouts/PublicLayout.astro";
import AddToCartButton from "../../components/islands/AddToCartButton";
import SizeRecommender from "../../components/islands/SizeRecommender";
import {
    getProductBySlug,
    getProducts,
    formatPrice,
    getProductMainImage,
} from "../../lib/supabase";

export const prerender = false;

const { slug } = Astro.params;
const product = slug ? await getProductBySlug(slug) : null;

if (!product) {
    return Astro.redirect("/productos");
}

const images = product.images || [];
const mainImage = getProductMainImage(product);

let relatedProducts: any[] = [];
if (product.category) {
    try {
        const categoryProducts = await getProducts({
            categorySlug: product.category.slug,
            limit: 4,
        });
        relatedProducts = categoryProducts
            .filter((p) => p.id !== product.id)
            .slice(0, 3);
    } catch (e) {
        console.error("Error fetching related:", e);
    }
}
---

<PublicLayout
    title={product.name}
    description={product.description ||
        `${product.name} - Moda masculina premium en FashionMarket`}
>
    <section class="py-12 md:py-20">
        <div class="container-custom">
            <!-- Breadcrumb -->
            <nav class="mb-8 text-sm">
                <ol class="flex flex-wrap items-center gap-2 text-zinc-500">
                    <li>
                        <a
                            href="/"
                            class="hover:text-neon-cyan transition-colors"
                            >Inicio</a>
                    </li>
                    <li class="text-zinc-600">/</li>
                    <li>
                        <a
                            href="/productos"
                            class="hover:text-neon-cyan transition-colors"
                            >Productos</a>
                    </li>
                    {
                        product.category && (
                            <>
                                <li class="text-zinc-600">/</li>
                                <li>
                                    <a
                                        href={`/categoria/${product.category.slug}`}
                                        class="hover:text-neon-cyan transition-colors"
                                    >
                                        {product.category.name}
                                    </a>
                                </li>
                            </>
                        )
                    }
                    <li class="text-zinc-600">/</li>
                    <li class="text-zinc-300">{product.name}</li>
                </ol>
            </nav>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
                <!-- Product Gallery -->
                <div class="space-y-4">
                    <!-- Main Image -->
                    <div
                        class="relative aspect-[4/5] glass-card overflow-hidden group"
                        transition:name={`product-image-${product.id}`}
                    >
                        <img
                            id="main-image"
                            src={mainImage}
                            alt={product.name}
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                        />
                        {
                            product.is_offer && (
                                <div class="absolute top-4 left-4">
                                    <span class="badge-offer text-sm">
                                        Oferta
                                    </span>
                                </div>
                            )
                        }
                        <!-- Gradient Overlay -->
                        <div
                            class="absolute inset-0 bg-gradient-to-t from-dark-600/50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"
                        >
                        </div>
                    </div>

                    <!-- Thumbnails -->
                    {
                        images.length > 1 && (
                            <div id="thumbnails-container" class="flex gap-3 overflow-x-auto pb-2">
                                {images.map((img: any, idx: number) => (
                                    <button
                                        class={`cursor-pointer flex-shrink-0 w-20 h-24 rounded-lg overflow-hidden border-2 transition-all thumbnail-btn ${idx === 0 ? "border-neon-cyan shadow-glow-cyan" : "border-white/10 hover:border-white/30"}`}
                                        data-image={img.image_url}
                                        data-color={img.color || ''}
                                    >
                                        <img
                                            src={img.image_url}
                                            alt={`${product.name} - Vista ${idx + 1}`}
                                            class="w-full h-full object-cover"
                                        />
                                    </button>
                                ))}
                            </div>
                        )
                    }
                </div>

                <!-- Product Info -->
                <div class="lg:py-4">
                    {
                        product.category && (
                            <a
                                href={`/categoria/${product.category.slug}`}
                                class="inline-block text-sm text-neon-cyan uppercase tracking-wider hover:text-neon-cyan-light transition-colors mb-2"
                            >
                                {product.category.name}
                            </a>
                        )
                    }

                    <h1
                        class="text-4xl md:text-5xl font-display text-white mb-6"
                    >
                        {product.name}
                    </h1>

                    <p
                        class="font-display text-4xl text-transparent bg-clip-text bg-gradient-to-r from-neon-cyan to-neon-fuchsia mb-8"
                    >
                        {formatPrice(product.price)}
                    </p>

                    {
                        product.description && (
                            <div class="mb-8">
                                <p class="text-zinc-400 leading-relaxed text-lg">
                                    {product.description}
                                </p>
                            </div>
                        )
                    }

                    <!-- Add to Cart Component (React Island) -->
                    <div class="glass-card p-6 mb-8">
                        <AddToCartButton client:load product={product} />
                        
                        <!-- Size Recommender (Interactive Island) -->
                        <div class="mt-4 pt-4 border-t border-white/10">
                            <SizeRecommender 
                                client:load 
                                productName={product.name}
                                availableSizes={product.sizes || ['S', 'M', 'L', 'XL']}
                                onSizeSelect={(size: string) => {
                                    document.dispatchEvent(new CustomEvent('size-recommender-select', { detail: size }));
                                }}
                            />
                        </div>
                    </div>

                    <!-- Product Features -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="flex items-center gap-3 p-4 glass-card">
                            <div
                                class="w-10 h-10 rounded-lg bg-neon-cyan/10 flex items-center justify-center"
                            >
                                <svg
                                    class="w-5 h-5 text-neon-cyan"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                            <span class="text-sm text-zinc-300"
                                >Envío gratis +50€</span
                            >
                        </div>
                        <div class="flex items-center gap-3 p-4 glass-card">
                            <div
                                class="w-10 h-10 rounded-lg bg-neon-fuchsia/10 flex items-center justify-center"
                            >
                                <svg
                                    class="w-5 h-5 text-neon-fuchsia"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                                    ></path>
                                </svg>
                            </div>
                            <span class="text-sm text-zinc-300"
                                >30 días devolución</span
                            >
                        </div>
                    </div>
                </div>
            </div>

            <!-- Related Products -->
            {
                relatedProducts.length > 0 && (
                    <div class="mt-20 pt-20 border-t border-white/5">
                        <h2 class="text-3xl font-display text-white mb-10">
                            También te puede interesar
                        </h2>
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                            {relatedProducts.map((related) => (
                                <a
                                    href={`/productos/${related.slug}`}
                                    class="product-card group"
                                >
                                    <div class="aspect-[4/5] bg-dark-400 overflow-hidden">
                                        <img
                                            src={getProductMainImage(related)}
                                            alt={related.name}
                                            class="product-image w-full h-full object-cover"
                                            loading="lazy"
                                        />
                                    </div>
                                    <div class="p-5">
                                        <h3 class="font-medium text-white group-hover:text-neon-cyan transition-colors">
                                            {related.name}
                                        </h3>
                                        <p class="font-display text-xl text-zinc-300 mt-2">
                                            {formatPrice(related.price)}
                                        </p>
                                    </div>
                                </a>
                            ))}
                        </div>
                    </div>
                )
            }
        </div>
    </section>

    <script>
        function initGallery() {
            const mainImage = document.getElementById("main-image") as HTMLImageElement | null;
            const thumbnailsContainer = document.getElementById("thumbnails-container");
            const thumbnails = document.querySelectorAll<HTMLElement>(".thumbnail-btn");
            if (!mainImage || thumbnails.length === 0) return;

            thumbnails.forEach((btn) => {
                const fresh = btn.cloneNode(true) as HTMLElement;
                btn.replaceWith(fresh);
            });

            // Re-query after clone
            document.querySelectorAll<HTMLElement>(".thumbnail-btn").forEach((btn) => {
                btn.addEventListener("click", () => {
                    const newSrc = btn.dataset.image;
                    if (!newSrc || !mainImage) return;

                    mainImage.src = newSrc;

                    document.querySelectorAll<HTMLElement>(".thumbnail-btn").forEach((t) => {
                        t.classList.remove("border-neon-cyan", "shadow-glow-cyan");
                        t.classList.add("border-white/10");
                    });
                    btn.classList.remove("border-white/10");
                    btn.classList.add("border-neon-cyan", "shadow-glow-cyan");
                });
            });
        }

        // Listen for color changes from AddToCartButton via custom event
        function initColorFilter() {
            document.addEventListener('product-color-change', ((e: CustomEvent) => {
                const color = e.detail?.color || '';
                const mainImage = document.getElementById("main-image") as HTMLImageElement | null;
                const allThumbnails = document.querySelectorAll<HTMLElement>(".thumbnail-btn");
                if (!mainImage || allThumbnails.length === 0) return;

                let firstVisible: HTMLElement | null = null;
                allThumbnails.forEach((btn) => {
                    const btnColor = btn.dataset.color || '';
                    // Show thumbnail if it matches the color or has no color assigned
                    if (!color || !btnColor || btnColor === color) {
                        btn.style.display = '';
                        if (!firstVisible) firstVisible = btn;
                    } else {
                        btn.style.display = 'none';
                    }
                });

                // Set main image to first visible thumbnail
                if (firstVisible) {
                    const visibleBtn = firstVisible as HTMLElement;
                    const newSrc = visibleBtn.dataset.image;
                    if (newSrc) {
                        mainImage.src = newSrc;
                        allThumbnails.forEach((t) => {
                            t.classList.remove("border-neon-cyan", "shadow-glow-cyan");
                            t.classList.add("border-white/10");
                        });
                        visibleBtn.classList.remove("border-white/10");
                        visibleBtn.classList.add("border-neon-cyan", "shadow-glow-cyan");
                    }
                }
            }) as EventListener);
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", () => { initGallery(); initColorFilter(); });
        } else {
            initGallery();
            initColorFilter();
        }

        document.addEventListener("astro:page-load", () => { initGallery(); initColorFilter(); });
    </script>
</PublicLayout>
