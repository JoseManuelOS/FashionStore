---
import PublicLayout from "../../layouts/PublicLayout.astro";
import ProductCard from "../../components/islands/ProductCard";
import FilterSidebar from "../../components/islands/FilterSidebar";
import { getProducts, getCategories } from "../../lib/supabase";

// SSR for dynamic filtering
export const prerender = false;

// Get URL params for filters
const url = new URL(Astro.request.url);
const searchQuery = url.searchParams.get("buscar") || "";
const categoryFilter = url.searchParams.get("categoria") || "";
const sizesFilter =
  url.searchParams.get("tallas")?.split(",").filter(Boolean) || [];
const priceMin = Number(url.searchParams.get("precioMin")) || 0;
const priceMax = Number(url.searchParams.get("precioMax")) || 1000;
const colorFilter = url.searchParams.get("color") || "";
const offersOnly = url.searchParams.get("ofertas") === "true";
const sortBy = url.searchParams.get("ordenar") || "newest";

let allProducts: any[] = [];
let categories: any[] = [];

try {
  allProducts = await getProducts();
  categories = await getCategories();
} catch (e) {
  console.error("Error fetching products:", e);
}

// Apply filters
let products = allProducts;

if (searchQuery) {
  const query = searchQuery.toLowerCase();
  products = products.filter(
    (p) =>
      p.name?.toLowerCase().includes(query) ||
      p.description?.toLowerCase().includes(query) ||
      p.category?.name?.toLowerCase().includes(query),
  );
}

if (categoryFilter) {
  products = products.filter((p) => p.category?.slug === categoryFilter);
}

if (sizesFilter.length > 0) {
  products = products.filter((p) =>
    sizesFilter.some((size) => p.sizes?.includes(size)),
  );
}

if (priceMin > 0) {
  products = products.filter((p) => p.price >= priceMin);
}

if (priceMax < 1000) {
  products = products.filter((p) => p.price <= priceMax);
}

if (offersOnly) {
  products = products.filter((p) => p.is_offer);
}

// Sort
if (sortBy === "price-low") {
  products.sort((a, b) => a.price - b.price);
} else if (sortBy === "price-high") {
  products.sort((a, b) => b.price - a.price);
} else if (sortBy === "name") {
  products.sort((a, b) => a.name.localeCompare(b.name));
}

// Get all unique sizes and max price
const allSizes = [...new Set(allProducts.flatMap((p) => p.sizes || []))];
const globalMaxPrice = Math.max(...allProducts.map((p) => p.price), 500);

// Initial filter values for the component
const initialFilters = {
  search: searchQuery,
  category: categoryFilter,
  sizes: sizesFilter,
  priceMin: priceMin,
  priceMax: priceMax || globalMaxPrice,
  offers: offersOnly,
  color: colorFilter,
};
---

<PublicLayout
  title={searchQuery ? `Buscando: ${searchQuery}` : "Productos"}
  description="Explora nuestra colección completa de moda masculina premium"
>
  <section class="py-8 md:py-12 min-h-screen">
    <div class="container-custom">
      <!-- Header -->
      <div
        class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6"
      >
        <div>
          {
            searchQuery ? (
              <h1 class="text-2xl md:text-3xl font-display text-white">
                Resultados para "
                <span class="text-neon-cyan">{searchQuery}</span>"
              </h1>
            ) : (
              <h1 class="text-2xl md:text-3xl font-display text-white">
                {categoryFilter
                  ? categories.find((c) => c.slug === categoryFilter)?.name
                  : "Todos los Productos"}
              </h1>
            )
          }
          <p class="text-sm text-zinc-500 mt-1">
            {products.length} producto{products.length !== 1 ? "s" : ""}
          </p>
        </div>

        <!-- Sort -->
        <select
          id="sort-select"
          class="bg-dark-400 border border-white/10 text-white px-4 py-2.5 rounded-lg text-sm focus:outline-none focus:border-neon-cyan/50 w-full md:w-auto"
        >
          <option value="newest" selected={sortBy === "newest"}
            >Más recientes</option
          >
          <option value="price-low" selected={sortBy === "price-low"}
            >Precio: menor a mayor</option
          >
          <option value="price-high" selected={sortBy === "price-high"}
            >Precio: mayor a menor</option
          >
          <option value="name" selected={sortBy === "name"}>Nombre A-Z</option>
        </select>
      </div>

      <div class="flex flex-col lg:flex-row gap-6">
        <!-- Filters Sidebar -->
        <aside class="lg:w-64 flex-shrink-0">
          <FilterSidebar
            client:load
            categories={categories}
            allSizes={allSizes}
            maxPrice={globalMaxPrice}
            initialFilters={initialFilters}
          />
        </aside>

        <!-- Products Grid -->
        <div class="flex-1">
          {
            products.length > 0 ? (
              <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 md:gap-6">
                {products.map((product) => (
                  <ProductCard client:load product={product} />
                ))}
              </div>
            ) : (
              <div class="text-center py-16 glass-card">
                <svg
                  class="w-12 h-12 mx-auto text-zinc-600 mb-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1"
                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                  />
                </svg>
                <h3 class="text-lg font-display text-white mb-2">
                  Sin resultados
                </h3>
                <p class="text-sm text-zinc-500 mb-4">
                  Prueba con otros filtros
                </p>
                <a
                  href="/productos"
                  class="text-neon-cyan hover:underline text-sm"
                >
                  Ver todos
                </a>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <script>
    // Sort select
    const sortSelect = document.getElementById(
      "sort-select",
    ) as HTMLSelectElement;
    sortSelect?.addEventListener("change", () => {
      const url = new URL(window.location.href);
      url.searchParams.set("ordenar", sortSelect.value);
      window.location.href = url.toString();
    });
  </script>
</PublicLayout>
