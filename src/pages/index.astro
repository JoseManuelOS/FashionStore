---
import PublicLayout from "../layouts/PublicLayout.astro";
import {
	getProducts,
	getCategories,
	formatPrice,
	getSetting,
	getProductMainImage,
	getCarouselSlides,
	type CarouselSlide,
} from "../lib/supabase";

export const prerender = false;

// Fallback slides if no database slides exist

let products: any[] = [];
let offerProducts: any[] = [];
let categories: any[] = [];
let offersEnabled = false;
let carouselSlides: CarouselSlide[] = [];

try {
	products = await getProducts({ limit: 8 });
	offerProducts = await getProducts({ isOffer: true, limit: 4 });
	categories = await getCategories();
	const offersSetting = await getSetting("offers_enabled");
	offersEnabled = offersSetting === true || offersSetting === "true";
	carouselSlides = await getCarouselSlides();
	
	// Debug logging for carousel
	console.log("[HOMEPAGE] Loaded carousel slides:", carouselSlides.length);
	carouselSlides.forEach((slide, i) => {
		console.log(`[HOMEPAGE] Slide ${i + 1} "${slide.title}":`, JSON.stringify(slide.style_config));
	});
} catch (e) {
	console.error("Error fetching data:", e);
}

// Fallback slides if no database slides exist
const defaultSlides = [
	{
		id: "default-1",
		image_url:
			"https://images.unsplash.com/photo-1490578474895-699cd4e2cf59?w=1920&q=80",
		title: "Nueva Colección",
		subtitle: "Primavera 2026",
		description: "Descubre las últimas tendencias en moda masculina",
		cta_text: "Explorar",
		cta_link: "/productos",
		duration: 5000,
		sort_order: 1,
		is_active: true,
		discount_code: undefined,
		style_config: undefined,
	},
	{
		id: "default-2",
		image_url:
			"https://images.unsplash.com/photo-1507680434567-5739c80be1ac?w=1920&q=80",
		title: "Estilo Premium",
		subtitle: "Elegancia Definida",
		description: "Prendas de alta calidad para el hombre moderno",
		cta_text: "Ver colección",
		cta_link: "/categoria/camisas",
		duration: 5000,
		sort_order: 2,
		is_active: true,
		style_config: undefined,
	},
	{
		id: "default-3",
		image_url:
			"https://images.unsplash.com/photo-1617137968427-85924c800a22?w=1920&q=80",
		title: "Ofertas Especiales",
		subtitle: "Hasta 40% Off",
		description: "Aprovecha nuestros descuentos exclusivos",
		cta_text: "Comprar ahora",
		cta_link: "/ofertas",
		duration: 5000,
		sort_order: 3,
		is_active: true,
		style_config: undefined,
	},
];

// Use database slides or fallback to defaults
const heroSlides = carouselSlides.length > 0 ? carouselSlides : defaultSlides;
---

<PublicLayout
	title="Moda Masculina Premium | FashionMarket"
	description="Tienda de moda masculina premium. Descubre nuestra colección de camisas, pantalones y trajes de alta calidad."
>
	<style>
		/* Hero Carousel */
		.hero-carousel {
			position: relative;
			width: 100%;
			aspect-ratio: 21 / 9;
			max-height: 90vh;
			overflow: hidden;
		}

		@media (max-width: 768px) {
			.hero-carousel {
				aspect-ratio: 3 / 4;
				max-height: 85vh;
			}
		}

		.hero-slide {
			position: absolute;
			inset: 0;
			opacity: 0;
			transition: opacity 1s ease-in-out;
		}

		.hero-slide.active {
			opacity: 1;
		}

		.hero-slide img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.hero-overlay {
			position: absolute;
			inset: 0;
			background: linear-gradient(
				to right,
				rgba(0, 0, 0, 0.7) 0%,
				rgba(0, 0, 0, 0.4) 50%,
				rgba(0, 0, 0, 0.2) 100%
			);
		}

		.hero-content {
			position: absolute;
			inset: 0;
			display: flex;
			align-items: center;
		}

		/* Responsive Carousel Elements - Use CSS custom properties for positions */
		.carousel-element {
			top: var(--desktop-top, 50%);
			left: var(--desktop-left, 10%);
			font-size: var(--desktop-font-size, 1rem);
			max-width: var(--desktop-max-width, auto);
		}

		.carousel-element .hero-title {
			font-size: var(--desktop-font-size, 3.5rem);
		}

		.carousel-element .hero-subtitle {
			font-size: var(--desktop-font-size, 1rem);
		}

		.carousel-element .hero-description {
			font-size: var(--desktop-font-size, 1.125rem);
		}

		/* Mobile responsive overrides */
		@media (max-width: 768px) {
			.carousel-element {
				top: var(--mobile-top, 50%);
				left: var(--mobile-left, 5%);
				font-size: var(--mobile-font-size, 0.875rem);
				max-width: var(--mobile-max-width, 90%);
			}

			.carousel-element .hero-title {
				font-size: var(--mobile-font-size, 2rem);
			}

			.carousel-element .hero-subtitle {
				font-size: var(--mobile-font-size, 0.875rem);
			}

			.carousel-element .hero-description {
				font-size: var(--mobile-font-size, 0.875rem);
			}
		}

		/* Carousel Navigation */
		.carousel-nav {
			position: absolute;
			bottom: 40px;
			left: 50%;
			transform: translateX(-50%);
			display: flex;
			gap: 12px;
			z-index: 10;
		}

		.carousel-dot {
			width: 40px;
			height: 4px;
			background: rgba(255, 255, 255, 0.3);
			border: none;
			cursor: pointer;
			transition: all 0.3s ease;
		}

		.carousel-dot.active {
			background: white;
			width: 60px;
		}

		.carousel-arrows {
			position: absolute;
			bottom: 40px;
			right: 5%;
			display: flex;
			gap: 8px;
			z-index: 10;
		}

		.carousel-arrow {
			width: 50px;
			height: 50px;
			background: rgba(255, 255, 255, 0.1);
			border: 1px solid rgba(255, 255, 255, 0.2);
			color: white;
			display: flex;
			align-items: center;
			justify-content: center;
			cursor: pointer;
			transition: all 0.3s ease;
		}

		.carousel-arrow:hover {
			background: white;
			color: #0a0a0f;
		}

		/* Section Styles */
		.section-header {
			text-align: center;
			margin-bottom: 60px;
		}

		.section-label {
			font-size: 12px;
			text-transform: uppercase;
			letter-spacing: 3px;
			color: #d4af37;
			margin-bottom: 16px;
			font-weight: 500;
		}

		.section-title {
			font-size: clamp(2rem, 4vw, 3rem);
			font-weight: 600;
			color: white;
			margin-bottom: 16px;
		}

		.section-description {
			color: #71717a;
			font-size: 16px;
			max-width: 500px;
			margin: 0 auto;
		}

		/* Categories Grid */
		.categories-grid {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 24px;
		}

		@media (max-width: 768px) {
			.categories-grid {
				grid-template-columns: 1fr;
			}
		}

		.category-card {
			position: relative;
			height: 400px;
			overflow: hidden;
			background: #111;
		}

		.category-card img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			transition: transform 0.6s ease;
		}

		.category-card:hover img {
			transform: scale(1.1);
		}

		.category-overlay {
			position: absolute;
			inset: 0;
			background: linear-gradient(
				to top,
				rgba(0, 0, 0, 0.8) 0%,
				transparent 60%
			);
		}

		.category-content {
			position: absolute;
			bottom: 0;
			left: 0;
			right: 0;
			padding: 32px;
		}

		.category-name {
			font-size: 24px;
			font-weight: 600;
			color: white;
			margin-bottom: 8px;
		}

		.category-link {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			color: #d4af37;
			font-size: 14px;
			text-transform: uppercase;
			letter-spacing: 1px;
			text-decoration: none;
			transition: gap 0.3s ease;
		}

		.category-link:hover {
			gap: 12px;
		}

		/* Products Grid */
		.products-section {
			background: linear-gradient(180deg, #0a0a0f 0%, #111118 100%);
			padding: 100px 0;
		}

		.products-grid {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			gap: 24px;
		}

		@media (max-width: 1024px) {
			.products-grid {
				grid-template-columns: repeat(2, 1fr);
			}
		}

		@media (max-width: 640px) {
			.products-grid {
				grid-template-columns: 1fr;
			}
		}

		.product-card-new {
			background: #18181b;
			overflow: hidden;
			transition: transform 0.3s ease;
		}

		.product-card-new:hover {
			transform: translateY(-8px);
		}

		.product-image-container {
			position: relative;
			aspect-ratio: 3/4;
			overflow: hidden;
			background: #27272a;
		}

		.product-image-container img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			transition: transform 0.5s ease;
		}

		.product-card-new:hover .product-image-container img {
			transform: scale(1.05);
		}

		.product-badge {
			position: absolute;
			top: 12px;
			left: 12px;
			padding: 6px 12px;
			font-size: 11px;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.5px;
		}

		.badge-sale {
			background: #dc2626;
			color: white;
		}

		.badge-new {
			background: #d4af37;
			color: #0a0a0f;
		}

		.product-quick-view {
			position: absolute;
			inset: 0;
			background: rgba(0, 0, 0, 0.6);
			display: flex;
			align-items: center;
			justify-content: center;
			opacity: 0;
			transition: opacity 0.3s ease;
		}

		.product-card-new:hover .product-quick-view {
			opacity: 1;
		}

		.quick-view-btn {
			padding: 14px 28px;
			background: white;
			color: #0a0a0f;
			font-size: 12px;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 1px;
			text-decoration: none;
			transform: translateY(20px);
			transition: all 0.3s ease;
		}

		.product-card-new:hover .quick-view-btn {
			transform: translateY(0);
		}

		.product-info {
			padding: 20px;
		}

		.product-category {
			font-size: 11px;
			text-transform: uppercase;
			letter-spacing: 1px;
			color: #71717a;
			margin-bottom: 8px;
		}

		.product-name {
			font-size: 16px;
			font-weight: 500;
			color: white;
			margin-bottom: 12px;
			line-height: 1.4;
		}

		.product-price {
			font-size: 18px;
			font-weight: 600;
			color: #d4af37;
		}

		/* Features Section */
		.features-section {
			padding: 80px 0;
			background: #0a0a0f;
			border-top: 1px solid #27272a;
			border-bottom: 1px solid #27272a;
		}

		.features-grid {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			gap: 40px;
		}

		@media (max-width: 768px) {
			.features-grid {
				grid-template-columns: repeat(2, 1fr);
				gap: 24px;
			}
		}

		@media (max-width: 480px) {
			.features-grid {
				grid-template-columns: 1fr;
			}
		}

		.feature-item {
			text-align: center;
		}

		.feature-icon {
			width: 60px;
			height: 60px;
			margin: 0 auto 20px;
			display: flex;
			align-items: center;
			justify-content: center;
			border: 1px solid #27272a;
			color: #d4af37;
		}

		.feature-title {
			font-size: 16px;
			font-weight: 600;
			color: white;
			margin-bottom: 8px;
		}

		.feature-text {
			font-size: 14px;
			color: #71717a;
			line-height: 1.6;
		}

		/* CTA Banner */
		.cta-banner {
			position: relative;
			height: 500px;
			overflow: hidden;
		}

		.cta-banner img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.cta-overlay {
			position: absolute;
			inset: 0;
			background: rgba(0, 0, 0, 0.6);
			display: flex;
			align-items: center;
			justify-content: center;
			text-align: center;
		}

		.cta-content {
			max-width: 600px;
			padding: 0 20px;
		}

		.cta-title {
			font-size: clamp(2rem, 4vw, 3rem);
			font-weight: 600;
			color: white;
			margin-bottom: 20px;
		}

		.cta-text {
			font-size: 18px;
			color: rgba(255, 255, 255, 0.8);
			margin-bottom: 32px;
		}

		.cta-btn {
			display: inline-flex;
			align-items: center;
			gap: 12px;
			padding: 16px 40px;
			background: #d4af37;
			color: #0a0a0f;
			font-weight: 600;
			font-size: 14px;
			text-transform: uppercase;
			letter-spacing: 1px;
			text-decoration: none;
			transition: all 0.3s ease;
		}

		.cta-btn:hover {
			background: white;
			transform: translateY(-2px);
		}

		/* Offers Section */
		.offers-section {
			padding: 100px 0;
			background: linear-gradient(135deg, #1a1a1f 0%, #0a0a0f 100%);
		}

		.offers-grid {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 24px;
		}

		@media (max-width: 768px) {
			.offers-grid {
				grid-template-columns: 1fr;
			}
		}

		.offer-card {
			position: relative;
			height: 350px;
			overflow: hidden;
			display: flex;
			background: #18181b;
		}

		.offer-image {
			width: 50%;
			position: relative;
			overflow: hidden;
		}

		.offer-image img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			transition: transform 0.5s ease;
		}

		.offer-card:hover .offer-image img {
			transform: scale(1.1);
		}

		.offer-content {
			width: 50%;
			padding: 40px;
			display: flex;
			flex-direction: column;
			justify-content: center;
		}

		.offer-badge {
			display: inline-block;
			padding: 6px 16px;
			background: #dc2626;
			color: white;
			font-size: 12px;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.5px;
			margin-bottom: 16px;
			width: fit-content;
		}

		.offer-name {
			font-size: 24px;
			font-weight: 600;
			color: white;
			margin-bottom: 12px;
		}

		.offer-price {
			font-size: 28px;
			font-weight: 700;
			color: #d4af37;
			margin-bottom: 24px;
		}

		.offer-link {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			color: white;
			font-size: 14px;
			text-transform: uppercase;
			letter-spacing: 1px;
			text-decoration: none;
			transition: gap 0.3s ease;
		}

		.offer-link:hover {
			gap: 12px;
			color: #d4af37;
		}

		@media (max-width: 640px) {
			.offer-card {
				flex-direction: column;
				height: auto;
			}
			.offer-image,
			.offer-content {
				width: 100%;
			}
			.offer-image {
				height: 250px;
			}
		}

		/* View All Link */
		.view-all-container {
			text-align: center;
			margin-top: 60px;
		}

		.view-all-link {
			display: inline-flex;
			align-items: center;
			gap: 12px;
			padding: 16px 40px;
			border: 1px solid #27272a;
			color: white;
			font-size: 14px;
			text-transform: uppercase;
			letter-spacing: 1px;
			text-decoration: none;
			transition: all 0.3s ease;
		}

		.view-all-link:hover {
			background: white;
			color: #0a0a0f;
			border-color: white;
		}
	</style>

	<!-- Hero Carousel -->
	<section class="hero-carousel" id="hero-carousel">
		{
			heroSlides.map((slide, index) => (
				<div
					class={`hero-slide ${index === 0 ? "active" : ""}`}
					data-slide={index}
					data-duration={slide.duration}
				>
					<img src={slide.image_url} alt={slide.title} />
					<div class="hero-overlay" />
					<div class="hero-content">
						<div class="w-full h-full relative">
							<!-- Subtitle -->
							<div
								class="absolute z-10 carousel-element"
								data-element="subtitle"
								style={(() => {
									const desktop = slide.style_config?.desktop?.subtitle || slide.style_config?.subtitle;
									const mobile = slide.style_config?.mobile?.subtitle || desktop;
									const d = desktop || { top: '15%', left: '10%' };
									const m = mobile || { top: '20%', left: '5%' };
									return `--desktop-top: ${d.top}; --desktop-left: ${d.left}; --mobile-top: ${m.top}; --mobile-left: ${m.left}; --desktop-font-size: ${d.fontSize || '1rem'}; --mobile-font-size: ${m.fontSize || '0.875rem'}; --desktop-max-width: ${d.maxWidth || 'auto'}; --mobile-max-width: ${m.maxWidth || '90%'};`;
								})()}
							>
								<p 
									class="hero-subtitle uppercase tracking-[0.2em] font-medium"
									style={(() => {
										const cfg = slide.style_config?.desktop?.subtitle || slide.style_config?.subtitle;
										return `color: ${cfg?.color || '#d4af37'}; text-transform: ${cfg?.textTransform || 'uppercase'};`;
									})()}
								>
									{slide.subtitle}
								</p>
							</div>

							<!-- Title -->
							<div
								class="absolute z-10 carousel-element"
								data-element="title"
								style={(() => {
									const desktop = slide.style_config?.desktop?.title || slide.style_config?.title;
									const mobile = slide.style_config?.mobile?.title || desktop;
									const d = desktop || { top: '25%', left: '10%' };
									const m = mobile || { top: '28%', left: '5%' };
									return `--desktop-top: ${d.top}; --desktop-left: ${d.left}; --mobile-top: ${m.top}; --mobile-left: ${m.left}; --desktop-font-size: ${d.fontSize || '3.5rem'}; --mobile-font-size: ${m.fontSize || '2rem'}; --desktop-max-width: ${d.maxWidth || '60%'}; --mobile-max-width: ${m.maxWidth || '90%'};`;
								})()}
							>
								<h1 
									class="hero-title font-bold leading-tight"
									style={(() => {
										const cfg = slide.style_config?.desktop?.title || slide.style_config?.title;
										return `color: ${cfg?.color || '#ffffff'}; font-weight: ${cfg?.fontWeight || '700'};`;
									})()}
								>
									{slide.title}
								</h1>
							</div>

							<!-- Description -->
							<div
								class="absolute z-10 carousel-element"
								data-element="description"
								style={(() => {
									const desktop = slide.style_config?.desktop?.description || slide.style_config?.description;
									const mobile = slide.style_config?.mobile?.description || desktop;
									const d = desktop || { top: '45%', left: '10%' };
									const m = mobile || { top: '48%', left: '5%' };
									return `--desktop-top: ${d.top}; --desktop-left: ${d.left}; --mobile-top: ${m.top}; --mobile-left: ${m.left}; --desktop-font-size: ${d.fontSize || '1.125rem'}; --mobile-font-size: ${m.fontSize || '0.875rem'}; --desktop-max-width: ${d.maxWidth || '40%'}; --mobile-max-width: ${m.maxWidth || '90%'};`;
								})()}
							>
								<p 
									class="hero-description"
									style={(() => {
										const cfg = slide.style_config?.desktop?.description || slide.style_config?.description;
										return `color: ${cfg?.color || '#e4e4e7'};`;
									})()}
								>
									{slide.description}
								</p>
							</div>

							<!-- Discount Code -->
							{slide.discount_code && (
								<div
									class="absolute z-10 carousel-element"
									data-element="discount"
									style={(() => {
										const desktop = slide.style_config?.desktop?.discount || slide.style_config?.discount;
										const mobile = slide.style_config?.mobile?.discount || desktop;
										const d = desktop || { top: '60%', left: '10%' };
										const m = mobile || { top: '62%', left: '5%' };
										return `--desktop-top: ${d.top}; --desktop-left: ${d.left}; --mobile-top: ${m.top}; --mobile-left: ${m.left};`;
									})()}
								>
									<button
										class="inline-flex items-center gap-3 bg-white/10 backdrop-blur-md border border-white/20 rounded-lg px-4 py-2 hover:bg-white/20 transition-all cursor-pointer group copy-discount-btn"
										data-code={slide.discount_code}
										title="Clic para copiar código"
									>
										<span class="text-white/80 text-sm font-medium discount-label">
											CÓDIGO:
										</span>
										<span 
									class="font-mono font-bold tracking-wider discount-code"
									style={(() => {
