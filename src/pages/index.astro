---
import PublicLayout from "../layouts/PublicLayout.astro";
import {
	getProducts,
	getCategories,
	formatPrice,
	getSetting,
	getProductMainImage,
} from "../lib/supabase";

// SSG - Generate at build time
export const prerender = true;

// Fetch data
let products: any[] = [];
let offerProducts: any[] = [];
let categories: any[] = [];
let offersEnabled = false;

try {
	products = await getProducts({ limit: 6 });
	offerProducts = await getProducts({ isOffer: true, limit: 4 });
	categories = await getCategories();
	const offersSetting = await getSetting("offers_enabled");
	offersEnabled = offersSetting === true || offersSetting === "true";
} catch (e) {
	console.error("Error fetching data:", e);
}
---

<PublicLayout
	title="Moda Masculina Premium"
	description="Descubre la colección de moda masculina premium en FashionMarket. Diseño futurista y elegancia."
>
	<!-- Hero Section - Futuristic Gradient -->
	<section class="relative min-h-[90vh] flex items-center overflow-hidden">
		<!-- Animated Background -->
		<div class="absolute inset-0">
			<div class="absolute inset-0 bg-gradient-to-br from-dark-600 via-dark-500 to-dark-600"></div>
			<div class="absolute top-0 left-1/4 w-[600px] h-[600px] bg-neon-cyan/10 rounded-full blur-[120px] animate-pulse"></div>
			<div class="absolute bottom-0 right-1/4 w-[500px] h-[500px] bg-neon-fuchsia/10 rounded-full blur-[100px] animate-pulse" style="animation-delay: 1s;"></div>
			<!-- Grid Pattern -->
			<div class="absolute inset-0 opacity-20" style="background-image: linear-gradient(rgba(6, 182, 212, 0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(6, 182, 212, 0.1) 1px, transparent 1px); background-size: 60px 60px;"></div>
		</div>

		<div class="container-custom relative z-10 py-20">
			<div class="max-w-3xl">
				<span class="inline-block px-4 py-2 bg-neon-cyan/10 border border-neon-cyan/30 rounded-full text-neon-cyan text-sm font-medium mb-6 animate-fade-in">
					✦ Nueva Colección 2026
				</span>
				<h1 class="text-5xl md:text-7xl font-display text-white mb-6 leading-tight animate-slide-up">
					El Futuro de la
					<span class="text-transparent bg-clip-text bg-gradient-to-r from-neon-cyan to-neon-fuchsia">
						Moda Masculina
					</span>
				</h1>
				<p class="text-xl text-zinc-400 mb-10 max-w-xl leading-relaxed animate-slide-up" style="animation-delay: 0.1s;">
					Diseños vanguardistas que fusionan tecnología y estilo. 
					Ropa que define el hombre del mañana.
				</p>
				<div class="flex flex-wrap gap-4 animate-slide-up" style="animation-delay: 0.2s;">
					<a href="/productos" class="btn-primary group">
						<span class="flex items-center gap-2">
							Explorar Colección
							<svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
							</svg>
						</span>
					</a>
					{offersEnabled && offerProducts.length > 0 && (
						<a href="#ofertas" class="btn-secondary">
							<span class="flex items-center gap-2">
								<span class="w-2 h-2 rounded-full bg-neon-fuchsia animate-pulse"></span>
								Ofertas Flash
							</span>
						</a>
					)}
				</div>
			</div>
		</div>

		<!-- Scroll Indicator -->
		<div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
			<svg class="w-6 h-6 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
			</svg>
		</div>
	</section>

	<!-- ⚡ OFERTAS FLASH SECTION -->
	{offersEnabled && offerProducts.length > 0 && (
		<section id="ofertas" class="py-20 relative overflow-hidden">
			<!-- Background -->
			<div class="absolute inset-0 bg-gradient-to-br from-neon-fuchsia/10 via-dark-500 to-neon-purple/10"></div>
			<div class="absolute inset-0 opacity-30" style="background-image: radial-gradient(circle at 2px 2px, rgba(217, 70, 239, 0.15) 1px, transparent 0); background-size: 40px 40px;"></div>
			
			<div class="container-custom relative z-10">
				<div class="text-center mb-14">
					<span class="inline-flex items-center gap-2 px-4 py-2 bg-neon-fuchsia/10 border border-neon-fuchsia/30 rounded-full text-neon-fuchsia text-sm font-medium mb-4">
						<span class="w-2 h-2 rounded-full bg-neon-fuchsia animate-pulse"></span>
						Tiempo Limitado
					</span>
					<h2 class="text-4xl md:text-5xl font-display text-white mb-4">
						Ofertas <span class="text-neon-fuchsia">Flash</span>
					</h2>
					<p class="text-zinc-400 max-w-lg mx-auto">
						Aprovecha estos precios especiales antes de que desaparezcan
					</p>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
					{offerProducts.map((product) => (
						<a
							href={`/productos/${product.slug}`}
							class="product-card group"
						>
							<div class="relative aspect-[4/5] bg-dark-400 overflow-hidden">
								<img
									src={getProductMainImage(product)}
									alt={product.name}
									class="product-image w-full h-full object-cover"
									loading="lazy"
								/>
								<div class="absolute top-3 left-3">
									<span class="badge-offer">🔥 Oferta</span>
								</div>
								<!-- Hover Overlay -->
								<div class="absolute inset-0 bg-gradient-to-t from-dark-600 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
							</div>
							<div class="p-5 relative z-10">
								<h3 class="font-medium text-white group-hover:text-neon-cyan transition-colors">
									{product.name}
								</h3>
								<p class="font-display text-xl text-neon-fuchsia mt-2">
									{formatPrice(product.price)}
								</p>
							</div>
						</a>
					))}
				</div>
			</div>
		</section>
	)}

	<!-- Categories Section -->
	<section class="py-20">
		<div class="container-custom">
			<div class="text-center mb-14">
				<h2 class="text-4xl md:text-5xl font-display text-white mb-4">
					Categorías
				</h2>
				<p class="text-zinc-400">Explora nuestra colección por estilo</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				{categories.map((category, index) => (
					<a
						href={`/categoria/${category.slug}`}
						class="group relative h-72 rounded-2xl overflow-hidden glass-card"
					>
						<!-- Gradient Background -->
						<div class={`absolute inset-0 bg-gradient-to-br ${index === 0 ? 'from-neon-cyan/20 to-dark-500' : index === 1 ? 'from-neon-fuchsia/20 to-dark-500' : 'from-neon-purple/20 to-dark-500'} transition-all group-hover:scale-110 duration-500`}></div>
						
						<!-- Content -->
						<div class="absolute inset-0 flex flex-col justify-end p-8">
							<h3 class="text-3xl font-display text-white mb-2 group-hover:text-neon-cyan transition-colors">
								{category.name}
							</h3>
							<span class="flex items-center gap-2 text-zinc-400 group-hover:text-white transition-colors">
								Ver productos
								<svg
									class="w-4 h-4 transform group-hover:translate-x-2 transition-transform"
									fill="none"
									stroke="currentColor"
									viewBox="0 0 24 24"
								>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
								</svg>
							</span>
						</div>
						
						<!-- Hover Glow -->
						<div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none">
							<div class="absolute inset-0 bg-gradient-to-t from-neon-cyan/10 to-transparent"></div>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- Featured Products Section -->
	<section id="featured" class="py-20 bg-dark-500/50">
		<div class="container-custom">
			<div class="flex items-end justify-between mb-14">
				<div>
					<h2 class="text-4xl md:text-5xl font-display text-white">
						Nuevos Productos
					</h2>
					<p class="text-zinc-400 mt-2">
						Lo último de nuestra colección
					</p>
				</div>
				<a
					href="/productos"
					class="hidden md:flex items-center gap-2 text-neon-cyan hover:text-neon-cyan-light font-medium transition-colors"
				>
					Ver todos
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
					</svg>
				</a>
			</div>

			{products.length > 0 ? (
				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
					{products.map((product) => (
						<a
							href={`/productos/${product.slug}`}
							class="product-card group"
						>
							<div class="relative aspect-[4/5] bg-dark-400 overflow-hidden">
								<img
									src={getProductMainImage(product)}
									alt={product.name}
									class="product-image w-full h-full object-cover"
									loading="lazy"
								/>
								{product.is_offer && (
									<div class="absolute top-3 left-3">
										<span class="badge-offer">Oferta</span>
									</div>
								)}
								{product.stock <= 5 && product.stock > 0 && (
									<div class="absolute top-3 right-3">
										<span class="badge-new">¡Últimas!</span>
									</div>
								)}
								<!-- Quick View Overlay -->
								<div class="absolute inset-0 bg-dark-600/80 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
									<span class="px-6 py-3 bg-neon-cyan text-dark-600 font-semibold rounded-lg transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
										Ver Producto
									</span>
								</div>
							</div>
							<div class="p-5">
								{product.category && (
									<span class="text-xs text-zinc-500 uppercase tracking-wider">
										{product.category.name}
									</span>
								)}
								<h3 class="font-medium text-white mt-1 group-hover:text-neon-cyan transition-colors">
									{product.name}
								</h3>
								<p class="font-display text-xl text-zinc-300 mt-2">
									{formatPrice(product.price)}
								</p>
							</div>
						</a>
					))}
				</div>
			) : (
				<div class="text-center py-16 glass-card">
					<p class="text-zinc-400">No hay productos disponibles</p>
				</div>
			)}

			<div class="mt-10 text-center md:hidden">
				<a href="/productos" class="btn-secondary">
					Ver todos los productos
				</a>
			</div>
		</div>
	</section>

	<!-- Brand Values Section -->
	<section class="py-20">
		<div class="container-custom">
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<div class="glass-card p-8 text-center group hover:border-neon-cyan/30 transition-colors">
					<div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-neon-cyan/10 flex items-center justify-center group-hover:shadow-glow-cyan transition-shadow">
						<svg class="w-8 h-8 text-neon-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
						</svg>
					</div>
					<h3 class="font-display text-xl text-white mb-3">Calidad Premium</h3>
					<p class="text-zinc-500">
						Materiales de última generación y acabados impecables en cada prenda.
					</p>
				</div>

				<div class="glass-card p-8 text-center group hover:border-neon-fuchsia/30 transition-colors">
					<div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-neon-fuchsia/10 flex items-center justify-center group-hover:shadow-glow-fuchsia transition-shadow">
						<svg class="w-8 h-8 text-neon-fuchsia" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
						</svg>
					</div>
					<h3 class="font-display text-xl text-white mb-3">Envío Express</h3>
					<p class="text-zinc-500">
						Entrega en 24-48h con seguimiento en tiempo real.
					</p>
				</div>

				<div class="glass-card p-8 text-center group hover:border-neon-purple/30 transition-colors">
					<div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-neon-purple/10 flex items-center justify-center group-hover:shadow-[0_0_20px_rgba(139,92,246,0.3)] transition-shadow">
						<svg class="w-8 h-8 text-neon-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
						</svg>
					</div>
					<h3 class="font-display text-xl text-white mb-3">Devolución Fácil</h3>
					<p class="text-zinc-500">
						30 días para cambios o devoluciones sin complicaciones.
					</p>
				</div>
			</div>
		</div>
	</section>
</PublicLayout>
