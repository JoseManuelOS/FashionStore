<script>
	document.addEventListener("astro:page-load", () => {
		initCopyButtons();
	});

	// Fallback for non-view-transitions
	document.addEventListener("DOMContentLoaded", () => {
		initCopyButtons();
	});

	function initCopyButtons() {
		const buttons = document.querySelectorAll(".copy-discount-btn");

		buttons.forEach((btn) => {
			btn.addEventListener("click", async () => {
				const code = btn.getAttribute("data-code");
				if (!code) return;

				try {
					await navigator.clipboard.writeText(code);

					// Visual feedback
					const label = btn.querySelector(".discount-label");
					if (label) {
						const originalText = label.textContent;
						label.textContent = "¡COPIADO!";
						label.classList.add("text-green-400");
						
						btn.classList.add(
							"bg-green-500/20",
							"border-green-500/50",
						);

						setTimeout(() => {
							label.textContent = originalText;
							label.classList.remove("text-green-400");
							btn.classList.remove(
								"bg-green-500/20",
								"border-green-500/50",
							);
						}, 2000);
					}
				} catch (err) {
					console.error("Failed to copy:", err);
				}
			});
		});
	}

	// Footer Newsletter Form Handler
	function initFooterNewsletter() {
		const form = document.getElementById("footer-newsletter-form") as HTMLFormElement;
		
		form?.addEventListener("submit", async (e) => {
			e.preventDefault();
			
			const emailInput = document.getElementById("footer-newsletter-email") as HTMLInputElement;
			const submitBtn = document.getElementById("footer-newsletter-btn") as HTMLButtonElement;
			const successDiv = document.getElementById("footer-newsletter-success");
			const promoCodeSpan = document.getElementById("footer-promo-code");
			
			const email = emailInput?.value;
			if (!email) return;
			
			// Show loading state
			submitBtn.disabled = true;
			const originalHTML = submitBtn.innerHTML;
			submitBtn.innerHTML = `
				<svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
					<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
					<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
				</svg>
			`;
			
			try {
				const response = await fetch("/api/newsletter/subscribe", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ email, source: "footer" })
				});
				
				const data = await response.json();
				
				const errorDiv = document.getElementById('footer-newsletter-error');
				const errorText = document.getElementById('footer-newsletter-error-text');
				const showError = (msg: string) => {
					if (errorDiv && errorText) {
						errorText.textContent = msg;
						errorDiv.classList.remove('hidden');
					}
					submitBtn.disabled = false;
					submitBtn.innerHTML = originalHTML;
				};

				if (data.success) {
					// Hide any previous error
					errorDiv?.classList.add('hidden');
					// Update promo code
					if (promoCodeSpan && data.promo_code) {
						promoCodeSpan.textContent = data.promo_code;
					}
					// Hide form, show success
					form.classList.add("hidden");
					successDiv?.classList.remove("hidden");
					// Mark as subscribed
					localStorage.setItem("newsletter_subscribed", "true");
				} else {
					showError(data.error || 'Error al suscribirse. Inténtalo de nuevo.');
				}
			} catch (error) {
				console.error("Error:", error);
				const errorDiv2 = document.getElementById('footer-newsletter-error');
				const errorText2 = document.getElementById('footer-newsletter-error-text');
				if (errorDiv2 && errorText2) {
					errorText2.textContent = 'Error de conexión. Inténtalo de nuevo.';
					errorDiv2.classList.remove('hidden');
				}
				submitBtn.disabled = false;
				submitBtn.innerHTML = originalHTML;
			}
		});
	}

	// Initialize on page load
	document.addEventListener("DOMContentLoaded", initFooterNewsletter);
	document.addEventListener("astro:page-load", initFooterNewsletter);
</script>

