---
import PublicLayout from "../../layouts/PublicLayout.astro";
import {
    getProducts,
    getCategories,
    formatPrice,
    getProductMainImage,
} from "../../lib/supabase";
import { expandProductsByColor } from "../../lib/utils";

export const prerender = true;

export async function getStaticPaths() {
    const categories = await getCategories();
    return categories.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const categories_all = await getCategories();
const category = categories_all.find((cat) => cat.slug === slug);

if (!category) {
    return Astro.redirect("/");
}
let products: any[] = [];
let categories: any[] = [];

try {
    products = expandProductsByColor(await getProducts({ categorySlug: category.slug }));
    categories = await getCategories();
} catch (e) {
    console.error("Error fetching products:", e);
}
---

<PublicLayout
    title={category.name}
    description={`Explora nuestra colección de ${category.name.toLowerCase()} premium`}
>
    <section class="py-16 min-h-screen">
        <div class="container-custom">
            <!-- Header -->
            <div class="mb-12">
                <nav class="text-sm text-zinc-500 mb-4">
                    <a href="/" class="hover:text-neon-cyan transition-colors"
                        >Inicio</a
                    >
                    <span class="mx-2 text-zinc-600">/</span>
                    <a
                        href="/productos"
                        class="hover:text-neon-cyan transition-colors"
                        >Productos</a
                    >
                    <span class="mx-2 text-zinc-600">/</span>
                    <span class="text-zinc-300">{category.name}</span>
                </nav>
                <h1 class="text-4xl md:text-5xl font-display text-white mb-4">
                    {category.name}
                </h1>
                <p class="text-zinc-400">
                    Nuestra colección de {category.name.toLowerCase()} premium para
                    el hombre moderno
                </p>
            </div>

            <div class="flex flex-col lg:flex-row gap-8">
                <!-- Filters Sidebar -->
                <aside class="lg:w-64 flex-shrink-0">
                    <div class="glass-card p-6 sticky top-24">
                        <h3 class="font-display text-white text-lg mb-4">
                            Categorías
                        </h3>
                        <ul class="space-y-2">
                            <li>
                                <a
                                    href="/productos"
                                    class="flex items-center gap-3 py-2.5 px-4 rounded-lg text-zinc-400 hover:text-white hover:bg-white/5 transition-colors"
                                >
                                    <span
                                        class="w-1.5 h-1.5 rounded-full bg-zinc-600"
                                    ></span>
                                    Todos
                                </a>
                            </li>
                            {
                                categories.map((cat) => (
                                    <li>
                                        <a
                                            href={`/categoria/${cat.slug}`}
                                            class={`flex items-center gap-3 py-2.5 px-4 rounded-lg transition-colors ${
                                                cat.slug === category.slug
                                                    ? "bg-neon-cyan/10 text-neon-cyan border border-neon-cyan/30"
                                                    : "text-zinc-400 hover:text-white hover:bg-white/5"
                                            }`}
                                        >
                                            <span
                                                class={`w-1.5 h-1.5 rounded-full ${cat.slug === category.slug ? "bg-neon-cyan" : "bg-zinc-600"}`}
                                            />
                                            {cat.name}
                                        </a>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                </aside>

                <!-- Products Grid -->
                <div class="flex-1">
                    <div class="flex items-center justify-between mb-8">
                        <p class="text-zinc-500">
                            {products.length} producto{
                                products.length !== 1 ? "s" : ""
                            } en {category.name}
                        </p>
                    </div>

                    {
                        products.length > 0 ? (
                            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
                                {products.map((product) => (
                                    <a
                                        href={product._colorSlug
                                            ? `/productos/${product.slug}?color=${encodeURIComponent(product._colorSlug)}`
                                            : `/productos/${product.slug}`}
                                        class="product-card group"
                                    >
                                        <div class="relative aspect-[4/5] bg-dark-400 overflow-hidden">
                                            <img
                                                src={product._displayImage || getProductMainImage(product)}
                                                alt={product.name}
                                                class="product-image w-full h-full object-cover"
                                                loading="lazy"
                                            />
                                            {product.is_offer && (
                                                <div class="absolute top-3 left-3">
                                                    <span class="badge-offer">
                                                        Oferta
                                                    </span>
                                                </div>
                                            )}
                                            {product.stock === 0 && (
                                                <div class="absolute inset-0 bg-dark-600/80 flex items-center justify-center">
                                                    <span class="px-4 py-2 bg-zinc-800 text-zinc-300 font-medium rounded-lg">
                                                        Agotado
                                                    </span>
                                                </div>
                                            )}
                                            <div class="absolute inset-0 bg-dark-600/80 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                                                <span class="px-6 py-3 bg-neon-cyan text-dark-600 font-semibold rounded-lg transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
                                                    Ver Producto
                                                </span>
                                            </div>
                                        </div>
                                        <div class="p-5">
                                            {product._displayColor && product._displayColorHex && (
                                                <div class="flex items-center gap-2 mb-2">
                                                    <span class="w-3.5 h-3.5 rounded-full border-2 border-cyan-400" style={`background:${product._displayColorHex}`}></span>
                                                    <span class="text-xs text-zinc-400 capitalize">{product._displayColor}</span>
                                                </div>
                                            )}
                                            <h3 class="font-medium text-white group-hover:text-neon-cyan transition-colors">
                                                {product.name}
                                            </h3>
                                            <div class="flex items-center justify-between mt-3">
                                                <p class="font-display text-xl text-zinc-300">
                                                    {formatPrice(product.price)}
                                                </p>
                                                {product.stock <= 5 &&
                                                    product.stock > 0 && (
                                                        <span class="text-xs text-neon-fuchsia">
                                                            Últimas unidades
                                                        </span>
                                                    )}
                                            </div>
                                        </div>
                                    </a>
                                ))}
                            </div>
                        ) : (
                            <div class="text-center py-20 glass-card">
                                <svg
                                    class="w-16 h-16 mx-auto text-zinc-600 mb-4"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="1"
                                        d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
                                    />
                                </svg>
                                <h3 class="text-xl font-display text-white mb-2">
                                    No hay productos en esta categoría
                                </h3>
                                <p class="text-zinc-500 mb-6">
                                    Estamos añadiendo nuevos productos pronto
                                </p>
                                <a href="/productos" class="btn-primary">
                                    <span>Ver todos los productos</span>
                                </a>
                            </div>
                        )
                    }
                </div>
            </div>
        </div>
    </section>
</PublicLayout>
