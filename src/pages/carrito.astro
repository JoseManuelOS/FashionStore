---
import PublicLayout from "../layouts/PublicLayout.astro";

// SSR - Render on each request for dynamic cart state
export const prerender = false;
---

<PublicLayout
    title="Tu Carrito"
    description="Revisa y finaliza tu compra en FashionMarket"
>
    <section class="py-12 md:py-16 min-h-[60vh]">
        <div class="container-custom">
            <h1 class="text-3xl md:text-4xl font-display font-bold text-white mb-8">Tu Carrito</h1>

            <div
                id="cart-container"
                class="grid grid-cols-1 lg:grid-cols-3 gap-8"
            >
                <!-- Cart Items (populated by JS) -->
                <div id="cart-items" class="lg:col-span-2 space-y-4">
                    <!-- Loading state -->
                    <div class="bg-dark-400/50 backdrop-blur-xl border border-white/10 rounded-2xl p-8 text-center">
                        <svg
                            class="animate-spin w-8 h-8 mx-auto text-neon-cyan mb-4"
                            fill="none"
                            viewBox="0 0 24 24"
                        >
                            <circle
                                class="opacity-25"
                                cx="12"
                                cy="12"
                                r="10"
                                stroke="currentColor"
                                stroke-width="4"></circle>
                            <path
                                class="opacity-75"
                                fill="currentColor"
                                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
                            ></path>
                        </svg>
                        <p class="text-zinc-400">
                            Cargando carrito...
                        </p>
                    </div>
                </div>

                <!-- Order Summary -->
                <div id="order-summary" class="lg:col-span-1 hidden">
                    <div
                        class="bg-dark-400/50 backdrop-blur-xl border border-white/10 rounded-2xl p-6 sticky top-24"
                    >
                        <h2 class="font-display text-xl text-white mb-6">
                            Resumen del Pedido
                        </h2>

                        <div class="space-y-3 mb-6">
                            <div
                                class="flex justify-between text-zinc-400"
                            >
                                <span>Subtotal</span>
                                <span id="subtotal">€0,00</span>
                            </div>
                            <div
                                class="flex justify-between text-zinc-400"
                            >
                                <span>Envío</span>
                                <span id="shipping">Gratis</span>
                            </div>
                        </div>

                        <div
                            class="border-t border-white/10 pt-4 mb-6"
                        >
                            <div class="flex justify-between items-center">
                                <span
                                    class="font-medium text-white"
                                    >Total</span
                                >
                                <span
                                    id="total"
                                    class="font-display text-2xl text-neon-cyan"
                                    >€0,00</span
                                >
                            </div>
                        </div>

                        <button
                            id="checkout-btn"
                            class="w-full py-4 px-6 bg-gradient-to-r from-neon-cyan to-neon-cyan-light text-dark-500 font-semibold rounded-xl hover:shadow-lg hover:shadow-neon-cyan/25 transition-all duration-200"
                        >
                            Proceder al Pago
                        </button>

                        <p
                            class="text-xs text-zinc-500 text-center mt-4"
                        >
                            Pago seguro con Stripe
                        </p>

                        <a
                            href="/productos"
                            class="block text-center text-sm text-zinc-400 hover:text-neon-cyan mt-4 transition-colors"
                        >
                            Continuar comprando
                        </a>
                    </div>
                </div>
            </div>

            <!-- Empty Cart State -->
            <div
                id="empty-cart"
                class="hidden text-center py-16 bg-dark-400/50 backdrop-blur-xl border border-white/10 rounded-2xl lg:col-span-3"
            >
                <svg
                    class="w-20 h-20 mx-auto text-zinc-600 mb-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="1"
                        d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                </svg>
                <h2 class="text-2xl font-display font-bold text-white mb-4">
                    Tu carrito está vacío
                </h2>
                <p class="text-zinc-400 mb-8">
                    ¿No sabes por dónde empezar? Explora nuestra colección.
                </p>
                <a href="/productos" class="inline-flex items-center gap-2 px-8 py-3 bg-gradient-to-r from-neon-cyan to-neon-cyan-light text-dark-500 font-semibold rounded-xl hover:shadow-lg hover:shadow-neon-cyan/25 transition-all duration-200"> Ver Productos </a>
            </div>
        </div>
    </section>

    <script>
        // Format price in euros
        function formatPrice(price: number): string {
            return new Intl.NumberFormat("es-ES", {
                style: "currency",
                currency: "EUR",
            }).format(price);
        }

        // Get cart from localStorage
        function getCart(): any[] {
            try {
                const saved = localStorage.getItem("fashionmarket-cart");
                return saved ? JSON.parse(saved) : [];
            } catch {
                return [];
            }
        }

        // Save cart to localStorage
        function saveCart(cart: any[]): void {
            localStorage.setItem("fashionmarket-cart", JSON.stringify(cart));
            // Dispatch custom event to update cart icon
            window.dispatchEvent(new CustomEvent('cart-updated'));
        }

        // Render cart
        function renderCart(): void {
            try {
                const cart = getCart();
                const itemsContainer = document.getElementById("cart-items");
                const summaryContainer = document.getElementById("order-summary");
                const emptyContainer = document.getElementById("empty-cart");
                const subtotalEl = document.getElementById("subtotal");
                const totalEl = document.getElementById("total");

                if (!itemsContainer || !summaryContainer || !emptyContainer || !subtotalEl || !totalEl) {
                    console.error('Required elements not found');
                    return;
                }

                if (cart.length === 0) {
                    itemsContainer.innerHTML = "";
                    summaryContainer.classList.add("hidden");
                    emptyContainer.classList.remove("hidden");
                    return;
                }

                emptyContainer.classList.add("hidden");
                summaryContainer.classList.remove("hidden");

                // Calculate totals
                const subtotal = cart.reduce(
                    (sum, item) => sum + item.price * item.quantity,
                    0,
                );
                subtotalEl.textContent = formatPrice(subtotal);
                totalEl.textContent = formatPrice(subtotal);

                // Render items
                itemsContainer.innerHTML = cart
                    .map(
                        (item, index) => `
        <div class="bg-dark-400/50 backdrop-blur-xl border border-white/10 rounded-2xl p-4 md:p-6 flex gap-4" data-index="${index}">
          <div class="w-24 h-28 md:w-32 md:h-40 bg-dark-500 rounded-lg overflow-hidden flex-shrink-0">
            <img src="${item.image}" alt="${item.name}" class="w-full h-full object-cover" />
          </div>
          
          <div class="flex-1 flex flex-col">
            <div class="flex justify-between">
              <div>
                <a href="/productos/${item.slug}" class="font-medium text-white hover:text-neon-cyan transition-colors">
                  ${item.name}
                </a>
                <p class="text-sm text-zinc-400 mt-1">Talla: ${item.size}${item.color ? ` · Color: ${item.color}` : ''}</p>
              </div>
              <button 
                class="remove-btn p-2 text-zinc-400 hover:text-red-400 transition-colors"
                data-id="${item.id}"
                data-size="${item.size}"
                data-color="${item.color || ''}"
                aria-label="Eliminar producto"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>
            
            <div class="mt-auto flex items-center justify-between pt-4">
              <div class="flex items-center gap-2">
                <button 
                  class="qty-btn w-8 h-8 flex items-center justify-center border border-white/10 rounded hover:border-neon-cyan/50 hover:text-white text-zinc-400 transition-colors"
                  data-action="decrease"
                  data-id="${item.id}"
                  data-size="${item.size}"
                  data-color="${item.color || ''}"
                  ${item.quantity <= 1 ? 'disabled opacity-50' : ''}
                >
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" />
                  </svg>
                </button>
                <span class="w-10 text-center font-medium text-white">${item.quantity}</span>
                <button 
                  class="qty-btn w-8 h-8 flex items-center justify-center border border-white/10 rounded hover:border-neon-cyan/50 hover:text-white text-zinc-400 transition-colors"
                  data-action="increase"
                  data-id="${item.id}"
                  data-size="${item.size}"
                  data-color="${item.color || ''}"
                >
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                  </svg>
                </button>
              </div>
              
              <p class="font-display text-lg text-neon-cyan">
                ${formatPrice(item.price * item.quantity)}
              </p>
            </div>
          </div>
        </div>
      `,
                    )
                    .join("");

                // Add event listeners
                document.querySelectorAll(".remove-btn").forEach((btn) => {
                    btn.addEventListener("click", (e) => {
                        const target = e.currentTarget as HTMLElement;
                        const id = target.dataset.id!;
                        const size = target.dataset.size!;
                        const color = target.dataset.color || '';
                        const cart = getCart().filter(
                            (item) => !(item.id === id && item.size === size && (item.color || '') === color),
                        );
                        saveCart(cart);
                        renderCart();
                    });
                });

                document.querySelectorAll(".qty-btn").forEach((btn) => {
                    btn.addEventListener("click", async (e) => {
                        const target = e.currentTarget as HTMLElement;
                        const action = target.dataset.action!;
                        const id = target.dataset.id!;
                        const size = target.dataset.size!;
                        const color = target.dataset.color || '';

                        const cart = getCart();
                        const item = cart.find(
                            (i) => i.id === id && i.size === size && (i.color || '') === color
                        );

                        if (action === "increase" && item) {
                            // Verificar stock disponible antes de incrementar
                            try {
                                const colorParam = color ? `&color=${encodeURIComponent(color)}` : '';
                                const res = await fetch(`/api/products/stock?productId=${id}${colorParam}`);
                                if (res.ok) {
                                    const data = await res.json();
                                    let available = 0;
                                    if (color && data.stockBySizeColor) {
                                        available = data.stockBySizeColor[`${size}|${color}`] ?? data.stockBySize?.[size] ?? 0;
                                    } else if (data.stockBySize) {
                                        available = data.stockBySize[size] ?? 0;
                                    }
                                    if (item.quantity >= available) {
                                        // Mostrar aviso inline
                                        const parent = target.closest('[data-index]');
                                        if (parent && !parent.querySelector('.stock-warning')) {
                                            const warning = document.createElement('p');
                                            warning.className = 'stock-warning text-xs text-amber-400 mt-2';
                                            warning.textContent = `Solo quedan ${available} unidades disponibles`;
                                            parent.querySelector('.flex-1')?.appendChild(warning);
                                            setTimeout(() => warning.remove(), 3000);
                                        }
                                        return;
                                    }
                                }
                            } catch {
                                // Si falla la verificación, dejamos pasar
                            }
                        }

                        const updatedCart = cart
                            .map((ci) => {
                                if (ci.id === id && ci.size === size && (ci.color || '') === color) {
                                    const newQty =
                                        action === "increase"
                                            ? ci.quantity + 1
                                            : ci.quantity - 1;
                                    if (newQty <= 0) return null;
                                    return { ...ci, quantity: newQty };
                                }
                                return ci;
                            })
                            .filter(Boolean);

                        saveCart(updatedCart);
                        renderCart();
                    });
                });
            } catch (error) {
                console.error('Error rendering cart:', error);
            }
        }

        // Handle checkout button
        const checkoutBtn = document.getElementById('checkout-btn');
        if (checkoutBtn) {
            checkoutBtn.addEventListener('click', () => {
                const cart = getCart();
                if (cart.length === 0) {
                    alert('Tu carrito está vacío');
                    return;
                }
                window.location.href = '/checkout';
            });
        }

        // Initialize on both DOMContentLoaded and immediate execution
        if (document.readyState === 'loading') {
            document.addEventListener("DOMContentLoaded", renderCart);
        } else {
            // DOM already loaded, execute immediately
            renderCart();
        }
    </script>
