---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { supabaseAdmin, formatPrice } from "../../lib/supabase";

export const prerender = false;

let stats = {
    totalProducts: 0,
    totalStock: 0,
    lowStockProducts: 0,
    offerProducts: 0,
    pendingOrders: 0,
};

let recentProducts: any[] = [];

try {
    const { data: products } = await supabaseAdmin
        .from("products")
        .select("*, images:product_images(image_url, order)")
        .eq("active", true)
        .order("created_at", { ascending: false });

    if (products) {
        stats.totalProducts = products.length;
        stats.totalStock = products.reduce((sum, p) => sum + p.stock, 0);
        stats.lowStockProducts = products.filter(p => p.stock <= 5 && p.stock > 0).length;
        stats.offerProducts = products.filter(p => p.is_offer).length;
        recentProducts = products.slice(0, 5);
    }

    const { data: orders } = await supabaseAdmin
        .from("orders")
        .select("status")
        .eq("status", "pending");

    if (orders) {
        stats.pendingOrders = orders.length;
    }
} catch (e) {
    console.error("Error fetching stats:", e);
}
---

<AdminLayout title="Dashboard">
    <style>
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 32px;
        }
        
        .stat-card {
            background: #fff;
            border: 1px solid #e4e4e7;
            border-radius: 12px;
            padding: 24px;
        }
        
        .stat-label {
            font-size: 13px;
            color: #71717a;
            margin-bottom: 8px;
        }
        
        .stat-value {
            font-size: 32px;
            font-weight: 600;
            color: #18181b;
        }
        
        .stat-value.warning {
            color: #f59e0b;
        }
        
        .stat-value.success {
            color: #10b981;
        }
        
        .content-grid {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 24px;
        }
        
        @media (max-width: 1024px) {
            .content-grid {
                grid-template-columns: 1fr;
            }
        }
        
        .card {
            background: #fff;
            border: 1px solid #e4e4e7;
            border-radius: 12px;
            padding: 24px;
        }
        
        .card-title {
            font-size: 14px;
            font-weight: 600;
            color: #18181b;
            margin-bottom: 20px;
        }
        
        .action-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        
        .action-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 14px;
            color: #52525b;
            transition: all 0.15s;
        }
        
        .action-link:hover {
            background: #f4f4f5;
            color: #18181b;
        }
        
        .action-link.primary {
            background: #18181b;
            color: #fff;
        }
        
        .action-link.primary:hover {
            background: #27272a;
        }
        
        .action-link svg {
            width: 18px;
            height: 18px;
            opacity: 0.7;
        }
        
        .product-list {
            display: flex;
            flex-direction: column;
        }
        
        .product-item {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 16px 0;
            border-bottom: 1px solid #f4f4f5;
            text-decoration: none;
            color: inherit;
            transition: opacity 0.15s;
        }
        
        .product-item:last-child {
            border-bottom: none;
        }
        
        .product-item:hover {
            opacity: 0.7;
        }
        
        .product-image {
            width: 48px;
            height: 56px;
            border-radius: 8px;
            background: #f4f4f5;
            overflow: hidden;
            flex-shrink: 0;
        }
        
        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .product-info {
            flex: 1;
            min-width: 0;
        }
        
        .product-name {
            font-size: 14px;
            font-weight: 500;
            color: #18181b;
            margin-bottom: 4px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        
        .product-stock {
            font-size: 12px;
            color: #71717a;
        }
        
        .product-price {
            font-size: 14px;
            font-weight: 600;
            color: #18181b;
        }
        
        .badge {
            display: inline-flex;
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 500;
            margin-left: 8px;
        }
        
        .badge.offer {
            background: #fef2f2;
            color: #dc2626;
        }
        
        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: #71717a;
            font-size: 14px;
        }
        
        .view-all {
            font-size: 13px;
            color: #71717a;
            text-decoration: none;
        }
        
        .view-all:hover {
            color: #18181b;
        }
        
        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
    </style>

    <!-- Stats -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-label">Productos Activos</div>
            <div class="stat-value">{stats.totalProducts}</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Unidades en Stock</div>
            <div class="stat-value success">{stats.totalStock}</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Stock Bajo (≤5)</div>
            <div class="stat-value warning">{stats.lowStockProducts}</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Pedidos Pendientes</div>
            <div class="stat-value">{stats.pendingOrders}</div>
        </div>
    </div>

    <!-- Content -->
    <div class="content-grid">
        <!-- Quick Actions -->
        <div class="card">
            <div class="card-title">Acciones Rápidas</div>
            <div class="action-list">
                <a href="/admin/productos/nuevo" class="action-link primary">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4" />
                    </svg>
                    Nuevo Producto
                </a>
                <a href="/admin/productos" class="action-link">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
                    </svg>
                    Ver Inventario
                </a>
                <a href="/" target="_blank" class="action-link">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                    Ver Tienda
                </a>
            </div>
        </div>

        <!-- Recent Products -->
        <div class="card">
            <div class="card-header">
                <div class="card-title" style="margin-bottom: 0;">Productos Recientes</div>
                <a href="/admin/productos" class="view-all">Ver todos →</a>
            </div>

            {recentProducts.length > 0 ? (
                <div class="product-list">
                    {recentProducts.map((product) => {
                        const mainImage = product.images?.sort((a: any, b: any) => a.order - b.order)[0]?.image_url;
                        return (
                            <a href={`/admin/productos/${product.id}`} class="product-item">
                                <div class="product-image">
                                    {mainImage ? (
                                        <img src={mainImage} alt={product.name} />
                                    ) : (
                                        <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #a1a1aa; font-size: 10px;">
                                            IMG
                                        </div>
                                    )}
                                </div>
                                <div class="product-info">
                                    <div class="product-name">
                                        {product.name}
                                        {product.is_offer && <span class="badge offer">Oferta</span>}
                                    </div>
                                    <div class="product-stock">Stock: {product.stock} unidades</div>
                                </div>
                                <div class="product-price">{formatPrice(product.price)}</div>
                            </a>
                        );
                    })}
                </div>
            ) : (
                <div class="empty-state">No hay productos registrados</div>
            )}
        </div>
    </div>
</AdminLayout>
