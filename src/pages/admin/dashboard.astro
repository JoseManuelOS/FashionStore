---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { supabaseAdmin, formatPrice, getSettings } from "../../lib/supabase";

// SSR - Protected by AdminLayout
export const prerender = false;

// Fetch stats and settings
let stats = {
    totalProducts: 0,
    totalStock: 0,
    lowStockProducts: 0,
    offerProducts: 0,
    totalOrders: 0,
    pendingOrders: 0,
};

let recentProducts: any[] = [];
let settings: any[] = [];
let offersEnabled = true;

try {
    // Products stats
    const { data: products } = await supabaseAdmin
        .from("products")
        .select("*")
        .eq("active", true);

    if (products) {
        stats.totalProducts = products.length;
        stats.totalStock = products.reduce((sum, p) => sum + p.stock, 0);
        stats.lowStockProducts = products.filter(
            (p) => p.stock <= 5 && p.stock > 0,
        ).length;
        stats.offerProducts = products.filter((p) => p.is_offer).length;
        recentProducts = products.slice(0, 5);
    }

    // Orders stats
    const { data: orders } = await supabaseAdmin
        .from("orders")
        .select("status");

    if (orders) {
        stats.totalOrders = orders.length;
        stats.pendingOrders = orders.filter(
            (o) => o.status === "pending",
        ).length;
    }

    // Settings
    settings = await getSettings();
    const offersSetting = settings.find((s) => s.key === "offers_enabled");
    offersEnabled =
        offersSetting?.value === true || offersSetting?.value === "true";
} catch (e) {
    console.error("Error fetching stats:", e);
}

// Handle settings toggle
if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const key = formData.get("key") as string;
    const value = formData.get("value") as string;

    if (key) {
        await supabaseAdmin
            .from("settings")
            .update({ value: value === "true" ? true : false })
            .eq("key", key);

        return Astro.redirect("/admin?updated=true");
    }
}
---

<AdminLayout title="Dashboard">
    <!-- Settings Toggle for Offers -->
    <div
        class="bg-gradient-to-r from-red-500 to-orange-500 rounded-xl p-6 mb-8 text-white"
    >
        <div class="flex items-center justify-between">
            <div>
                <h3 class="font-serif text-xl mb-1">
                    🔥 Sección Ofertas Flash
                </h3>
                <p class="text-white/80 text-sm">
                    {
                        offersEnabled
                            ? "Visible en la tienda pública"
                            : "Oculta de la tienda pública"
                    }
                </p>
            </div>
            <form method="POST" class="flex items-center gap-4">
                <input type="hidden" name="key" value="offers_enabled" />
                <input
                    type="hidden"
                    name="value"
                    value={offersEnabled ? "false" : "true"}
                />
                <button
                    type="submit"
                    class={`relative w-14 h-8 rounded-full transition-colors ${offersEnabled ? "bg-white" : "bg-white/30"}`}
                >
                    <span
                        class={`absolute top-1 w-6 h-6 rounded-full transition-all ${offersEnabled ? "left-7 bg-red-500" : "left-1 bg-white"}`}
                    ></span>
                </button>
                <span class="font-medium">{offersEnabled ? "ON" : "OFF"}</span>
            </form>
        </div>
        <p class="text-white/60 text-xs mt-3">
            Hay {stats.offerProducts} producto(s) marcados como oferta
        </p>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <div class="bg-white rounded-xl p-6 shadow-elegant">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-brand-charcoal-500">
                        Productos Activos
                    </p>
                    <p class="text-3xl font-serif text-brand-navy-500 mt-2">
                        {stats.totalProducts}
                    </p>
                </div>
                <div
                    class="w-12 h-12 rounded-full bg-brand-navy-100 flex items-center justify-center"
                >
                    <svg
                        class="w-6 h-6 text-brand-navy-500"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.5"
                            d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
                        ></path>
                    </svg>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl p-6 shadow-elegant">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-brand-charcoal-500">
                        Unidades en Stock
                    </p>
                    <p class="text-3xl font-serif text-brand-navy-500 mt-2">
                        {stats.totalStock}
                    </p>
                </div>
                <div
                    class="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center"
                >
                    <svg
                        class="w-6 h-6 text-green-600"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.5"
                            d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"
                        ></path>
                    </svg>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl p-6 shadow-elegant">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-brand-charcoal-500">Stock Bajo</p>
                    <p class="text-3xl font-serif text-amber-600 mt-2">
                        {stats.lowStockProducts}
                    </p>
                </div>
                <div
                    class="w-12 h-12 rounded-full bg-amber-100 flex items-center justify-center"
                >
                    <svg
                        class="w-6 h-6 text-amber-600"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.5"
                            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                        ></path>
                    </svg>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl p-6 shadow-elegant">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-brand-charcoal-500">
                        Pedidos Pendientes
                    </p>
                    <p class="text-3xl font-serif text-brand-navy-500 mt-2">
                        {stats.pendingOrders}
                    </p>
                </div>
                <div
                    class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center"
                >
                    <svg
                        class="w-6 h-6 text-blue-600"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.5"
                            d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"
                        ></path>
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions & Recent Products -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Quick Actions -->
        <div class="bg-white rounded-xl p-6 shadow-elegant">
            <h2 class="font-serif text-lg text-brand-navy-500 mb-4">
                Acciones Rápidas
            </h2>
            <div class="space-y-3">
                <a
                    href="/admin/productos/nuevo"
                    class="flex items-center gap-3 p-3 rounded-lg bg-brand-navy-50 text-brand-navy-600 hover:bg-brand-navy-100 transition-colors"
                >
                    <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.5"
                            d="M12 4v16m8-8H4"></path>
                    </svg>
                    <span>Añadir Producto</span>
                </a>
                <a
                    href="/admin/productos"
                    class="flex items-center gap-3 p-3 rounded-lg bg-cream-100 text-brand-charcoal-600 hover:bg-cream-200 transition-colors"
                >
                    <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.5"
                            d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
                    </svg>
                    <span>Ver Inventario</span>
                </a>
                <a
                    href="/admin/pedidos"
                    class="flex items-center gap-3 p-3 rounded-lg bg-cream-100 text-brand-charcoal-600 hover:bg-cream-200 transition-colors"
                >
                    <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.5"
                            d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
                        ></path>
                    </svg>
                    <span>Ver Pedidos</span>
                </a>
            </div>
        </div>

        <!-- Recent Products -->
        <div class="lg:col-span-2 bg-white rounded-xl p-6 shadow-elegant">
            <div class="flex items-center justify-between mb-4">
                <h2 class="font-serif text-lg text-brand-navy-500">
                    Productos Recientes
                </h2>
                <a
                    href="/admin/productos"
                    class="text-sm text-brand-navy-500 hover:underline"
                    >Ver todos</a
                >
            </div>

            {
                recentProducts.length > 0 ? (
                    <div class="space-y-3">
                        {recentProducts.map((product) => (
                            <a
                                href={`/admin/productos/${product.id}`}
                                class="flex items-center gap-4 p-3 rounded-lg hover:bg-cream-100 transition-colors"
                            >
                                <div class="w-12 h-14 bg-cream-200 rounded overflow-hidden flex-shrink-0">
                                    <div class="w-full h-full bg-brand-navy-100 flex items-center justify-center text-brand-navy-400 text-xs">
                                        IMG
                                    </div>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2">
                                        <p class="font-medium text-brand-charcoal-700 truncate">
                                            {product.name}
                                        </p>
                                        {product.is_offer && (
                                            <span class="px-2 py-0.5 bg-red-100 text-red-600 text-xs rounded">
                                                Oferta
                                            </span>
                                        )}
                                    </div>
                                    <p class="text-sm text-brand-charcoal-400">
                                        Stock: {product.stock}
                                    </p>
                                </div>
                                <p class="font-serif text-brand-navy-500">
                                    {formatPrice(product.price)}
                                </p>
                            </a>
                        ))}
                    </div>
                ) : (
                    <p class="text-brand-charcoal-400 text-center py-8">
                        No hay productos registrados
                    </p>
                )
            }
        </div>
    </div>
</AdminLayout>
