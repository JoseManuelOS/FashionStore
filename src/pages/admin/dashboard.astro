---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { supabaseAdmin, formatPrice } from "../../lib/supabase";

export const prerender = false;

let stats = {
    totalProducts: 0,
    totalStock: 0,
    lowStockProducts: 0,
    offerProducts: 0,
    pendingOrders: 0,
};

let recentProducts: any[] = [];
let lowStockItems: Array<{
    id: string;
    name: string;
    slug: string;
    image?: string;
    variants: Array<{ size: string; stock: number }>;
    totalStock: number;
}> = [];

try {
    const { data: products } = await supabaseAdmin
        .from("products")
        .select("*, images:product_images(image_url, order), variants:product_variants(size, stock)")
        .eq("active", true)
        .order("created_at", { ascending: false });

    if (products) {
        stats.totalProducts = products.length;
        // Calculate total stock from variants
        stats.totalStock = products.reduce((sum, p) => {
            const variantStock = (p.variants || []).reduce((vs: number, v: any) => vs + (v.stock || 0), 0);
            return sum + variantStock;
        }, 0);
        // A product has low stock if any variant has stock <= 5 (including 0)
        stats.lowStockProducts = products.filter(p => 
            (p.variants || []).some((v: any) => v.stock <= 5)
        ).length;
        stats.offerProducts = products.filter(p => p.is_offer).length;
        recentProducts = products.slice(0, 5);

        // Build low-stock items list: products with any variant stock <= 5
        for (const p of products) {
            const problematicVariants = (p.variants || [])
                .filter((v: any) => v.stock <= 5)
                .sort((a: any, b: any) => a.stock - b.stock);
            if (problematicVariants.length > 0) {
                const mainImage = (p.images || []).sort((a: any, b: any) => a.order - b.order)[0]?.image_url;
                const totalStock = (p.variants || []).reduce((s: number, v: any) => s + (v.stock || 0), 0);
                lowStockItems.push({
                    id: p.id,
                    name: p.name,
                    slug: p.slug,
                    image: mainImage,
                    variants: problematicVariants,
                    totalStock
                });
            }
        }
        // Sort: products with out-of-stock variants first, then by total stock ascending
        lowStockItems.sort((a, b) => {
            const aHasZero = a.variants.some(v => v.stock === 0);
            const bHasZero = b.variants.some(v => v.stock === 0);
            if (aHasZero && !bHasZero) return -1;
            if (!aHasZero && bHasZero) return 1;
            return a.totalStock - b.totalStock;
        });
    }

    const { data: orders } = await supabaseAdmin
        .from("orders")
        .select("status")
        .eq("status", "paid");

    if (orders) {
        stats.pendingOrders = orders.length;
    }
} catch (e) {
    console.error("Error fetching stats:", e);
}
---

<AdminLayout title="Dashboard">
    <style>
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 32px;
        }
        
        .stat-card {
            background: #12121a;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 24px;
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
        }
        
        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, var(--card-accent, #06b6d4), transparent);
            opacity: 0.6;
        }
        
        .stat-card:hover {
            border-color: rgba(6, 182, 212, 0.3);
            box-shadow: 0 0 30px rgba(6, 182, 212, 0.1);
        }
        
        .stat-card.cyan { --card-accent: #06b6d4; }
        .stat-card.emerald { --card-accent: #10b981; }
        .stat-card.amber { --card-accent: #f59e0b; }
        .stat-card.fuchsia { --card-accent: #d946ef; }
        
        .stat-label {
            font-size: 13px;
            color: #a1a1aa;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .stat-value {
            font-size: 32px;
            font-weight: 700;
            color: #f4f4f5;
        }
        
        .stat-value.cyan { color: #06b6d4; }
        .stat-value.emerald { color: #10b981; }
        .stat-value.amber { color: #f59e0b; }
        .stat-value.fuchsia { color: #d946ef; }
        
        .content-grid {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 24px;
        }
        
        @media (max-width: 1024px) {
            .content-grid {
                grid-template-columns: 1fr;
            }
        }
        
        .card {
            background: #12121a;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 24px;
        }
        
        .card-title {
            font-size: 14px;
            font-weight: 600;
            color: #f4f4f5;
            margin-bottom: 20px;
        }
        
        .action-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        
        .action-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            border-radius: 10px;
            text-decoration: none;
            font-size: 14px;
            color: #a1a1aa;
            transition: all 0.2s ease;
            border: 1px solid transparent;
        }
        
        .action-link:hover {
            background: rgba(6, 182, 212, 0.1);
            color: #f4f4f5;
            border-color: rgba(6, 182, 212, 0.2);
        }
        
        .action-link.primary {
            background: linear-gradient(135deg, #06b6d4, #8b5cf6);
            color: #fff;
            font-weight: 500;
        }
        
        .action-link.primary:hover {
            box-shadow: 0 0 20px rgba(6, 182, 212, 0.4);
            transform: translateY(-1px);
        }
        
        .action-link svg {
            width: 18px;
            height: 18px;
        }
        
        .product-list {
            display: flex;
            flex-direction: column;
        }
        
        .product-item {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 16px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            text-decoration: none;
            color: inherit;
            transition: all 0.2s ease;
        }
        
        .product-item:last-child {
            border-bottom: none;
        }
        
        .product-item:hover {
            opacity: 0.8;
        }
        
        .product-image {
            width: 48px;
            height: 56px;
            border-radius: 8px;
            background: #1f1f28;
            overflow: hidden;
            flex-shrink: 0;
        }
        
        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .product-info {
            flex: 1;
            min-width: 0;
        }
        
        .product-name {
            font-size: 14px;
            font-weight: 500;
            color: #f4f4f5;
            margin-bottom: 4px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        
        .product-stock {
            font-size: 12px;
            color: #71717a;
        }
        
        .product-price {
            font-size: 14px;
            font-weight: 600;
            color: #06b6d4;
        }
        
        .badge {
            display: inline-flex;
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 500;
            margin-left: 8px;
        }
        
        .badge.offer {
            background: rgba(239, 68, 68, 0.2);
            color: #f87171;
        }
        
        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: #71717a;
            font-size: 14px;
        }
        
        .view-all {
            font-size: 13px;
            color: #06b6d4;
            text-decoration: none;
            transition: color 0.2s;
        }
        
        .view-all:hover {
            color: #22d3ee;
        }
        
        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        /* Low Stock Section */
        .low-stock-section {
            margin-bottom: 24px;
        }

        .low-stock-grid {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .low-stock-item {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 14px 16px;
            border-radius: 12px;
            text-decoration: none;
            color: inherit;
            transition: all 0.2s ease;
            border: 1px solid transparent;
        }

        .low-stock-item:hover {
            background: rgba(245, 158, 11, 0.08);
            border-color: rgba(245, 158, 11, 0.2);
        }

        .low-stock-thumb {
            width: 44px;
            height: 52px;
            border-radius: 8px;
            background: #1f1f28;
            overflow: hidden;
            flex-shrink: 0;
        }

        .low-stock-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .low-stock-info {
            flex: 1;
            min-width: 0;
        }

        .low-stock-name {
            font-size: 14px;
            font-weight: 500;
            color: #f4f4f5;
            margin-bottom: 6px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .low-stock-sizes {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }

        .size-tag {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 8px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 500;
            border: 1px solid;
        }

        .size-tag.out {
            background: rgba(239, 68, 68, 0.15);
            border-color: rgba(239, 68, 68, 0.3);
            color: #f87171;
        }

        .size-tag.low {
            background: rgba(245, 158, 11, 0.15);
            border-color: rgba(245, 158, 11, 0.3);
            color: #fbbf24;
        }

        .size-tag .stock-num {
            font-weight: 700;
            font-size: 11px;
        }

        .low-stock-total {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            color: #71717a;
            flex-shrink: 0;
        }

        .low-stock-total .total-count {
            font-weight: 600;
            color: #a1a1aa;
        }

        .edit-icon {
            color: #52525b;
            transition: color 0.2s;
            flex-shrink: 0;
        }

        .low-stock-item:hover .edit-icon {
            color: #f59e0b;
        }

        /* Collapsible */
        .collapse-toggle {
            display: flex;
            align-items: center;
            gap: 6px;
            background: none;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            padding: 6px 12px;
            color: #a1a1aa;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .collapse-toggle:hover {
            background: rgba(255, 255, 255, 0.05);
            color: #f4f4f5;
            border-color: rgba(255, 255, 255, 0.2);
        }
        .collapse-toggle svg {
            transition: transform 0.3s ease;
        }
        .collapse-toggle.collapsed svg {
            transform: rotate(-90deg);
        }
        .low-stock-grid.collapsed {
            display: none;
        }
    </style>

    <!-- Stats -->
    <div class="stats-grid">
        <div class="stat-card cyan">
            <div class="stat-label">Productos Activos</div>
            <div class="stat-value cyan">{stats.totalProducts}</div>
        </div>
        <div class="stat-card emerald">
            <div class="stat-label">Unidades en Stock</div>
            <div class="stat-value emerald">{stats.totalStock}</div>
        </div>
        <div class="stat-card amber">
            <div class="stat-label">Tallas Stock Bajo / Agotadas</div>
            <div class="stat-value amber">{stats.lowStockProducts}</div>
        </div>
        <a href="/admin/pedidos" class="stat-card fuchsia" style="text-decoration: none;">
            <div class="stat-label">Pedidos por Enviar</div>
            <div class="stat-value fuchsia">{stats.pendingOrders}</div>
        </a>
    </div>

    <!-- Low Stock Alert Section -->
    {lowStockItems.length > 0 && (
        <div class="low-stock-section">
            <div class="card">
                <div class="card-header">
                    <div class="card-title" style="margin-bottom: 0; display: flex; align-items: center; gap: 8px;">
                        <svg width="18" height="18" fill="none" stroke="#f59e0b" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4.5c-.77-.833-2.694-.833-3.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z" />
                        </svg>
                        <span>Productos con Stock Bajo o Agotado</span>
                    </div>
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <button id="toggle-low-stock" class="collapse-toggle" title="Contraer/Expandir">
                            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                            <span>Contraer</span>
                        </button>
                        <a href="/admin/productos" class="view-all">Ver inventario →</a>
                    </div>
                </div>
                <div id="low-stock-list" class="low-stock-grid">
                    {lowStockItems.map((item) => (
                        <a href={`/admin/productos/${item.id}`} class="low-stock-item">
                            <div class="low-stock-thumb">
                                {item.image ? (
                                    <img src={item.image} alt={item.name} loading="lazy" />
                                ) : (
                                    <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #52525b; font-size: 10px;">IMG</div>
                                )}
                            </div>
                            <div class="low-stock-info">
                                <div class="low-stock-name">{item.name}</div>
                                <div class="low-stock-sizes">
                                    {item.variants.map((v) => (
                                        <span class={`size-tag ${v.stock === 0 ? 'out' : 'low'}`}>
                                            {v.size} <span class="stock-num">{v.stock}</span>
                                        </span>
                                    ))}
                                </div>
                            </div>
                            <div class="low-stock-total">
                                <span class="total-count">{item.totalStock}</span> uds
                            </div>
                            <svg class="edit-icon" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                            </svg>
                        </a>
                    ))}
                </div>
            </div>
        </div>
    )}

    <!-- Content -->
    <div class="content-grid">
        <!-- Quick Actions -->
        <div class="card">
            <div class="card-title">Acciones Rápidas</div>
            <div class="action-list">
                <a href="/admin/productos/nuevo" class="action-link primary">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4" />
                    </svg>
                    Nuevo Producto
                </a>
                <a href="/admin/productos" class="action-link">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
                    </svg>
                    Ver Inventario
                </a>
                <a href="/" target="_blank" class="action-link">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                    Ver Tienda
                </a>
            </div>
        </div>

        <!-- Recent Products -->
        <div class="card">
            <div class="card-header">
                <div class="card-title" style="margin-bottom: 0;">Productos Recientes</div>
                <a href="/admin/productos" class="view-all">Ver todos →</a>
            </div>

            {recentProducts.length > 0 ? (
                <div class="product-list">
                    {recentProducts.map((product) => {
                        const mainImage = product.images?.sort((a: any, b: any) => a.order - b.order)[0]?.image_url;
                        return (
                            <a href={`/admin/productos/${product.id}`} class="product-item">
                                <div class="product-image">
                                    {mainImage ? (
                                        <img src={mainImage} alt={product.name} />
                                    ) : (
                                        <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #a1a1aa; font-size: 10px;">
                                            IMG
                                        </div>
                                    )}
                                </div>
                                <div class="product-info">
                                    <div class="product-name">
                                        {product.name}
                                        {product.is_offer && <span class="badge offer">Oferta</span>}
                                    </div>
                                    <div class="product-stock">Stock: {(product.variants || []).reduce((s: number, v: any) => s + (v.stock || 0), 0)} unidades</div>
                                </div>
                                <div class="product-price">{formatPrice(product.price)}</div>
                            </a>
                        );
                    })}
                </div>
            ) : (
                <div class="empty-state">No hay productos registrados</div>
            )}
        </div>
    </div>

    <script>
        const toggleBtn = document.getElementById('toggle-low-stock');
        const stockList = document.getElementById('low-stock-list');
        if (toggleBtn && stockList) {
            const saved = localStorage.getItem('dashboard-low-stock-collapsed');
            if (saved === 'true') {
                stockList.classList.add('collapsed');
                toggleBtn.classList.add('collapsed');
                toggleBtn.querySelector('span')!.textContent = 'Expandir';
            }
            toggleBtn.addEventListener('click', () => {
                const isCollapsed = stockList.classList.toggle('collapsed');
                toggleBtn.classList.toggle('collapsed', isCollapsed);
                toggleBtn.querySelector('span')!.textContent = isCollapsed ? 'Expandir' : 'Contraer';
                localStorage.setItem('dashboard-low-stock-collapsed', String(isCollapsed));
            });
        }
    </script>
</AdminLayout>
