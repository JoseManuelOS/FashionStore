---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { supabase } from "../../lib/supabase";

// SSR - Render on each request
export const prerender = false;

let error: string | null = null;

// Handle form submission
if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const email = formData.get("email") as string;
    const password = formData.get("password") as string;

    const { data, error: authError } = await supabase.auth.signInWithPassword({
        email,
        password,
    });

    if (authError) {
        error = "Credenciales incorrectas. Por favor, inténtalo de nuevo.";
    } else if (data.session) {
        // Set auth cookies
        Astro.cookies.set("sb-access-token", data.session.access_token, {
            path: "/",
            httpOnly: true,
            secure: import.meta.env.PROD,
            sameSite: "lax",
            maxAge: 60 * 60 * 24 * 7,
        });
        Astro.cookies.set("sb-refresh-token", data.session.refresh_token, {
            path: "/",
            httpOnly: true,
            secure: import.meta.env.PROD,
            sameSite: "lax",
            maxAge: 60 * 60 * 24 * 7,
        });

        return Astro.redirect("/admin");
    }
}
---

<BaseLayout title="Admin Login">
    <div
        class="min-h-screen bg-brand-navy-500 flex items-center justify-center px-4"
    >
        <div class="w-full max-w-md">
            <!-- Logo -->
            <div class="text-center mb-8">
                <a href="/" class="inline-block">
                    <span class="font-serif text-3xl text-white"
                        >FashionMarket</span
                    >
                </a>
                <p class="text-brand-navy-200 mt-2">Panel de Administración</p>
            </div>

            <!-- Login Card -->
            <div class="bg-white rounded-2xl shadow-elegant-lg p-8">
                <h1
                    class="font-serif text-2xl text-brand-navy-500 text-center mb-6"
                >
                    Iniciar Sesión
                </h1>

                {
                    error && (
                        <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm">
                            {error}
                        </div>
                    )
                }

                <form method="POST" class="space-y-5">
                    <div>
                        <label
                            for="email"
                            class="block text-sm font-medium text-brand-charcoal-600 mb-2"
                        >
                            Email
                        </label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            required
                            class="w-full px-4 py-3 border-2 border-brand-charcoal-200 rounded-lg focus:outline-none focus:border-brand-navy-500 transition-colors"
                            placeholder="admin@fashionmarket.es"
                        />
                    </div>

                    <div>
                        <label
                            for="password"
                            class="block text-sm font-medium text-brand-charcoal-600 mb-2"
                        >
                            Contraseña
                        </label>
                        <input
                            type="password"
                            id="password"
                            name="password"
                            required
                            class="w-full px-4 py-3 border-2 border-brand-charcoal-200 rounded-lg focus:outline-none focus:border-brand-navy-500 transition-colors"
                            placeholder="••••••••"
                        />
                    </div>

                    <button
                        type="submit"
                        class="w-full py-4 bg-brand-navy-500 text-white font-semibold rounded-lg hover:bg-brand-navy-600 transition-colors"
                    >
                        Entrar
                    </button>
                </form>
            </div>

            <!-- Back Link -->
            <p class="text-center mt-6">
                <a
                    href="/"
                    class="text-brand-navy-200 hover:text-white transition-colors"
                >
                    ← Volver a la tienda
                </a>
            </p>
        </div>
    </div>
</BaseLayout>
