---
import AdminLayout from "../../layouts/AdminLayout.astro";
import {
    getAllEmailRecipients,
    getNewsletterSubscribers,
    getNewsletterSubscribersFromTable,
} from "../../lib/supabase";

// Get all email recipients (combined from both sources)
const allRecipients = await getAllEmailRecipients();
const customersWithNewsletter = await getNewsletterSubscribers();
const tableSubscribers = await getNewsletterSubscribersFromTable();

// For backwards compatibility, use allRecipients as subscribers
const subscribers = allRecipients;

let message = "";
let messageType = "";
let sentTo: string[] = [];
let failedTo: string[] = [];

// Handle form submission
if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const action = formData.get("action")?.toString();
    const subject = formData.get("subject")?.toString();
    const content = formData.get("content")?.toString();
    const headerTitle = formData.get("headerTitle")?.toString() || "";
    const imageUrl = formData.get("imageUrl")?.toString() || "";
    const promoCode = formData.get("promoCode")?.toString() || "";
    const promoDiscount = formData.get("promoDiscount")?.toString() || "";
    const buttonText = formData.get("buttonText")?.toString() || "";
    const buttonUrl = formData.get("buttonUrl")?.toString() || "";

    if (action === "send_email" && subject && content) {
        if (subscribers.length > 0) {
            try {
                // Llamar al endpoint de envío de newsletter
                const response = await fetch(
                    new URL("/api/email/send-newsletter", Astro.url.origin),
                    {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "cookie": Astro.request.headers.get("cookie") || "",
                        },
                        body: JSON.stringify({
                            subject,
                            content,
                            headerTitle,
                            imageUrl,
                            promoCode,
                            promoDiscount,
                            buttonText,
                            buttonUrl,
                        }),
                    },
                );

                const result = await response.json();

                if (result.success) {
                    sentTo = result.stats.successfulEmails || [];
                    failedTo = result.stats.failedEmails || [];

                    if (failedTo.length === 0) {
                        message = `Newsletter enviado correctamente a ${result.stats.sent} suscriptores`;
                        messageType = "success";
                    } else {
                        message = `Newsletter enviado a ${result.stats.sent} de ${result.stats.total} suscriptores. ${result.stats.failed} fallaron.`;
                        messageType = "warning";
                    }
                } else {
                    message = result.error || "Error al enviar el newsletter";
                    messageType = "error";
                }
            } catch (error) {
                console.error("Error enviando newsletter:", error);
                message = "Error de conexión al enviar el newsletter";
                messageType = "error";
            }
        } else {
            message = "No hay suscriptores en el newsletter";
            messageType = "error";
        }
    }
}

function formatDate(dateStr: string) {
    return new Date(dateStr).toLocaleDateString("es-ES", {
        day: "2-digit",
        month: "short",
        year: "numeric",
    });
}
---

<AdminLayout title="Comunicaciones">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Main Content - Email Form -->
        <div class="lg:col-span-2 space-y-6">
            {
                message && (
                    <div
                        class={`p-4 rounded-xl border ${messageType === "success" ? "bg-emerald-500/10 border-emerald-500/30 text-emerald-400" : messageType === "warning" ? "bg-amber-500/10 border-amber-500/30 text-amber-400" : "bg-red-500/10 border-red-500/30 text-red-400"}`}
                    >
                        <div class="flex items-start gap-3">
                            {messageType === "success" ? (
                                <svg
                                    class="w-5 h-5 mt-0.5"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M5 13l4 4L19 7"
                                    />
                                </svg>
                            ) : messageType === "warning" ? (
                                <svg
                                    class="w-5 h-5 mt-0.5"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                                    />
                                </svg>
                            ) : (
                                <svg
                                    class="w-5 h-5 mt-0.5"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                    />
                                </svg>
                            )}
                            <div class="flex-1">
                                <p>{message}</p>
                                {sentTo.length > 0 && (
                                    <details class="mt-2">
                                        <summary class="text-sm cursor-pointer hover:underline">
                                            Ver enviados ({sentTo.length})
                                        </summary>
                                        <div class="mt-2 text-sm opacity-80 max-h-32 overflow-auto">
                                            {sentTo.join(", ")}
                                        </div>
                                    </details>
                                )}
                                {failedTo.length > 0 && (
                                    <details class="mt-2">
                                        <summary class="text-sm cursor-pointer hover:underline text-red-400">
                                            Ver fallidos ({failedTo.length})
                                        </summary>
                                        <div class="mt-2 text-sm text-red-400 max-h-32 overflow-auto">
                                            {failedTo.join(", ")}
                                        </div>
                                    </details>
                                )}
                            </div>
                        </div>
                    </div>
                )
            }

            <form
                method="POST"
                class="bg-dark-400 rounded-2xl border border-white/10 overflow-hidden"
            >
                <div class="p-6 border-b border-white/10">
                    <h2
                        class="text-lg font-semibold text-zinc-100 flex items-center gap-2"
                    >
                        <svg
                            class="w-5 h-5 text-neon-cyan"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                            ></path>
                        </svg>
                        Enviar Newsletter
                    </h2>
                    <p class="text-sm text-zinc-400 mt-1">
                        Envía emails a los {subscribers.length} clientes suscritos
                        al newsletter
                    </p>
                </div>

                <div class="p-6 space-y-5">
                    <input type="hidden" name="action" value="send_email" />

                    <!-- Audience Info -->
                    <div
                        class="p-4 bg-emerald-500/10 border border-emerald-500/30 rounded-xl"
                    >
                        <div class="flex items-center gap-3">
                            <div
                                class="w-10 h-10 bg-emerald-500/20 rounded-lg flex items-center justify-center"
                            >
                                <svg
                                    class="w-5 h-5 text-emerald-400"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="1.5"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                            <div>
                                <div class="font-medium text-emerald-300">
                                    Suscriptores del Newsletter
                                </div>
                                <div class="text-sm text-emerald-400/80">
                                    {subscribers.length} personas recibirán este email
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Header Title -->
                    <div>
                        <label
                            for="headerTitle"
                            class="block text-sm font-medium text-zinc-300 mb-2"
                        >
                            Título del Header
                        </label>
                        <input
                            type="text"
                            id="headerTitle"
                            name="headerTitle"
                            placeholder="Novedades de FashionMarket"
                            class="w-full px-4 py-3 bg-dark-300 border border-white/10 rounded-xl text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-neon-cyan focus:ring-2 focus:ring-neon-cyan/20 transition-all"
                        />
                    </div>

                    <!-- Subject -->
                    <div>
                        <label
                            for="subject"
                            class="block text-sm font-medium text-zinc-300 mb-2"
                        >
                            Asunto del Email <span class="text-red-400">*</span>
                        </label>
                        <input
                            type="text"
                            id="subject"
                            name="subject"
                            required
                            placeholder="Nuevas ofertas exclusivas para ti"
                            class="w-full px-4 py-3 bg-dark-300 border border-white/10 rounded-xl text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-neon-cyan focus:ring-2 focus:ring-neon-cyan/20 transition-all"
                        />
                    </div>

                    <!-- Image URL -->
                    <div>
                        <label
                            for="imageUrl"
                            class="block text-sm font-medium text-zinc-300 mb-2"
                        >
                            URL de Imagen (opcional)
                        </label>
                        <input
                            type="url"
                            id="imageUrl"
                            name="imageUrl"
                            placeholder="https://ejemplo.com/imagen-promocional.jpg"
                            class="w-full px-4 py-3 bg-dark-300 border border-white/10 rounded-xl text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-neon-cyan focus:ring-2 focus:ring-neon-cyan/20 transition-all"
                        />
                        <p class="text-xs text-zinc-500 mt-1">
                            Imagen destacada que aparecerá en el email
                        </p>
                    </div>

                    <!-- Content -->
                    <div>
                        <label
                            for="content"
                            class="block text-sm font-medium text-zinc-300 mb-2"
                        >
                            Contenido <span class="text-red-400">*</span>
                        </label>
                        <textarea
                            id="content"
                            name="content"
                            required
                            rows={6}
                            placeholder="Escribe el contenido de tu email aquí...

Puedes incluir información sobre nuevos productos, descuentos especiales o novedades de la tienda."
                            class="w-full px-4 py-3 bg-dark-300 border border-white/10 rounded-xl text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-neon-cyan focus:ring-2 focus:ring-neon-cyan/20 transition-all resize-none"
                        ></textarea>
                    </div>

                    <!-- Promo Code Section -->
                    <div
                        class="p-4 bg-amber-500/10 border border-amber-500/30 rounded-xl"
                    >
                        <h3
                            class="text-sm font-medium text-amber-400 mb-3 flex items-center gap-2"
                        >
                            <svg
                                class="w-4 h-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"
                                ></path>
                            </svg>
                            Código Promocional (opcional)
                        </h3>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label
                                    for="promoCode"
                                    class="block text-xs text-amber-400/80 mb-1"
                                    >Código</label
                                >
                                <input
                                    type="text"
                                    id="promoCode"
                                    name="promoCode"
                                    placeholder="VERANO20"
                                    class="w-full px-3 py-2 bg-dark-300 border border-amber-500/20 rounded-lg text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-amber-500 text-sm uppercase"
                                />
                            </div>
                            <div>
                                <label
                                    for="promoDiscount"
                                    class="block text-xs text-amber-400/80 mb-1"
                                    >Descripción del descuento</label
                                >
                                <input
                                    type="text"
                                    id="promoDiscount"
                                    name="promoDiscount"
                                    placeholder="20% de descuento"
                                    class="w-full px-3 py-2 bg-dark-300 border border-amber-500/20 rounded-lg text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-amber-500 text-sm"
                                />
                            </div>
                        </div>
                    </div>

                    <!-- CTA Button Section -->
                    <div
                        class="p-4 bg-neon-cyan/10 border border-neon-cyan/30 rounded-xl"
                    >
                        <h3
                            class="text-sm font-medium text-neon-cyan mb-3 flex items-center gap-2"
                        >
                            <svg
                                class="w-4 h-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
                                ></path>
                            </svg>
                            Botón de Acción
                        </h3>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label
                                    for="buttonText"
                                    class="block text-xs text-neon-cyan/80 mb-1"
                                    >Texto del botón</label
                                >
                                <input
                                    type="text"
                                    id="buttonText"
                                    name="buttonText"
                                    placeholder="Visitar la tienda"
                                    class="w-full px-3 py-2 bg-dark-300 border border-neon-cyan/20 rounded-lg text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-neon-cyan text-sm"
                                />
                            </div>
                            <div class="relative">
                                <label class="block text-xs text-neon-cyan/80 mb-1">Destino del botón</label>

                                <!-- Custom dropdown trigger -->
                                <button
                                    type="button"
                                    id="urlDropdownBtn"
                                    onclick="toggleUrlDropdown()"
                                    class="w-full px-3 py-2 bg-dark-300 border border-neon-cyan/20 rounded-lg text-zinc-100 focus:outline-none focus:border-neon-cyan text-sm flex items-center justify-between gap-2"
                                >
                                    <span id="urlDropdownLabel" class="flex items-center gap-2">
                                        <svg class="w-4 h-4 text-neon-cyan flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 11H4L5 9z"/></svg>
                                        Todos los productos
                                    </span>
                                    <svg id="urlDropdownChevron" class="w-4 h-4 text-zinc-400 flex-shrink-0 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                                </button>

                                <!-- Dropdown list -->
                                <div
                                    id="urlDropdownList"
                                    class="hidden absolute z-50 w-full mt-1 bg-dark-200 border border-neon-cyan/20 rounded-lg shadow-xl overflow-hidden"
                                >
                                    <div class="py-1">
                                        <button type="button" onclick="selectUrlOption('/productos', this)" data-value="/productos" class="url-option w-full px-3 py-2 text-sm text-left flex items-center gap-3 hover:bg-neon-cyan/10 text-zinc-100 transition-colors bg-neon-cyan/5">
                                            <svg class="w-4 h-4 text-neon-cyan flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 11H4L5 9z"/></svg>
                                            Todos los productos
                                        </button>
                                        <button type="button" onclick="selectUrlOption('/ofertas', this)" data-value="/ofertas" class="url-option w-full px-3 py-2 text-sm text-left flex items-center gap-3 hover:bg-neon-cyan/10 text-zinc-100 transition-colors">
                                            <svg class="w-4 h-4 text-orange-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                                            Ofertas y descuentos
                                        </button>
                                        <button type="button" onclick="selectUrlOption('/categoria/camisas', this)" data-value="/categoria/camisas" class="url-option w-full px-3 py-2 text-sm text-left flex items-center gap-3 hover:bg-neon-cyan/10 text-zinc-100 transition-colors">
                                            <svg class="w-4 h-4 text-blue-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                                            Camisas
                                        </button>
                                        <button type="button" onclick="selectUrlOption('/categoria/pantalones', this)" data-value="/categoria/pantalones" class="url-option w-full px-3 py-2 text-sm text-left flex items-center gap-3 hover:bg-neon-cyan/10 text-zinc-100 transition-colors">
                                            <svg class="w-4 h-4 text-indigo-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2 2z"/></svg>
                                            Pantalones
                                        </button>
                                        <button type="button" onclick="selectUrlOption('/categoria/chaquetas', this)" data-value="/categoria/chaquetas" class="url-option w-full px-3 py-2 text-sm text-left flex items-center gap-3 hover:bg-neon-cyan/10 text-zinc-100 transition-colors">
                                            <svg class="w-4 h-4 text-purple-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3l4 4-4 4M3 12h18M19 3l-4 4 4 4"/></svg>
                                            Chaquetas
                                        </button>
                                        <button type="button" onclick="selectUrlOption('/categoria/zapatos', this)" data-value="/categoria/zapatos" class="url-option w-full px-3 py-2 text-sm text-left flex items-center gap-3 hover:bg-neon-cyan/10 text-zinc-100 transition-colors">
                                            <svg class="w-4 h-4 text-yellow-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
                                            Zapatos
                                        </button>
                                        <button type="button" onclick="selectUrlOption('/categoria/accesorios', this)" data-value="/categoria/accesorios" class="url-option w-full px-3 py-2 text-sm text-left flex items-center gap-3 hover:bg-neon-cyan/10 text-zinc-100 transition-colors">
                                            <svg class="w-4 h-4 text-pink-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
                                            Accesorios
                                        </button>
                                        <button type="button" onclick="selectUrlOption('/', this)" data-value="/" class="url-option w-full px-3 py-2 text-sm text-left flex items-center gap-3 hover:bg-neon-cyan/10 text-zinc-100 transition-colors">
                                            <svg class="w-4 h-4 text-green-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                                            Inicio
                                        </button>
                                        <div class="border-t border-neon-cyan/10 my-1"></div>
                                        <button type="button" onclick="selectUrlOption('custom', this)" data-value="custom" class="url-option w-full px-3 py-2 text-sm text-left flex items-center gap-3 hover:bg-neon-cyan/10 text-zinc-400 transition-colors">
                                            <svg class="w-4 h-4 text-zinc-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                                            URL personalizada...
                                        </button>
                                    </div>
                                </div>

                                <input
                                    type="url"
                                    id="buttonUrlCustom"
                                    placeholder="https://..."
                                    class="hidden w-full mt-2 px-3 py-2 bg-dark-300 border border-neon-cyan/20 rounded-lg text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-neon-cyan text-sm"
                                />
                                <input
                                    type="hidden"
                                    id="buttonUrl"
                                    name="buttonUrl"
                                    value="/productos"
                                />
                            </div>
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <div class="flex items-center justify-between pt-2">
                        <div class="text-sm text-zinc-400">
                            <span class="font-medium text-zinc-200"
                                >{subscribers.length}</span
                            > destinatarios
                        </div>
                        <button
                            type="submit"
                            disabled={subscribers.length === 0}
                            class="px-6 py-3 bg-gradient-to-r from-neon-cyan to-neon-purple text-white font-medium rounded-xl hover:opacity-90 disabled:opacity-50 disabled:cursor-not-allowed transition-all flex items-center gap-2 shadow-lg shadow-neon-cyan/20"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                            </svg>
                            Enviar Newsletter
                        </button>
                    </div>
                </div>

                <!-- Info Note -->
            </form>
        </div>

        <!-- Sidebar - Subscribers List -->
        <div class="space-y-6">
