<script is:inline>
function toggleUrlDropdown() {
    const list = document.getElementById('urlDropdownList');
    const chevron = document.getElementById('urlDropdownChevron');
    const isOpen = !list.classList.contains('hidden');
    if (isOpen) {
        list.classList.add('hidden');
        chevron.style.transform = 'rotate(0deg)';
    } else {
        list.classList.remove('hidden');
        chevron.style.transform = 'rotate(180deg)';
    }
}

function selectUrlOption(value, btn) {
    const list = document.getElementById('urlDropdownList');
    const chevron = document.getElementById('urlDropdownChevron');
    const label = document.getElementById('urlDropdownLabel');
    const hiddenInput = document.getElementById('buttonUrl');
    const customInput = document.getElementById('buttonUrlCustom');

    // Update active styling
    document.querySelectorAll('.url-option').forEach(el => {
        el.classList.remove('bg-neon-cyan/5');
    });
    btn.classList.add('bg-neon-cyan/5');

    // Update trigger label (clone the svg + text)
    const svgEl = btn.querySelector('svg');
    const text = btn.textContent.trim();
    label.innerHTML = (svgEl ? svgEl.outerHTML : '') + '<span>' + text + '</span>';

    // Close dropdown
    list.classList.add('hidden');
    chevron.style.transform = 'rotate(0deg)';

    // Handle custom URL
    if (value === 'custom') {
        customInput.classList.remove('hidden');
        customInput.required = true;
        customInput.focus();
        hiddenInput.value = customInput.value || '';
    } else {
        customInput.classList.add('hidden');
        customInput.required = false;
        hiddenInput.value = value;
    }
}

document.addEventListener('DOMContentLoaded', () => {
    // Close dropdown when clicking outside
    document.addEventListener('click', (e) => {
        const btn = document.getElementById('urlDropdownBtn');
        const list = document.getElementById('urlDropdownList');
        if (btn && list && !btn.contains(e.target) && !list.contains(e.target)) {
            list.classList.add('hidden');
            document.getElementById('urlDropdownChevron').style.transform = 'rotate(0deg)';
        }
    });

    document.getElementById('buttonUrlCustom')?.addEventListener('input', (e) => {
        document.getElementById('buttonUrl').value = e.target.value;
    });
});
</script>
