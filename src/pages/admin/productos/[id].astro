---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import ImageUploader from "../../../components/islands/ImageUploader";
import { supabaseAdmin, getCategories } from "../../../lib/supabase";
import { slugify } from "../../../lib/utils";

// SSR - Protected by AdminLayout
export const prerender = false;

const { id } = Astro.params;
let error: string | null = null;
let product: any = null;

// Fetch product
const { data } = await supabaseAdmin
    .from("products")
    .select("*")
    .eq("id", id)
    .single();

product = data;

if (!product) {
    return Astro.redirect("/admin/productos");
}

const categories = await getCategories();

// Handle form submission
if (Astro.request.method === "POST") {
    try {
        const formData = await Astro.request.formData();

        const name = formData.get("name") as string;
        const slug = slugify(name);
        const description = formData.get("description") as string;
        const price = Math.round(
            parseFloat(formData.get("price") as string) * 100,
        );
        const stock = parseInt(formData.get("stock") as string);
        const category_id = (formData.get("category_id") as string) || null;
        const imagesJson = formData.get("images") as string;
        const images = imagesJson ? JSON.parse(imagesJson) : product.images;
        const sizesRaw = formData.get("sizes") as string;
        const sizes = sizesRaw
            ? sizesRaw.split(",").map((s) => s.trim())
            : product.sizes;
        const featured = formData.get("featured") === "on";
        const active = formData.get("active") === "on";

        const { error: updateError } = await supabaseAdmin
            .from("products")
            .update({
                name,
                slug,
                description,
                price,
                stock,
                category_id: category_id || null,
                images,
                sizes,
                featured,
                active,
            })
            .eq("id", id);

        if (updateError) {
            error = "Error al actualizar el producto: " + updateError.message;
        } else {
            return Astro.redirect("/admin/productos?updated=true");
        }
    } catch (e) {
        error = "Error al procesar el formulario";
    }
}
---

<AdminLayout title={`Editar: ${product.name}`}>
    <div class="max-w-4xl">
        <!-- Back Link -->
        <a
            href="/admin/productos"
            class="inline-flex items-center gap-2 text-brand-charcoal-500 hover:text-brand-navy-500 mb-6"
        >
            <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 19l-7-7 7-7"></path>
            </svg>
            Volver a productos
        </a>

        {
            error && (
                <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700">
                    {error}
                </div>
            )
        }

        <form
            method="POST"
            class="bg-white rounded-xl shadow-elegant p-6 md:p-8 space-y-6"
        >
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Name -->
                <div class="md:col-span-2">
                    <label
                        for="name"
                        class="block text-sm font-medium text-brand-charcoal-700 mb-2"
                    >
                        Nombre del Producto *
                    </label>
                    <input
                        type="text"
                        id="name"
                        name="name"
                        required
                        value={product.name}
                        class="w-full px-4 py-3 border-2 border-brand-charcoal-200 rounded-lg focus:outline-none focus:border-brand-navy-500 transition-colors"
                    />
                </div>

                <!-- Category -->
                <div>
                    <label
                        for="category_id"
                        class="block text-sm font-medium text-brand-charcoal-700 mb-2"
                    >
                        Categoría
                    </label>
                    <select
                        id="category_id"
                        name="category_id"
                        class="w-full px-4 py-3 border-2 border-brand-charcoal-200 rounded-lg focus:outline-none focus:border-brand-navy-500 transition-colors"
                    >
                        <option value="">Sin categoría</option>
                        {
                            categories.map((cat) => (
                                <option
                                    value={cat.id}
                                    selected={cat.id === product.category_id}
                                >
                                    {cat.name}
                                </option>
                            ))
                        }
                    </select>
                </div>

                <!-- Price -->
                <div>
                    <label
                        for="price"
                        class="block text-sm font-medium text-brand-charcoal-700 mb-2"
                    >
                        Precio (€) *
                    </label>
                    <input
                        type="number"
                        id="price"
                        name="price"
                        required
                        min="0"
                        step="0.01"
                        value={(product.price / 100).toFixed(2)}
                        class="w-full px-4 py-3 border-2 border-brand-charcoal-200 rounded-lg focus:outline-none focus:border-brand-navy-500 transition-colors"
                    />
                </div>

                <!-- Stock -->
                <div>
                    <label
                        for="stock"
                        class="block text-sm font-medium text-brand-charcoal-700 mb-2"
                    >
                        Stock *
                    </label>
                    <input
                        type="number"
                        id="stock"
                        name="stock"
                        required
                        min="0"
                        value={product.stock}
                        class="w-full px-4 py-3 border-2 border-brand-charcoal-200 rounded-lg focus:outline-none focus:border-brand-navy-500 transition-colors"
                    />
                </div>

                <!-- Sizes -->
                <div>
                    <label
                        for="sizes"
                        class="block text-sm font-medium text-brand-charcoal-700 mb-2"
                    >
                        Tallas (separadas por coma)
                    </label>
                    <input
                        type="text"
                        id="sizes"
                        name="sizes"
                        value={product.sizes.join(", ")}
                        class="w-full px-4 py-3 border-2 border-brand-charcoal-200 rounded-lg focus:outline-none focus:border-brand-navy-500 transition-colors"
                    />
                </div>

                <!-- Description -->
                <div class="md:col-span-2">
                    <label
                        for="description"
                        class="block text-sm font-medium text-brand-charcoal-700 mb-2"
                    >
                        Descripción
                    </label>
                    <textarea
                        id="description"
                        name="description"
                        rows="4"
                        class="w-full px-4 py-3 border-2 border-brand-charcoal-200 rounded-lg focus:outline-none focus:border-brand-navy-500 transition-colors resize-none"
                        >{product.description}</textarea
                    >
                </div>

                <!-- Image Uploader -->
                <div class="md:col-span-2">
                    <ImageUploader
                        client:load
                        existingImages={product.images}
                        onImagesChange={() => {}}
                    />
                </div>

                <!-- Checkboxes -->
                <div class="md:col-span-2 flex flex-wrap gap-6">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input
                            type="checkbox"
                            name="featured"
                            checked={product.featured}
                            class="w-5 h-5 rounded border-brand-charcoal-300 text-brand-navy-500 focus:ring-brand-navy-500"
                        />
                        <span class="text-brand-charcoal-700"
                            >Producto destacado</span
                        >
                    </label>

                    <label class="flex items-center gap-2 cursor-pointer">
                        <input
                            type="checkbox"
                            name="active"
                            checked={product.active}
                            class="w-5 h-5 rounded border-brand-charcoal-300 text-brand-navy-500 focus:ring-brand-navy-500"
                        />
                        <span class="text-brand-charcoal-700"
                            >Activo (visible en tienda)</span
                        >
                    </label>
                </div>
            </div>

            <!-- Submit -->
            <div class="flex gap-4 pt-4 border-t border-brand-charcoal-100">
                <button
                    type="submit"
                    class="px-6 py-3 bg-brand-navy-500 text-white font-semibold rounded-lg hover:bg-brand-navy-600 transition-colors"
                >
                    Guardar Cambios
                </button>
                <a
                    href="/admin/productos"
                    class="px-6 py-3 border border-brand-charcoal-200 text-brand-charcoal-600 font-medium rounded-lg hover:bg-cream-100 transition-colors"
                >
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</AdminLayout>
