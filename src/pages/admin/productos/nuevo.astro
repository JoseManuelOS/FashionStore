---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { supabaseAdmin, getCategories, updateProductStockBulk, initProductStock } from "../../../lib/supabase";
import ProductImagesUploader from "../../../components/islands/ProductImagesUploader";
import { slugify } from "../../../lib/utils";

export const prerender = false;

let error: string | null = null;
const categories = await getCategories();
const defaultSizes = ['XS', 'S', 'M', 'L', 'XL', 'XXL'];

if (Astro.request.method === "POST") {
    try {
        const formData = await Astro.request.formData();
        const name = formData.get("name") as string;
        const slug = slugify(name);
        const description = formData.get("description") as string;
        const price = parseFloat(formData.get("price") as string);
        const category_id = (formData.get("category_id") as string) || null;
        const sizesRaw = formData.get("sizes") as string;
        const sizes = sizesRaw ? sizesRaw.split(",").map(s => s.trim()) : ["S", "M", "L", "XL"];
        const is_offer = formData.get("is_offer") === "on";
        const active = formData.get("active") === "on";

        // Parse colors
        const colorsJson = formData.get("colors_json") as string;
        const colors: Array<{name: string; hex: string}> = colorsJson ? JSON.parse(colorsJson) : [];

        const stockBySize: Record<string, number> = {};
        if (colors.length > 0) {
            for (const size of sizes) {
                for (const color of colors) {
                    const stockValue = parseInt(formData.get(`stock_${size}|${color.name}`) as string) || 0;
                    stockBySize[`${size}|${color.name}`] = stockValue;
                }
            }
        } else {
            for (const size of defaultSizes) {
                const stockValue = formData.get(`stock_${size}`) as string;
                if (sizes.includes(size)) {
                    stockBySize[size] = parseInt(stockValue) || 0;
                }
            }
        }

        const totalStock = Object.values(stockBySize).reduce((sum, qty) => sum + qty, 0);

        const imagesRaw = formData.get("images") as string;
        const imageUrls = imagesRaw ? imagesRaw.split(",").map(url => url.trim()).filter(Boolean) : [];

        const { data: product, error: insertError } = await supabaseAdmin
            .from("products")
            .insert({ name, slug, description, price, stock: totalStock, category_id: category_id || null, sizes, colors, is_offer, active })
            .select()
            .single();

        if (insertError) {
            error = "Error al crear el producto: " + insertError.message;
        } else if (product) {
            await updateProductStockBulk(product.id, stockBySize);

            if (imageUrls.length > 0) {
                const imgColorsJson = formData.get("image_colors_json") as string;
                const imgColorsOverride: Record<string, {color: string; colorHex: string}> = imgColorsJson ? JSON.parse(imgColorsJson) : {};
                const imageRecords = imageUrls.map((url, index) => ({
                    product_id: product.id,
                    image_url: url,
                    order: index,
                    color: imgColorsOverride[url]?.color || null,
                    color_hex: imgColorsOverride[url]?.colorHex || null,
                }));
                await supabaseAdmin.from("product_images").insert(imageRecords);
            }

            return Astro.redirect("/admin/productos?created=true");
        }
    } catch (e) {
        error = "Error al procesar el formulario";
        console.error(e);
    }
}
---

<AdminLayout title="Nuevo Producto">
    <style>
        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #a1a1aa;
            text-decoration: none;
            font-size: 14px;
            margin-bottom: 24px;
            transition: color 0.2s;
        }
        
        .back-link:hover {
            color: #06b6d4;
        }
        
        .back-link svg {
            width: 16px;
            height: 16px;
        }
        
        .form-card {
            background: #12121a;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 32px;
            max-width: 720px;
        }
        
        .form-section {
            margin-bottom: 32px;
        }
        
        .form-section:last-child {
            margin-bottom: 0;
        }
        
        .section-title {
            font-size: 13px;
            font-weight: 600;
            color: #06b6d4;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 20px;
            padding-bottom: 12px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }
        
        .form-grid {
            display: grid;
            gap: 20px;
        }
        
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }
        
        @media (max-width: 600px) {
            .form-row {
                grid-template-columns: 1fr;
            }
        }
        
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        
        .form-label {
            font-size: 14px;
            font-weight: 500;
            color: #d4d4d8;
        }
        
        .form-input {
            padding: 12px 16px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            font-size: 14px;
            color: #fafafa;
            background: #18181f;
            transition: all 0.2s;
        }
        
        .form-input:focus {
            outline: none;
            border-color: #06b6d4;
            box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.1);
        }
        
        .form-input::placeholder {
            color: #52525b;
        }
        
        textarea.form-input {
            resize: none;
            min-height: 100px;
        }
        
        .form-hint {
            font-size: 12px;
            color: #71717a;
        }
        
        .color-entry {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 8px;
        }

        .color-name-input {
            flex: 1;
            max-width: 200px;
        }

        .color-hex-input {
            width: 44px;
            height: 44px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            background: #18181f;
            cursor: pointer;
            padding: 2px;
        }

        .btn-remove-color {
            background: rgba(239, 68, 68, 0.15);
            color: #ef4444;
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 8px;
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 16px;
            transition: all 0.2s;
        }

        .btn-remove-color:hover {
            background: rgba(239, 68, 68, 0.25);
        }

        .color-stock-group {
            background: #18181f;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            padding: 16px;
            margin-bottom: 12px;
        }

        .color-stock-header {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 12px;
            font-weight: 600;
            color: #fafafa;
        }

        .color-dot {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            border: 2px solid rgba(255, 255, 255, 0.2);
            display: inline-block;
            flex-shrink: 0;
        }

        .stock-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 12px;
        }
        
        @media (max-width: 600px) {
            .stock-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }
        
        .stock-item {
            text-align: center;
        }
        
        .stock-label {
            font-size: 12px;
            font-weight: 600;
            color: #a1a1aa;
            margin-bottom: 6px;
        }
        
        .stock-input {
            width: 100%;
            padding: 10px;
            text-align: center;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            font-size: 14px;
            background: #18181f;
            color: #fafafa;
        }
        
        .stock-input:focus {
            outline: none;
            border-color: #06b6d4;
            box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.1);
        }
        
        .checkbox-group {
            display: flex;
            flex-wrap: wrap;
            gap: 24px;
        }
        
        .checkbox-item {
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
        }
        
        .checkbox-item input {
            width: 18px;
            height: 18px;
            accent-color: #06b6d4;
        }
        
        .checkbox-item span {
            font-size: 14px;
            color: #a1a1aa;
        }
        
        .form-actions {
            display: flex;
            gap: 12px;
            padding-top: 24px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            margin-top: 32px;
        }
        
        .btn {
            padding: 12px 24px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, #06b6d4 0%, #8b5cf6 100%);
            color: #fff;
            border: none;
            box-shadow: 0 4px 15px rgba(6, 182, 212, 0.3);
        }
        
        .btn-primary:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }
        
        .btn-secondary {
            background: transparent;
            color: #a1a1aa;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(255, 255, 255, 0.2);
        }
        
        .error-message {
            padding: 12px 16px;
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 10px;
            color: #f87171;
            font-size: 14px;
            margin-bottom: 24px;
        }
    </style>

    <a href="/admin/productos" class="back-link">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Volver a productos
    </a>

    {error && <div class="error-message">{error}</div>}

    <form method="POST" class="form-card">
        <div class="form-section">
            <div class="section-title">Información básica</div>
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label" for="name">Nombre del producto</label>
                    <input type="text" id="name" name="name" required class="form-input" placeholder="Ej: Camisa Oxford Premium" />
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" for="category_id">Categoría</label>
                        <select id="category_id" name="category_id" class="form-input">
                            <option value="">Sin categoría</option>
                            {categories.map(cat => <option value={cat.id}>{cat.name}</option>)}
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="price">Precio (€)</label>
                        <input type="number" id="price" name="price" required min="0" step="0.01" class="form-input" placeholder="89.99" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label" for="description">Descripción</label>
                    <textarea id="description" name="description" class="form-input" placeholder="Describe el producto..."></textarea>
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="section-title">Colores</div>
            <div id="colors-container"></div>
            <button type="button" id="add-color-btn" class="btn btn-secondary" style="margin-top:12px">+ Añadir color</button>
            <input type="hidden" name="colors_json" id="colors-json-input" value="[]" />
            <span class="form-hint">Define los colores disponibles. Si no tiene colores, déjalo vacío.</span>
        </div>

        <div class="form-section">
            <div class="section-title">Tallas y stock</div>
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label" for="sizes">Tallas disponibles</label>
                    <input type="text" id="sizes" name="sizes" class="form-input" placeholder="XS, S, M, L, XL, XXL" value="XS, S, M, L, XL, XXL" />
                    <span class="form-hint">Separadas por coma</span>
                </div>
                <div class="form-group">
                    <label class="form-label">Stock por talla</label>
                    <div id="stock-container">
                        <div class="stock-grid">
                            {defaultSizes.map(size => (
                                <div class="stock-item">
                                    <div class="stock-label">{size}</div>
                                    <input type="number" name={`stock_${size}`} min="0" value="0" class="stock-input" />
                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="section-title">Imágenes</div>
            <div class="form-group">
                <label class="form-label" for="images">Galería de Imágenes</label>
                <ProductImagesUploader
                    client:load
                    initialImages={[]}
                    inputName="images"
                    availableColors={[]}
                    initialImageColors={{}}
                />
                <input type="hidden" name="image_colors_json" id="image-colors-json-input" value="" />
                <span class="form-hint">Arrastra para reordenar. Haz clic en 'Eliminar' para quitar una imagen.</span>
            </div>
        </div>

        <div class="form-section">
            <div class="section-title">Opciones</div>
            <div class="checkbox-group">
                <label class="checkbox-item">
                    <input type="checkbox" name="is_offer" />
                    <span>Producto en oferta</span>
                </label>
                <label class="checkbox-item">
                    <input type="checkbox" name="active" checked />
                    <span>Activo (visible en tienda)</span>
                </label>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Crear Producto</button>
            <a href="/admin/productos" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const colorsContainer = document.getElementById('colors-container');
            const addColorBtn = document.getElementById('add-color-btn');
            const colorsJsonInput = document.getElementById('colors-json-input') as HTMLInputElement;
            const stockContainer = document.getElementById('stock-container');
            const sizesInput = document.getElementById('sizes') as HTMLInputElement;

            if (!colorsContainer || !addColorBtn || !colorsJsonInput || !stockContainer || !sizesInput) return;

            function getColors(): Array<{name: string; hex: string}> {
                const entries = colorsContainer!.querySelectorAll('.color-entry');
                const colors: Array<{name: string; hex: string}> = [];
                entries.forEach(entry => {
                    const name = (entry.querySelector('.color-name-input') as HTMLInputElement).value.trim();
                    const hex = (entry.querySelector('.color-hex-input') as HTMLInputElement).value;
                    if (name) colors.push({ name, hex });
                });
                return colors;
            }

            function getSizes(): string[] {
                return sizesInput!.value.split(',').map(s => s.trim()).filter(Boolean);
            }

            function updateColorsJson() {
                colorsJsonInput!.value = JSON.stringify(getColors());
            }

            function saveCurrentStockValues(): Record<string, string> {
                const values: Record<string, string> = {};
                stockContainer!.querySelectorAll('input[type="number"]').forEach((input) => {
                    const inp = input as HTMLInputElement;
                    values[inp.name] = inp.value;
                });
                return values;
            }

            function rebuildStockSection() {
                const colors = getColors();
                const sizes = getSizes();
                const savedValues = saveCurrentStockValues();
                let html = '';

                if (colors.length > 0) {
                    colors.forEach(color => {
                        html += `<div class="color-stock-group">
                            <div class="color-stock-header">
                                <span class="color-dot" style="background:${color.hex}"></span>
                                <span>${color.name}</span>
                            </div>
                            <div class="stock-grid">`;
                        sizes.forEach(size => {
                            const name = `stock_${size}|${color.name}`;
                            const val = savedValues[name] || '0';
                            html += `<div class="stock-item">
                                <div class="stock-label">${size}</div>
                                <input type="number" name="${name}" min="0" value="${val}" class="stock-input" />
                            </div>`;
                        });
                        html += `</div></div>`;
                    });
                } else {
                    html += `<div class="stock-grid">`;
                    sizes.forEach(size => {
                        const name = `stock_${size}`;
                        const val = savedValues[name] || '0';
                        html += `<div class="stock-item">
                            <div class="stock-label">${size}</div>
                            <input type="number" name="${name}" min="0" value="${val}" class="stock-input" />
                        </div>`;
                    });
                    html += `</div>`;
                }
                stockContainer!.innerHTML = html;
            }

            function attachColorEntryListeners(entry: Element) {
                entry.querySelector('.btn-remove-color')?.addEventListener('click', () => {
                    entry.remove();
                    updateColorsJson();
                    rebuildStockSection();
                });
                entry.querySelector('.color-name-input')?.addEventListener('input', () => {
                    updateColorsJson();
                    rebuildStockSection();
                });
                entry.querySelector('.color-hex-input')?.addEventListener('input', () => {
                    updateColorsJson();
                    rebuildStockSection();
                });
            }

            addColorBtn.addEventListener('click', () => {
                const div = document.createElement('div');
                div.className = 'color-entry';
                div.innerHTML = `
                    <input type="text" class="color-name-input form-input" value="" placeholder="Nombre (ej: Negro)" />
                    <input type="color" class="color-hex-input" value="#000000" />
                    <button type="button" class="btn-remove-color" title="Eliminar color">&times;</button>
                `;
                colorsContainer!.appendChild(div);
                attachColorEntryListeners(div);
                updateColorsJson();
            });

            let sizesTimeout: ReturnType<typeof setTimeout>;
            sizesInput.addEventListener('input', () => {
                clearTimeout(sizesTimeout);
                sizesTimeout = setTimeout(() => {
                    rebuildStockSection();
                }, 500);
            });
        });
    </script>
</AdminLayout>
