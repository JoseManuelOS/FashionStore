---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { supabaseAdmin, getCategories, initProductStock, updateProductStockBulk } from "../../../lib/supabase";
import { slugify } from "../../../lib/utils";

// SSR - Protected by AdminLayout
export const prerender = false;

let error: string | null = null;
const categories = await getCategories();
const defaultSizes = ['XS', 'S', 'M', 'L', 'XL', 'XXL'];

// Handle form submission
if (Astro.request.method === "POST") {
    try {
        const formData = await Astro.request.formData();

        const name = formData.get("name") as string;
        const slug = slugify(name);
        const description = formData.get("description") as string;
        const price = parseFloat(formData.get("price") as string);
        const category_id = (formData.get("category_id") as string) || null;
        const sizesRaw = formData.get("sizes") as string;
        const sizes = sizesRaw
            ? sizesRaw.split(",").map((s) => s.trim())
            : ["S", "M", "L", "XL"];
        const is_offer = formData.get("is_offer") === "on";
        const active = formData.get("active") === "on";

        // Procesar stock por talla
        const stockBySize: Record<string, number> = {};
        for (const size of defaultSizes) {
            const stockValue = formData.get(`stock_${size}`) as string;
            if (sizes.includes(size)) {
                stockBySize[size] = parseInt(stockValue) || 0;
            }
        }

        // Calcular stock total
        const totalStock = Object.values(stockBySize).reduce((sum, qty) => sum + qty, 0);

        // Get image URLs (comma separated)
        const imagesRaw = formData.get("images") as string;
        const imageUrls = imagesRaw
            ? imagesRaw
                  .split(",")
                  .map((url) => url.trim())
                  .filter(Boolean)
            : [];

        // Create product
        const { data: product, error: insertError } = await supabaseAdmin
            .from("products")
            .insert({
                name,
                slug,
                description,
                price,
                stock: totalStock,
                category_id: category_id || null,
                sizes,
                is_offer,
                active,
            })
            .select()
            .single();

        if (insertError) {
            error = "Error al crear el producto: " + insertError.message;
        } else if (product) {
            // Inicializar y actualizar stock por talla
            await updateProductStockBulk(product.id, stockBySize);

            // Insert images
            if (imageUrls.length > 0) {
                const imageRecords = imageUrls.map((url, index) => ({
                    product_id: product.id,
                    image_url: url,
                    order: index,
                }));

                await supabaseAdmin.from("product_images").insert(imageRecords);
            }

            return Astro.redirect("/admin/productos?created=true");
        }
    } catch (e) {
        error = "Error al procesar el formulario";
        console.error(e);
    }
}
---

<AdminLayout title="Nuevo Producto">
    <div class="max-w-4xl">
        <!-- Back Link -->
        <a
            href="/admin/productos"
            class="inline-flex items-center gap-2 text-brand-charcoal-500 hover:text-brand-navy-500 mb-6"
        >
            <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 19l-7-7 7-7"></path>
            </svg>
            Volver a productos
        </a>

        <h1 class="text-2xl font-serif text-brand-navy-500 mb-6">
            Crear Nuevo Producto
        </h1>

        {
            error && (
                <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700">
                    {error}
                </div>
            )
        }

        <form
            method="POST"
            class="bg-white rounded-xl shadow-elegant p-6 md:p-8 space-y-6"
        >
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Name -->
                <div class="md:col-span-2">
                    <label
                        for="name"
                        class="block text-sm font-medium text-brand-charcoal-700 mb-2"
                    >
                        Nombre del Producto *
                    </label>
                    <input
                        type="text"
                        id="name"
                        name="name"
                        required
                        class="w-full px-4 py-3 border-2 border-brand-charcoal-200 rounded-lg focus:outline-none focus:border-brand-navy-500 transition-colors"
                        placeholder="Ej: Camisa Oxford Premium"
                    />
                </div>

                <!-- Category -->
                <div>
                    <label
                        for="category_id"
                        class="block text-sm font-medium text-brand-charcoal-700 mb-2"
                    >
                        Categoría
                    </label>
                    <select
                        id="category_id"
                        name="category_id"
                        class="w-full px-4 py-3 border-2 border-brand-charcoal-200 rounded-lg focus:outline-none focus:border-brand-navy-500 transition-colors"
                    >
                        <option value="">Sin categoría</option>
                        {
                            categories.map((cat) => (
                                <option value={cat.id}>{cat.name}</option>
                            ))
                        }
                    </select>
                </div>

                <!-- Price -->
                <div class="md:col-span-2">
                    <label
                        for="price"
                        class="block text-sm font-medium text-brand-charcoal-700 mb-2"
                    >
                        Precio (€) *
                    </label>
                    <input
                        type="number"
                        id="price"
                        name="price"
                        required
                        min="0"
                        step="0.01"
                        class="w-full px-4 py-3 border-2 border-brand-charcoal-200 rounded-lg focus:outline-none focus:border-brand-navy-500 transition-colors"
                        placeholder="89.99"
                    />
                </div>

                <!-- Sizes -->
                <div class="md:col-span-2">
                    <label
                        for="sizes"
                        class="block text-sm font-medium text-brand-charcoal-700 mb-2"
                    >
                        Tallas (separadas por coma)
                    </label>
                    <input
                        type="text"
                        id="sizes"
                        name="sizes"
                        class="w-full px-4 py-3 border-2 border-brand-charcoal-200 rounded-lg focus:outline-none focus:border-brand-navy-500 transition-colors"
                        placeholder="XS, S, M, L, XL, XXL"
                        value="XS, S, M, L, XL, XXL"
                    />
                </div>

                <!-- Stock por Talla -->
                <div class="md:col-span-2">
                    <label class="block text-sm font-medium text-brand-charcoal-700 mb-3">
                        📦 Stock por Talla
                    </label>
                    <div class="bg-cream-100 rounded-lg p-4">
                        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4">
                            {defaultSizes.map((size: string) => (
                                <div class="text-center">
                                    <label 
                                        for={`stock_${size}`}
                                        class="block text-sm font-bold text-brand-navy-500 mb-1"
                                    >
                                        {size}
                                    </label>
                                    <input
                                        type="number"
                                        id={`stock_${size}`}
                                        name={`stock_${size}`}
                                        min="0"
                                        value="0"
                                        class="w-full px-3 py-2 text-center border-2 border-brand-charcoal-200 rounded-lg focus:outline-none focus:border-brand-navy-500 transition-colors"
                                    />
                                </div>
                            ))}
                        </div>
                        <p class="mt-3 text-xs text-brand-charcoal-500">
                            💡 Introduce el stock para cada talla. Las tallas que no existan en el producto se ignorarán.
                        </p>
                    </div>
                </div>

                <!-- Description -->
                <div class="md:col-span-2">
                    <label
                        for="description"
                        class="block text-sm font-medium text-brand-charcoal-700 mb-2"
                    >
                        Descripción
                    </label>
                    <textarea
                        id="description"
                        name="description"
                        rows="4"
                        class="w-full px-4 py-3 border-2 border-brand-charcoal-200 rounded-lg focus:outline-none focus:border-brand-navy-500 transition-colors resize-none"
                        placeholder="Describe el producto..."></textarea>
                </div>

                <!-- Images -->
                <div class="md:col-span-2">
                    <label
                        for="images"
                        class="block text-sm font-medium text-brand-charcoal-700 mb-2"
                    >
                        URLs de Imágenes (separadas por coma)
                    </label>
                    <textarea
                        id="images"
                        name="images"
                        rows="3"
                        class="w-full px-4 py-3 border-2 border-brand-charcoal-200 rounded-lg focus:outline-none focus:border-brand-navy-500 transition-colors resize-none"
                        placeholder="https://ejemplo.com/imagen1.jpg, https://ejemplo.com/imagen2.jpg"
                    ></textarea>
                    <p class="mt-2 text-xs text-brand-charcoal-400">
                        Sube las imágenes a Supabase Storage y pega las URLs
                        aquí. La primera imagen será la principal.
                    </p>
                </div>

                <!-- Checkboxes -->
                <div class="md:col-span-2 flex flex-wrap gap-6">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input
                            type="checkbox"
                            name="is_offer"
                            class="w-5 h-5 rounded border-brand-charcoal-300 text-red-500 focus:ring-red-500"
                        />
                        <span class="text-brand-charcoal-700"
                            >🔥 Producto en oferta</span
                        >
                    </label>

                    <label class="flex items-center gap-2 cursor-pointer">
                        <input
                            type="checkbox"
                            name="active"
                            checked
                            class="w-5 h-5 rounded border-brand-charcoal-300 text-brand-navy-500 focus:ring-brand-navy-500"
                        />
                        <span class="text-brand-charcoal-700"
                            >Activo (visible en tienda)</span
                        >
                    </label>
                </div>
            </div>

            <!-- Submit -->
            <div class="flex gap-4 pt-4 border-t border-brand-charcoal-100">
                <button
                    type="submit"
                    class="px-6 py-3 bg-brand-navy-500 text-white font-semibold rounded-lg hover:bg-brand-navy-600 transition-colors"
                >
                    Crear Producto
                </button>
                <a
                    href="/admin/productos"
                    class="px-6 py-3 border border-brand-charcoal-200 text-brand-charcoal-600 font-medium rounded-lg hover:bg-cream-100 transition-colors"
                >
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</AdminLayout>
