import AdminLayout from "../../../layouts/AdminLayout.astro";
import { supabaseAdmin, formatPrice } from "../../../lib/supabase";

export const prerender = false;

const { data: products, error: productsError } = await supabaseAdmin
    .from("products")
    .select(
        `
    *,
    category:categories(name, slug),
    images:product_images(id, image_url, order),
    variants:product_variants(size, stock, sku, color)
  `,
    )
    .order("created_at", { ascending: false });

if (productsError) {
    console.error("Error loading products:", productsError);
}

// Debug: Log para verificar
console.log("Products loaded:", products?.length || 0);
if (productsError) {
    console.error("Products error details:", productsError);
}

// Filtro: por defecto ocultar inactivos
const showInactive = Astro.url.searchParams.get("inactivos") === "true";
const activeProducts = products?.filter((p) => p.active) || [];
const inactiveCount = (products?.length || 0) - activeProducts.length;

if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const action = formData.get("action");
    const id = formData.get("id") as string;

    if (action === "delete" && id) {
        await supabaseAdmin
            .from("products")
            .update({ active: false })
            .eq("id", id);
        return Astro.redirect("/admin/productos?deleted=true");
    }

    if (action === "toggle_offer" && id) {
        const currentProduct = products?.find((p) => p.id === id);
        if (currentProduct) {
            await supabaseAdmin
                .from("products")
                .update({ is_offer: !currentProduct.is_offer })
                .eq("id", id);
            return Astro.redirect("/admin/productos");
        }
    }
}

const urlParams = Astro.url.searchParams;
const showNotification =
    urlParams.get("deleted") ||
    urlParams.get("created") ||
    urlParams.get("updated");
const notificationMessage = urlParams.get("deleted")
    ? "Producto ocultado de la tienda"
    : urlParams.get("created")
      ? "Producto creado"
      : urlParams.get("updated")
        ? "Producto actualizado"
        : "";

// Función helper para obtener el estado del stock
function getStockStatus(stock: number): string {
    if (stock === 0) return "red";
    if (stock <= 5) return "yellow";
    return "green";
}

// Color name to hex mapping for visual swatches
function getColorHex(colorName: string): string {
    const colors: Record<string, string> = {
        'rojo': '#ef4444', 'red': '#ef4444',
        'azul': '#3b82f6', 'blue': '#3b82f6',
        'verde': '#22c55e', 'green': '#22c55e',
        'amarillo': '#eab308', 'yellow': '#eab308',
        'negro': '#1f2937', 'black': '#1f2937',
        'blanco': '#e5e7eb', 'white': '#e5e7eb',
        'rosa': '#ec4899', 'pink': '#ec4899',
        'morado': '#a855f7', 'purple': '#a855f7',
        'naranja': '#f97316', 'orange': '#f97316',
        'gris': '#6b7280', 'gray': '#6b7280', 'grey': '#6b7280',
        'marrón': '#92400e', 'brown': '#92400e',
        'beige': '#d4a574', 'crema': '#f5e6d3',
        'celeste': '#67e8f9', 'turquesa': '#2dd4bf',
        'dorado': '#d4a017', 'gold': '#d4a017',
        'plateado': '#94a3b8', 'silver': '#94a3b8',
        'burdeos': '#881337', 'borgoña': '#881337',
        'coral': '#fb7185', 'lavanda': '#c4b5fd',
        'oliva': '#84cc16', 'marino': '#1e3a5f',
        'caqui': '#a3946a', 'lila': '#c084fc',
    };
    return colors[colorName.toLowerCase().trim()] || '#06b6d4';
}

// Standard size order
const sizeOrder = ['XS', 'S', 'M', 'L', 'XL', 'XXL', '2XL', '3XL'];
function sortSizes(a: string, b: string): number {
    const iA = sizeOrder.indexOf(a);
    const iB = sizeOrder.indexOf(b);
    if (iA !== -1 && iB !== -1) return iA - iB;
    if (iA !== -1) return -1;
    if (iB !== -1) return 1;
    return a.localeCompare(b);
}

function stockCls(qty: number): string {
    if (qty === 0) return 'out-of-stock';
    if (qty <= 3) return 'low-stock';
    return '';
}

// Preparar productos con datos pre-calculados
const filteredProducts = showInactive ? products : activeProducts;
const productsWithData =
    filteredProducts?.map((product) => {
        // Agrupar stock por tallas (sumando todos los colores)
        const stockBySize: Record<string, number> = {};
        // Detalle agrupado por color: { color: { sizes: { size: stock }, total: N } }
        const colorGroups: Record<string, { sizes: Record<string, number>, total: number }> = {};
        let totalFromVariants = 0;
        let hasColors = false;
        const uniqueColors = new Set<string>();
        const uniqueSizes = new Set<string>();

        if (product.variants && product.variants.length > 0) {
            product.variants.forEach((v: any) => {
                const color = v.color || '';
                if (color) {
                    hasColors = true;
                    uniqueColors.add(color);
                }
                uniqueSizes.add(v.size);
                // Sumar stock total por talla
                stockBySize[v.size] = (stockBySize[v.size] || 0) + v.stock;
                // Agrupar por color
                const colorKey = color || 'Sin color';
                if (!colorGroups[colorKey]) colorGroups[colorKey] = { sizes: {}, total: 0 };
                colorGroups[colorKey].sizes[v.size] = v.stock;
                colorGroups[colorKey].total += v.stock;
                totalFromVariants += v.stock;
            });
        }
        // Usar el total de variantes si hay variantes, si no el stock general
        const effectiveStock = totalFromVariants > 0 ? totalFromVariants : product.stock;
        
        return {
            ...product,
            mainImage: product.images?.sort(
                (a: any, b: any) => a.order - b.order,
            )[0]?.image_url,
            stockStatus: getStockStatus(effectiveStock),
            stockBySize,
            colorGroups,
            hasColors,
            totalStock: effectiveStock,
            colorCount: uniqueColors.size,
            sizeCount: uniqueSizes.size,
            sortedSizes: [...uniqueSizes].sort(sortSizes),
        };
    }) || [];
