            transform: translateY(-1px);
        }

        .btn-primary svg {
            width: 18px;
            height: 18px;
        }

        .notification {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 12px 16px;
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid rgba(16, 185, 129, 0.3);
            border-radius: 10px;
            color: #10b981;
            font-size: 14px;
            margin-bottom: 24px;
        }

        .table-container {
            background: #12121a;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            overflow: hidden;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
        }

        .data-table th {
            text-align: left;
            padding: 12px 20px;
            font-size: 12px;
            font-weight: 500;
            color: #71717a;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            background: #0d0d14;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .data-table td {
            padding: 16px 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            vertical-align: middle;
        }

        .data-table tr:last-child td {
            border-bottom: none;
        }

        .data-table tr:hover td {
            background: rgba(6, 182, 212, 0.05);
        }

        .product-cell {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .product-image {
            width: 48px;
            height: 56px;
            border-radius: 8px;
            background: #1f1f28;
            overflow: hidden;
            flex-shrink: 0;
        }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .product-name {
            font-size: 14px;
            font-weight: 500;
            color: #f4f4f5;
        }

        .product-images-count {
            font-size: 12px;
            color: #71717a;
        }

        .category-text {
            font-size: 14px;
            color: #a1a1aa;
        }

        .price-text {
            font-size: 14px;
            font-weight: 600;
            color: #06b6d4;
        }

        .stock-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            color: #71717a;
            margin-top: 6px;
        }

        .stock-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }

        .stock-dot.green {
            background: #22c55e;
            box-shadow: 0 0 8px rgba(34, 197, 94, 0.5);
        }
        .stock-dot.yellow {
            background: #f59e0b;
            box-shadow: 0 0 8px rgba(245, 158, 11, 0.5);
        }
        .stock-dot.red {
            background: #ef4444;
            box-shadow: 0 0 8px rgba(239, 68, 68, 0.5);
        }

        .stock-sizes {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
        }

        .size-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 8px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 500;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #a1a1aa;
            transition: all 0.2s;
        }

        .size-badge:hover {
            background: rgba(6, 182, 212, 0.1);
            border-color: rgba(6, 182, 212, 0.3);
        }

        .size-badge .size-name {
            color: #71717a;
            text-transform: uppercase;
            font-weight: 600;
        }

        .size-badge .size-stock {
            color: #06b6d4;
            font-weight: 700;
        }

        .size-badge.out-of-stock {
            opacity: 0.4;
            border-color: rgba(239, 68, 68, 0.3);
        }

        .size-badge.out-of-stock .size-stock {
            color: #ef4444;
        }

        .size-badge.low-stock {
            border-color: rgba(245, 158, 11, 0.3);
        }

        .size-badge.low-stock .size-stock {
            color: #f59e0b;
        }

        .status-badges {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }

        .badge {
            display: inline-flex;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 500;
        }

        .badge.active {
            background: rgba(16, 185, 129, 0.15);
            color: #10b981;
        }

        .badge.inactive {
            background: rgba(255, 255, 255, 0.08);
            color: #71717a;
        }

        .badge.offer {
            background: rgba(239, 68, 68, 0.15);
            color: #f87171;
        }

        .actions {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .action-btn {
            padding: 8px;
            border-radius: 8px;
            border: none;
            background: none;
            color: #71717a;
            cursor: pointer;
            transition: all 0.2s;
        }

        .action-btn:hover {
            background: rgba(6, 182, 212, 0.1);
            color: #06b6d4;
        }

        .action-btn.danger:hover {
            background: rgba(239, 68, 68, 0.1);
            color: #ef4444;
        }

        .action-btn svg {
            width: 16px;
            height: 16px;
        }

        .empty-state {
            padding: 60px 20px;
            text-align: center;
        }

        .empty-state p {
            color: #71717a;
            font-size: 14px;
        }

        .empty-state a {
            color: #06b6d4;
            font-weight: 500;
        }

        /* Modal */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(4px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            z-index: 50;
            opacity: 0;
            visibility: hidden;
            transition: all 0.2s;
        }

        .modal-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .modal {
            background: #12121a;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 24px;
            max-width: 400px;
            width: 100%;
        }

        .modal-title {
            font-size: 16px;
            font-weight: 600;
            color: #f4f4f5;
            margin-bottom: 8px;
        }

        .modal-text {
            font-size: 14px;
            color: #a1a1aa;
            margin-bottom: 24px;
        }

        .modal-actions {
            display: flex;
            gap: 12px;
        }

        .modal-btn {
            flex: 1;
            padding: 10px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
        }

        .modal-btn.cancel {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #a1a1aa;
        }

        .modal-btn.cancel:hover {
            background: rgba(255, 255, 255, 0.1);
            color: #f4f4f5;
        }

        .modal-btn.danger {
            background: #dc2626;
            border: none;
            color: #fff;
        }

        .modal-btn.danger:hover {
            background: #b91c1c;
            box-shadow: 0 0 20px rgba(220, 38, 38, 0.4);
        }

        .search-bar {
            position: relative;
            margin-bottom: 24px;
        }

        .search-bar svg {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            width: 20px;
            height: 20px;
            color: #71717a;
        }

        .search-input {
            width: 100%;
            padding: 12px 12px 12px 40px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            font-size: 14px;
            color: #f4f4f5;
            background: #12121a;
            transition: all 0.2s;
        }

        .search-input:focus {
            outline: none;
            border-color: #06b6d4;
            box-shadow: 0 0 20px rgba(6, 182, 212, 0.15);
        }

        .search-input::placeholder {
            color: #52525b;
        }
    </style>

    {
        showNotification && (
            <div class="notification">
                <svg
                    width="16"
                    height="16"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M5 13l4 4L19 7"
                    />
                </svg>
                {notificationMessage}
            </div>
        )
    }

    <div class="page-header">
        <div>
            <h1 style="font-size: 24px; font-weight: 600; color: #f4f4f5; margin-bottom: 4px;">Productos</h1>
            <div class="page-subtitle">
                {products?.length || 0} productos registrados
            </div>
        </div>
        <a href="/admin/productos/nuevo" class="btn-primary">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 4v16m8-8H4"></path>
            </svg>
            Nuevo Producto
        </a>
    </div>

    {productsError && (
        <div style="padding: 16px; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 12px; color: #ef4444; margin-bottom: 24px;">
            <strong>Error al cargar productos:</strong> {productsError.message}
        </div>
    )}

    <!-- Search Bar -->
    <div class="search-bar">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input type="text" id="product-search" class="search-input" placeholder="Buscar por nombre, categoría o SKU..." />
    </div>
    <div id="no-results" style="display: none; text-align: center; padding: 40px 20px; color: #71717a; font-size: 14px;">No se encontraron productos</div>

    <div class="table-container">
        {productsError ? (
            <div style="padding: 60px 20px; text-align: center;">
                <div style="display: inline-flex; align-items: center; justify-content: center; width: 64px; height: 64px; background: rgba(239, 68, 68, 0.1); border-radius: 50%; margin-bottom: 16px;">
                    <svg style="width: 32px; height: 32px; color: #ef4444;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
                <p style="color: #ef4444; font-size: 16px; font-weight: 600; margin-bottom: 8px;">Error al cargar productos</p>
                <p style="color: #71717a; font-size: 14px; margin-bottom: 20px;">{productsError.message}</p>
                <p style="color: #a1a1aa; font-size: 13px;">Verifica tu conexión a Supabase y que SUPABASE_SERVICE_ROLE_KEY esté configurada</p>
            </div>
        ) : (
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {
                        productsWithData.length > 0 ? (
                            productsWithData.map((product) => (
                            <tr>
                                <td>
                                    <div class="product-cell">
                                        <div class="product-image">
                                            {product.mainImage ? (
                                                <img
                                                    src={product.mainImage}
                                                    alt={product.name}
                                                />
                                            ) : (
                                                <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #a1a1aa; font-size: 10px;">
                                                    IMG
                                                </div>
                                            )}
                                        </div>
                                        <div>
                                            <div class="product-name">
                                                {product.name}
                                            </div>
                                            <div class="product-images-count">
                                                {product.images?.length || 0}{" "}
                                                imagen(es)
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="category-text">
                                        {product.category?.name || "—"}
                                    </span>
                                </td>
                                <td>
                                    <span class="price-text">
                                        {formatPrice(product.price)}
                                    </span>
                                </td>
                                <td>
                                    <div>
                                        {Object.keys(product.stockBySize).length > 0 ? (
                                            <>
                                                <div class="stock-sizes">
                                                    {Object.entries(product.stockBySize)
                                                        .sort((a: [string, unknown], b: [string, unknown]) => {
                                                            const order = ['XS', 'S', 'M', 'L', 'XL', 'XXL'];
                                                            const indexA = order.indexOf(a[0]);
                                                            const indexB = order.indexOf(b[0]);
                                                            if (indexA !== -1 && indexB !== -1) return indexA - indexB;
                                                            return a[0].localeCompare(b[0]);
                                                        })
                                                        .map(([size, stock]: [string, any]) => (
                                                            <span class={`size-badge ${stock === 0 ? 'out-of-stock' : stock <= 3 ? 'low-stock' : ''}`}>
                                                                <span class="size-name">{size}</span>
                                                                <span class="size-stock">{stock}</span>
                                                            </span>
                                                        ))}
                                                </div>
                                                <div class="stock-badge">
                                                    <span class={`stock-dot ${product.stockStatus}`} />
                                                    {product.totalStock} total
                                                </div>
                                            </>
                                        ) : (
                                            <div class="stock-badge">
                                                <span class={`stock-dot ${product.stockStatus}`} />
                                                {product.totalStock} total
                                            </div>
                                        )}
                                    </div>
                                </td>
                                <td>
                                    <div class="status-badges">
                                        <span
                                            class={`badge ${product.active ? "active" : "inactive"}`}
                                        >
                                            {product.active
                                                ? "Activo"
                                                : "Inactivo"}
                                        </span>
                                        {product.is_offer && (
                                            <span class="badge offer">
                                                Oferta
                                            </span>
                                        )}
                                    </div>
                                </td>
                                <td>
                                    <div class="actions">
                                        <a
                                            href={`/admin/productos/${product.id}`}
                                            class="action-btn"
                                            title="Editar"
                                        >
                                            <svg
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                                                />
                                            </svg>
                                        </a>
                                        <form
                                            method="POST"
                                            style="display: inline;"
                                        >
                                            <input
                                                type="hidden"
                                                name="action"
                                                value="toggle_offer"
                                            />
                                            <input
                                                type="hidden"
                                                name="id"
                                                value={product.id}
                                            />
                                            <button
                                                type="submit"
                                                class="action-btn"
                                                title={
                                                    product.is_offer
                                                        ? "Quitar oferta"
                                                        : "Marcar como oferta"
                                                }
                                            >
                                                <svg
                                                    fill={
                                                        product.is_offer
                                                            ? "currentColor"
                                                            : "none"
                                                    }
                                                    stroke="currentColor"
                                                    viewBox="0 0 24 24"
                                                >
                                                    <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"
                                                    />
                                                </svg>
                                            </button>
                                        </form>
                                        <button
                                            class="action-btn danger delete-btn"
                                            data-id={product.id}
                                            data-name={product.name}
                                            title="Eliminar"
                                        >
                                            <svg
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                                                />
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        ))
                    ) : (
                        <tr>
                            <td colspan={6}>
                                <div class="empty-state">
                                    <div style="display: inline-flex; align-items: center; justify-content: center; width: 80px; height: 80px; background: rgba(6, 182, 212, 0.1); border-radius: 50%; margin-bottom: 20px;">
                                        <svg style="width: 40px; height: 40px; color: #06b6d4;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                                        </svg>
                                    </div>
                                    <p style="color: #f4f4f5; font-size: 18px; font-weight: 600; margin-bottom: 8px;">
                                        No hay productos en la base de datos
                                    </p>
                                    <p style="color: #a1a1aa; font-size: 14px; margin-bottom: 24px;">
                                        Puedes crear productos manualmente o ejecutar el seed de datos
                                    </p>
                                    <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
                                        <a href="/admin/productos/nuevo" style="display: inline-flex; align-items: center; gap: 8px; padding: 12px 24px; background: linear-gradient(135deg, #06b6d4, #8b5cf6); color: #fff; font-size: 14px; font-weight: 500; border-radius: 10px; text-decoration: none;">
                                            <svg style="width: 18px; height: 18px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                            </svg>
                                            Crear primer producto
                                        </a>
                                        <details style="display: inline-block;">
                                            <summary style="padding: 12px 24px; background: rgba(255, 255, 255, 0.05); color: #06b6d4; font-size: 14px; font-weight: 500; border-radius: 10px; cursor: pointer; list-style: none; border: 1px solid rgba(6, 182, 212, 0.3);">
                                                📦 Ejecutar seed de datos
                                            </summary>
                                            <div style="margin-top: 16px; padding: 16px; background: rgba(0, 0, 0, 0.3); border-radius: 10px; text-align: left; max-width: 600px; margin-left: auto; margin-right: auto;">
                                                <p style="color: #a1a1aa; font-size: 13px; margin-bottom: 12px;">
                                                    Ejecuta este script SQL en el SQL Editor de Supabase:
                                                </p>
                                                <code style="display: block; padding: 12px; background: #0a0a0f; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; color: #06b6d4; font-size: 12px; overflow-x: auto; white-space: nowrap;">
                                                    supabase/seed-products.sql
                                                </code>
                                                <p style="color: #71717a; font-size: 12px; margin-top: 12px;">
                                                    Esto creará 100 productos de ejemplo con imágenes
                                                </p>
                                            </div>
                                        </details>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    )
                }
                </tbody>
            </table>
        )}
    </div>

    <!-- Delete Modal -->
    <div id="delete-modal" class="modal-overlay">
        <div class="modal">
            <div class="modal-title">Eliminar Producto</div>
            <p class="modal-text">
                ¿Estás seguro de eliminar <strong id="product-name"></strong>?
                Esta acción no se puede deshacer.
            </p>
            <form method="POST">
                <input type="hidden" name="action" value="delete" />
                <input type="hidden" name="id" id="delete-id" />
                <div class="modal-actions">
                    <button
                        type="button"
                        id="cancel-delete"
                        class="modal-btn cancel">Cancelar</button
                    >
                    <button type="submit" class="modal-btn danger"
                        >Eliminar</button
                    >
                </div>
            </form>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const modal = document.getElementById("delete-modal");
            const productName = document.getElementById("product-name");
            const deleteId = document.getElementById(
                "delete-id",
            ) as HTMLInputElement;

            document.querySelectorAll(".delete-btn").forEach((btn) => {
                btn.addEventListener("click", () => {
                    const id = (btn as HTMLElement).dataset.id;
                    const name = (btn as HTMLElement).dataset.name;
                    if (id && name && productName && deleteId && modal) {
                        productName.textContent = name;
                        deleteId.value = id;
                        modal.classList.add("active");
                    }
                });
            });

            const closeModal = () => modal?.classList.remove("active");
            modal?.addEventListener("click", (e) => {
                if (e.target === modal) closeModal();
            });
            document
                .getElementById("cancel-delete")
                ?.addEventListener("click", closeModal);

            // Search functionality
            const searchInput = document.getElementById('product-search') as HTMLInputElement;
            const noResults = document.getElementById('no-results');
            const tableContainer = document.querySelector('.table-container') as HTMLElement;

            searchInput?.addEventListener('input', () => {
                const query = searchInput.value.toLowerCase().trim();
                const rows = document.querySelectorAll('.data-table tbody tr');
                let visible = 0;

                rows.forEach(row => {
                    const text = (row as HTMLElement).innerText.toLowerCase();
                    const match = !query || text.includes(query);
                    (row as HTMLElement).style.display = match ? '' : 'none';
                    if (match) visible++;
                });

                if (noResults) noResults.style.display = visible === 0 && query ? 'block' : 'none';
                if (tableContainer) tableContainer.style.display = visible === 0 && query ? 'none' : '';
            });
        });
    </script>
</AdminLayout>
