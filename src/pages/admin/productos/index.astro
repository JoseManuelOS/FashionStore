        {productsError ? (
            <div style="padding: 60px 20px; text-align: center;">
                <div style="display: inline-flex; align-items: center; justify-content: center; width: 64px; height: 64px; background: rgba(239, 68, 68, 0.1); border-radius: 50%; margin-bottom: 16px;">
                    <svg style="width: 32px; height: 32px; color: #ef4444;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
                <p style="color: #ef4444; font-size: 16px; font-weight: 600; margin-bottom: 8px;">Error al cargar productos</p>
                <p style="color: #71717a; font-size: 14px; margin-bottom: 20px;">{productsError.message}</p>
                <p style="color: #a1a1aa; font-size: 13px;">Verifica tu conexión a Supabase y que SUPABASE_SERVICE_ROLE_KEY esté configurada</p>
            </div>
        ) : (
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {
                        productsWithData.length > 0 ? (
                            productsWithData.map((product) => (
                            <tr>
                                <td>
                                    <div class="product-cell">
                                        <div class="product-image">
                                            {product.mainImage ? (
                                                <img
                                                    src={product.mainImage}
                                                    alt={product.name}
                                                />
                                            ) : (
                                                <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #a1a1aa; font-size: 10px;">
                                                    IMG
                                                </div>
                                            )}
                                        </div>
                                        <div>
                                            <div class="product-name">
                                                {product.name}
                                            </div>
                                            <div class="product-images-count">
                                                {product.images?.length || 0}{" "}
                                                imagen(es)
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="category-text">
                                        {product.category?.name || "—"}
                                    </span>
                                </td>
                                <td>
                                    <span class="price-text">
                                        {formatPrice(product.price)}
                                    </span>
                                </td>
                                <td>
                                    <div class="stock-cell">
                                        {Object.keys(product.stockBySize).length > 0 ? (
                                            <>
                                                {product.hasColors ? (
                                                    <>
                                                        {/* Clickable summary for color products */}
                                                        <div class="stock-summary" data-stock-toggle={product.id}>
                                                            <div class="stock-summary-left">
                                                                <div class="stock-badge">
                                                                    <span class={`stock-dot ${product.stockStatus}`} />
                                                                    {product.totalStock} uds
                                                                </div>
                                                                <div class="stock-meta">
                                                                    {product.colorCount} {product.colorCount === 1 ? 'color' : 'colores'} · {product.sizeCount} {product.sizeCount === 1 ? 'talla' : 'tallas'}
                                                                </div>
                                                            </div>
                                                            <svg class="stock-toggle" data-toggle-icon={product.id} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                                            </svg>
                                                        </div>

                                                        {/* Expandable color detail */}
                                                        <div class="stock-detail" data-stock-detail={product.id}>
                                                            {Object.entries(product.colorGroups)
                                                                .sort((a: [string, any], b: [string, any]) => b[1].total - a[1].total)
                                                                .map(([color, data]: [string, any]) => (
                                                                    <div class="color-group">
                                                                        <div class="color-group-header">
                                                                            <span class="color-swatch" style={`background: ${getColorHex(color)}`} />
                                                                            <span class="color-group-name">{color}</span>
                                                                            <span class="color-group-total">{data.total} uds</span>
                                                                        </div>
                                                                        <div class="stock-sizes-grid">
                                                                            {product.sortedSizes.map((size: string) => {
                                                                                const qty = data.sizes[size] ?? 0;
                                                                                return (
                                                                                    <span class={`size-pill ${stockCls(qty)}`}>
                                                                                        <span class="sz">{size}</span>
                                                                                        <span class="sq">{qty}</span>
                                                                                    </span>
                                                                                );
                                                                            })}
                                                                        </div>
                                                                    </div>
                                                                ))}
                                                        </div>
                                                    </>
                                                ) : (
                                                    <>
                                                        {/* Non-color: bigger inline chips */}
                                                        <div class="stock-sizes-inline">
                                                            {Object.entries(product.stockBySize)
                                                                .sort((a: [string, unknown], b: [string, unknown]) => sortSizes(a[0], b[0]))
                                                                .map(([size, stock]: [string, any]) => (
                                                                    <span class={`size-chip ${stockCls(stock)}`}>
                                                                        <span class="sc-label">{size}</span>
                                                                        <span class="sc-qty">{stock}</span>
                                                                    </span>
                                                                ))}
                                                        </div>
                                                        <div class="stock-badge">
                                                            <span class={`stock-dot ${product.stockStatus}`} />
                                                            {product.totalStock} total
                                                        </div>
                                                    </>
                                                )}
                                            </>
                                        ) : (
                                            <div class="stock-badge">
                                                <span class={`stock-dot ${product.stockStatus}`} />
                                                {product.totalStock} total
                                            </div>
                                        )}
                                    </div>
                                </td>
                                <td>
                                    <div class="status-badges">
                                        <span
                                            class={`badge ${product.active ? "active" : "inactive"}`}
                                        >
                                            {product.active
                                                ? "Activo"
                                                : "Inactivo"}
                                        </span>
                                        {product.is_offer && (
                                            <span class="badge offer">
                                                Oferta
                                            </span>
                                        )}
                                    </div>
                                </td>
                                <td>
                                    <div class="actions">
                                        <a
                                            href={`/admin/productos/${product.id}`}
                                            class="action-btn"
                                            title="Editar"
                                        >
                                            <svg
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                                                />
                                            </svg>
                                        </a>
                                        <form
                                            method="POST"
                                            style="display: inline;"
                                        >
                                            <input
                                                type="hidden"
                                                name="action"
                                                value="toggle_offer"
                                            />
                                            <input
                                                type="hidden"
                                                name="id"
                                                value={product.id}
                                            />
                                            <button
                                                type="submit"
                                                class="action-btn"
                                                title={
                                                    product.is_offer
                                                        ? "Quitar oferta"
                                                        : "Marcar como oferta"
                                                }
                                            >
                                                <svg
                                                    fill={
                                                        product.is_offer
                                                            ? "currentColor"
                                                            : "none"
                                                    }
                                                    stroke="currentColor"
                                                    viewBox="0 0 24 24"
                                                >
                                                    <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"
                                                    />
                                                </svg>
                                            </button>
                                        </form>
                                        <button
                                            class="action-btn danger delete-btn"
                                            data-id={product.id}
                                            data-name={product.name}
                                            title="Eliminar"
                                        >
                                            <svg
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                                                />
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        ))
                    ) : (
                        <tr>
                            <td colspan={6}>
                                <div class="empty-state">
                                    <div style="display: inline-flex; align-items: center; justify-content: center; width: 80px; height: 80px; background: rgba(6, 182, 212, 0.1); border-radius: 50%; margin-bottom: 20px;">
                                        <svg style="width: 40px; height: 40px; color: #06b6d4;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                                        </svg>
                                    </div>
                                    <p style="color: #f4f4f5; font-size: 18px; font-weight: 600; margin-bottom: 8px;">
                                        No hay productos en la base de datos
                                    </p>
                                    <p style="color: #a1a1aa; font-size: 14px; margin-bottom: 24px;">
                                        Puedes crear productos manualmente o ejecutar el seed de datos
                                    </p>
                                    <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
                                        <a href="/admin/productos/nuevo" style="display: inline-flex; align-items: center; gap: 8px; padding: 12px 24px; background: linear-gradient(135deg, #06b6d4, #8b5cf6); color: #fff; font-size: 14px; font-weight: 500; border-radius: 10px; text-decoration: none;">
                                            <svg style="width: 18px; height: 18px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                            </svg>
                                            Crear primer producto
                                        </a>
                                        <details style="display: inline-block;">
                                            <summary style="padding: 12px 24px; background: rgba(255, 255, 255, 0.05); color: #06b6d4; font-size: 14px; font-weight: 500; border-radius: 10px; cursor: pointer; list-style: none; border: 1px solid rgba(6, 182, 212, 0.3);">
                                                📦 Ejecutar seed de datos
                                            </summary>
                                            <div style="margin-top: 16px; padding: 16px; background: rgba(0, 0, 0, 0.3); border-radius: 10px; text-align: left; max-width: 600px; margin-left: auto; margin-right: auto;">
                                                <p style="color: #a1a1aa; font-size: 13px; margin-bottom: 12px;">
                                                    Ejecuta este script SQL en el SQL Editor de Supabase:
                                                </p>
                                                <code style="display: block; padding: 12px; background: #0a0a0f; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; color: #06b6d4; font-size: 12px; overflow-x: auto; white-space: nowrap;">
                                                    supabase/seed-products.sql
                                                </code>
                                                <p style="color: #71717a; font-size: 12px; margin-top: 12px;">
                                                    Esto creará 100 productos de ejemplo con imágenes
                                                </p>
                                            </div>
                                        </details>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    )
                }
                </tbody>
            </table>
        )}
    </div>

    <!-- Delete Modal -->
    <div id="delete-modal" class="modal-overlay">
        <div class="modal">
            <div class="modal-title">Ocultar Producto</div>
            <p class="modal-text">
                ¿Estás seguro de ocultar <strong id="product-name"></strong>?
                El producto dejará de ser visible en la tienda pero se mantendrá en la base de datos.
                Puedes reactivarlo editándolo y marcándolo como activo.
            </p>
            <form method="POST">
                <input type="hidden" name="action" value="delete" />
                <input type="hidden" name="id" id="delete-id" />
                <div class="modal-actions">
                    <button
                        type="button"
                        id="cancel-delete"
                        class="modal-btn cancel">Cancelar</button
                    >
                    <button type="submit" class="modal-btn danger"
                        >Ocultar</button
                    >
                </div>
            </form>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const modal = document.getElementById("delete-modal");
            const productName = document.getElementById("product-name");
            const deleteId = document.getElementById(
                "delete-id",
            ) as HTMLInputElement;

            document.querySelectorAll(".delete-btn").forEach((btn) => {
                btn.addEventListener("click", () => {
                    const id = (btn as HTMLElement).dataset.id;
                    const name = (btn as HTMLElement).dataset.name;
                    if (id && name && productName && deleteId && modal) {
                        productName.textContent = name;
                        deleteId.value = id;
                        modal.classList.add("active");
                    }
                });
            });

            const closeModal = () => modal?.classList.remove("active");
            modal?.addEventListener("click", (e) => {
                if (e.target === modal) closeModal();
            });
            document
                .getElementById("cancel-delete")
                ?.addEventListener("click", closeModal);

            // Search functionality
            const searchInput = document.getElementById('product-search') as HTMLInputElement;
            const noResults = document.getElementById('no-results');
            const tableContainer = document.querySelector('.table-container') as HTMLElement;

            searchInput?.addEventListener('input', () => {
                const query = searchInput.value.toLowerCase().trim();
                const rows = document.querySelectorAll('.data-table tbody tr');
                let visible = 0;

                rows.forEach(row => {
                    const text = (row as HTMLElement).innerText.toLowerCase();
                    const match = !query || text.includes(query);
                    (row as HTMLElement).style.display = match ? '' : 'none';
                    if (match) visible++;
                });

                if (noResults) noResults.style.display = visible === 0 && query ? 'block' : 'none';
                if (tableContainer) tableContainer.style.display = visible === 0 && query ? 'none' : '';
            });

            // Stock detail toggle for color products
            document.querySelectorAll('[data-stock-toggle]').forEach(summary => {
                summary.addEventListener('click', () => {
                    const id = (summary as HTMLElement).dataset.stockToggle;
                    const detail = document.querySelector(`[data-stock-detail="${id}"]`);
                    const icon = document.querySelector(`[data-toggle-icon="${id}"]`);
                    detail?.classList.toggle('open');
                    icon?.classList.toggle('open');
                });
            });
        });
    </script>
</AdminLayout>
