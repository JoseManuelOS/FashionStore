---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { supabaseAdmin, formatPrice } from "../../../lib/supabase";

export const prerender = false;

const { data: products } = await supabaseAdmin
    .from("products")
    .select(
        `
    *,
    category:categories(name, slug),
    images:product_images(id, image_url, order)
  `,
    )
    .order("created_at", { ascending: false });

if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const action = formData.get("action");
    const id = formData.get("id") as string;

    if (action === "delete" && id) {
        await supabaseAdmin
            .from("product_images")
            .delete()
            .eq("product_id", id);
        await supabaseAdmin.from("products").delete().eq("id", id);
        return Astro.redirect("/admin/productos?deleted=true");
    }

    if (action === "toggle_offer" && id) {
        const currentProduct = products?.find((p) => p.id === id);
        if (currentProduct) {
            await supabaseAdmin
                .from("products")
                .update({ is_offer: !currentProduct.is_offer })
                .eq("id", id);
            return Astro.redirect("/admin/productos");
        }
    }
}

const urlParams = Astro.url.searchParams;
const showNotification =
    urlParams.get("deleted") ||
    urlParams.get("created") ||
    urlParams.get("updated");
const notificationMessage = urlParams.get("deleted")
    ? "Producto eliminado"
    : urlParams.get("created")
      ? "Producto creado"
      : urlParams.get("updated")
        ? "Producto actualizado"
        : "";

// Función helper para obtener el estado del stock
function getStockStatus(stock: number): string {
    if (stock === 0) return "red";
    if (stock <= 5) return "yellow";
    return "green";
}

// Preparar productos con datos pre-calculados
const productsWithData =
    products?.map((product) => ({
        ...product,
        mainImage: product.images?.sort(
            (a: any, b: any) => a.order - b.order,
        )[0]?.image_url,
        stockStatus: getStockStatus(product.stock),
    })) || [];
---

<AdminLayout title="Productos">
    <style>
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }

        .page-subtitle {
            font-size: 14px;
            color: #71717a;
            margin-top: 4px;
        }

        .btn-primary {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            background: linear-gradient(135deg, #06b6d4, #8b5cf6);
            color: #fff;
            font-size: 14px;
            font-weight: 500;
            border-radius: 10px;
            text-decoration: none;
            transition: all 0.3s;
            border: none;
        }

        .btn-primary:hover {
            box-shadow: 0 0 25px rgba(6, 182, 212, 0.4);
            transform: translateY(-1px);
        }

        .btn-primary svg {
            width: 18px;
            height: 18px;
        }

        .notification {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 12px 16px;
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid rgba(16, 185, 129, 0.3);
            border-radius: 10px;
            color: #10b981;
            font-size: 14px;
            margin-bottom: 24px;
        }

        .table-container {
            background: #12121a;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            overflow: hidden;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
        }

        .data-table th {
            text-align: left;
            padding: 12px 20px;
            font-size: 12px;
            font-weight: 500;
            color: #71717a;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            background: #0d0d14;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .data-table td {
            padding: 16px 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            vertical-align: middle;
        }

        .data-table tr:last-child td {
            border-bottom: none;
        }

        .data-table tr:hover td {
            background: rgba(6, 182, 212, 0.05);
        }

        .product-cell {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .product-image {
            width: 48px;
            height: 56px;
            border-radius: 8px;
            background: #1f1f28;
            overflow: hidden;
            flex-shrink: 0;
        }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .product-name {
            font-size: 14px;
            font-weight: 500;
            color: #f4f4f5;
        }

        .product-images-count {
            font-size: 12px;
            color: #71717a;
        }

        .category-text {
            font-size: 14px;
            color: #a1a1aa;
        }

        .price-text {
            font-size: 14px;
            font-weight: 600;
            color: #06b6d4;
        }

        .stock-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            color: #a1a1aa;
        }

        .stock-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }

        .stock-dot.green {
            background: #22c55e;
            box-shadow: 0 0 8px rgba(34, 197, 94, 0.5);
        }
        .stock-dot.yellow {
            background: #f59e0b;
            box-shadow: 0 0 8px rgba(245, 158, 11, 0.5);
        }
        .stock-dot.red {
            background: #ef4444;
            box-shadow: 0 0 8px rgba(239, 68, 68, 0.5);
        }

        .status-badges {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }

        .badge {
            display: inline-flex;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 500;
        }

        .badge.active {
            background: rgba(16, 185, 129, 0.15);
            color: #10b981;
        }

        .badge.inactive {
            background: rgba(255, 255, 255, 0.08);
            color: #71717a;
        }

        .badge.offer {
            background: rgba(239, 68, 68, 0.15);
            color: #f87171;
        }

        .actions {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .action-btn {
            padding: 8px;
            border-radius: 8px;
            border: none;
            background: none;
            color: #71717a;
            cursor: pointer;
            transition: all 0.2s;
        }

        .action-btn:hover {
            background: rgba(6, 182, 212, 0.1);
            color: #06b6d4;
        }

        .action-btn.danger:hover {
            background: rgba(239, 68, 68, 0.1);
            color: #ef4444;
        }

        .action-btn svg {
            width: 16px;
            height: 16px;
        }

        .empty-state {
            padding: 60px 20px;
            text-align: center;
        }

        .empty-state p {
            color: #71717a;
            font-size: 14px;
        }

        .empty-state a {
            color: #06b6d4;
            font-weight: 500;
        }

        /* Modal */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(4px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            z-index: 50;
            opacity: 0;
            visibility: hidden;
            transition: all 0.2s;
        }

        .modal-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .modal {
            background: #12121a;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 24px;
            max-width: 400px;
            width: 100%;
        }

        .modal-title {
            font-size: 16px;
            font-weight: 600;
            color: #f4f4f5;
            margin-bottom: 8px;
        }

        .modal-text {
            font-size: 14px;
            color: #a1a1aa;
            margin-bottom: 24px;
        }

        .modal-actions {
            display: flex;
            gap: 12px;
        }

        .modal-btn {
            flex: 1;
            padding: 10px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
        }

        .modal-btn.cancel {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #a1a1aa;
        }

        .modal-btn.cancel:hover {
            background: rgba(255, 255, 255, 0.1);
            color: #f4f4f5;
        }

        .modal-btn.danger {
            background: #dc2626;
            border: none;
            color: #fff;
        }

        .modal-btn.danger:hover {
            background: #b91c1c;
            box-shadow: 0 0 20px rgba(220, 38, 38, 0.4);
        }

        .search-bar {
            position: relative;
            margin-bottom: 24px;
        }

        .search-bar svg {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            width: 20px;
            height: 20px;
            color: #71717a;
        }

        .search-input {
            width: 100%;
            padding: 12px 12px 12px 40px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            font-size: 14px;
            color: #f4f4f5;
            background: #12121a;
            transition: all 0.2s;
        }

        .search-input:focus {
            outline: none;
            border-color: #06b6d4;
            box-shadow: 0 0 20px rgba(6, 182, 212, 0.15);
        }

        .search-input::placeholder {
            color: #52525b;
        }
    </style>

    {
        showNotification && (
            <div class="notification">
                <svg
                    width="16"
                    height="16"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M5 13l4 4L19 7"
                    />
                </svg>
                {notificationMessage}
            </div>
        )
    }

    <div class="page-header">
        <div>
            <div class="page-subtitle">
                {products?.length || 0} productos registrados
            </div>
        </div>
        <a href="/admin/productos/nuevo" class="btn-primary">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 4v16m8-8H4"></path>
            </svg>
            Nuevo Producto
        </a>
    </div>

    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Categoría</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                {
                    productsWithData.length > 0 ? (
                        productsWithData.map((product) => (
                            <tr>
                                <td>
                                    <div class="product-cell">
                                        <div class="product-image">
                                            {product.mainImage ? (
                                                <img
                                                    src={product.mainImage}
                                                    alt={product.name}
                                                />
                                            ) : (
                                                <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #a1a1aa; font-size: 10px;">
                                                    IMG
                                                </div>
                                            )}
                                        </div>
                                        <div>
                                            <div class="product-name">
                                                {product.name}
                                            </div>
                                            <div class="product-images-count">
                                                {product.images?.length || 0}{" "}
                                                imagen(es)
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="category-text">
                                        {product.category?.name || "—"}
                                    </span>
                                </td>
                                <td>
                                    <span class="price-text">
                                        {formatPrice(product.price)}
                                    </span>
                                </td>
                                <td>
                                    <span class="stock-badge">
                                        <span
                                            class={`stock-dot ${product.stockStatus}`}
                                        />
                                        {product.stock}
                                    </span>
                                </td>
                                <td>
                                    <div class="status-badges">
                                        <span
                                            class={`badge ${product.active ? "active" : "inactive"}`}
                                        >
                                            {product.active
                                                ? "Activo"
                                                : "Inactivo"}
                                        </span>
                                        {product.is_offer && (
                                            <span class="badge offer">
                                                Oferta
                                            </span>
                                        )}
                                    </div>
                                </td>
                                <td>
                                    <div class="actions">
                                        <a
                                            href={`/admin/productos/${product.id}`}
                                            class="action-btn"
                                            title="Editar"
                                        >
                                            <svg
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                                                />
                                            </svg>
                                        </a>
                                        <form
                                            method="POST"
                                            style="display: inline;"
                                        >
                                            <input
                                                type="hidden"
                                                name="action"
                                                value="toggle_offer"
                                            />
                                            <input
                                                type="hidden"
                                                name="id"
                                                value={product.id}
                                            />
                                            <button
                                                type="submit"
                                                class="action-btn"
                                                title={
                                                    product.is_offer
                                                        ? "Quitar oferta"
                                                        : "Marcar como oferta"
                                                }
                                            >
                                                <svg
                                                    fill={
                                                        product.is_offer
                                                            ? "currentColor"
                                                            : "none"
                                                    }
                                                    stroke="currentColor"
                                                    viewBox="0 0 24 24"
                                                >
                                                    <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"
                                                    />
                                                </svg>
                                            </button>
                                        </form>
                                        <button
                                            class="action-btn danger delete-btn"
                                            data-id={product.id}
                                            data-name={product.name}
                                            title="Eliminar"
                                        >
                                            <svg
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                                                />
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        ))
                    ) : (
                        <tr>
                            <td colspan={6}>
                                <div class="empty-state">
                                    <p>
                                        No hay productos.{" "}
                                        <a href="/admin/productos/nuevo">
                                            Crea el primero →
                                        </a>
                                    </p>
                                </div>
                            </td>
                        </tr>
                    )
                }
            </tbody>
        </table>
    </div>

    <!-- Delete Modal -->
    <div id="delete-modal" class="modal-overlay">
        <div class="modal">
            <div class="modal-title">Eliminar Producto</div>
            <p class="modal-text">
                ¿Estás seguro de eliminar <strong id="product-name"></strong>?
                Esta acción no se puede deshacer.
            </p>
            <form method="POST">
                <input type="hidden" name="action" value="delete" />
                <input type="hidden" name="id" id="delete-id" />
                <div class="modal-actions">
                    <button
                        type="button"
                        id="cancel-delete"
                        class="modal-btn cancel">Cancelar</button
                    >
                    <button type="submit" class="modal-btn danger"
                        >Eliminar</button
                    >
                </div>
            </form>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const modal = document.getElementById("delete-modal");
            const productName = document.getElementById("product-name");
            const deleteId = document.getElementById(
                "delete-id",
            ) as HTMLInputElement;

            document.querySelectorAll(".delete-btn").forEach((btn) => {
                btn.addEventListener("click", () => {
                    const id = (btn as HTMLElement).dataset.id;
                    const name = (btn as HTMLElement).dataset.name;
                    if (id && name && productName && deleteId && modal) {
                        productName.textContent = name;
                        deleteId.value = id;
                        modal.classList.add("active");
                    }
                });
            });

            const closeModal = () => modal?.classList.remove("active");
            modal?.addEventListener("click", (e) => {
                if (e.target === modal) closeModal();
            });
            document
                .getElementById("cancel-delete")
                ?.addEventListener("click", closeModal);
        });
    </script>
</AdminLayout>
