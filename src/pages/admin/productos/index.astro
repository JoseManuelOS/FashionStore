---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { supabaseAdmin, formatPrice } from '../../../lib/supabase';

// SSR - Protected
export const prerender = false;

// Fetch products with images
const { data: products } = await supabaseAdmin
  .from('products')
  .select(`
    *,
    category:categories(name, slug),
    images:product_images(id, image_url, order)
  `)
  .order('created_at', { ascending: false });

// Handle delete
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action');
  const id = formData.get('id') as string;

  if (action === 'delete' && id) {
    // Delete product images first
    await supabaseAdmin.from('product_images').delete().eq('product_id', id);
    // Delete product
    await supabaseAdmin.from('products').delete().eq('id', id);
    return Astro.redirect('/admin/productos?deleted=true');
  }

  if (action === 'toggle_offer' && id) {
    const currentProduct = products?.find(p => p.id === id);
    if (currentProduct) {
      await supabaseAdmin
        .from('products')
        .update({ is_offer: !currentProduct.is_offer })
        .eq('id', id);
      return Astro.redirect('/admin/productos');
    }
  }
}

const urlParams = Astro.url.searchParams;
const deleted = urlParams.get('deleted');
const created = urlParams.get('created');
const updated = urlParams.get('updated');
---

<AdminLayout title="Gestión de Productos">
  <!-- Success messages -->
  {deleted && (
    <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg text-green-700">
      ✓ Producto eliminado correctamente
    </div>
  )}
  {created && (
    <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg text-green-700">
      ✓ Producto creado correctamente
    </div>
  )}
  {updated && (
    <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg text-green-700">
      ✓ Producto actualizado correctamente
    </div>
  )}

  <!-- Header -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-serif text-brand-navy-500">Productos</h1>
      <p class="text-brand-charcoal-500 text-sm mt-1">
        {products?.length || 0} productos registrados
      </p>
    </div>
    <a 
      href="/admin/productos/nuevo"
      class="inline-flex items-center gap-2 px-4 py-2 bg-brand-navy-500 text-white rounded-lg hover:bg-brand-navy-600 transition-colors"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      Nuevo Producto
    </a>
  </div>

  <!-- Products Table -->
  <div class="bg-white rounded-xl shadow-elegant overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-cream-100 text-left">
          <tr>
            <th class="px-6 py-4 text-xs font-medium text-brand-charcoal-500 uppercase tracking-wide">
              Producto
            </th>
            <th class="px-6 py-4 text-xs font-medium text-brand-charcoal-500 uppercase tracking-wide">
              Categoría
            </th>
            <th class="px-6 py-4 text-xs font-medium text-brand-charcoal-500 uppercase tracking-wide">
              Precio
            </th>
            <th class="px-6 py-4 text-xs font-medium text-brand-charcoal-500 uppercase tracking-wide">
              Stock
            </th>
            <th class="px-6 py-4 text-xs font-medium text-brand-charcoal-500 uppercase tracking-wide">
              Estado
            </th>
            <th class="px-6 py-4 text-xs font-medium text-brand-charcoal-500 uppercase tracking-wide">
              Acciones
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-brand-charcoal-100">
          {products && products.length > 0 ? (
            products.map((product) => {
              const mainImage = product.images?.sort((a: any, b: any) => a.order - b.order)[0]?.image_url;
              return (
                <tr class="hover:bg-cream-50">
                  <td class="px-6 py-4">
                    <div class="flex items-center gap-3">
                      <div class="w-12 h-14 bg-cream-200 rounded overflow-hidden flex-shrink-0">
                        {mainImage ? (
                          <img 
                            src={mainImage} 
                            alt={product.name}
                            class="w-full h-full object-cover"
                          />
                        ) : (
                          <div class="w-full h-full flex items-center justify-center text-brand-charcoal-300 text-xs">
                            Sin img
                          </div>
                        )}
                      </div>
                      <div>
                        <p class="font-medium text-brand-charcoal-700">{product.name}</p>
                        <p class="text-xs text-brand-charcoal-400">{product.images?.length || 0} imagen(es)</p>
                      </div>
                    </div>
                  </td>
                  <td class="px-6 py-4 text-brand-charcoal-600">
                    {product.category?.name || '—'}
                  </td>
                  <td class="px-6 py-4 font-serif text-brand-navy-500">
                    {formatPrice(product.price)}
                  </td>
                  <td class="px-6 py-4">
                    <span class={`inline-flex items-center gap-1 ${
                      product.stock === 0 ? 'text-red-600' : 
                      product.stock <= 5 ? 'text-amber-600' : 'text-green-600'
                    }`}>
                      <span class={`w-2 h-2 rounded-full ${
                        product.stock === 0 ? 'bg-red-500' : 
                        product.stock <= 5 ? 'bg-amber-500' : 'bg-green-500'
                      }`}></span>
                      {product.stock}
                    </span>
                  </td>
                  <td class="px-6 py-4">
                    <div class="flex flex-wrap gap-1">
                      {product.active ? (
                        <span class="px-2 py-1 bg-green-100 text-green-700 text-xs rounded">Activo</span>
                      ) : (
                        <span class="px-2 py-1 bg-gray-100 text-gray-600 text-xs rounded">Inactivo</span>
                      )}
                      {product.is_offer && (
                        <span class="px-2 py-1 bg-red-100 text-red-600 text-xs rounded">🔥 Oferta</span>
                      )}
                    </div>
                  </td>
                  <td class="px-6 py-4">
                    <div class="flex items-center gap-2">
                      <a 
                        href={`/admin/productos/${product.id}`}
                        class="p-2 text-brand-charcoal-400 hover:text-brand-navy-500 hover:bg-brand-navy-50 rounded transition-colors"
                        title="Editar"
                      >
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                        </svg>
                      </a>
                      
                      <!-- Toggle Offer -->
                      <form method="POST" class="inline">
                        <input type="hidden" name="action" value="toggle_offer" />
                        <input type="hidden" name="id" value={product.id} />
                        <button
                          type="submit"
                          class={`p-2 rounded transition-colors ${
                            product.is_offer 
                              ? 'text-red-500 hover:bg-red-50' 
                              : 'text-brand-charcoal-400 hover:text-orange-500 hover:bg-orange-50'
                          }`}
                          title={product.is_offer ? 'Quitar de ofertas' : 'Añadir a ofertas'}
                        >
                          <svg class="w-4 h-4" fill={product.is_offer ? 'currentColor' : 'none'} stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" />
                          </svg>
                        </button>
                      </form>

                      <!-- Delete -->
                      <button
                        class="p-2 text-brand-charcoal-400 hover:text-red-500 hover:bg-red-50 rounded transition-colors delete-btn"
                        data-id={product.id}
                        data-name={product.name}
                        title="Eliminar"
                      >
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                      </button>
                    </div>
                  </td>
                </tr>
              );
            })
          ) : (
            <tr>
              <td colspan="6" class="px-6 py-12 text-center text-brand-charcoal-400">
                No hay productos. <a href="/admin/productos/nuevo" class="text-brand-navy-500 hover:underline">Crea el primero</a>
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Delete Modal -->
  <div id="delete-modal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/50" id="modal-backdrop"></div>
    <div class="absolute inset-0 flex items-center justify-center p-4">
      <div class="bg-white rounded-xl p-6 max-w-md w-full shadow-2xl">
        <h3 class="text-lg font-serif text-brand-navy-500 mb-2">Eliminar Producto</h3>
        <p class="text-brand-charcoal-600 mb-6">
          ¿Estás seguro de eliminar <strong id="product-name"></strong>? Esta acción no se puede deshacer.
        </p>
        <form method="POST" class="flex gap-3">
          <input type="hidden" name="action" value="delete" />
          <input type="hidden" name="id" id="delete-id" />
          <button
            type="button"
            id="cancel-delete"
            class="flex-1 px-4 py-2 border border-brand-charcoal-200 text-brand-charcoal-600 rounded-lg hover:bg-cream-100"
          >
            Cancelar
          </button>
          <button
            type="submit"
            class="flex-1 px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600"
          >
            Eliminar
          </button>
        </form>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const modal = document.getElementById('delete-modal');
      const backdrop = document.getElementById('modal-backdrop');
      const cancelBtn = document.getElementById('cancel-delete');
      const productName = document.getElementById('product-name');
      const deleteId = document.getElementById('delete-id') as HTMLInputElement;

      document.querySelectorAll('.delete-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = (btn as HTMLElement).dataset.id;
          const name = (btn as HTMLElement).dataset.name;
          if (id && name && productName && deleteId && modal) {
            productName.textContent = name;
            deleteId.value = id;
            modal.classList.remove('hidden');
          }
        });
      });

      const closeModal = () => modal?.classList.add('hidden');
      backdrop?.addEventListener('click', closeModal);
      cancelBtn?.addEventListener('click', closeModal);
    });
  </script>
</AdminLayout>
