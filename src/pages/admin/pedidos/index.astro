---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getOrders, getOrdersStats, formatPrice } from "../../../lib/supabase";

const orders = await getOrders();
const stats = await getOrdersStats();

const statusLabels: Record<
    string,
    { label: string; color: string; bg: string }
> = {
    pending: {
        label: "Pendiente",
        color: "text-amber-400",
        bg: "bg-amber-500/10 border-amber-500/30",
    },
    paid: {
        label: "Pagado",
        color: "text-blue-400",
        bg: "bg-blue-500/10 border-blue-500/30",
    },
    shipped: {
        label: "Enviado",
        color: "text-purple-400",
        bg: "bg-purple-500/10 border-purple-500/30",
    },
    delivered: {
        label: "Entregado",
        color: "text-emerald-400",
        bg: "bg-emerald-500/10 border-emerald-500/30",
    },
    cancelled: {
        label: "Cancelado",
        color: "text-red-400",
        bg: "bg-red-500/10 border-red-500/30",
    },
    return_requested: {
        label: "Devolución Solicitada",
        color: "text-orange-400",
        bg: "bg-orange-500/10 border-orange-500/30",
    },
    returned: {
        label: "Devuelto",
        color: "text-pink-400",
        bg: "bg-pink-500/10 border-pink-500/30",
    },
};

function formatDate(dateStr: string) {
    return new Date(dateStr).toLocaleDateString("es-ES", {
        day: "2-digit",
        month: "short",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
    });
}
---

<AdminLayout title="Gestión de Pedidos">
    <!-- Stats Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-4 mb-8">
        <div class="bg-dark-400 rounded-xl border border-white/10 p-4">
            <div class="text-2xl font-bold text-zinc-100">{stats.total}</div>
            <div class="text-sm text-zinc-500">Total Pedidos</div>
        </div>
        <div class="bg-dark-400 rounded-xl border border-amber-500/30 p-4">
            <div class="text-2xl font-bold text-amber-400">{stats.pending}</div>
            <div class="text-sm text-amber-400/70">Pendientes</div>
        </div>
        <div class="bg-dark-400 rounded-xl border border-blue-500/30 p-4">
            <div class="text-2xl font-bold text-blue-400">{stats.paid}</div>
            <div class="text-sm text-blue-400/70">Pagados</div>
        </div>
        <div class="bg-dark-400 rounded-xl border border-purple-500/30 p-4">
            <div class="text-2xl font-bold text-purple-400">
                {stats.shipped}
            </div>
            <div class="text-sm text-purple-400/70">Enviados</div>
        </div>
        <div class="bg-dark-400 rounded-xl border border-emerald-500/30 p-4">
            <div class="text-2xl font-bold text-emerald-400">
                {stats.delivered}
            </div>
            <div class="text-sm text-emerald-400/70">Entregados</div>
        </div>
        <div class="bg-dark-400 rounded-xl border border-orange-500/30 p-4">
            <div class="text-2xl font-bold text-orange-400">
                {stats.return_requested}
            </div>
            <div class="text-sm text-orange-400/70">Devoluciones</div>
        </div>
        <div class="bg-gradient-to-br from-neon-cyan/20 to-neon-purple/20 rounded-xl border border-neon-cyan/30 p-4">
            <div class="text-2xl font-bold text-neon-cyan">
                {formatPrice(stats.totalRevenue)}
            </div>
            <div class="text-sm text-zinc-400">Ingresos</div>
        </div>
    </div>

    <!-- Search Bar -->
    <div class="relative mb-6">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input type="text" id="order-search" class="w-full pl-10 pr-4 py-3 bg-dark-400 border border-white/10 rounded-xl text-zinc-100 text-sm placeholder-zinc-600 focus:outline-none focus:border-neon-cyan focus:shadow-[0_0_20px_rgba(6,182,212,0.15)] transition-all" placeholder="Buscar por nº pedido, cliente, email o estado..." />
    </div>
    <div id="no-results" class="hidden text-center py-10 text-zinc-500 text-sm">No se encontraron pedidos</div>

    <!-- Orders List -->
    <div id="orders-table" class="bg-dark-400 rounded-2xl border border-white/10 overflow-hidden">
        <div class="p-6 border-b border-white/10">
            <h2 class="text-lg font-semibold text-zinc-100">
                Todos los Pedidos
            </h2>
            <p class="text-sm text-zinc-500 mt-1">
                Gestiona y actualiza el estado de los pedidos
            </p>
        </div>

        {
            orders.length === 0 ? (
                <div class="p-12 text-center">
                    <div class="w-16 h-16 bg-dark-300 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg
                            class="w-8 h-8 text-zinc-600"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"
                            />
                        </svg>
                    </div>
                    <p class="text-zinc-500">No hay pedidos todavía</p>
                </div>
            ) : (
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-dark-300 border-b border-white/10">
                            <tr>
                                <th class="px-6 py-3 text-left">
                                    <button data-sort="order" class="sort-btn inline-flex items-center gap-1 text-xs font-semibold text-zinc-500 uppercase tracking-wider hover:text-neon-cyan transition-colors">
                                        Pedido <span class="sort-icon text-zinc-600">↕</span>
                                    </button>
                                </th>
                                <th class="px-6 py-3 text-left">
                                    <button data-sort="customer" class="sort-btn inline-flex items-center gap-1 text-xs font-semibold text-zinc-500 uppercase tracking-wider hover:text-neon-cyan transition-colors">
                                        Cliente <span class="sort-icon text-zinc-600">↕</span>
                                    </button>
                                </th>
                                <th class="text-left px-6 py-3 text-xs font-semibold text-zinc-500 uppercase tracking-wider">
                                    Productos
                                </th>
                                <th class="px-6 py-3 text-left">
                                    <button data-sort="total" class="sort-btn inline-flex items-center gap-1 text-xs font-semibold text-zinc-500 uppercase tracking-wider hover:text-neon-cyan transition-colors">
                                        Total <span class="sort-icon text-zinc-600">↕</span>
                                    </button>
                                </th>
                                <th class="px-6 py-3 text-left">
                                    <button data-sort="status" class="sort-btn inline-flex items-center gap-1 text-xs font-semibold text-zinc-500 uppercase tracking-wider hover:text-neon-cyan transition-colors">
                                        Estado <span class="sort-icon text-zinc-600">↕</span>
                                    </button>
                                </th>
                                <th class="px-6 py-3 text-left">
                                    <button data-sort="date" class="sort-btn inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wider hover:text-neon-cyan transition-colors text-neon-cyan">
                                        Fecha <span class="sort-icon">↓</span>
                                    </button>
                                </th>
                                <th class="text-right px-6 py-3 text-xs font-semibold text-zinc-500 uppercase tracking-wider">
                                    Acciones
                                </th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5">
                            {orders.map((order) => {
                                const status =
                                    statusLabels[order.status] ||
                                    statusLabels.pending;
                                return (
                                    <tr
                                    class="order-row hover:bg-white/5 transition-colors"
                                    data-order={order.order_number ?? 0}
                                    data-customer={(order.customer_name || '').toLowerCase()}
                                    data-total={order.total_price}
                                    data-status={order.status}
                                    data-date={order.created_at}
                                >
                                        <td class="px-6 py-4">
                                            <span class="font-mono text-sm text-zinc-100">
                                                #
                                                {order.order_number
                                                    ? order.order_number
                                                    : order.id.slice(0, 8)}
                                            </span>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="text-sm font-medium text-zinc-100">
                                                {order.customer_name ||
                                                    "Invitado"}
                                            </div>
                                            <div class="text-xs text-zinc-500">
                                                {order.customer_email || "-"}
                                            </div>
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="text-sm text-zinc-400">
                                                {order.items?.length || 0}{" "}
                                                productos
                                            </span>
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="font-semibold text-neon-cyan">
                                                {formatPrice(order.total_price)}
                                            </span>
                                        </td>
                                        <td class="px-6 py-4">
                                            <span
                                                class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium border whitespace-nowrap ${status.bg} ${status.color}`}
                                            >
                                                <span class="w-1.5 h-1.5 rounded-full bg-current shrink-0 opacity-80"></span>
                                                {status.label}
                                            </span>
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="text-sm text-zinc-500">
                                                {formatDate(order.created_at)}
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 text-right">
                                            <a
                                                href={`/admin/pedidos/${order.id}`}
                                                class="inline-flex items-center gap-1 text-sm text-neon-cyan hover:text-neon-cyan-light font-medium"
                                            >
                                                Ver detalles
                                                <svg
                                                    class="w-4 h-4"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    viewBox="0 0 24 24"
                                                >
                                                    <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M9 5l7 7-7 7"
                                                    />
                                                </svg>
                                            </a>
                                        </td>
                                    </tr>
                                );
                            })}
                        </tbody>
                    </table>
                </div>
            )
        }
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('order-search') as HTMLInputElement;
            const noResults = document.getElementById('no-results');
            const tableContainer = document.getElementById('orders-table') as HTMLElement;
            const tbody = tableContainer?.querySelector('tbody');

            // ── Search ──────────────────────────────────────────────
            function applySearch() {
                const query = searchInput?.value.toLowerCase().trim() ?? '';
                const rows = tableContainer?.querySelectorAll('tbody tr.order-row');
                let visible = 0;
                rows?.forEach(row => {
                    const text = (row as HTMLElement).innerText.toLowerCase();
                    const match = !query || text.includes(query);
                    (row as HTMLElement).style.display = match ? '' : 'none';
                    if (match) visible++;
                });
                if (noResults) noResults.classList.toggle('hidden', visible > 0 || !query);
                if (tableContainer) tableContainer.style.display = visible === 0 && query ? 'none' : '';
            }
            searchInput?.addEventListener('input', applySearch);

            // ── Sort ────────────────────────────────────────────────
            let sortCol = 'date';
            let sortDir: 'asc' | 'desc' = 'desc';

            function applySort(col: string) {
                if (sortCol === col) {
                    sortDir = sortDir === 'asc' ? 'desc' : 'asc';
                } else {
                    sortCol = col;
                    sortDir = (col === 'date' || col === 'total' || col === 'order') ? 'desc' : 'asc';
                }

                tableContainer?.querySelectorAll('button[data-sort]').forEach(btn => {
                    const icon = btn.querySelector('.sort-icon') as HTMLElement;
                    if (!icon) return;
                    const isActive = (btn as HTMLElement).dataset.sort === col;
                    icon.textContent = isActive ? (sortDir === 'asc' ? '↑' : '↓') : '↕';
                    btn.classList.toggle('text-neon-cyan', isActive);
                    btn.classList.toggle('text-zinc-500', !isActive);
                });

                if (!tbody) return;
                const rows = Array.from(tbody.querySelectorAll('tr.order-row'));
                rows.sort((a, b) => {
                    const aEl = a as HTMLElement;
                    const bEl = b as HTMLElement;
                    const aRaw = aEl.dataset[col] ?? '';
                    const bRaw = bEl.dataset[col] ?? '';

                    if (col === 'total' || col === 'order') {
                        const aNum = parseFloat(aRaw) || 0;
                        const bNum = parseFloat(bRaw) || 0;
                        return sortDir === 'asc' ? aNum - bNum : bNum - aNum;
                    }
                    if (col === 'date') {
                        const aTime = new Date(aRaw).getTime() || 0;
                        const bTime = new Date(bRaw).getTime() || 0;
                        return sortDir === 'asc' ? aTime - bTime : bTime - aTime;
                    }
                    return sortDir === 'asc'
                        ? aRaw.localeCompare(bRaw, 'es')
                        : bRaw.localeCompare(aRaw, 'es');
                });
                rows.forEach(row => tbody.appendChild(row));
            }

            tableContainer?.querySelectorAll('button[data-sort]').forEach(btn => {
                btn.addEventListener('click', () => applySort((btn as HTMLElement).dataset.sort ?? ''));
            });
        });
    </script>
</AdminLayout>
