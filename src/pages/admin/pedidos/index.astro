---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getOrders, getOrdersStats, formatPrice } from "../../../lib/supabase";

const orders = await getOrders();
const stats = await getOrdersStats();

const statusLabels: Record<string, { label: string; color: string; bg: string }> = {
    pending: { label: 'Pendiente', color: 'text-amber-700', bg: 'bg-amber-50 border-amber-200' },
    paid: { label: 'Pagado', color: 'text-blue-700', bg: 'bg-blue-50 border-blue-200' },
    shipped: { label: 'Enviado', color: 'text-purple-700', bg: 'bg-purple-50 border-purple-200' },
    delivered: { label: 'Entregado', color: 'text-emerald-700', bg: 'bg-emerald-50 border-emerald-200' },
    cancelled: { label: 'Cancelado', color: 'text-red-700', bg: 'bg-red-50 border-red-200' }
};

function formatDate(dateStr: string) {
    return new Date(dateStr).toLocaleDateString('es-ES', {
        day: '2-digit',
        month: 'short',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
    });
}
---

<AdminLayout title="Gestión de Pedidos">
    <!-- Stats Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4 mb-8">
        <div class="bg-white rounded-xl border border-zinc-200 p-4">
            <div class="text-2xl font-bold text-zinc-900">{stats.total}</div>
            <div class="text-sm text-zinc-500">Total Pedidos</div>
        </div>
        <div class="bg-amber-50 rounded-xl border border-amber-200 p-4">
            <div class="text-2xl font-bold text-amber-700">{stats.pending}</div>
            <div class="text-sm text-amber-600">Pendientes</div>
        </div>
        <div class="bg-blue-50 rounded-xl border border-blue-200 p-4">
            <div class="text-2xl font-bold text-blue-700">{stats.paid}</div>
            <div class="text-sm text-blue-600">Pagados</div>
        </div>
        <div class="bg-purple-50 rounded-xl border border-purple-200 p-4">
            <div class="text-2xl font-bold text-purple-700">{stats.shipped}</div>
            <div class="text-sm text-purple-600">Enviados</div>
        </div>
        <div class="bg-emerald-50 rounded-xl border border-emerald-200 p-4">
            <div class="text-2xl font-bold text-emerald-700">{stats.delivered}</div>
            <div class="text-sm text-emerald-600">Entregados</div>
        </div>
        <div class="bg-zinc-900 rounded-xl p-4">
            <div class="text-2xl font-bold text-white">{formatPrice(stats.totalRevenue)}</div>
            <div class="text-sm text-zinc-400">Ingresos</div>
        </div>
    </div>

    <!-- Orders List -->
    <div class="bg-white rounded-2xl border border-zinc-200 overflow-hidden">
        <div class="p-6 border-b border-zinc-200">
            <h2 class="text-lg font-semibold text-zinc-900">Todos los Pedidos</h2>
            <p class="text-sm text-zinc-500 mt-1">Gestiona y actualiza el estado de los pedidos</p>
        </div>

        {orders.length === 0 ? (
            <div class="p-12 text-center">
                <div class="w-16 h-16 bg-zinc-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                    </svg>
                </div>
                <p class="text-zinc-500">No hay pedidos todavía</p>
            </div>
        ) : (
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-zinc-50 border-b border-zinc-200">
                        <tr>
                            <th class="text-left px-6 py-3 text-xs font-semibold text-zinc-500 uppercase tracking-wider">Pedido</th>
                            <th class="text-left px-6 py-3 text-xs font-semibold text-zinc-500 uppercase tracking-wider">Cliente</th>
                            <th class="text-left px-6 py-3 text-xs font-semibold text-zinc-500 uppercase tracking-wider">Productos</th>
                            <th class="text-left px-6 py-3 text-xs font-semibold text-zinc-500 uppercase tracking-wider">Total</th>
                            <th class="text-left px-6 py-3 text-xs font-semibold text-zinc-500 uppercase tracking-wider">Estado</th>
                            <th class="text-left px-6 py-3 text-xs font-semibold text-zinc-500 uppercase tracking-wider">Fecha</th>
                            <th class="text-right px-6 py-3 text-xs font-semibold text-zinc-500 uppercase tracking-wider">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-100">
                        {orders.map((order) => {
                            const status = statusLabels[order.status] || statusLabels.pending;
                            return (
                                <tr class="hover:bg-zinc-50 transition-colors">
                                    <td class="px-6 py-4">
                                        <span class="font-mono text-sm text-zinc-900">#{order.id.slice(0, 8)}</span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="text-sm font-medium text-zinc-900">{order.customer_name || 'Invitado'}</div>
                                        <div class="text-xs text-zinc-500">{order.customer_email || '-'}</div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="text-sm text-zinc-600">{order.items?.length || 0} productos</span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="font-semibold text-zinc-900">{formatPrice(order.total_price)}</span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class={`inline-flex px-2.5 py-1 rounded-full text-xs font-medium border ${status.bg} ${status.color}`}>
                                            {status.label}
                                        </span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="text-sm text-zinc-500">{formatDate(order.created_at)}</span>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <a
                                            href={`/admin/pedidos/${order.id}`}
                                            class="inline-flex items-center gap-1 text-sm text-cyan-600 hover:text-cyan-700 font-medium"
                                        >
                                            Ver detalles
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                            </svg>
                                        </a>
                                    </td>
                                </tr>
                            );
                        })}
                    </tbody>
                </table>
            </div>
        )}
    </div>
</AdminLayout>
