---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import {
    getOrderById,
    updateOrderStatus,
    updateOrderShipping,
    formatPrice,
    supabaseAdmin,
    getFacturacionByOrderId,
} from "../../../lib/supabase";

const { id } = Astro.params;

if (!id) {
    return Astro.redirect("/admin/pedidos");
}

let order = await getOrderById(id);
let message = "";
let messageType = "";

if (!order) {
    return Astro.redirect("/admin/pedidos");
}

// Handle form submissions
if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const action = formData.get("action")?.toString();

    // Handle status update
    if (action === "update_status") {
        const newStatus = formData.get("status")?.toString();

        if (
            newStatus &&
            ["pending", "paid", "shipped", "delivered", "cancelled", "return_requested", "returned"].includes(
                newStatus,
            )
        ) {
            try {
                await updateOrderStatus(id, newStatus as any);
                order = await getOrderById(id);
                message = "Estado actualizado correctamente";
                messageType = "success";
            } catch (e: any) {
                message = e.message || "Error al actualizar el estado";
                messageType = "error";
            }
        }
    }

    // Handle shipping info update
    if (action === "update_shipping") {
        const carrier = formData.get("shipping_carrier")?.toString();
        const trackingNumber = formData.get("tracking_number")?.toString();
        const trackingUrl = formData.get("tracking_url")?.toString();
        const markAsShipped = formData.get("mark_shipped") === "on";

        try {
            await updateOrderShipping(id, {
                shipping_carrier: carrier || null,
                tracking_number: trackingNumber || null,
                tracking_url: trackingUrl || null,
                markAsShipped,
            });
            order = await getOrderById(id);
            message = markAsShipped
                ? "Pedido marcado como enviado y cliente notificado"
                : "Información de envío actualizada";
            messageType = "success";
        } catch (e: any) {
            message = e.message || "Error al actualizar información de envío";
            messageType = "error";
        }
    }
}

// Lista de transportistas
const carriers = [
    {
        id: "seur",
        name: "SEUR",
        trackingBase:
            "https://www.seur.com/livetracking/?segOnlineIdentificador=",
    },
    {
        id: "mrw",
        name: "MRW",
        trackingBase: "https://www.mrw.es/seguimiento_envios/",
    },
    {
        id: "correos",
        name: "Correos",
        trackingBase:
            "https://www.correos.es/es/es/herramientas/localizador/envios/",
    },
    {
        id: "gls",
        name: "GLS",
        trackingBase:
            "https://www.gls-spain.es/es/ayuda/seguimiento-envio/?match=",
    },
    {
        id: "ups",
        name: "UPS",
        trackingBase: "https://www.ups.com/track?tracknum=",
    },
    {
        id: "dhl",
        name: "DHL",
        trackingBase:
            "https://www.dhl.com/es-es/home/tracking.html?tracking-id=",
    },
    {
        id: "envialia",
        name: "Envialia",
        trackingBase: "https://www.envialia.com/es/tracking/?id=",
    },
    {
        id: "nacex",
        name: "Nacex",
        trackingBase: "https://www.nacex.es/seguimiento-envios/?id=",
    },
    {
        id: "fedex",
        name: "FedEx",
        trackingBase: "https://www.fedex.com/fedextrack/?trknbr=",
    },
    { id: "otro", name: "Otro", trackingBase: "" },
];

const statusLabels: Record<
    string,
    { label: string; color: string; bg: string }
> = {
    pending: {
        label: "Pendiente",
        color: "text-amber-400",
        bg: "bg-amber-500/10 border-amber-500/30",
    },
    paid: {
        label: "Pagado",
        color: "text-blue-400",
        bg: "bg-blue-500/10 border-blue-500/30",
    },
    shipped: {
        label: "Enviado",
        color: "text-purple-400",
        bg: "bg-purple-500/10 border-purple-500/30",
    },
    delivered: {
        label: "Entregado",
        color: "text-emerald-400",
        bg: "bg-emerald-500/10 border-emerald-500/30",
    },
    cancelled: {
        label: "Cancelado",
        color: "text-red-400",
        bg: "bg-red-500/10 border-red-500/30",
    },
    return_requested: {
        label: "Devolución Solicitada",
        color: "text-orange-400",
        bg: "bg-orange-500/10 border-orange-500/30",
    },
    returned: {
        label: "Devuelto",
        color: "text-pink-400",
        bg: "bg-pink-500/10 border-pink-500/30",
    },
};

function formatDate(dateStr: string) {
    return new Date(dateStr).toLocaleDateString("es-ES", {
        day: "2-digit",
        month: "long",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
    });
}

const currentStatus = statusLabels[order?.status || "pending"];
---

<AdminLayout
    title={`Pedido #${order?.order_number ? order.order_number : id.slice(0, 8)}`}
>
    <div class="max-w-5xl">
        <!-- Header -->
        <div class="bg-dark-400 rounded-2xl border border-white/10 p-6 mb-6">
            <div class="flex items-center gap-4 mb-6">
                <a
                    href="/admin/pedidos"
                    class="p-2.5 text-zinc-400 hover:text-neon-cyan hover:bg-white/5 rounded-xl transition-colors border border-white/10"
                >
                    <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 19l-7-7 7-7"></path>
                    </svg>
                </a>
                <div class="flex-1">
                    <div class="flex items-center gap-3 flex-wrap">
                        <h1 class="text-2xl font-bold text-zinc-100">
                            Pedido #{
                                order?.order_number
                                    ? order.order_number
                                    : id.slice(0, 8)
                            }
                        </h1>
                        <span
                            class={`inline-flex px-3 py-1 rounded-full text-sm font-medium border ${currentStatus.bg} ${currentStatus.color}`}
                        >
                            {currentStatus.label}
                        </span>
                    </div>
                    <p class="text-zinc-500 mt-1 text-sm">
                        {formatDate(order?.created_at || "")}
                    </p>
                </div>
                <div class="text-right hidden sm:block">
                    <p class="text-sm text-zinc-400">Total del pedido</p>
                    <p class="text-2xl font-bold text-zinc-100">
                        {formatPrice(order?.total_price || 0)}
                    </p>
                    {
                        (await getFacturacionByOrderId(id)) ? (
                            <a
                                href={`/admin/pedidos/${id}`}
                                class="inline-block mt-2 text-sm font-medium text-neon-cyan hover:text-neon-cyan/80 hover:underline"
                            >
                                Factura #
                                {(await getFacturacionByOrderId(id))?.id}
                            </a>
                        ) : (
                            <span class="inline-block mt-2 text-sm text-zinc-400">
                                Sin factura
                            </span>
                        )
                    }
                </div>
            </div>

            <!-- Progress Bar -->
            {
                order?.status !== "cancelled" && order?.status !== "return_requested" && order?.status !== "returned" && (
                    <div class="border-t border-white/10 pt-6">
                        <div class="flex items-center justify-between relative">
                            <div class="absolute top-5 left-8 right-8 h-0.5 bg-white/10 rounded-full" />
                            <div
                                class="absolute top-5 left-8 h-0.5 bg-neon-cyan rounded-full transition-all duration-500"
                                style={`width: calc(${Math.max(0, (["pending", "paid", "shipped", "delivered"].indexOf(order?.status || "pending") / 3) * 100)}% - 64px)`}
                            />
                            {[
                                { key: "pending", label: "Pendiente" },
                                { key: "paid", label: "Pagado" },
                                { key: "shipped", label: "Enviado" },
                                { key: "delivered", label: "Entregado" },
                            ].map((step, index) => {
                                const currentIndex = [
                                    "pending",
                                    "paid",
                                    "shipped",
                                    "delivered",
                                ].indexOf(order?.status || "pending");
                                const isCompleted = index <= currentIndex;
                                const isCurrent = index === currentIndex;
                                return (
                                    <div class="flex flex-col items-center z-10 flex-1">
                                        <div
                                            class={`w-10 h-10 rounded-full flex items-center justify-center text-sm font-semibold transition-all duration-300 ${
                                                isCompleted
                                                    ? "bg-neon-cyan text-white"
                                                    : "bg-dark-300 text-zinc-500"
                                            } ${isCurrent ? "ring-2 ring-neon-cyan/30" : ""}`}
                                        >
                                            {isCompleted ? (
                                                <svg
                                                    class="w-5 h-5"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    viewBox="0 0 24 24"
                                                >
                                                    <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        stroke-width="2.5"
                                                        d="M5 13l4 4L19 7"
                                                    />
                                                </svg>
                                            ) : (
                                                index + 1
                                            )}
                                        </div>
                                        <span
                                            class={`text-xs mt-2 font-medium ${isCompleted ? "text-neon-cyan" : "text-zinc-500"}`}
                                        >
                                            {step.label}
                                        </span>
                                    </div>
                                );
                            })}
                        </div>
                    </div>
                )
            }
            {
                order?.status === "cancelled" && (
                    <div class="border-t border-white/10 pt-4">
                        <div class="flex items-center gap-2 text-red-400 bg-red-500/10 px-4 py-3 rounded-xl border border-red-500/30">
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M6 18L18 6M6 6l12 12"
                                />
                            </svg>
                            <span class="font-medium">
                                Este pedido ha sido cancelado
                            </span>
                        </div>
                    </div>
                )
            }
            {
                order?.status === "return_requested" && (
                    <div class="border-t border-white/10 pt-4">
                        <div class="flex items-center gap-2 text-orange-400 bg-orange-500/10 px-4 py-3 rounded-xl border border-orange-500/30">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6" />
                            </svg>
                            <span class="font-medium">
                                El cliente ha solicitado la devolución de este pedido
                            </span>
                        </div>
                    </div>
                )
            }
            {
                order?.status === "returned" && (
                    <div class="border-t border-white/10 pt-4">
                        <div class="flex items-center gap-2 text-pink-400 bg-pink-500/10 px-4 py-3 rounded-xl border border-pink-500/30">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            <span class="font-medium">
                                Devolución aceptada - Reembolso procesado
                            </span>
                        </div>
                    </div>
                )
            }
        </div>

        {
            message && (
                <div
                    class={`mb-6 p-4 rounded-xl border ${messageType === "success" ? "bg-emerald-50 border-emerald-200 text-emerald-700" : "bg-red-50 border-red-200 text-red-700"}`}
                >
                    {message}
                </div>
            )
        }

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Order Details -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Products -->
                <div
                    class="bg-dark-400 rounded-2xl border border-white/10 overflow-hidden"
                >
                    <div
                        class="p-5 border-b border-white/10 flex items-center justify-between"
                    >
                        <h2
                            class="font-semibold text-zinc-100 flex items-center gap-2"
                        >
                            <svg
                                class="w-5 h-5 text-neon-cyan"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.5"
                                    d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"
                                ></path>
                            </svg>
                            Productos
                        </h2>
                        <span
                            class="text-sm text-zinc-400 bg-dark-300 px-2.5 py-1 rounded-lg border border-white/10"
                            >{order?.items?.length || 0} artículos</span
                        >
                    </div>
                    <div class="divide-y divide-zinc-100">
                        {
                            order?.items?.map((item: any) => (
                                <div class="p-5 flex items-center gap-4 hover:bg-white/5 transition-colors">
                                    <div class="w-20 h-20 bg-dark-300 rounded-xl flex items-center justify-center overflow-hidden flex-shrink-0">
                                        {item.product_image ? (
                                            <img
                                                src={item.product_image}
                                                alt={item.product_name}
                                                class="w-full h-full object-cover"
                                            />
                                        ) : (
                                            <svg
                                                class="w-8 h-8 text-zinc-500"
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="1.5"
                                                    d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
                                                />
                                            </svg>
                                        )}
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <div class="font-medium text-zinc-100 truncate">
                                            {item.product_name}
                                        </div>
                                        <div class="text-sm text-zinc-400">
                                            {item.size && (
                                                <span>
                                                    Talla: {item.size} •{" "}
                                                </span>
                                            )}
                                            Cantidad: {item.quantity}
                                        </div>
                                    </div>
                                    <div class="text-right">
                                        <div class="font-semibold text-zinc-100">
                                            {formatPrice(
                                                item.price_at_purchase *
                                                    item.quantity,
                                            )}
                                        </div>
                                        <div class="text-xs text-zinc-400">
                                            {formatPrice(
                                                item.price_at_purchase,
                                            )}{" "}
                                            c/u
                                        </div>
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                    <div class="p-5 bg-dark-300 border-t border-white/10">
                        <div class="flex justify-between items-center">
                            <span class="font-semibold text-zinc-100"
                                >Total</span
                            >
                            <span class="text-xl font-bold text-neon-cyan"
                                >{formatPrice(order?.total_price || 0)}</span
                            >
                        </div>
                    </div>
                </div>

                <!-- Shipping Address -->
                {
                    order?.shipping_address && (
                        <div class="bg-dark-400 rounded-2xl border border-white/10 p-5">
                            <h2 class="font-semibold text-zinc-100 mb-3 flex items-center gap-2">
                                <svg
                                    class="w-5 h-5 text-neon-purple"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="1.5"
                                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                    />
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="1.5"
                                        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                    />
                                </svg>
                                Dirección de Envío
                            </h2>
                            <p class="text-zinc-600 whitespace-pre-line">
                                {order.shipping_address
                                    .split("\n")
                                    .filter(
                                        (line: string) =>
                                            line &&
                                            line.trim() !== "" &&
                                            !line.includes("null"),
                                    )
                                    .join("\n") || "Dirección no disponible"}
                            </p>
                        </div>
                    )
                }
            </div>

            <!-- Sidebar -->
            <div class="space-y-6">
                <!-- Customer Info -->
                <div class="bg-dark-400 rounded-2xl border border-white/10 p-5">
                    <h2
                        class="font-semibold text-zinc-100 mb-4 flex items-center gap-2"
                    >
                        <svg
                            class="w-5 h-5 text-neon-cyan"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                            ></path>
                        </svg>
                        Cliente
                    </h2>
                    <div class="space-y-4">
                        <div class="flex items-center gap-3">
                            <div
                                class="w-10 h-10 rounded-full bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center text-white font-semibold"
                            >
                                {
                                    (order?.customer_name || "I")
                                        .charAt(0)
                                        .toUpperCase()
                                }
                            </div>
                            <div>
                                <div class="text-zinc-100 font-medium">
                                    {order?.customer_name || "Invitado"}
                                </div>
                                {
                                    order?.customer_email && (
                                        <div class="text-sm text-zinc-400">
                                            {order.customer_email}
                                        </div>
                                    )
                                }
                            </div>
                        </div>
                        {
                            order?.customer_email && (
                                <a
                                    href={`mailto:${order.customer_email}`}
                                    class="flex items-center justify-center gap-2 w-full px-4 py-2.5 bg-gradient-to-r from-neon-cyan to-cyan-600 text-white font-medium rounded-xl hover:from-cyan-400 hover:to-cyan-700 transition-all text-sm shadow-lg shadow-neon-cyan/20"
                                >
                                    <svg
                                        class="w-4 h-4"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                        />
                                    </svg>
                                    Enviar email
                                </a>
                            )
                        }
                    </div>
                </div>

                <!-- Update Status -->
                <div class="bg-dark-400 rounded-2xl border border-white/10 p-5">
                    <h2
                        class="font-semibold text-zinc-100 mb-4 flex items-center gap-2"
                    >
                        <svg
                            class="w-5 h-5 text-amber-400"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                            ></path>
                        </svg>
                        Actualizar Estado
                    </h2>
                    <form method="POST" class="space-y-3">
                        <input
                            type="hidden"
                            name="action"
                            value="update_status"
                        />
                        <select
                            name="status"
                            class="w-full px-4 py-3 bg-dark-300 border border-white/10 rounded-xl text-zinc-100 focus:outline-none focus:border-neon-cyan focus:ring-2 focus:ring-neon-cyan/20 cursor-pointer"
                        >
                            <option
                                value="pending"
                                selected={order?.status === "pending"}
                                >Pendiente</option
                            >
                            <option
                                value="paid"
                                selected={order?.status === "paid"}
                                >Pagado</option
                            >
                            <option
                                value="shipped"
                                selected={order?.status === "shipped"}
                                >Enviado</option
                            >
                            <option
                                value="delivered"
                                selected={order?.status === "delivered"}
                                >Entregado</option
                            >
                            <option
                                value="cancelled"
                                selected={order?.status === "cancelled"}
                                >Cancelado</option
                            >
                            <option
                                value="return_requested"
                                selected={order?.status === "return_requested"}
                                >Devolución Solicitada</option
                            >
                            <option
                                value="returned"
                                selected={order?.status === "returned"}
                                >Devuelto</option
                            >
                        </select>
                        <button
                            type="submit"
                            class="w-full px-4 py-2.5 bg-gradient-to-r from-cyan-600 to-cyan-500 text-white font-medium rounded-xl hover:from-cyan-700 hover:to-cyan-600 transition-all shadow-sm hover:shadow-md flex items-center justify-center gap-2"
                        >
                            <svg
                                class="w-4 h-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                                ></path>
                            </svg>
                            Actualizar
                        </button>
                    </form>
                </div>

                {/* Accept Return Button - shown when order is in return_requested status */}
                {
                    order?.status === "return_requested" && (
                        <div class="bg-dark-400 rounded-2xl border border-orange-500/30 p-5">
                            <h2 class="font-semibold text-orange-400 mb-3 flex items-center gap-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6" />
                                </svg>
                                Solicitud de Devolución
                            </h2>
                            <p class="text-zinc-400 text-sm mb-4">
                                El cliente ha solicitado la devolución de este pedido. Al aceptar se procesará el reembolso por Stripe, se generará la factura rectificativa y se enviará todo por email al cliente.
                            </p>
                            <button
                                id="accept-return-btn"
                                data-order-id={order.id}
                                class="w-full px-4 py-3 bg-gradient-to-r from-emerald-600 to-emerald-500 text-white font-semibold rounded-xl hover:from-emerald-700 hover:to-emerald-600 transition-all shadow-lg shadow-emerald-500/20 flex items-center justify-center gap-2"
                            >
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                                Aceptar Devolución y Reembolsar
                            </button>
                            <p class="text-xs text-zinc-500 mt-2 text-center">
                                Esta acción no se puede deshacer
                            </p>
                        </div>
                    )
                }

                {/* Cancel Order Button - shown when order is in paid status */}
                {
                    order?.status === "paid" && (
                        <div class="bg-dark-400 rounded-2xl border border-red-500/30 p-5">
                            <h2 class="font-semibold text-red-400 mb-3 flex items-center gap-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                                Cancelar Pedido
                            </h2>
                            <p class="text-zinc-400 text-sm mb-4">
                                Al cancelar se procesará el reembolso por Stripe, se generará la factura rectificativa y se enviará todo por email al cliente.
                            </p>
                            <button
                                id="admin-cancel-btn"
                                data-order-id={order.id}
                                class="w-full px-4 py-3 bg-gradient-to-r from-red-600 to-red-500 text-white font-semibold rounded-xl hover:from-red-700 hover:to-red-600 transition-all shadow-lg shadow-red-500/20 flex items-center justify-center gap-2"
                            >
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                                Cancelar Pedido y Reembolsar
                            </button>
                            <p class="text-xs text-zinc-500 mt-2 text-center">
                                Esta acción no se puede deshacer
                            </p>
                        </div>
                    )
                }

                <!-- Shipping Info -->
                <div class="bg-dark-400 rounded-2xl border border-white/10 p-5">
                    <h2
                        class="font-semibold text-zinc-100 mb-4 flex items-center gap-2"
                    >
                        <svg
                            class="w-5 h-5 text-neon-purple"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"
                            ></path>
                        </svg>
                        Información de Envío
                    </h2>
                    <form method="POST" class="space-y-4">
                        <input
                            type="hidden"
                            name="action"
                            value="update_shipping"
                        />

                        <div>
                            <label
                                class="block text-sm font-medium text-zinc-300 mb-1.5"
                                >Empresa Transportista</label
                            >
                            <select
                                name="shipping_carrier"
                                id="shipping_carrier"
                                class="w-full px-4 py-3 bg-dark-300 border border-white/10 rounded-xl text-zinc-100 focus:outline-none focus:border-neon-cyan focus:ring-2 focus:ring-neon-cyan/20"
                            >
                                <option value="">Seleccionar...</option>
                                {
                                    carriers.map((c) => (
                                        <option
                                            value={c.id}
                                            selected={
                                                order?.shipping_carrier === c.id
                                            }
                                            data-tracking-base={c.trackingBase}
                                        >
                                            {c.name}
                                        </option>
                                    ))
                                }
                            </select>
                        </div>

                        <div>
                            <label
                                class="block text-sm font-medium text-zinc-300 mb-1.5"
                                >Código de Seguimiento</label
                            >
                            <input
                                type="text"
                                name="tracking_number"
                                id="tracking_number"
                                value={order?.tracking_number || ""}
                                placeholder="Ej: 1Z999AA10123456784"
                                class="w-full px-4 py-3 bg-dark-300 border border-white/10 rounded-xl text-zinc-100 focus:outline-none focus:border-neon-cyan focus:ring-2 focus:ring-neon-cyan/20"
                            />
                        </div>

                        <div>
                            <label
                                class="block text-sm font-medium text-zinc-300 mb-1.5"
                                >URL de Seguimiento</label
                            >
                            <input
                                type="url"
                                name="tracking_url"
                                id="tracking_url"
                                value={order?.tracking_url || ""}
                                placeholder="https://..."
                                class="w-full px-4 py-3 bg-dark-300 border border-white/10 rounded-xl text-zinc-100 focus:outline-none focus:border-neon-cyan focus:ring-2 focus:ring-neon-cyan/20"
                            />
                            <p class="text-xs text-zinc-500 mt-1">
                                Se genera automáticamente al seleccionar
                                transportista y código
                            </p>
                        </div>

                        {
                            order?.status === "paid" && (
                                <div class="flex items-center gap-3 p-3 bg-cyan-50 rounded-xl border border-cyan-200">
                                    <input
                                        type="checkbox"
                                        name="mark_shipped"
                                        id="mark_shipped"
                                        class="w-4 h-4 text-cyan-600 bg-white border-zinc-300 rounded focus:ring-cyan-500"
                                    />
                                    <label
                                        for="mark_shipped"
                                        class="text-sm text-cyan-800"
                                    >
                                        Marcar como enviado y notificar al
                                        cliente
                                    </label>
                                </div>
                            )
                        }

                        <button
                            type="submit"
                            class="w-full px-4 py-2.5 bg-gradient-to-r from-cyan-600 to-cyan-500 text-white font-medium rounded-xl hover:from-cyan-700 hover:to-cyan-600 transition-all shadow-sm hover:shadow-md flex items-center justify-center gap-2"
                        >
                            <svg
                                class="w-4 h-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M5 13l4 4L19 7"></path>
                            </svg>
                            {
                                order?.status === "paid"
                                    ? "Guardar y Notificar"
                                    : "Guardar"
                            }
                        </button>
                    </form>

                    {
                        order?.shipped_at && (
                            <div class="mt-4 p-3 bg-green-50 rounded-xl border border-green-200">
                                <div class="flex items-center gap-2 text-green-700 text-sm">
                                    <svg
                                        class="w-4 h-4"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M5 13l4 4L19 7"
                                        />
                                    </svg>
                                    <span>
                                        Enviado el{" "}
                                        {formatDate(order.shipped_at)}
                                    </span>
                                </div>
                                {order.tracking_url && (
                                    <a
                                        href={order.tracking_url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="inline-flex items-center gap-1 mt-2 text-sm text-cyan-600 hover:text-cyan-700"
                                    >
                                        Ver seguimiento
                                        <svg
                                            class="w-4 h-4"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                                            />
                                        </svg>
                                    </a>
                                )}
                            </div>
                        )
                    }
                </div>

                <!-- Timeline -->
                <div class="bg-dark-400 rounded-2xl border border-white/10 p-5">
                    <h2
                        class="font-semibold text-zinc-100 mb-4 flex items-center gap-2"
                    >
                        <svg
                            class="w-5 h-5 text-emerald-400"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                            ></path>
                        </svg>
                        Historial
                    </h2>
                    <div class="space-y-3 relative">
                        <div
                            class="absolute left-[7px] top-2 bottom-2 w-0.5 bg-white/10"
                        >
                        </div>
                        <div class="flex gap-3 relative">
                            <div
                                class="w-3.5 h-3.5 mt-0.5 rounded-full bg-emerald-500 border-2 border-white shadow-sm z-10"
                            >
                            </div>
                            <div class="flex-1">
                                <div class="text-sm font-medium text-zinc-100">
                                    Pedido creado
                                </div>
                                <div class="text-xs text-zinc-400">
                                    {formatDate(order?.created_at || "")}
                                </div>
                            </div>
                        </div>
                        {
                            order?.shipped_at && (
                                <div class="flex gap-3 relative">
                                    <div class="w-3.5 h-3.5 mt-0.5 rounded-full bg-purple-500 border-2 border-white shadow-sm z-10" />
                                    <div class="flex-1">
                                        <div class="text-sm font-medium text-zinc-100">
                                            Pedido enviado
                                        </div>
                                        <div class="text-xs text-zinc-400">
                                            {formatDate(order.shipped_at)}
                                        </div>
                                    </div>
                                </div>
                            )
                        }
                        {
                            order?.delivered_at && (
                                <div class="flex gap-3 relative">
                                    <div class="w-3.5 h-3.5 mt-0.5 rounded-full bg-cyan-500 border-2 border-white shadow-sm z-10" />
                                    <div class="flex-1">
                                        <div class="text-sm font-medium text-zinc-100">
                                            Pedido entregado
                                        </div>
                                        <div class="text-xs text-zinc-400">
                                            {formatDate(order.delivered_at)}
                                        </div>
                                    </div>
                                </div>
                            )
                        }
                        {
                            order?.updated_at &&
                                order.updated_at !== order.created_at &&
                                !order?.shipped_at &&
                                !order?.delivered_at && (
                                    <div class="flex gap-3 relative">
                                        <div class="w-3.5 h-3.5 mt-0.5 rounded-full bg-blue-500 border-2 border-white shadow-sm z-10" />
                                        <div class="flex-1">
                                            <div class="text-sm font-medium text-zinc-100">
                                                Última actualización
                                            </div>
                                            <div class="text-xs text-zinc-400">
                                                {formatDate(order.updated_at)}
                                            </div>
                                        </div>
                                    </div>
                                )
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Auto-generate tracking URL based on carrier and tracking number
        const carrierSelect = document.getElementById(
            "shipping_carrier",
        ) as HTMLSelectElement;
        const trackingNumberInput = document.getElementById(
            "tracking_number",
        ) as HTMLInputElement;
        const trackingUrlInput = document.getElementById(
            "tracking_url",
        ) as HTMLInputElement;

        function updateTrackingUrl() {
            const selectedOption =
                carrierSelect.options[carrierSelect.selectedIndex];
            const trackingBase = selectedOption?.dataset?.trackingBase || "";
            const trackingNumber = trackingNumberInput?.value?.trim() || "";

            if (trackingBase && trackingNumber) {
                trackingUrlInput.value = trackingBase + trackingNumber;
            }
        }

        carrierSelect?.addEventListener("change", updateTrackingUrl);
        trackingNumberInput?.addEventListener("input", updateTrackingUrl);

        // Accept Return Button
        const acceptReturnBtn = document.getElementById('accept-return-btn');
        if (acceptReturnBtn) {
            acceptReturnBtn.addEventListener('click', async () => {
                const orderId = acceptReturnBtn.dataset.orderId;
                if (!orderId) return;

                if (!confirm('¿Estás seguro de aceptar esta devolución?\n\nSe procesará el reembolso por Stripe, se generará la factura rectificativa y se enviará el email al cliente con ambas facturas en PDF.\n\nEsta acción no se puede deshacer.')) {
                    return;
                }

                acceptReturnBtn.classList.add('opacity-50', 'pointer-events-none');
                acceptReturnBtn.innerHTML = `
                    <svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                    </svg>
                    Procesando devolución...
                `;

                try {
                    const response = await fetch('/api/orders/accept-return', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ orderId })
                    });

                    const result = await response.json();

                    if (result.success) {
                        acceptReturnBtn.innerHTML = `
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            Devolución procesada correctamente
                        `;
                        acceptReturnBtn.className = 'w-full px-4 py-3 bg-emerald-700 text-white font-semibold rounded-xl flex items-center justify-center gap-2 pointer-events-none';
                        
                        // Reload page after a short delay
                        setTimeout(() => window.location.reload(), 1500);
                    } else {
                        throw new Error(result.error || 'Error desconocido');
                    }
                } catch (error: any) {
                    acceptReturnBtn.classList.remove('opacity-50', 'pointer-events-none');
                    acceptReturnBtn.innerHTML = `
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        Aceptar Devolución y Reembolsar
                    `;
                    alert('Error al procesar la devolución: ' + (error.message || 'Error desconocido'));
                }
            });
        }

        // Admin Cancel Order Button
        const adminCancelBtn = document.getElementById('admin-cancel-btn');
        if (adminCancelBtn) {
            adminCancelBtn.addEventListener('click', async () => {
                const orderId = adminCancelBtn.dataset.orderId;
                if (!orderId) return;

                if (!confirm('¿Estás seguro de cancelar este pedido?\n\nSe procesará el reembolso por Stripe, se generará la factura rectificativa y se enviará el email al cliente con ambas facturas en PDF.\n\nEsta acción no se puede deshacer.')) {
                    return;
                }

                adminCancelBtn.classList.add('opacity-50', 'pointer-events-none');
                adminCancelBtn.innerHTML = `
                    <svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                    </svg>
                    Procesando cancelación...
                `;

                try {
                    const response = await fetch('/api/orders/admin-cancel', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ orderId })
                    });

                    const result = await response.json();

                    if (result.success) {
                        adminCancelBtn.innerHTML = `
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            Pedido cancelado correctamente
                        `;
                        adminCancelBtn.className = 'w-full px-4 py-3 bg-red-800 text-white font-semibold rounded-xl flex items-center justify-center gap-2 pointer-events-none';
                        
                        // Reload page after a short delay
                        setTimeout(() => window.location.reload(), 1500);
                    } else {
                        throw new Error(result.error || 'Error desconocido');
                    }
                } catch (error: any) {
                    adminCancelBtn.classList.remove('opacity-50', 'pointer-events-none');
                    adminCancelBtn.innerHTML = `
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                        Cancelar Pedido y Reembolsar
                    `;
                    alert('Error al cancelar el pedido: ' + (error.message || 'Error desconocido'));
                }
            });
        }
    </script>
</AdminLayout>
