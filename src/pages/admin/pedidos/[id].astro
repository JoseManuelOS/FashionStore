---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getOrderById, updateOrderStatus, formatPrice } from "../../../lib/supabase";

const { id } = Astro.params;

if (!id) {
    return Astro.redirect("/admin/pedidos");
}

let order = await getOrderById(id);
let message = "";
let messageType = "";

if (!order) {
    return Astro.redirect("/admin/pedidos");
}

// Handle status update
if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const newStatus = formData.get("status")?.toString();
    
    if (newStatus && ['pending', 'paid', 'shipped', 'delivered', 'cancelled'].includes(newStatus)) {
        try {
            await updateOrderStatus(id, newStatus as any);
            order = await getOrderById(id);
            message = "Estado actualizado correctamente";
            messageType = "success";
        } catch (e: any) {
            message = e.message || "Error al actualizar el estado";
            messageType = "error";
        }
    }
}

const statusLabels: Record<string, { label: string; color: string; bg: string }> = {
    pending: { label: 'Pendiente', color: 'text-amber-700', bg: 'bg-amber-50 border-amber-200' },
    paid: { label: 'Pagado', color: 'text-blue-700', bg: 'bg-blue-50 border-blue-200' },
    shipped: { label: 'Enviado', color: 'text-purple-700', bg: 'bg-purple-50 border-purple-200' },
    delivered: { label: 'Entregado', color: 'text-emerald-700', bg: 'bg-emerald-50 border-emerald-200' },
    cancelled: { label: 'Cancelado', color: 'text-red-700', bg: 'bg-red-50 border-red-200' }
};

function formatDate(dateStr: string) {
    return new Date(dateStr).toLocaleDateString('es-ES', {
        day: '2-digit',
        month: 'long',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
    });
}

const currentStatus = statusLabels[order?.status || 'pending'];
---

<AdminLayout title={`Pedido #${id.slice(0, 8)}`}>
    <div class="max-w-4xl">
        <!-- Header -->
        <div class="flex items-center gap-4 mb-8">
            <a
                href="/admin/pedidos"
                class="p-2 text-zinc-400 hover:text-zinc-900 hover:bg-zinc-100 rounded-lg transition-colors"
            >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
            </a>
            <div class="flex-1">
                <div class="flex items-center gap-3">
                    <h1 class="text-2xl font-bold text-zinc-900">Pedido #{id.slice(0, 8)}</h1>
                    <span class={`inline-flex px-3 py-1 rounded-full text-sm font-medium border ${currentStatus.bg} ${currentStatus.color}`}>
                        {currentStatus.label}
                    </span>
                </div>
                <p class="text-zinc-500 mt-0.5">{formatDate(order?.created_at || '')}</p>
            </div>
        </div>

        {message && (
            <div class={`mb-6 p-4 rounded-xl border ${messageType === 'success' ? 'bg-emerald-50 border-emerald-200 text-emerald-700' : 'bg-red-50 border-red-200 text-red-700'}`}>
                {message}
            </div>
        )}

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Order Details -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Products -->
                <div class="bg-white rounded-2xl border border-zinc-200 overflow-hidden">
                    <div class="p-5 border-b border-zinc-200">
                        <h2 class="font-semibold text-zinc-900">Productos ({order?.items?.length || 0})</h2>
                    </div>
                    <div class="divide-y divide-zinc-100">
                        {order?.items?.map((item: any) => (
                            <div class="p-5 flex items-center gap-4">
                                <div class="w-16 h-16 bg-zinc-100 rounded-lg flex items-center justify-center">
                                    {item.product_image ? (
                                        <img src={item.product_image} alt={item.product_name} class="w-full h-full object-cover rounded-lg" />
                                    ) : (
                                        <svg class="w-8 h-8 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                                        </svg>
                                    )}
                                </div>
                                <div class="flex-1">
                                    <div class="font-medium text-zinc-900">{item.product_name}</div>
                                    <div class="text-sm text-zinc-500">
                                        {item.size && <span>Talla: {item.size} • </span>}
                                        Cantidad: {item.quantity}
                                    </div>
                                </div>
                                <div class="text-right">
                                    <div class="font-semibold text-zinc-900">{formatPrice(item.price_at_purchase * item.quantity)}</div>
                                    <div class="text-xs text-zinc-500">{formatPrice(item.price_at_purchase)} c/u</div>
                                </div>
                            </div>
                        ))}
                    </div>
                    <div class="p-5 bg-zinc-50 border-t border-zinc-200">
                        <div class="flex justify-between items-center">
                            <span class="font-semibold text-zinc-900">Total</span>
                            <span class="text-xl font-bold text-zinc-900">{formatPrice(order?.total_price || 0)}</span>
                        </div>
                    </div>
                </div>

                <!-- Shipping Address -->
                {order?.shipping_address && (
                    <div class="bg-white rounded-2xl border border-zinc-200 p-5">
                        <h2 class="font-semibold text-zinc-900 mb-3 flex items-center gap-2">
                            <svg class="w-5 h-5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            Dirección de Envío
                        </h2>
                        <p class="text-zinc-600 whitespace-pre-line">{order.shipping_address}</p>
                    </div>
                )}
            </div>

            <!-- Sidebar -->
            <div class="space-y-6">
                <!-- Customer Info -->
                <div class="bg-white rounded-2xl border border-zinc-200 p-5">
                    <h2 class="font-semibold text-zinc-900 mb-4 flex items-center gap-2">
                        <svg class="w-5 h-5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                        Cliente
                    </h2>
                    <div class="space-y-3">
                        <div>
                            <div class="text-xs text-zinc-500 uppercase tracking-wider">Nombre</div>
                            <div class="text-zinc-900 font-medium">{order?.customer_name || 'Invitado'}</div>
                        </div>
                        {order?.customer_email && (
                            <div>
                                <div class="text-xs text-zinc-500 uppercase tracking-wider">Email</div>
                                <div class="text-zinc-900">{order.customer_email}</div>
                            </div>
                        )}
                    </div>
                </div>

                <!-- Update Status -->
                <div class="bg-white rounded-2xl border border-zinc-200 p-5">
                    <h2 class="font-semibold text-zinc-900 mb-4 flex items-center gap-2">
                        <svg class="w-5 h-5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        Actualizar Estado
                    </h2>
                    <form method="POST" class="space-y-4">
                        <select
                            name="status"
                            class="w-full px-4 py-3 bg-zinc-50 border border-zinc-200 rounded-xl text-zinc-900 focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20"
                        >
                            <option value="pending" selected={order?.status === 'pending'}>⏳ Pendiente</option>
                            <option value="paid" selected={order?.status === 'paid'}>💳 Pagado</option>
                            <option value="shipped" selected={order?.status === 'shipped'}>📦 Enviado</option>
                            <option value="delivered" selected={order?.status === 'delivered'}>✅ Entregado</option>
                            <option value="cancelled" selected={order?.status === 'cancelled'}>❌ Cancelado</option>
                        </select>
                        <button
                            type="submit"
                            class="w-full px-4 py-3 bg-zinc-900 text-white font-semibold rounded-xl hover:bg-zinc-800 transition-colors"
                        >
                            Actualizar Estado
                        </button>
                    </form>
                </div>

                <!-- Timeline -->
                <div class="bg-white rounded-2xl border border-zinc-200 p-5">
                    <h2 class="font-semibold text-zinc-900 mb-4">Historial</h2>
                    <div class="space-y-4">
                        <div class="flex gap-3">
                            <div class="w-2 h-2 mt-2 rounded-full bg-emerald-500"></div>
                            <div>
                                <div class="text-sm font-medium text-zinc-900">Pedido creado</div>
                                <div class="text-xs text-zinc-500">{formatDate(order?.created_at || '')}</div>
                            </div>
                        </div>
                        {order?.updated_at && order.updated_at !== order.created_at && (
                            <div class="flex gap-3">
                                <div class="w-2 h-2 mt-2 rounded-full bg-blue-500"></div>
                                <div>
                                    <div class="text-sm font-medium text-zinc-900">Última actualización</div>
                                    <div class="text-xs text-zinc-500">{formatDate(order.updated_at)}</div>
                                </div>
                            </div>
                        )}
                    </div>
                </div>
            </div>
        </div>
    </div>
</AdminLayout>
