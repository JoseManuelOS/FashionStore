---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import CarouselImageUploader from "../../../components/islands/CarouselImageUploader";
import { createCarouselSlide } from "../../../lib/supabase";

let error = "";
let success = false;

if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();

    const title = formData.get("title")?.toString() || "";
    const subtitle = formData.get("subtitle")?.toString() || "";
    const description = formData.get("description")?.toString() || "";
    const image_url = formData.get("image_url")?.toString() || "";
    const cta_text = formData.get("cta_text")?.toString() || "Ver más";
    const cta_link = formData.get("cta_link")?.toString() || "/productos";
    const discount_code = formData.get("discount_code")?.toString() || "";
    const duration = parseInt(formData.get("duration")?.toString() || "5000");
    const sort_order = parseInt(formData.get("sort_order")?.toString() || "0");
    const is_active = formData.get("is_active") === "true";
    const style_config_raw = formData.get("style_config")?.toString();
    let style_config = {};

    try {
        if (style_config_raw) {
            style_config = JSON.parse(style_config_raw);
        }
    } catch (e) {
        console.error("Error parsing style_config", e);
    }

    if (!title || !image_url) {
        error = "El título y la imagen son obligatorios";
    } else {
        try {
            await createCarouselSlide({
                title,
                subtitle: subtitle || null,
                description: description || null,
                image_url,
                cta_text,
                cta_link,
                discount_code: discount_code || null,
                duration,
                sort_order,
                is_active,
                style_config,
            });
            return Astro.redirect("/admin/carrusel?saved=true");
        } catch (e: any) {
            error = e.message || "Error al crear la slide";
        }
    }
}
---

<AdminLayout title="Nueva Slide del Carrusel">
    <div class="w-full max-w-[1800px] mx-auto px-4">
        <!-- Header -->
        <div class="flex items-center gap-4 mb-8">
            <a
                href="/admin/carrusel"
                class="p-2 text-zinc-400 hover:text-zinc-900 hover:bg-zinc-100 rounded-lg transition-colors"
            >
                <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15 19l-7-7 7-7"></path>
                </svg>
            </a>
            <div>
                <h1 class="text-2xl font-bold text-zinc-900">Nueva Slide</h1>
                <p class="text-zinc-500 mt-0.5">
                    Añade una nueva imagen al carrusel del homepage
                </p>
            </div>
        </div>

        {
            error && (
                <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl text-red-700">
                    {error}
                </div>
            )
        }

        <!-- Main Grid Layout -->
        <div class="grid grid-cols-1 xl:grid-cols-12 gap-8 items-start">
            <!-- Left Column: Live Preview -->
            <div class="xl:col-span-8 sticky top-6">
                <div class="mb-4">
                    <h2
                        class="text-lg font-semibold text-zinc-900 mb-4 flex items-center gap-2"
                    >
                        <svg
                            class="w-5 h-5 text-purple-600"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                            ></path>
                        </svg>
                        Vista Previa
                    </h2>
                    <div
                        class="relative w-full aspect-[21/9] rounded-2xl overflow-hidden shadow-2xl group border border-zinc-200 bg-zinc-100"
                    >
                        <!-- Background Image -->
                        <img
                            id="preview-image"
                            src="/placeholder-image.jpg"
                            alt="Preview"
                            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 opacity-0"
                            onload="this.style.opacity = this.src.includes('placeholder') ? '0' : '1'"
                        />
                        <div
                            class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/40 to-transparent"
                        >
                        </div>

                        <!-- Content Container -->
                        <div
                            class="absolute inset-0 flex flex-col justify-center px-10 sm:px-16 max-w-3xl"
                        >
                            <span
                                id="preview-subtitle"
                                class="text-cyan-400 font-medium tracking-wider text-sm sm:text-base uppercase mb-2 sm:mb-4 opacity-0 translate-y-4 transition-all duration-700 delay-100"
                                style="opacity: 1; transform: translateY(0);"
                            >
                            </span>
                            <h1
                                id="preview-title"
                                class="text-4xl sm:text-5xl md:text-7xl font-bold text-white mb-4 sm:mb-6 leading-tight opacity-0 translate-y-4 transition-all duration-700 delay-200"
                                style="opacity: 1; transform: translateY(0);"
                            >
                            </h1>
                            <p
                                id="preview-description"
                                class="text-zinc-300 text-base sm:text-lg md:text-xl max-w-2xl mb-8 opacity-0 translate-y-4 transition-all duration-700 delay-300"
                                style="opacity: 1; transform: translateY(0);"
                            >
                            </p>
                            <div
                                id="preview-discount-container"
                                class="hidden mb-8 inline-flex items-center gap-3 bg-white/10 backdrop-blur-md border border-white/20 rounded-lg px-4 py-2 opacity-0 translate-y-4 transition-all duration-700 delay-400"
                                style="opacity: 1; transform: translateY(0);"
                            >
                                <span class="text-white/80 text-sm font-medium"
                                    >CÓDIGO:</span
                                >
                                <span
                                    id="preview-discount-code"
                                    class="text-[#d4af37] font-mono font-bold tracking-wider text-lg"
                                ></span>
                            </div>

                            <div
                                <div
                                id="preview-subtitle-wrapper"
                                data-key="subtitle"
                                class="draggable-item absolute"
                                style="top: 10%; left: 10%;"
                            >
                                <span
                                    id="preview-subtitle"
                                    class="text-cyan-400 font-medium tracking-wider text-sm sm:text-base uppercase mb-2 sm:mb-4 opacity-0 translate-y-4 transition-all duration-700 delay-100"
                                    style="opacity: 1; transform: translateY(0);"
                                >
                                </span>
                            </div>
                            <div
                                id="preview-title-wrapper"
                                data-key="title"
                                class="draggable-item absolute"
                                style="top: 20%; left: 10%;"
                            >
                                <h1
                                    id="preview-title"
                                    class="text-4xl sm:text-5xl md:text-7xl font-bold text-white mb-4 sm:mb-6 leading-tight opacity-0 translate-y-4 transition-all duration-700 delay-200"
                                    style="opacity: 1; transform: translateY(0);"
                                >
                                </h1>
                            </div>
                            <div
                                id="preview-description-wrapper"
                                data-key="description"
                                class="draggable-item absolute"
                                style="top: 40%; left: 10%;"
                            >
                                <p
                                    id="preview-description"
                                    class="text-zinc-300 text-base sm:text-lg md:text-xl max-w-2xl mb-8 opacity-0 translate-y-4 transition-all duration-700 delay-300"
                                    style="opacity: 1; transform: translateY(0);"
                                >
                                </p>
                            </div>
                            <div
                                id="preview-discount-wrapper"
                                data-key="discount"
                                class="draggable-item absolute"
                                style="top: 60%; left: 10%;"
                            >
                                <div
                                    id="preview-discount-container"
                                    class="hidden mb-8 inline-flex items-center gap-3 bg-white/10 backdrop-blur-md border border-white/20 rounded-lg px-4 py-2 opacity-0 translate-y-4 transition-all duration-700 delay-400"
                                    style="opacity: 1; transform: translateY(0);"
                                >
                                    <span
                                        class="text-white/80 text-sm font-medium"
                                        >CÓDIGO:</span
                                    >
                                    <span
                                        id="preview-discount-code"
                                        class="text-[#d4af37] font-mono font-bold tracking-wider text-lg"
                                    ></span>
                                </div>
                            </div>

                            <div
                                id="preview-cta-wrapper"
                                data-key="cta"
                                class="draggable-item absolute"
                                style="top: 80%; left: 10%;"
                            >
                                <div
                                    class="opacity-0 translate-y-4 transition-all duration-700 delay-500"
                                    style="opacity: 1; transform: translateY(0);"
                                >
                                    <span
                                        id="preview-cta-text-inner"
                                        class="px-8 py-4 bg-white text-black font-semibold rounded-full hover:bg-zinc-200 transition-colors inline-flex items-center gap-2"
                                    >
                                        Ver más
                                        <svg
                                            class="w-5 h-5"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                            ><path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M17 8l4 4m0 0l-4 4m4-4H3"
                                            ></path></svg
                                        >
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Form -->
            <div class="xl:col-span-4">
                <form method="POST" class="space-y-6">
                    <!-- Hidden input for style_config -->
                    <input
                        type="hidden"
                        name="style_config"
                        id="style_config"
                        value="{}"
                    />
                    <!-- Image Section -->
                    <div
                        class="bg-white rounded-2xl border border-zinc-200 p-6"
                    >
                        <h2
                            class="text-base font-semibold text-zinc-900 flex items-center gap-2 mb-5"
                        >
                            <svg
                                class="w-5 h-5 text-cyan-600"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                                ></path></svg
                            >
                            Imagen de la Slide
                        </h2>
                        <div>
                            <label
                                class="block text-sm font-medium text-zinc-700 mb-2"
                                >Imagen del carrusel <span class="text-red-500"
                                    >*</span
                                ></label
                            >
                            <div class="space-y-4">
                                <div class="space-y-2">
                                    <label
                                        class="block text-sm font-medium text-zinc-700"
                                    >
                                        Imagen (opcional para actualizar)
                                    </label>
                                    <input
                                        type="file"
                                        name="image"
                                        id="image"
                                        accept="image/*"
                                        class="w-full px-4 py-3 bg-zinc-50 border border-zinc-200 rounded-xl text-zinc-900 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-cyan-500 file:text-white hover:file:bg-cyan-600 transition-all cursor-pointer"
                                        onchange="updatePreviewImage(this)"
                                    />
                                    <p class="text-xs text-zinc-500">
                                        Formatos soportados: JPG, PNG, WEBP.
                                        Max: 5MB.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Content Section -->
                    <div
                        class="bg-white rounded-2xl border border-zinc-200 p-6"
                    >
                        <h2
                            class="text-base font-semibold text-zinc-900 flex items-center gap-2 mb-5"
                        >
                            <svg
                                class="w-5 h-5 text-cyan-600"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                                ></path>
                            </svg>
                            Contenido
                        </h2>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div>
                                <label
                                    for="title"
                                    class="block text-sm font-medium text-zinc-700 mb-2"
                                >
                                    Título <span class="text-red-500">*</span>
                                </label>
                                <input
                                    type="text"
                                    id="title"
                                    name="title"
                                    required
                                    placeholder="Nueva Colección"
                                    class="w-full px-4 py-3 bg-zinc-50 border border-zinc-200 rounded-xl text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 transition-all"
                                    oninput="document.getElementById('preview-title').textContent = this.value"
                                />
                            </div>

                            <div>
                                <label
                                    for="subtitle"
                                    class="block text-sm font-medium text-zinc-700 mb-2"
                                >
                                    Subtítulo
                                </label>
                                <input
                                    type="text"
                                    id="subtitle"
                                    name="subtitle"
                                    placeholder="Primavera 2026"
                                    class="w-full px-4 py-3 bg-zinc-50 border border-zinc-200 rounded-xl text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 transition-all"
                                    oninput="document.getElementById('preview-subtitle').textContent = this.value"
                                />
                            </div>
                        </div>

                        <div class="mt-5">
                            <label
                                for="discount_code"
                                class="block text-sm font-medium text-zinc-700 mb-2"
                            >
                                Código de Descuento (Opcional)
                            </label>
                            <div class="relative">
                                <div
                                    class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
                                >
                                    <svg
                                        class="h-5 w-5 text-zinc-400"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"
                                        ></path>
                                    </svg>
                                </div>
                                <input
                                    type="text"
                                    id="discount_code"
                                    name="discount_code"
                                    placeholder="EJ: VERANO2026"
                                    class="w-full pl-10 px-4 py-3 bg-zinc-50 border border-zinc-200 rounded-xl text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 transition-all uppercase"
                                    oninput="const el = document.getElementById('preview-discount-container'); const code = document.getElementById('preview-discount-code'); if(this.value){ el.classList.remove('hidden'); code.textContent = this.value; } else { el.classList.add('hidden'); }"
                                />
                            </div>
                            <p class="text-xs text-zinc-500 mt-1.5">
                                Aparecerá destacado en la slide para que los
                                usuarios lo copien.
                            </p>
                        </div>

                        <div class="mt-5">
                            <label
                                for="description"
                                class="block text-sm font-medium text-zinc-700 mb-2"
                            >
                                Descripción
                            </label>
                            <textarea
                                id="description"
                                name="description"
                                rows={3}
                                placeholder="Descubre las últimas tendencias en moda masculina"
                                class="w-full px-4 py-3 bg-zinc-50 border border-zinc-200 rounded-xl text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 transition-all resize-none"
                                oninput="document.getElementById('preview-description').textContent = this.value"
                            ></textarea>
                        </div>
                    </div>

                    <!-- CTA Section -->
                    <div
                        class="bg-white rounded-2xl border border-zinc-200 p-6"
                    >
                        <h2
                            class="text-base font-semibold text-zinc-900 flex items-center gap-2 mb-5"
                        >
                            <svg
                                class="w-5 h-5 text-cyan-600"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"
                                ></path>
                            </svg>
                            Botón de Acción (CTA)
                        </h2>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div>
                                <label
                                    for="cta_text"
                                    class="block text-sm font-medium text-zinc-700 mb-2"
                                >
                                    Texto del botón
                                </label>
                                <input
                                    type="text"
                                    id="cta_text"
                                    name="cta_text"
                                    value="Ver más"
                                    placeholder="Explorar"
                                    class="w-full px-4 py-3 bg-zinc-50 border border-zinc-200 rounded-xl text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 transition-all"
                                    oninput="document.getElementById('preview-cta-text-inner').textContent = this.value"
                                />
                            </div>

                            <div>
                                <label
                                    for="cta_link"
                                    class="block text-sm font-medium text-zinc-700 mb-2"
                                >
                                    Enlace del botón
                                </label>
                                <input
                                    type="text"
                                    id="cta_link"
                                    name="cta_link"
                                    value="/productos"
                                    placeholder="/productos"
                                    class="w-full px-4 py-3 bg-zinc-50 border border-zinc-200 rounded-xl text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 transition-all"
                                />
                            </div>
                        </div>
                    </div>

                    <!-- Config Section -->
                    <div
                        class="bg-white rounded-2xl border border-zinc-200 p-6"
                    >
                        <h2
                            class="text-base font-semibold text-zinc-900 flex items-center gap-2 mb-5"
                        >
                            <svg
                                class="w-5 h-5 text-cyan-600"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                                ></path>
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                            Configuración
                        </h2>

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                            <div>
                                <label
                                    for="duration"
                                    class="block text-sm font-medium text-zinc-700 mb-2"
                                >
                                    Duración (ms)
                                </label>
                                <div class="relative">
                                    <input
                                        type="number"
                                        id="duration"
                                        name="duration"
                                        value="5000"
                                        min="1000"
                                        max="30000"
                                        step="500"
                                        class="w-full px-4 py-3 pr-12 bg-zinc-50 border border-zinc-200 rounded-xl text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 transition-all"
                                    />
                                    <span
                                        class="absolute right-4 top-1/2 -translate-y-1/2 text-zinc-400 text-sm"
                                        >ms</span
                                    >
                                </div>
                                <p class="text-xs text-zinc-500 mt-1.5">
                                    5000ms = 5 segundos
                                </p>
                            </div>

                            <div>
                                <label
                                    for="sort_order"
                                    class="block text-sm font-medium text-zinc-700 mb-2"
                                >
                                    Orden
                                </label>
                                <input
                                    type="number"
                                    id="sort_order"
                                    name="sort_order"
                                    value="0"
                                    min="0"
                                    class="w-full px-4 py-3 bg-zinc-50 border border-zinc-200 rounded-xl text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 transition-all"
                                />
                                <p class="text-xs text-zinc-500 mt-1.5">
                                    Menor número = primero
                                </p>
                            </div>

                            <div>
                                <label
                                    class="block text-sm font-medium text-zinc-700 mb-2"
                                >
                                    Estado
                                </label>
                                <label
                                    class="flex items-center gap-3 px-4 py-3 bg-zinc-50 border border-zinc-200 rounded-xl cursor-pointer hover:border-cyan-500 transition-colors"
                                >
                                    <input
                                        type="checkbox"
                                        name="is_active"
                                        value="true"
                                        checked
                                        class="w-5 h-5 rounded border-zinc-300 text-cyan-600 focus:ring-cyan-500"
                                    />
                                    <span class="text-zinc-700">Activa</span>
                                </label>
                            </div>
                        </div>
                        <p class="text-sm text-zinc-500 mt-2 text-center">
                            Arrastra cada elemento para posicionarlo donde
                            quieras.
                        </p>
                    </div>

                    <!-- Actions -->
                    <div class="flex items-center justify-end gap-4 pt-4">
                        <a
                            href="/admin/carrusel"
                            class="px-6 py-3 text-zinc-500 hover:text-zinc-900 transition-colors"
                        >
                            Cancelar
                        </a>
                        <button
                            type="submit"
                            class="px-6 py-3 bg-zinc-900 text-white font-semibold rounded-xl hover:bg-zinc-800 transition-all hover:-translate-y-0.5 flex items-center gap-2"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M5 13l4 4L19 7"></path>
                            </svg>
                            Crear Slide
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Fullscreen Overlay -->
    <div
        id="fullscreen-overlay"
        class="fixed inset-0 bg-black bg-opacity-90 z-50 hidden flex items-center justify-center p-4"
    >
        <button
            id="close-fullscreen"
            class="absolute top-4 right-4 text-white text-2xl z-50 p-2 rounded-full hover:bg-white/20 transition-colors"
        >
            &times;
        </button>
    </div>

    <script>
        // Toggle Mobile/Desktop View
        const viewDesktop = document.getElementById("view-desktop");
        const viewMobile = document.getElementById("view-mobile");
        const viewFullscreen = document.getElementById("view-fullscreen");
        const previewWrapper = document.getElementById("preview-wrapper");
        const fullscreenOverlay = document.getElementById("fullscreen-overlay");
        const closeFullscreen = document.getElementById("close-fullscreen");
        const previewBgContainer = document.getElementById(
            "preview-bg-container",
        );

        // Store original parent to restore after fullscreen
        const originalParent = previewWrapper?.parentElement;

        if (viewDesktop && viewMobile && previewWrapper) {
            viewDesktop.addEventListener("click", () => {
                previewWrapper.style.maxWidth = "100%";
                previewWrapper.style.aspectRatio = "16/9";
                viewDesktop.classList.add(
                    "bg-white",
                    "shadow-sm",
                    "text-zinc-900",
                );
                viewDesktop.classList.remove("text-zinc-500");
                viewMobile.classList.remove(
                    "bg-white",
                    "shadow-sm",
                    "text-zinc-900",
                );
                viewMobile.classList.add("text-zinc-500");
            });

            viewMobile.addEventListener("click", () => {
                previewWrapper.style.maxWidth = "375px";
                previewWrapper.style.aspectRatio = "9/16";
                viewMobile.classList.add(
                    "bg-white",
                    "shadow-sm",
                    "text-zinc-900",
                );
                viewMobile.classList.remove("text-zinc-500");
                viewDesktop.classList.remove(
                    "bg-white",
                    "shadow-sm",
                    "text-zinc-900",
                );
                viewDesktop.classList.add("text-zinc-500");
            });
        }

        // Fullscreen Logic
        if (
            viewFullscreen &&
            fullscreenOverlay &&
            previewWrapper &&
            closeFullscreen &&
            previewBgContainer
        ) {
            viewFullscreen.addEventListener("click", () => {
                fullscreenOverlay.classList.remove("hidden");
                fullscreenOverlay.appendChild(previewWrapper);

                // Add immersive mode classes
                previewWrapper.style.maxWidth = "90vw";
                previewWrapper.style.maxHeight = "90vh";
                previewWrapper.style.height = "auto";
                previewWrapper.style.aspectRatio = "16/9";
            });

            closeFullscreen.addEventListener("click", () => {
                fullscreenOverlay.classList.add("hidden");
                originalParent.prepend(previewWrapper); // Restore to original location

                // Restore styles
                // Check which mode was active
                if (viewMobile?.classList.contains("text-zinc-900")) {
                    previewWrapper.style.maxWidth = "375px";
                    previewWrapper.style.aspectRatio = "9/16";
                } else {
                    previewWrapper.style.maxWidth = "100%";
                    previewWrapper.style.aspectRatio = "16/9";
                }
                previewWrapper.style.maxHeight = "";
                previewWrapper.style.height = "";
            });
        }

        // Granular Drag and Drop Logic
        const container = document.getElementById("preview-container");
        const draggables = document.querySelectorAll(".draggable-item");
        const styleInput = document.getElementById("style_config");

        let activeDraggable = null;
        let currentX;
        let currentY;
        let initialX;
        let initialY;
        let xOffset = 0;
        let yOffset = 0;

        // Load initial config
        let currentConfig = {};
        try {
            currentConfig = JSON.parse(styleInput.value || "{}");
        } catch (e) {
            currentConfig = {};
        }

        // Apply initial styles from config
        draggables.forEach((el) => {
            const key = el.dataset.key;
            if (currentConfig[key]) {
                el.style.top = currentConfig[key].top;
                el.style.left = currentConfig[key].left;
                // Reset transform if it was set by JS before
                el.style.transform = "translate3d(0px, 0px, 0px)";
            }
        });

        if (container) {
            container.addEventListener("mousedown", dragStart);
            container.addEventListener("mouseup", dragEnd);
            container.addEventListener("mousemove", drag);
            container.addEventListener("mouseleave", dragEnd);
        }

        function dragStart(e) {
            const target = e.target.closest(".draggable-item");
            if (target) {
                activeDraggable = target;

                const style = window.getComputedStyle(activeDraggable);
                const matrix = new WebKitCSSMatrix(style.transform);
                xOffset = matrix.m41;
                yOffset = matrix.m42;

                initialX = e.clientX - xOffset;
                initialY = e.clientY - yOffset;
            }
        }

        function dragEnd(e) {
            if (!activeDraggable) return;

            initialX = currentX;
            initialY = currentY;

            // Update styling config
            updateConfig(activeDraggable);

            activeDraggable = null;
        }

        function drag(e) {
            if (activeDraggable) {
                e.preventDefault();
                currentX = e.clientX - initialX;
                currentY = e.clientY - initialY;

                setTranslate(currentX, currentY, activeDraggable);
            }
        }

        function setTranslate(xPos, yPos, el) {
            el.style.transform = `translate3d(${xPos}px, ${yPos}px, 0)`;
        }

        function updateConfig(element) {
            if (!container || !styleInput) return;

            const rect = container.getBoundingClientRect();
            const dragRect = element.getBoundingClientRect();
            const key = element.dataset.key;

            // Calculate percentage relative to container
            const topPercent = ((dragRect.top - rect.top) / rect.height) * 100;
            const leftPercent =
                ((dragRect.left - rect.left) / rect.width) * 100;

            const clampedTop = Math.max(0, Math.min(98, topPercent));
            const clampedLeft = Math.max(0, Math.min(98, leftPercent));

            // Update config object
            currentConfig[key] = {
                top: `${clampedTop.toFixed(2)}%`,
                left: `${clampedLeft.toFixed(2)}%`,
            };

            // Update hidden input
            styleInput.value = JSON.stringify(currentConfig);
        }

        function updatePreviewImage(input) {
            const previewImage = document.getElementById("preview-image");
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    previewImage.src = e.target.result;
                    previewImage.style.opacity = "1"; // Ensure image is visible
                };
                reader.readAsDataURL(input.files[0]);
            } else {
                previewImage.src = "/placeholder-image.jpg";
                previewImage.style.opacity = "0"; // Hide placeholder
            }
        }
    </script>
</AdminLayout>
