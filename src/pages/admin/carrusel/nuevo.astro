                                        type="file"
                                        name="image"
                                        id="image"
                                        accept="image/*"
                                        class="w-full px-4 py-3 bg-dark-300 border border-white/10 rounded-xl text-zinc-100 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-neon-cyan file:text-black hover:file:bg-cyan-400 transition-all cursor-pointer"
                                        onchange="updatePreviewImage(this)"
                                    />
                                    <p class="text-xs text-zinc-500">
                                        Formatos soportados: JPG, PNG, WEBP.
                                        Max: 5MB.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Content Section -->
                    <div
                        class="bg-dark-400 rounded-2xl border border-white/10 p-6"
                    >
                        <h2
                            class="text-base font-semibold text-zinc-100 flex items-center gap-2 mb-5"
                        >
                            <svg
                                class="w-5 h-5 text-neon-cyan"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                                ></path>
                            </svg>
                            Contenido
                        </h2>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div>
                                <label
                                    for="title"
                                    class="block text-sm font-medium text-zinc-300 mb-2"
                                >
                                    Título <span class="text-red-400">*</span>
                                </label>
                                <input
                                    type="text"
                                    id="title"
                                    name="title"
                                    required
                                    placeholder="Nueva Colección"
                                    class="w-full px-4 py-3 bg-dark-300 border border-white/10 rounded-xl text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-neon-cyan focus:ring-2 focus:ring-neon-cyan/20 transition-all"
                                    oninput="document.getElementById('preview-title').textContent = this.value"
                                />
                            </div>

                            <div>
                                <label
                                    for="subtitle"
                                    class="block text-sm font-medium text-zinc-300 mb-2"
                                >
                                    Subtítulo
                                </label>
                                <input
                                    type="text"
                                    id="subtitle"
                                    name="subtitle"
                                    placeholder="Primavera 2026"
                                    class="w-full px-4 py-3 bg-dark-300 border border-white/10 rounded-xl text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-neon-cyan focus:ring-2 focus:ring-neon-cyan/20 transition-all"
                                    oninput="document.getElementById('preview-subtitle').textContent = this.value"
                                />
                            </div>
                        </div>

                        <div class="mt-5">
                            <label
                                for="discount_code"
                                class="block text-sm font-medium text-zinc-300 mb-2"
                            >
                                Código de Descuento (Opcional)
                            </label>
                            <div class="relative">
                                <div
                                    class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
                                >
                                    <svg
                                        class="h-5 w-5 text-zinc-400"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"
                                        ></path>
                                    </svg>
                                </div>
                                <input
                                    type="text"
                                    id="discount_code"
                                    name="discount_code"
                                    placeholder="EJ: VERANO2026"
                                    class="w-full pl-10 px-4 py-3 bg-dark-300 border border-white/10 rounded-xl text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-neon-cyan focus:ring-2 focus:ring-neon-cyan/20 transition-all uppercase"
                                    oninput="const el = document.getElementById('preview-discount-container'); const code = document.getElementById('preview-discount-code'); if(this.value){ el.classList.remove('hidden'); code.textContent = this.value; } else { el.classList.add('hidden'); }"
                                />
                            </div>
                            <p class="text-xs text-zinc-500 mt-1.5">
                                Aparecerá destacado en la slide para que los
                                usuarios lo copien.
                            </p>
                        </div>

                        <div class="mt-5">
                            <label
                                for="description"
                                class="block text-sm font-medium text-zinc-300 mb-2"
                            >
                                Descripción
                            </label>
                            <textarea
                                id="description"
                                name="description"
                                rows={3}
                                placeholder="Descubre las últimas tendencias en moda masculina"
                                class="w-full px-4 py-3 bg-dark-300 border border-white/10 rounded-xl text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-neon-cyan focus:ring-2 focus:ring-neon-cyan/20 transition-all resize-none"
                                oninput="document.getElementById('preview-description').textContent = this.value"
                            ></textarea>
                        </div>
                    </div>

                    <!-- CTA Section -->
                    <div
                        class="bg-dark-400 rounded-2xl border border-white/10 p-6"
                    >
                        <h2
                            class="text-base font-semibold text-zinc-100 flex items-center gap-2 mb-5"
                        >
                            <svg
                                class="w-5 h-5 text-neon-cyan"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
