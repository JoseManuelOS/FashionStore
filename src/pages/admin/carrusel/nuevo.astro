                                    for="cta_link"
                                    class="block text-sm font-medium text-zinc-300 mb-2"
                                >
                                    Enlace del botón
                                </label>
                                <!-- Custom dropdown trigger -->
                                <button
                                    type="button"
                                    id="ctaDropdownBtn"
                                    onclick="toggleCtaDropdown()"
                                    class="w-full px-4 py-3 bg-dark-300 border border-white/10 rounded-xl text-zinc-100 focus:outline-none focus:border-neon-cyan text-sm flex items-center justify-between gap-2"
                                >
                                    <span id="ctaDropdownLabel" class="flex items-center gap-2 truncate text-left">
                                        <svg class="w-4 h-4 text-neon-cyan flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 11H4L5 9z"/></svg>
                                        Todos los productos
                                    </span>
                                    <svg id="ctaDropdownChevron" class="w-4 h-4 text-zinc-400 flex-shrink-0 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                                    </svg>
                                </button>
                                <!-- Dropdown list -->
                                <div id="ctaDropdownList" class="hidden absolute z-50 w-full mt-1 bg-dark-200 border border-white/10 rounded-lg shadow-xl overflow-hidden">
                                    <div class="py-1">
                                        <button type="button" onclick="selectCtaOption('/productos', this)" data-value="/productos" class="cta-option w-full px-3 py-2 text-sm text-left flex items-center gap-3 hover:bg-neon-cyan/10 text-zinc-100 transition-colors bg-neon-cyan/5">
                                            <svg class="w-4 h-4 text-neon-cyan flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 11H4L5 9z"/></svg>
                                            Todos los productos
                                        </button>
                                        <button type="button" onclick="selectCtaOption('/ofertas', this)" data-value="/ofertas" class="cta-option w-full px-3 py-2 text-sm text-left flex items-center gap-3 hover:bg-neon-cyan/10 text-zinc-100 transition-colors">
                                            <svg class="w-4 h-4 text-orange-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                                            Ofertas y descuentos
                                        </button>
                                        <button type="button" onclick="selectCtaOption('/categoria/camisas', this)" data-value="/categoria/camisas" class="cta-option w-full px-3 py-2 text-sm text-left flex items-center gap-3 hover:bg-neon-cyan/10 text-zinc-100 transition-colors">
                                            <svg class="w-4 h-4 text-blue-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                                            Camisas
                                        </button>
                                        <button type="button" onclick="selectCtaOption('/categoria/pantalones', this)" data-value="/categoria/pantalones" class="cta-option w-full px-3 py-2 text-sm text-left flex items-center gap-3 hover:bg-neon-cyan/10 text-zinc-100 transition-colors">
                                            <svg class="w-4 h-4 text-indigo-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2 2z"/></svg>
                                            Pantalones
                                        </button>
                                        <button type="button" onclick="selectCtaOption('/categoria/chaquetas', this)" data-value="/categoria/chaquetas" class="cta-option w-full px-3 py-2 text-sm text-left flex items-center gap-3 hover:bg-neon-cyan/10 text-zinc-100 transition-colors">
                                            <svg class="w-4 h-4 text-purple-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3l4 4-4 4M3 12h18M19 3l-4 4 4 4"/></svg>
                                            Chaquetas
