            &times;
        </button>
    </div>

    <script>
        // Toggle Mobile/Desktop View
        const viewDesktop = document.getElementById("view-desktop");
        const viewMobile = document.getElementById("view-mobile");
        const viewFullscreen = document.getElementById("view-fullscreen");
        const previewWrapper = document.getElementById("preview-wrapper");
        const fullscreenOverlay = document.getElementById("fullscreen-overlay");
        const closeFullscreen = document.getElementById("close-fullscreen");
        const previewBgContainer = document.getElementById(
            "preview-bg-container",
        );

        // Store original parent to restore after fullscreen
        const originalParent = previewWrapper?.parentElement;

        if (viewDesktop && viewMobile && previewWrapper) {
            viewDesktop.addEventListener("click", () => {
                previewWrapper.style.maxWidth = "100%";
                previewWrapper.style.aspectRatio = "16/9";
                viewDesktop.classList.add(
                    "bg-white",
                    "shadow-sm",
                    "text-zinc-900",
                );
                viewDesktop.classList.remove("text-zinc-500");
                viewMobile.classList.remove(
                    "bg-white",
                    "shadow-sm",
                    "text-zinc-900",
                );
                viewMobile.classList.add("text-zinc-500");
            });

            viewMobile.addEventListener("click", () => {
                previewWrapper.style.maxWidth = "375px";
                previewWrapper.style.aspectRatio = "9/16";
                viewMobile.classList.add(
                    "bg-white",
                    "shadow-sm",
                    "text-zinc-900",
                );
                viewMobile.classList.remove("text-zinc-500");
                viewDesktop.classList.remove(
                    "bg-white",
                    "shadow-sm",
                    "text-zinc-900",
                );
                viewDesktop.classList.add("text-zinc-500");
            });
        }

        // Fullscreen Logic
        if (
            viewFullscreen &&
            fullscreenOverlay &&
            previewWrapper &&
            closeFullscreen &&
            previewBgContainer
        ) {
            viewFullscreen.addEventListener("click", () => {
                fullscreenOverlay.classList.remove("hidden");
                fullscreenOverlay.appendChild(previewWrapper);

                // Add immersive mode classes
                previewWrapper.style.maxWidth = "90vw";
                previewWrapper.style.maxHeight = "90vh";
                previewWrapper.style.height = "auto";
                previewWrapper.style.aspectRatio = "16/9";
            });

            closeFullscreen.addEventListener("click", () => {
                fullscreenOverlay.classList.add("hidden");
                if (originalParent) originalParent.prepend(previewWrapper); // Restore to original location

                // Restore styles
                // Check which mode was active
                if (viewMobile?.classList.contains("text-zinc-900")) {
                    previewWrapper.style.maxWidth = "375px";
                    previewWrapper.style.aspectRatio = "9/16";
                } else {
                    previewWrapper.style.maxWidth = "100%";
                    previewWrapper.style.aspectRatio = "16/9";
                }
                previewWrapper.style.maxHeight = "";
                previewWrapper.style.height = "";
            });
        }

        // Granular Drag and Drop Logic
        const container = document.getElementById("preview-container");
        const draggables = document.querySelectorAll<HTMLElement>(".draggable-item");
        const styleInput = document.getElementById("style_config") as HTMLInputElement | null;

        let activeDraggable: HTMLElement | null = null;
        let initialMouseX: number = 0;
        let initialMouseY: number = 0;
        let startTopPercent: number = 0;
        let startLeftPercent: number = 0;

        // Load initial config (use desktop/mobile structure for public page compatibility)
        interface PositionConfig { top: string; left: string; }
        interface ViewConfig { [key: string]: PositionConfig; }
        interface StyleConfig { desktop?: ViewConfig; mobile?: ViewConfig; }
        
        let currentConfig: StyleConfig = { desktop: {}, mobile: {} };
        try {
            const raw = JSON.parse(styleInput?.value || "{}");
            // Handle flat legacy config → convert to desktop/mobile
            if (raw.desktop || raw.mobile) {
                currentConfig = raw;
            } else {
                currentConfig = { desktop: raw, mobile: raw };
            }
        } catch (e) {
            currentConfig = { desktop: {}, mobile: {} };
        }

        // Apply initial styles from config
        draggables.forEach((el) => {
            const key = (el as HTMLElement).dataset.key;
            const cfg = currentConfig.desktop?.[key || ""];
            if (key && cfg) {
                (el as HTMLElement).style.top = cfg.top;
                (el as HTMLElement).style.left = cfg.left;
                (el as HTMLElement).style.transform = "";
            }
        });

        if (container) {
            container.addEventListener("mousedown", dragStart);
            container.addEventListener("mouseup", dragEnd);
            container.addEventListener("mousemove", drag);
            container.addEventListener("mouseleave", dragEnd);
        }

        function dragStart(e: MouseEvent) {
            const target = (e.target as HTMLElement).closest<HTMLElement>(".draggable-item");
            if (target && container) {
                activeDraggable = target;
                // Store initial mouse position
                initialMouseX = e.clientX;
                initialMouseY = e.clientY;
                // Calculate current element position as percentage of container
                const containerRect = container.getBoundingClientRect();
                const elRect = activeDraggable.getBoundingClientRect();
                startTopPercent = ((elRect.top - containerRect.top) / containerRect.height) * 100;
                startLeftPercent = ((elRect.left - containerRect.left) / containerRect.width) * 100;
                activeDraggable.style.transform = "";
            }
        }

        function dragEnd(_e: MouseEvent) {
            if (!activeDraggable) return;
            updateConfig(activeDraggable);
            activeDraggable = null;
        }

        function drag(e: MouseEvent) {
            if (!activeDraggable || !container) return;
            e.preventDefault();
            // Calculate mouse delta as percentage of container
            const containerRect = container.getBoundingClientRect();
            const deltaXPercent = ((e.clientX - initialMouseX) / containerRect.width) * 100;
            const deltaYPercent = ((e.clientY - initialMouseY) / containerRect.height) * 100;
            // Apply new position directly as percentage
            const newTop = Math.max(0, Math.min(95, startTopPercent + deltaYPercent));
            const newLeft = Math.max(0, Math.min(95, startLeftPercent + deltaXPercent));
            activeDraggable.style.top = `${newTop.toFixed(2)}%`;
            activeDraggable.style.left = `${newLeft.toFixed(2)}%`;
        }

        function updateConfig(element: HTMLElement) {
            if (!container || !styleInput) return;
            const key = element.dataset.key;
            if (!key) return;
            // Read percentage values directly from CSS
            const top = element.style.top || "0%";
            const left = element.style.left || "0%";
            // Save to both desktop and mobile
            if (!currentConfig.desktop) currentConfig.desktop = {};
            if (!currentConfig.mobile) currentConfig.mobile = {};
            currentConfig.desktop[key] = { top, left };
            currentConfig.mobile[key] = { top, left };
            // Update hidden input
            styleInput.value = JSON.stringify(currentConfig);
        }

        function updatePreviewImage(input: HTMLInputElement) {
            const previewImage = document.getElementById("preview-image") as HTMLImageElement | null;
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    if (previewImage && e.target) {
                        previewImage.src = e.target.result as string;
                        previewImage.style.opacity = "1"; // Ensure image is visible
                    }
                };
                reader.readAsDataURL(input.files[0]);
            } else {
                if (previewImage) {
                    previewImage.src = "/placeholder-image.jpg";
                    previewImage.style.opacity = "0"; // Hide placeholder
                }
            }
        }
    </script>
</AdminLayout>
<script is:inline>
function toggleCtaDropdown() {
    const list = document.getElementById('ctaDropdownList');
    const chevron = document.getElementById('ctaDropdownChevron');
    const isOpen = !list.classList.contains('hidden');
    if (isOpen) {
        list.classList.add('hidden');
        chevron.style.transform = 'rotate(0deg)';
    } else {
        list.classList.remove('hidden');
        chevron.style.transform = 'rotate(180deg)';
    }
}

function selectCtaOption(value, btn) {
    const list = document.getElementById('ctaDropdownList');
    const chevron = document.getElementById('ctaDropdownChevron');
    const label = document.getElementById('ctaDropdownLabel');
    const hiddenInput = document.getElementById('cta_link');
    const customInput = document.getElementById('ctaCustomInput');

    document.querySelectorAll('.cta-option').forEach(el => el.classList.remove('bg-neon-cyan/5'));
    btn.classList.add('bg-neon-cyan/5');

    const svgEl = btn.querySelector('svg');
    const text = btn.textContent.trim();
    label.innerHTML = (svgEl ? svgEl.outerHTML : '') + '<span>' + text + '</span>';

    list.classList.add('hidden');
    chevron.style.transform = 'rotate(0deg)';

    if (value === 'custom') {
        customInput.classList.remove('hidden');
        customInput.focus();
        hiddenInput.value = customInput.value || '';
        customInput.oninput = function() { hiddenInput.value = customInput.value; };
    } else {
        customInput.classList.add('hidden');
        hiddenInput.value = value;
    }
}

// Close dropdown on outside click
document.addEventListener('click', function(e) {
    const btn = document.getElementById('ctaDropdownBtn');
    const list = document.getElementById('ctaDropdownList');
    if (btn && list && !btn.contains(e.target) && !list.contains(e.target)) {
        list.classList.add('hidden');
        const ch = document.getElementById('ctaDropdownChevron');
        if (ch) ch.style.transform = 'rotate(0deg)';
    }
});
</script>