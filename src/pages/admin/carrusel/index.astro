---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getAllCarouselSlides, deleteCarouselSlide } from "../../../lib/supabase";

// Handle delete action
if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const action = formData.get("action");
    const slideId = formData.get("slideId");

    if (action === "delete" && slideId) {
        try {
            await deleteCarouselSlide(slideId.toString());
            return Astro.redirect("/admin/carrusel?deleted=true");
        } catch (error) {
            console.error("Error deleting slide:", error);
        }
    }
}

// Fetch all slides
let slides: any[] = [];
let error = "";

try {
    slides = await getAllCarouselSlides();
} catch (e: any) {
    error = e.message || "Error al cargar las slides";
}

const deleted = Astro.url.searchParams.get("deleted");
const saved = Astro.url.searchParams.get("saved");
---

<AdminLayout title="Gestión del Carrusel">
    <div class="max-w-6xl">
        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
            <div>
                <h1 class="text-2xl font-bold text-zinc-100">Carrusel del Homepage</h1>
                <p class="text-zinc-400 mt-1">Gestiona las imágenes y configuración del carrusel principal</p>
            </div>
            <a
                href="/admin/carrusel/nuevo"
                class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-gradient-to-r from-neon-cyan to-cyan-500 text-black font-semibold rounded-xl hover:from-cyan-400 hover:to-cyan-600 transition-all duration-300 hover:-translate-y-0.5 shadow-lg shadow-neon-cyan/25"
            >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Nueva Slide
            </a>
        </div>

        <!-- Notifications -->
        {deleted && (
            <div class="mb-6 p-4 bg-dark-400 border border-emerald-500/30 rounded-xl text-emerald-400 flex items-center gap-3">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Slide eliminada correctamente
            </div>
        )}

        {saved && (
            <div class="mb-6 p-4 bg-dark-400 border border-emerald-500/30 rounded-xl text-emerald-400 flex items-center gap-3">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Slide guardada correctamente
            </div>
        )}

        {error && (
            <div class="mb-6 p-4 bg-dark-400 border border-red-500/30 rounded-xl text-red-400">
                {error}
            </div>
        )}

        <!-- Info Card -->
        <div class="mb-8 p-4 bg-dark-400 border border-neon-cyan/30 rounded-xl">
            <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-neon-cyan flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div>
                    <p class="font-semibold text-zinc-100 text-sm">Configuración del carrusel</p>
                    <p class="text-zinc-400 text-sm mt-0.5">Cada slide puede tener su propia duración. El orden determina la secuencia de visualización. Las slides inactivas no se mostrarán en el homepage.</p>
                </div>
            </div>
        </div>

        <!-- Slides Grid -->
        {slides.length > 0 ? (
            <div class="space-y-5">
                {slides.map((slide, index) => (
                    <div class={`bg-dark-400 rounded-2xl border overflow-hidden transition-shadow hover:shadow-lg ${slide.is_active ? 'border-white/10' : 'border-red-500/30 bg-red-900/20'}`}>
                        <div class="flex flex-col md:flex-row">
                            <!-- Image Preview -->
                            <div class="md:w-72 h-44 md:h-auto relative flex-shrink-0 bg-dark-300">
                                <img 
                                    src={slide.image_url} 
                                    alt={slide.title}
                                    class="w-full h-full object-cover"
                                />
                                <div class="absolute top-3 left-3 flex gap-2">
                                    <span class="px-2.5 py-1 bg-white/95 backdrop-blur-sm rounded-full text-xs font-semibold text-zinc-700 shadow-sm">
                                        #{index + 1}
                                    </span>
                                    {!slide.is_active && (
                                        <span class="px-2.5 py-1 bg-red-500 rounded-full text-xs font-semibold text-white">
                                            Inactiva
                                        </span>
                                    )}
                                </div>
                            </div>

                            <!-- Content -->
                            <div class="flex-1 p-5">
                                <div class="flex items-start justify-between gap-4">
                                    <div class="flex-1 min-w-0">
                                        <h3 class="text-lg font-bold text-zinc-100">{slide.title}</h3>
                                        {slide.subtitle && (
                                            <p class="text-neon-cyan font-medium text-sm mt-0.5">{slide.subtitle}</p>
                                        )}
                                        {slide.description && (
                                            <p class="text-zinc-400 text-sm mt-2 line-clamp-2">{slide.description}</p>
                                        )}

                                        <!-- Meta Info -->
                                        <div class="flex flex-wrap gap-x-5 gap-y-2 mt-4">
                                            <div class="flex items-center gap-1.5 text-sm text-zinc-400">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                                </svg>
                                                <span>Duración: <strong class="text-zinc-100">{slide.duration / 1000}s</strong></span>
                                            </div>
                                            <div class="flex items-center gap-1.5 text-sm text-zinc-400">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                                                </svg>
                                                <span>Enlace: <strong class="text-zinc-100">{slide.cta_link}</strong></span>
                                            </div>
                                            <div class="flex items-center gap-1.5 text-sm text-zinc-400">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" />
                                                </svg>
                                                <span>Botón: <strong class="text-zinc-100">{slide.cta_text}</strong></span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Actions -->
                                    <div class="flex items-center gap-1">
                                        <a
                                            href={`/admin/carrusel/${slide.id}`}
                                            class="p-2 text-zinc-400 hover:text-neon-cyan hover:bg-neon-cyan/10 rounded-lg transition-colors"
                                            title="Editar"
                                        >
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                            </svg>
                                        </a>
                                        <form method="POST" class="inline" onsubmit="return confirm('¿Eliminar esta slide del carrusel?')">
                                            <input type="hidden" name="action" value="delete" />
                                            <input type="hidden" name="slideId" value={slide.id} />
                                            <button
                                                type="submit"
                                                class="p-2 text-zinc-400 hover:text-red-400 hover:bg-red-500/10 rounded-lg transition-colors"
                                                title="Eliminar"
                                            >
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                </svg>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        ) : (
            <div class="text-center py-16 bg-dark-400 rounded-2xl border-2 border-dashed border-white/10">
                <svg class="w-16 h-16 mx-auto text-zinc-500 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <h3 class="text-xl font-semibold text-zinc-100 mb-2">No hay slides en el carrusel</h3>
                <p class="text-zinc-400 mb-6">Añade la primera imagen para comenzar</p>
                <a
                    href="/admin/carrusel/nuevo"
                    class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-neon-cyan to-cyan-500 text-black font-semibold rounded-xl hover:from-cyan-400 hover:to-cyan-600 transition-all duration-300 shadow-lg shadow-neon-cyan/25"
                >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    Crear primera slide
                </a>
            </div>
        )}
    </div>
</AdminLayout>
