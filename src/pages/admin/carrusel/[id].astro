                    >
                        <option value="0">▢ Cuadrado</option>
                        <option value="0.5rem">◢ Redondeado</option>
                        <option value="9999px" selected>◯ Píldora</option>
                    </select>
                </div>
            </div>

            <!-- Config Section -->
            <div class="bg-dark-400 rounded-xl border border-white/10 p-4">
                <h2
                    class="text-sm font-semibold text-zinc-900 flex items-center gap-2 mb-3"
                >
                    <svg
                        class="w-5 h-5 text-cyan-600"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                        ></path>
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    Configuración
                </h2>
                <div class="grid grid-cols-3 gap-3">
                    <div>
                        <label
                            for="duration"
                            class="block text-sm font-medium text-zinc-700 mb-1"
                            >Duración (ms)</label
                        >
                        <input
                            type="number"
                            id="duration"
                            name="duration"
                            value={slide.duration}
                            min="1000"
                            step="500"
                            class="w-full px-3 py-2 bg-dark-300 border border-white/10 rounded-lg text-zinc-100 focus:outline-none focus:border-neon-cyan focus:ring-1 focus:ring-neon-cyan/20"
                        />
                    </div>
                    <div>
                        <label
                            for="sort_order"
                            class="block text-sm font-medium text-zinc-700 mb-1"
                            >Orden</label
                        >
                        <input
                            type="number"
                            id="sort_order"
                            name="sort_order"
                            value={slide.sort_order}
                            min="0"
                            class="w-full px-3 py-2 bg-dark-300 border border-white/10 rounded-lg text-zinc-100 focus:outline-none focus:border-neon-cyan focus:ring-1 focus:ring-neon-cyan/20"
                        />
                    </div>
                    <div>
                        <label
                            class="block text-sm font-medium text-zinc-700 mb-1"
                            >Estado</label
                        >
                        <label
                            class="flex items-center gap-2 px-3 py-2 bg-dark-300 border border-white/10 rounded-lg cursor-pointer hover:border-neon-cyan transition-colors"
                        >
                            <input
                                type="checkbox"
                                name="is_active"
                                value="true"
                                checked={slide.is_active}
                                class="w-4 h-4 text-neon-cyan border-white/10 rounded focus:ring-neon-cyan"
                            />
                            <span class="text-sm text-zinc-100">Activo</span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Submit -->
            <div class="flex justify-end">
                <button
                    type="button"
                    id="save-carousel-btn"
                    class="px-6 py-3 bg-gradient-to-r from-cyan-600 to-cyan-500 text-white font-semibold rounded-xl hover:from-cyan-700 hover:to-cyan-600 transition-all hover:-translate-y-0.5 flex items-center gap-2 shadow-sm hover:shadow-md"
                >
                    <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M5 13l4 4L19 7"></path>
                    </svg>
                    Guardar Cambios
                </button>
            </div>
        </form>
    </div>
</AdminLayout>

<style>
