        font-size: 3.5rem;
        font-weight: 700;
        line-height: 1.1;
        color: white;
    }
    #preview-container .hero-subtitle {
        color: #d4af37;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        font-weight: 500;
        font-size: 1rem;
    }
    #preview-container .hero-description {
        color: rgb(228 228 231);
        font-size: 1.125rem;
        line-height: 1.6;
    }
    #preview-container .hero-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 1rem 2rem;
        background: white;
        color: black;
        font-weight: 600;
        border-radius: 9999px;
        font-size: 0.875rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }
    #preview-container::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to right,
            rgba(0, 0, 0, 0.7) 0%,
            rgba(0, 0, 0, 0.4) 50%,
            rgba(0, 0, 0, 0.2) 100%
        );
        z-index: 1;
        pointer-events: none;
    }
    input[type="color"] {
        -webkit-appearance: none;
        appearance: none;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0;
    }
    input[type="color"]::-webkit-color-swatch-wrapper {
        padding: 0;
        border-radius: 50%;
    }
    input[type="color"]::-webkit-color-swatch {
        border: 2px solid #e4e4e7;
        border-radius: 50%;
    }
    .draggable-item {
        z-index: 20 !important;
    }
    .resize-handle {
        position: absolute;
        width: 12px;
        height: 12px;
        background: #22d3ee;
        border: 2px solid white;
        border-radius: 2px;
        opacity: 0;
        transition: opacity 0.2s;
        z-index: 30;
    }
    .draggable-item:hover .resize-handle,
    .draggable-item.active .resize-handle {
        opacity: 1;
    }
    .resize-handle-se {
        bottom: -6px;
        right: -6px;
        cursor: se-resize;
    }
    .draggable-item.active {
        border-color: #22d3ee !important;
        background: rgba(34, 211, 238, 0.1);
    }
    #preview-wrapper.mobile-view .hero-title {
        font-size: 2rem !important;
    }
    #preview-wrapper.mobile-view .hero-subtitle {
        font-size: 0.875rem !important;
    }
    #preview-wrapper.mobile-view .hero-description {
        font-size: 0.875rem !important;
    }
</style>

<script>
    // ===== Modal Controls =====
    const previewModal = document.getElementById(
        "preview-modal",
    ) as HTMLElement;
    const openPreviewBtn = document.getElementById("open-preview-modal");
    const closePreviewBtn = document.getElementById("close-preview-modal");
    const previewModalBackdrop = document.getElementById(
        "preview-modal-backdrop",
    );

    const viewDesktop = document.getElementById("view-desktop");
    const viewMobile = document.getElementById("view-mobile");
    const previewWrapper = document.getElementById(
        "preview-wrapper",
    ) as HTMLElement;
    const container = document.getElementById(
        "preview-container",
    ) as HTMLElement;
    const styleInput = document.getElementById(
        "style_config",
    ) as HTMLInputElement;

    let currentView: "desktop" | "mobile" = "desktop";
    let activeDraggable: HTMLElement | null = null;
    let isResizing = false;
    let currentX = 0,
        currentY = 0,
        initialX = 0,
        initialY = 0,
        xOffset = 0,
        yOffset = 0;
    let initialWidth = 0;

    interface ElementConfig {
        top?: string;
        left?: string;
        fontSize?: string;
        maxWidth?: string;
        color?: string;
        fontWeight?: string;
        textTransform?: string;
        bgColor?: string;
        textColor?: string;
        borderRadius?: string;
    }
    interface ViewConfig {
        title?: ElementConfig;
        subtitle?: ElementConfig;
        description?: ElementConfig;
        cta?: ElementConfig;
        discount?: ElementConfig;
    }
    interface StyleConfig {
        desktop?: ViewConfig;
        mobile?: ViewConfig;
    }

    let currentConfig: StyleConfig = {};
    try {
        currentConfig = JSON.parse(styleInput?.value || "{}");
        if (!currentConfig.desktop && !currentConfig.mobile) {
            const legacy = { ...currentConfig };
            currentConfig = {
                desktop: legacy as ViewConfig,
                mobile: legacy as ViewConfig,
            };
        }
    } catch (e) {
        currentConfig = { desktop: {}, mobile: {} };
    }

    function openPreviewModal() {
        if (previewModal) {
            previewModal.classList.remove("hidden");
            document.body.style.overflow = "hidden";
            applyConfigToView();
        }
    }
    function closePreviewModal() {
        if (previewModal) {
            previewModal.classList.add("hidden");
            document.body.style.overflow = "";
        }
    }

    openPreviewBtn?.addEventListener("click", openPreviewModal);
    closePreviewBtn?.addEventListener("click", closePreviewModal);
    previewModalBackdrop?.addEventListener("click", closePreviewModal);
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !previewModal?.classList.contains("hidden"))
            closePreviewModal();
    });

    function switchView(view: "desktop" | "mobile") {
        currentView = view;
        const simulatedHeader = document.getElementById("simulated-header");
        if (previewWrapper && container) {
            if (view === "desktop") {
                previewWrapper.style.maxWidth = "95vw";
                container.style.aspectRatio = "";
                container.style.height = "70vh";
                container.style.maxHeight = "700px";
                container.style.minHeight = "400px";
                previewWrapper.classList.remove("mobile-view");
                if (simulatedHeader) simulatedHeader.style.display = "flex";
            } else {
                previewWrapper.style.maxWidth = "375px";
                container.style.height = "";
                container.style.maxHeight = "";
                container.style.minHeight = "";
                container.style.aspectRatio = "9/16";
                previewWrapper.classList.add("mobile-view");
                if (simulatedHeader) simulatedHeader.style.display = "none";
            }
        }

        if (view === "desktop") {
            viewDesktop?.classList.add("bg-white/20");
            viewDesktop?.classList.remove("text-white/60");
            viewMobile?.classList.remove("bg-white/20");
            viewMobile?.classList.add("text-white/60");
        } else {
            viewMobile?.classList.add("bg-white/20");
            viewMobile?.classList.remove("text-white/60");
            viewDesktop?.classList.remove("bg-white/20");
            viewDesktop?.classList.add("text-white/60");
        }
        applyConfigToView();
    }

    viewDesktop?.addEventListener("click", () => switchView("desktop"));
    viewMobile?.addEventListener("click", () => switchView("mobile"));

    function applyConfigToView() {
        const viewConfig = currentConfig[currentView] || {};
        const draggables = document.querySelectorAll(
            ".draggable-item",
        ) as NodeListOf<HTMLElement>;
        draggables.forEach((el) => {
            const key = el.dataset.key as keyof ViewConfig;
            const cfg = viewConfig[key];
            el.style.transform = "";
            if (cfg) {
                el.style.top = cfg.top || "";
                el.style.left = cfg.left || "";
                if (cfg.fontSize) el.style.fontSize = cfg.fontSize;
                if (cfg.maxWidth) el.style.maxWidth = cfg.maxWidth;
            }
        });
    }

    if (container) {
        container.addEventListener("mousedown", dragStart);
        container.addEventListener("mouseup", dragEnd);
        container.addEventListener("mousemove", drag);
        container.addEventListener("mouseleave", dragEnd);
    }

    function dragStart(e: MouseEvent) {
        const target = e.target as HTMLElement;
        if (target.classList.contains("resize-handle")) {
            isResizing = true;
            activeDraggable = target.closest(".draggable-item") as HTMLElement;
            if (activeDraggable) {
                activeDraggable.classList.add("active");
                const rect = activeDraggable.getBoundingClientRect();
                initialWidth = rect.width;
                initialX = e.clientX;
            }
            return;
        }
        const draggable = target.closest(".draggable-item") as HTMLElement;
        if (draggable) {
            activeDraggable = draggable;
            activeDraggable.classList.add("active");
            const style = window.getComputedStyle(activeDraggable);
            const matrix = new WebKitCSSMatrix(style.transform);
            xOffset = matrix.m41;
            yOffset = matrix.m42;
            initialX = e.clientX - xOffset;
            initialY = e.clientY - yOffset;
        }
    }

    function dragEnd(e: MouseEvent) {
        if (!activeDraggable) return;
        activeDraggable.classList.remove("active");
        updateConfig(activeDraggable);
        initialX = currentX;
        initialY = currentY;
        activeDraggable = null;
        isResizing = false;
    }

    function drag(e: MouseEvent) {
        if (!activeDraggable || !container) return;
        e.preventDefault();
        if (isResizing) {
            const deltaX = e.clientX - initialX;
            const containerRect = container.getBoundingClientRect();
            const newWidthPercent =
                ((initialWidth + deltaX) / containerRect.width) * 100;
            const clampedWidth = Math.max(10, Math.min(90, newWidthPercent));
            activeDraggable.style.maxWidth = `${clampedWidth.toFixed(1)}%`;
        } else {
            currentX = e.clientX - initialX;
            currentY = e.clientY - initialY;
            activeDraggable.style.transform = `translate3d(${currentX}px, ${currentY}px, 0)`;
        }
    }

    function updateConfig(element: HTMLElement) {
        if (!container || !styleInput) return;
        const rect = container.getBoundingClientRect();
        const dragRect = element.getBoundingClientRect();
        const key = element.dataset.key as keyof ViewConfig;
        const topPercent = ((dragRect.top - rect.top) / rect.height) * 100;
        const leftPercent = ((dragRect.left - rect.left) / rect.width) * 100;
        const clampedTop = Math.max(0, Math.min(95, topPercent));
        const clampedLeft = Math.max(0, Math.min(95, leftPercent));
        const computedStyle = window.getComputedStyle(element);
        const fontSize = element.style.fontSize || computedStyle.fontSize;
        const maxWidth = element.style.maxWidth || computedStyle.maxWidth;
        if (!currentConfig[currentView]) currentConfig[currentView] = {};
        currentConfig[currentView]![key] = {
            ...currentConfig[currentView]?.[key],
            top: `${clampedTop.toFixed(2)}%`,
            left: `${clampedLeft.toFixed(2)}%`,
            fontSize: fontSize,
            maxWidth: maxWidth.includes("%")
                ? maxWidth
                : currentConfig[currentView]?.[key]?.maxWidth,
        };
        styleInput.value = JSON.stringify(currentConfig);
    }

    // ===== Image Sync =====
    const thumbnailPreview = document.getElementById(
        "thumbnail-preview",
    ) as HTMLImageElement;
    const previewImage = document.getElementById(
        "preview-image",
    ) as HTMLImageElement;
    const imageInput = document.querySelector(
        'input[name="image_url"]',
    ) as HTMLInputElement;
    if (imageInput) {
        const observer = new MutationObserver((mutations) => {
            mutations.forEach((mutation) => {
                if (
                    mutation.type === "attributes" &&
                    mutation.attributeName === "value"
                ) {
                    const newUrl = imageInput.value;
                    if (newUrl && thumbnailPreview)
                        thumbnailPreview.src = newUrl;
                    if (newUrl && previewImage) previewImage.src = newUrl;
                }
            });
        });
        observer.observe(imageInput, { attributes: true });
    }

    // ===== Style Controls =====
    const styleTitleSize = document.getElementById(
        "style-title-size",
    ) as HTMLInputElement;
    const styleTitleColor = document.getElementById(
        "style-title-color",
    ) as HTMLInputElement;
    const styleTitleBold = document.getElementById(
        "style-title-bold",
    ) as HTMLButtonElement;
    const styleSubtitleSize = document.getElementById(
        "style-subtitle-size",
    ) as HTMLInputElement;
    const styleSubtitleColor = document.getElementById(
        "style-subtitle-color",
    ) as HTMLInputElement;
    const styleSubtitleUppercaseBtn = document.getElementById(
        "style-subtitle-uppercase-btn",
    ) as HTMLButtonElement;
    const styleDescSize = document.getElementById(
        "style-desc-size",
    ) as HTMLInputElement;
    const styleDescColor = document.getElementById(
        "style-desc-color",
    ) as HTMLInputElement;
    const styleDiscountSize = document.getElementById(
        "style-discount-size",
    ) as HTMLInputElement;
    const styleDiscountColor = document.getElementById(
        "style-discount-color",
    ) as HTMLInputElement;
    const styleBtnBg = document.getElementById(
        "style-btn-bg",
    ) as HTMLInputElement;
    const styleBtnText = document.getElementById(
        "style-btn-text",
    ) as HTMLInputElement;
    const styleBtnRadius = document.getElementById(
        "style-btn-radius",
    ) as HTMLSelectElement;

    const previewTitle = document.getElementById(
        "preview-title",
    ) as HTMLElement;
    const previewSubtitle = document.getElementById(
        "preview-subtitle",
    ) as HTMLElement;
    const previewDescription = document.getElementById(
        "preview-description",
    ) as HTMLElement;
    const previewCtaBtn = document.querySelector(
        "#preview-cta-container .hero-btn",
    ) as HTMLElement;

    let isTitleBold = true;
    let isSubtitleUppercase = true;

    styleTitleBold?.addEventListener("click", () => {
        isTitleBold = !isTitleBold;
        styleTitleBold.classList.toggle("bg-zinc-900", isTitleBold);
        styleTitleBold.classList.toggle("bg-zinc-300", !isTitleBold);
        styleTitleBold.classList.toggle("text-white", isTitleBold);
        styleTitleBold.classList.toggle("text-zinc-600", !isTitleBold);
        updateStyleConfig();
        updatePreviewStyles();
    });
    styleSubtitleUppercaseBtn?.addEventListener("click", () => {
        isSubtitleUppercase = !isSubtitleUppercase;
        styleSubtitleUppercaseBtn.classList.toggle(
            "bg-zinc-900",
            isSubtitleUppercase,
        );
        styleSubtitleUppercaseBtn.classList.toggle(
            "bg-zinc-300",
            !isSubtitleUppercase,
        );
        styleSubtitleUppercaseBtn.classList.toggle(
            "text-white",
            isSubtitleUppercase,
        );
        styleSubtitleUppercaseBtn.classList.toggle(
            "text-zinc-600",
            !isSubtitleUppercase,
        );
        updateStyleConfig();
        updatePreviewStyles();
    });

    [
        styleTitleSize,
        styleTitleColor,
        styleSubtitleSize,
        styleSubtitleColor,
        styleDescSize,
        styleDescColor,
        styleDiscountSize,
        styleDiscountColor,
        styleBtnBg,
        styleBtnText,
        styleBtnRadius,
    ].forEach((el) => {
        el?.addEventListener("input", () => {
            updateStyleConfig();
            updatePreviewStyles();
        });
    });

    function updatePreviewStyles() {
        if (previewTitle) {
            previewTitle.style.fontSize =
                (styleTitleSize?.value || "56") + "px";
            previewTitle.style.color = styleTitleColor?.value || "#ffffff";
            previewTitle.style.fontWeight = isTitleBold ? "700" : "400";
        }
        if (previewSubtitle) {
            previewSubtitle.style.fontSize =
                (styleSubtitleSize?.value || "16") + "px";
            previewSubtitle.style.color =
                styleSubtitleColor?.value || "#d4af37";
            previewSubtitle.style.textTransform = isSubtitleUppercase
                ? "uppercase"
                : "none";
        }
        if (previewDescription) {
            previewDescription.style.fontSize =
                (styleDescSize?.value || "18") + "px";
            previewDescription.style.color = styleDescColor?.value || "#e4e4e7";
        }
        const previewDiscountCode = document.getElementById(
            "preview-discount-code",
        );
        if (previewDiscountCode) {
            previewDiscountCode.style.fontSize =
                (styleDiscountSize?.value || "18") + "px";
            previewDiscountCode.style.color =
                styleDiscountColor?.value || "#d4af37";
        }
        if (previewCtaBtn) {
            previewCtaBtn.style.backgroundColor =
                styleBtnBg?.value || "#ffffff";
            previewCtaBtn.style.color = styleBtnText?.value || "#000000";
            previewCtaBtn.style.borderRadius =
                styleBtnRadius?.value || "9999px";
        }
    }

    function updateStyleConfig() {
        const view = currentView;
        if (!currentConfig[view]) currentConfig[view] = {};
        currentConfig[view]!.title = {
            ...currentConfig[view]?.title,
            fontSize: (styleTitleSize?.value || "56") + "px",
            color: styleTitleColor?.value,
            fontWeight: isTitleBold ? "700" : "400",
        };
        currentConfig[view]!.subtitle = {
            ...currentConfig[view]?.subtitle,
            fontSize: (styleSubtitleSize?.value || "16") + "px",
            color: styleSubtitleColor?.value,
            textTransform: isSubtitleUppercase ? "uppercase" : "none",
        };
        currentConfig[view]!.description = {
            ...currentConfig[view]?.description,
            fontSize: (styleDescSize?.value || "18") + "px",
            color: styleDescColor?.value,
        };
        currentConfig[view]!.discount = {
            ...currentConfig[view]?.discount,
            fontSize: (styleDiscountSize?.value || "18") + "px",
            color: styleDiscountColor?.value,
        };
        currentConfig[view]!.cta = {
            ...currentConfig[view]?.cta,
            bgColor: styleBtnBg?.value,
            textColor: styleBtnText?.value,
            borderRadius: styleBtnRadius?.value,
        };
        if (styleInput) styleInput.value = JSON.stringify(currentConfig);
    }

    function loadStyleControls() {
        const config =
            currentConfig[currentView] || currentConfig.desktop || {};
        if (config.title?.fontSize && styleTitleSize) {
            const size =
                parseInt(
                    config.title.fontSize.replace("px", "").replace("rem", ""),
                ) || 56;
            styleTitleSize.value = String(size > 10 ? size : 56);
        }
        if (config.title?.color && styleTitleColor)
            styleTitleColor.value = config.title.color;
        if (config.title?.fontWeight) {
            isTitleBold =
                config.title.fontWeight === "700" ||
                config.title.fontWeight === "800";
            if (styleTitleBold) {
                styleTitleBold.classList.toggle("bg-zinc-900", isTitleBold);
                styleTitleBold.classList.toggle("bg-zinc-300", !isTitleBold);
                styleTitleBold.classList.toggle("text-white", isTitleBold);
                styleTitleBold.classList.toggle("text-zinc-600", !isTitleBold);
            }
        }
        if (config.subtitle?.fontSize && styleSubtitleSize) {
            const size =
                parseInt(
                    config.subtitle.fontSize
                        .replace("px", "")
                        .replace("rem", ""),
                ) || 16;
            styleSubtitleSize.value = String(size > 5 ? size : 16);
        }
        if (config.subtitle?.color && styleSubtitleColor)
            styleSubtitleColor.value = config.subtitle.color;
        if (config.subtitle?.textTransform !== undefined) {
            isSubtitleUppercase = config.subtitle.textTransform === "uppercase";
            if (styleSubtitleUppercaseBtn) {
                styleSubtitleUppercaseBtn.classList.toggle(
                    "bg-zinc-900",
                    isSubtitleUppercase,
                );
                styleSubtitleUppercaseBtn.classList.toggle(
                    "bg-zinc-300",
                    !isSubtitleUppercase,
                );
                styleSubtitleUppercaseBtn.classList.toggle(
                    "text-white",
                    isSubtitleUppercase,
                );
                styleSubtitleUppercaseBtn.classList.toggle(
                    "text-zinc-600",
                    !isSubtitleUppercase,
                );
            }
        }
        if (config.description?.fontSize && styleDescSize) {
            const size =
                parseInt(
                    config.description.fontSize
                        .replace("px", "")
                        .replace("rem", ""),
                ) || 18;
            styleDescSize.value = String(size > 5 ? size : 18);
        }
        if (config.description?.color && styleDescColor)
            styleDescColor.value = config.description.color;
        if (config.discount?.fontSize && styleDiscountSize) {
            const size =
                parseInt(
                    config.discount.fontSize
                        .replace("px", "")
                        .replace("rem", ""),
                ) || 18;
            styleDiscountSize.value = String(size > 5 ? size : 18);
        }
        if (config.discount?.color && styleDiscountColor)
            styleDiscountColor.value = config.discount.color;
        if (config.cta?.bgColor && styleBtnBg)
            styleBtnBg.value = config.cta.bgColor;
        if (config.cta?.textColor && styleBtnText)
            styleBtnText.value = config.cta.textColor;
        if (config.cta?.borderRadius && styleBtnRadius)
            styleBtnRadius.value = config.cta.borderRadius;
        updatePreviewStyles();
    }

    loadStyleControls();
    applyConfigToView();

    // Save button handler - explicitly update style_config before submitting
    const saveBtn = document.getElementById("save-carousel-btn");
    saveBtn?.addEventListener("click", () => {
        // Update style config with current positions and styles
        updateStyleConfig();

        // Log what we're saving for debugging
        console.log(
            "[SAVE CLICK] Final currentConfig:",
            JSON.stringify(currentConfig, null, 2),
        );
        console.log("[SAVE CLICK] styleInput.value:", styleInput?.value);

        // Submit the form programmatically
        const formElement = document.querySelector(
            'form[method="POST"]',
        ) as HTMLFormElement;
        if (formElement) {
            formElement.submit();
        }
    });
</script>
