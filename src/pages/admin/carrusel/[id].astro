---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import CarouselImageUploader from "../../../components/islands/CarouselImageUploader";
import {
    getCarouselSlideById,
    updateCarouselSlide,
    supabaseAdmin,
} from "../../../lib/supabase";

// Fetch active discount codes
const { data: discountCodes } = await supabaseAdmin
    .from("discount_codes")
    .select("code, description, discount_type, discount_value")
    .eq("active", true)
    .order("code");

const { id } = Astro.params;

if (!id) {
    return Astro.redirect("/admin/carrusel");
}

let slide = await getCarouselSlideById(id);

if (!slide) {
    return Astro.redirect("/admin/carrusel");
}

let error = "";

if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();

    const title = formData.get("title")?.toString() || "";
    const subtitle = formData.get("subtitle")?.toString() || "";
    const description = formData.get("description")?.toString() || "";
    const image_url = formData.get("image_url")?.toString() || slide.image_url;
    const cta_text = formData.get("cta_text")?.toString() || "Ver más";
    const cta_link = formData.get("cta_link")?.toString() || "/productos";
    const discount_code = formData.get("discount_code")?.toString() || "";
    const duration = parseInt(formData.get("duration")?.toString() || "5000");
    const sort_order = parseInt(formData.get("sort_order")?.toString() || "0");
    const is_active = formData.get("is_active") === "true";
    const style_config_raw = formData.get("style_config")?.toString();
    let style_config = {};

    console.log("[CAROUSEL SAVE] ID:", id);
    console.log("[CAROUSEL SAVE] style_config_raw:", style_config_raw);

    try {
        if (style_config_raw) {
            style_config = JSON.parse(style_config_raw);
            console.log(
                "[CAROUSEL SAVE] Parsed style_config:",
                JSON.stringify(style_config),
            );
        }
    } catch (e) {
        console.error("[CAROUSEL SAVE] Error parsing style_config", e);
    }

    if (!title || !image_url) {
        error = "El título y la imagen son obligatorios";
    } else {
        try {
            console.log(
                "[CAROUSEL SAVE] Calling updateCarouselSlide with style_config:",
                JSON.stringify(style_config),
            );
            await updateCarouselSlide(id, {
                title,
                subtitle: subtitle || null,
                description: description || null,
                image_url,
                cta_text,
                cta_link,
                discount_code: discount_code || null,
                duration,
                sort_order,
                is_active,
                style_config,
            });
            console.log("[CAROUSEL SAVE] Successfully saved!");
            return Astro.redirect("/admin/carrusel?saved=true");
        } catch (e: any) {
            console.error("[CAROUSEL SAVE] Error saving:", e);
            error = e.message || "Error al actualizar la slide";
        }
    }
}
---

<AdminLayout title={`Editar Slide: ${slide.title}`}>
    <div class="w-full max-w-[1800px] mx-auto px-4">
        <!-- Header -->
        <div class="flex items-center gap-4 mb-6">
            <a
                href="/admin/carrusel"
                class="p-2 text-zinc-400 hover:text-zinc-900 hover:bg-zinc-100 rounded-lg transition-colors"
            >
                <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15 19l-7-7 7-7"></path>
                </svg>
            </a>
            <div>
                <h1 class="text-2xl font-bold text-zinc-100">Editar Slide</h1>
                <p class="text-zinc-400 mt-0.5">
                    Modifica la configuración de esta slide del carrusel
                </p>
            </div>
        </div>

        {
            error && (
                <div class="mb-6 p-4 bg-dark-400 border border-red-500/30 rounded-xl text-red-400">
                    {error}
                </div>
            )
        }

        <!-- Preview Header Bar -->
        <div
            class="bg-dark-400 rounded-xl border border-white/10 p-3 mb-4 flex items-center justify-between gap-4"
        >
            <div class="flex items-center gap-4 flex-1">
                <div
                    class="w-32 h-20 rounded-lg overflow-hidden border border-white/10 flex-shrink-0 relative"
                >
                    <img
                        id="thumbnail-preview"
                        src={slide.image_url}
                        class="w-full h-full object-cover"
                        alt="Preview"
                    />
                    <div
                        class="absolute inset-0 bg-gradient-to-r from-black/40 to-transparent"
                    >
                    </div>
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-zinc-100 truncate">
                        {slide.title}
                    </p>
                    <p class="text-xs text-zinc-400">
                        Clic en "Ver Vista Previa" para editar posiciones
                    </p>
                </div>
            </div>
            <button
                type="button"
                id="open-preview-modal"
                class="px-4 py-2 bg-gradient-to-r from-neon-cyan to-cyan-600 text-black text-sm font-semibold rounded-lg hover:from-cyan-400 hover:to-cyan-700 transition-all flex items-center gap-2"
            >
                <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                    ></path>
                </svg>
                Ver Vista Previa
            </button>
        </div>

        <!-- Preview Modal -->
        <div id="preview-modal" class="fixed inset-0 z-50 hidden">
            <div
                class="absolute inset-0 bg-black/80 backdrop-blur-md"
                id="preview-modal-backdrop"
            >
            </div>
            <div
                class="relative z-10 flex flex-col items-center justify-center min-h-screen p-6"
            >
                <button
                    type="button"
                    id="close-preview-modal"
                    class="absolute top-6 right-6 p-3 bg-white/10 hover:bg-white/20 rounded-full text-white transition-all"
                >
                    <svg
                        class="w-6 h-6"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>

                <div class="mb-4 flex items-center gap-4">
                    <div
                        class="flex bg-white/10 backdrop-blur-sm p-1 rounded-lg gap-1"
                    >
                        <button
                            type="button"
                            id="view-desktop"
                            class="p-2 rounded-md bg-white/20 text-white transition-all"
                            title="Vista Desktop"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                ></path>
                            </svg>
                        </button>
                        <button
                            type="button"
                            id="view-mobile"
                            class="p-2 rounded-md text-white/60 hover:text-white transition-all"
                            title="Vista Mobile"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
                                ></path>
                            </svg>
                        </button>
                    </div>
                    <span class="text-white/70 text-sm"
                        >Arrastra cada elemento para posicionarlo</span
                    >
                </div>

                <div
                    id="preview-wrapper"
                    class="relative w-full transition-all duration-300 ease-in-out bg-black overflow-hidden shadow-2xl rounded-xl"
                    style="max-width: 95vw;"
                >
                    <!-- Simulated header bar to match web proportions -->
                    <div
                        id="simulated-header"
                        class="h-14 bg-zinc-900/90 flex items-center px-6 border-b border-white/10"
                    >
                        <span class="text-white/50 text-sm font-medium"
                            >📍 Header simulado</span
                        >
                    </div>
                    <div
                        id="preview-container"
                        class="relative w-full select-none"
                        style="height: 70vh; max-height: 700px; min-height: 400px;"
                    >
                        <img
                            id="preview-image"
                            src={slide.image_url}
                            class="w-full h-full object-cover"
                            alt="Preview"
                        />
                        <div class="absolute inset-0" style="z-index: 10;">
                            <!-- Subtitle -->
                            <div
                                id="preview-subtitle-container"
                                class="draggable-item resizable-item absolute cursor-move rounded border-2 border-transparent hover:border-cyan-400/50 transition-all group z-20"
                                data-key="subtitle"
                                style={(() => {
                                    const cfg =
                                        slide.style_config?.desktop?.subtitle ||
                                        slide.style_config?.subtitle;
                                    return cfg
                                        ? `top: ${cfg.top}; left: ${cfg.left};`
                                        : "top: 15%; left: 10%;";
                                })()}
                            >
                                <p
                                    id="preview-subtitle"
                                    class="hero-subtitle pointer-events-none text-[#d4af37] uppercase tracking-[0.2em] font-medium"
                                >
                                    {slide.subtitle}
                                </p>
                                <div class="resize-handle resize-handle-se">
                                </div>
                            </div>

                            <!-- Title -->
                            <div
                                id="preview-title-container"
                                class="draggable-item resizable-item absolute cursor-move rounded border-2 border-transparent hover:border-cyan-400/50 transition-all group z-20"
                                data-key="title"
                                style={(() => {
                                    const cfg =
                                        slide.style_config?.desktop?.title ||
                                        slide.style_config?.title;
                                    return cfg
                                        ? `top: ${cfg.top}; left: ${cfg.left}; max-width: ${cfg.maxWidth || "60%"};`
                                        : "top: 25%; left: 10%; max-width: 60%;";
                                })()}
                            >
                                <h1
                                    id="preview-title"
                                    class="hero-title pointer-events-none font-bold text-white leading-tight"
                                >
                                    {slide.title}
                                </h1>
                                <div class="resize-handle resize-handle-se">
                                </div>
                            </div>

                            <!-- Description -->
                            <div
                                id="preview-description-container"
                                class="draggable-item resizable-item absolute cursor-move rounded border-2 border-transparent hover:border-cyan-400/50 transition-all group z-20"
                                data-key="description"
                                style={(() => {
                                    const cfg =
                                        slide.style_config?.desktop
                                            ?.description ||
                                        slide.style_config?.description;
                                    return cfg
                                        ? `top: ${cfg.top}; left: ${cfg.left}; max-width: ${cfg.maxWidth || "40%"};`
                                        : "top: 45%; left: 10%; max-width: 40%;";
                                })()}
                            >
                                <p
                                    id="preview-description"
                                    class="hero-description pointer-events-none text-zinc-200"
                                >
                                    {slide.description}
                                </p>
                                <div class="resize-handle resize-handle-se">
                                </div>
                            </div>

                            <!-- Discount -->
                            <div
                                id="preview-discount-container"
                                class={`draggable-item resizable-item absolute cursor-move rounded border-2 border-transparent hover:border-cyan-400/50 transition-all group z-20 ${!slide.discount_code ? "hidden" : ""}`}
                                data-key="discount"
                                style={(() => {
                                    const cfg =
                                        slide.style_config?.desktop?.discount ||
                                        slide.style_config?.discount;
                                    return cfg
                                        ? `top: ${cfg.top}; left: ${cfg.left};`
                                        : "top: 60%; left: 10%;";
                                })()}
                            >
                                <div
                                    class="inline-flex items-center gap-3 bg-white/10 backdrop-blur-md border border-white/20 rounded-lg px-4 py-2 pointer-events-none"
                                >
                                    <span
                                        class="text-white/80 text-sm font-medium"
                                        >CÓDIGO:</span
                                    >
                                    <span
                                        id="preview-discount-code"
                                        class="text-[#d4af37] font-mono font-bold tracking-wider text-lg"
                                        >{slide.discount_code}</span
                                    >
                                </div>

                                <div class="resize-handle resize-handle-se">
                                </div>
                            </div>

                            <!-- CTA -->
                            <div
                                id="preview-cta-container"
                                class="draggable-item resizable-item absolute cursor-move rounded border-2 border-transparent hover:border-cyan-400/50 transition-all group z-20"
                                data-key="cta"
                                style={(() => {
                                    const cfg =
                                        slide.style_config?.desktop?.cta ||
                                        slide.style_config?.cta;
                                    return cfg
                                        ? `top: ${cfg.top}; left: ${cfg.left};`
                                        : "top: 75%; left: 10%;";
                                })()}
                            >
                                <span
                                    id="preview-cta"
                                    class="hero-btn pointer-events-none inline-flex items-center gap-2 px-6 py-3 bg-white text-black font-semibold rounded-full"
                                >
                                    <span id="preview-cta-text-inner"
                                        >{slide.cta_text}</span
                                    >
                                    <svg
                                        class="w-5 h-5"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                                    </svg>
                                </span>
                                <div class="resize-handle resize-handle-se">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Form -->
        <form method="POST" class="space-y-4">
            <input
                type="hidden"
                name="style_config"
                id="style_config"
                value={JSON.stringify(slide.style_config || {})}
            />

            <!-- Image Section -->
            <div class="bg-dark-400 rounded-xl border border-white/10 p-4">
                <h2
                    class="text-sm font-semibold text-zinc-900 flex items-center gap-2 mb-3"
                >
                    <svg
                        class="w-5 h-5 text-cyan-600"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                        ></path>
                    </svg>
                    Imagen
                </h2>
                <CarouselImageUploader
                    client:load
                    inputName="image_url"
                    initialImage={slide.image_url}
                />
            </div>

            <!-- Content Section -->
            <div class="bg-dark-400 rounded-xl border border-white/10 p-4">
                <h2
                    class="text-sm font-semibold text-zinc-900 flex items-center gap-2 mb-3"
                >
                    <svg
                        class="w-5 h-5 text-cyan-600"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                        ></path>
                    </svg>
                    Contenido
                </h2>

                <!-- Title -->
                <div class="mb-3">
                    <div class="flex items-center justify-between mb-1">
                        <label
                            for="title"
                            class="text-sm font-medium text-zinc-700"
                            >Título <span class="text-red-500">*</span></label
                        >
                        <div class="flex items-center gap-1">
                            <div
                                class="flex items-center border border-zinc-200 rounded bg-zinc-50"
                            >
                                <input
                                    type="number"
                                    id="style-title-size"
                                    value="56"
                                    min="12"
                                    max="120"
                                    step="2"
                                    class="w-10 px-1 py-0.5 text-xs text-center bg-transparent border-none focus:outline-none"
                                />
                                <span class="text-[9px] text-zinc-400 pr-1"
                                    >px</span
                                >
                            </div>
                            <button
                                type="button"
                                id="style-title-bold"
                                class="w-6 h-6 flex items-center justify-center bg-zinc-900 text-white rounded text-xs font-bold hover:bg-zinc-700"
                                title="Bold">B</button
                            >
                            <input
                                type="color"
                                id="style-title-color"
                                value="#ffffff"
                                class="w-6 h-6 rounded-full border border-white/10 cursor-pointer"
                            />
                        </div>
                    </div>
                    <input
                        type="text"
                        id="title"
                        name="title"
                        required
                        value={slide.title}
                        placeholder="Nueva Colección"
                        class="w-full px-3 py-2 bg-dark-300 border border-white/10 rounded-lg text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-neon-cyan focus:ring-1 focus:ring-neon-cyan/20 transition-all"
                        oninput="document.getElementById('preview-title').textContent = this.value"
                    />
                </div>

                <!-- Subtitle -->
                <div class="mb-3">
                    <div class="flex items-center justify-between mb-1">
                        <label
                            for="subtitle"
                            class="text-sm font-medium text-zinc-300"
                            >Subtítulo</label
                        >
                        <div class="flex items-center gap-1">
                            <div
                                class="flex items-center border border-white/10 rounded bg-dark-300"
                            >
                                <input
                                    type="number"
                                    id="style-subtitle-size"
                                    value="16"
                                    min="10"
                                    max="48"
                                    step="1"
                                    class="w-10 px-1 py-0.5 text-xs text-center bg-transparent border-none focus:outline-none"
                                />
                                <span class="text-[9px] text-zinc-400 pr-1"
                                    >px</span
                                >
                            </div>
                            <button
                                type="button"
                                id="style-subtitle-uppercase-btn"
                                class="w-6 h-6 flex items-center justify-center bg-zinc-900 text-white rounded text-[9px] font-bold hover:bg-zinc-700"
                                title="Mayúsculas">AA</button
                            >
                            <input
                                type="hidden"
                                id="style-subtitle-uppercase"
                                value="true"
                            />
                            <input
                                type="color"
                                id="style-subtitle-color"
                                value="#d4af37"
                                class="w-6 h-6 rounded-full border border-white/10 cursor-pointer"
                            />
                        </div>
                    </div>
                    <input
                        type="text"
                        id="subtitle"
                        name="subtitle"
                        value={slide.subtitle || ""}
                        placeholder="Primavera 2026"
                        class="w-full px-3 py-2 bg-dark-300 border border-white/10 rounded-lg text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-neon-cyan focus:ring-1 focus:ring-neon-cyan/20 transition-all"
                        oninput="document.getElementById('preview-subtitle').textContent = this.value"
                    />
                </div>

                <!-- Discount Code -->
                <div class="mb-3">
                    <div class="flex items-center justify-between mb-1">
                        <label
                            for="discount_code"
                            class="text-sm font-medium text-zinc-300"
                            >Código de Descuento</label
                        >
                        <div class="flex items-center gap-1">
                            <div
                                class="flex items-center border border-white/10 rounded bg-dark-300"
                            >
                                <input
                                    type="number"
                                    id="style-discount-size"
                                    value="18"
                                    min="12"
                                    max="36"
                                    step="1"
                                    class="w-10 px-1 py-0.5 text-xs text-center bg-transparent border-none focus:outline-none"
                                />
                                <span class="text-[9px] text-zinc-400 pr-1"
                                    >px</span
                                >
                            </div>
                            <input
                                type="color"
                                id="style-discount-color"
                                value="#d4af37"
                                class="w-6 h-6 rounded-full border border-white/10 cursor-pointer"
                            />
                        </div>
                    </div>
                    <select
                        id="discount_code"
                        name="discount_code"
                        class="w-full px-3 py-2 bg-dark-300 border border-white/10 rounded-lg text-zinc-100 focus:outline-none focus:border-neon-cyan focus:ring-1 focus:ring-neon-cyan/20 transition-all"
                        onchange="const el = document.getElementById('preview-discount-container'); const code = document.getElementById('preview-discount-code'); if(this.value){ el.classList.remove('hidden'); code.textContent = this.value; } else { el.classList.add('hidden'); }"
                    >
                        <option value="">Sin código de descuento</option>
                        {
                            discountCodes?.map((dc) => (
                                <option
                                    value={dc.code}
                                    selected={slide.discount_code === dc.code}
                                >
                                    {dc.code} (
                                    {dc.discount_type === "percentage"
                                        ? `${dc.discount_value}%`
                                        : `${dc.discount_value}€`}
                                    )
                                </option>
                            ))
                        }
                    </select>
                </div>

                <!-- Description -->
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label
                            for="description"
                            class="text-sm font-medium text-zinc-300"
                            >Descripción</label
                        >
                        <div class="flex items-center gap-1">
                            <div
                                class="flex items-center border border-white/10 rounded bg-dark-300"
                            >
                                <input
                                    type="number"
                                    id="style-desc-size"
                                    value="18"
                                    min="10"
                                    max="36"
                                    step="1"
                                    class="w-10 px-1 py-0.5 text-xs text-center bg-transparent border-none focus:outline-none"
                                />
                                <span class="text-[9px] text-zinc-400 pr-1"
                                    >px</span
                                >
                            </div>
                            <input
                                type="color"
                                id="style-desc-color"
                                value="#e4e4e7"
                                class="w-6 h-6 rounded-full border border-white/10 cursor-pointer"
                            />
                        </div>
                    </div>
                    <textarea
                        id="description"
                        name="description"
                        rows={2}
                        placeholder="Descubre las últimas tendencias"
                        class="w-full px-3 py-2 bg-dark-300 border border-white/10 rounded-lg text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-neon-cyan focus:ring-1 focus:ring-neon-cyan/20 transition-all resize-none"
                        oninput="document.getElementById('preview-description').textContent = this.value"
                        >{slide.description || ""}</textarea
                    >
                </div>
            </div>

            <!-- CTA Section -->
            <div class="bg-white rounded-xl border border-zinc-200 p-4">
                <h2
                    class="text-sm font-semibold text-zinc-900 flex items-center gap-2 mb-3"
                >
                    <svg
                        class="w-5 h-5 text-cyan-600"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5"></path>
                    </svg>
                    Botón CTA
                </h2>
                <div class="grid grid-cols-2 gap-3 mb-3">
                    <div>
                        <label
                            for="cta_text"
                            class="block text-sm font-medium text-zinc-700 mb-1"
                            >Texto</label
                        >
                        <input
                            type="text"
                            id="cta_text"
                            name="cta_text"
                            value={slide.cta_text}
                            placeholder="Explorar"
                            class="w-full px-3 py-2 bg-dark-300 border border-white/10 rounded-lg text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-neon-cyan focus:ring-1 focus:ring-neon-cyan/20"
                            oninput="document.getElementById('preview-cta-text-inner').textContent = this.value"
                        />
                    </div>
                    <div>
                        <label
                            for="cta_link"
                            class="block text-sm font-medium text-zinc-700 mb-1"
                            >Enlace</label
                        >
                        <input
                            type="text"
                            id="cta_link"
                            name="cta_link"
                            value={slide.cta_link}
                            placeholder="/productos"
                            class="w-full px-3 py-2 bg-dark-300 border border-white/10 rounded-lg text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-neon-cyan focus:ring-1 focus:ring-neon-cyan/20"
                        />
                    </div>
                </div>
                <div class="flex items-center gap-3 p-2 bg-dark-300 rounded-lg">
                    <span class="text-xs font-medium text-zinc-400"
                        >Estilos:</span
                    >
                    <div class="flex items-center gap-1">
                        <input
                            type="color"
                            id="style-btn-bg"
                            value="#ffffff"
                            class="w-6 h-6 rounded-full border border-white/10 cursor-pointer"
                            title="Fondo"
                        />
                        <span class="text-[9px] text-zinc-400">Fondo</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <input
                            type="color"
                            id="style-btn-text"
                            value="#000000"
                            class="w-6 h-6 rounded-full border border-white/10 cursor-pointer"
                            title="Texto"
                        />
                        <span class="text-[9px] text-zinc-400">Texto</span>
