---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { supabaseAdmin } from "../../lib/supabase";

// Get all discount codes
const { data: discountCodes, error } = await supabaseAdmin
    .from('discount_codes')
    .select('*')
    .order('created_at', { ascending: false });

let message = "";
let messageType = "";

// Handle form submissions
if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const action = formData.get("action")?.toString();

    // Create new code
    if (action === "create") {
        const code = formData.get("code")?.toString()?.toUpperCase();
        const description = formData.get("description")?.toString();
        const discountType = formData.get("discount_type")?.toString();
        const discountValue = parseFloat(formData.get("discount_value")?.toString() || "0");
        const minPurchase = parseFloat(formData.get("min_purchase")?.toString() || "0");
        const maxDiscount = formData.get("max_discount")?.toString();
        const usageLimit = formData.get("usage_limit")?.toString();
        const singleUse = formData.get("single_use") === "on";
        const expiresAt = formData.get("expires_at")?.toString();

        if (code && discountType && discountValue > 0) {
            const { error: insertError } = await supabaseAdmin
                .from('discount_codes')
                .insert({
                    code,
                    description,
                    discount_type: discountType,
                    discount_value: discountValue,
                    min_purchase: minPurchase || 0,
                    max_discount: maxDiscount ? parseFloat(maxDiscount) : null,
                    usage_limit: usageLimit ? parseInt(usageLimit) : null,
                    single_use_per_customer: singleUse,
                    expires_at: expiresAt || null,
                    active: true
                });

            if (insertError) {
                message = insertError.code === '23505' 
                    ? "Ya existe un código con ese nombre"
                    : insertError.message;
                messageType = "error";
            } else {
                message = `Código ${code} creado correctamente`;
                messageType = "success";
                return Astro.redirect("/admin/codigos");
            }
        }
    }

    // Toggle active status
    if (action === "toggle") {
        const codeId = formData.get("code_id")?.toString();
        const currentActive = formData.get("current_active") === "true";

        if (codeId) {
            await supabaseAdmin
                .from('discount_codes')
                .update({ active: !currentActive })
                .eq('id', codeId);
            
            return Astro.redirect("/admin/codigos");
        }
    }

    // Delete code
    if (action === "delete") {
        const codeId = formData.get("code_id")?.toString();

        if (codeId) {
            await supabaseAdmin
                .from('discount_codes')
                .delete()
                .eq('id', codeId);
            
            return Astro.redirect("/admin/codigos");
        }
    }
}

function formatDate(dateStr: string | null) {
    if (!dateStr) return '-';
    return new Date(dateStr).toLocaleDateString('es-ES', {
        day: '2-digit',
        month: 'short',
        year: 'numeric'
    });
}
---

<AdminLayout title="Códigos Promocionales">
    <!-- Header with Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="bg-white rounded-xl border border-zinc-200 p-4">
            <div class="text-2xl font-bold text-zinc-900">{discountCodes?.length || 0}</div>
            <div class="text-sm text-zinc-500">Total Códigos</div>
        </div>
        <div class="bg-emerald-50 rounded-xl border border-emerald-200 p-4">
            <div class="text-2xl font-bold text-emerald-700">{discountCodes?.filter(c => c.active).length || 0}</div>
            <div class="text-sm text-emerald-600">Activos</div>
        </div>
        <div class="bg-amber-50 rounded-xl border border-amber-200 p-4">
            <div class="text-2xl font-bold text-amber-700">{discountCodes?.filter(c => !c.active).length || 0}</div>
            <div class="text-sm text-amber-600">Inactivos</div>
        </div>
        <div class="bg-purple-50 rounded-xl border border-purple-200 p-4">
            <div class="text-2xl font-bold text-purple-700">{discountCodes?.reduce((sum, c) => sum + (c.times_used || 0), 0) || 0}</div>
            <div class="text-sm text-purple-600">Usos Totales</div>
        </div>
    </div>

    {message && (
        <div class={`mb-6 p-4 rounded-xl border ${messageType === 'success' ? 'bg-emerald-50 border-emerald-200 text-emerald-700' : 'bg-red-50 border-red-200 text-red-700'}`}>
            {message}
        </div>
    )}

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Codes List -->
        <div class="lg:col-span-2">
            <div class="bg-white rounded-2xl border border-zinc-200 overflow-hidden">
                <div class="p-6 border-b border-zinc-200">
                    <h2 class="text-lg font-semibold text-zinc-900">Códigos Promocionales</h2>
                    <p class="text-sm text-zinc-500 mt-1">Gestiona los códigos de descuento de tu tienda</p>
                </div>

                {(!discountCodes || discountCodes.length === 0) ? (
                    <div class="p-12 text-center">
                        <div class="w-16 h-16 bg-zinc-100 rounded-full flex items-center justify-center mx-auto mb-4">
                            <svg class="w-8 h-8 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                            </svg>
                        </div>
                        <p class="text-zinc-500">No hay códigos promocionales</p>
                        <p class="text-sm text-zinc-400 mt-1">Crea tu primer código de descuento</p>
                    </div>
                ) : (
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead class="bg-zinc-50 border-b border-zinc-200">
                                <tr>
                                    <th class="text-left px-6 py-3 text-xs font-semibold text-zinc-500 uppercase">Código</th>
                                    <th class="text-left px-6 py-3 text-xs font-semibold text-zinc-500 uppercase">Descuento</th>
                                    <th class="text-left px-6 py-3 text-xs font-semibold text-zinc-500 uppercase">Usos</th>
                                    <th class="text-left px-6 py-3 text-xs font-semibold text-zinc-500 uppercase">Expira</th>
                                    <th class="text-left px-6 py-3 text-xs font-semibold text-zinc-500 uppercase">Estado</th>
                                    <th class="text-right px-6 py-3 text-xs font-semibold text-zinc-500 uppercase">Acciones</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-zinc-100">
                                {discountCodes?.map((code) => (
                                    <tr class="hover:bg-zinc-50 transition-colors">
                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-2">
                                                <span class="font-mono font-semibold text-zinc-900 bg-zinc-100 px-2 py-1 rounded">
                                                    {code.code}
                                                </span>
                                                <button 
                                                    type="button"
                                                    class="copy-btn text-zinc-400 hover:text-cyan-600 transition-colors"
                                                    data-code={code.code}
                                                    title="Copiar código"
                                                >
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                                                    </svg>
                                                </button>
                                            </div>
                                            {code.description && (
                                                <p class="text-xs text-zinc-500 mt-1">{code.description}</p>
                                            )}
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="font-semibold text-zinc-900">
                                                {code.discount_type === 'percentage' 
                                                    ? `${code.discount_value}%` 
                                                    : `${code.discount_value}€`}
                                            </span>
                                            {code.min_purchase > 0 && (
                                                <p class="text-xs text-zinc-500">Mín: {code.min_purchase}€</p>
                                            )}
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="text-zinc-900">{code.times_used || 0}</span>
                                            {code.usage_limit && (
                                                <span class="text-zinc-500">/{code.usage_limit}</span>
                                            )}
                                        </td>
                                        <td class="px-6 py-4 text-sm text-zinc-500">
                                            {formatDate(code.expires_at)}
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class={`inline-flex px-2.5 py-1 rounded-full text-xs font-medium ${code.active ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-zinc-100 text-zinc-500 border border-zinc-200'}`}>
                                                {code.active ? 'Activo' : 'Inactivo'}
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 text-right">
                                            <div class="flex items-center justify-end gap-2">
                                                <form method="POST" class="inline">
                                                    <input type="hidden" name="action" value="toggle" />
                                                    <input type="hidden" name="code_id" value={code.id} />
                                                    <input type="hidden" name="current_active" value={code.active.toString()} />
                                                    <button
                                                        type="submit"
                                                        class={`text-sm ${code.active ? 'text-amber-600 hover:text-amber-700' : 'text-emerald-600 hover:text-emerald-700'}`}
                                                        title={code.active ? 'Desactivar' : 'Activar'}
                                                    >
                                                        {code.active ? 'Desactivar' : 'Activar'}
                                                    </button>
                                                </form>
                                                <form method="POST" class="inline" onsubmit="return confirm('¿Eliminar este código?')">
                                                    <input type="hidden" name="action" value="delete" />
                                                    <input type="hidden" name="code_id" value={code.id} />
                                                    <button
                                                        type="submit"
                                                        class="text-sm text-red-600 hover:text-red-700"
                                                    >
                                                        Eliminar
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                )}
            </div>
        </div>

        <!-- Create New Code -->
        <div class="space-y-6">
            <div class="bg-white rounded-2xl border border-zinc-200 p-6">
                <h3 class="font-semibold text-zinc-900 mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                    </svg>
                    Crear Nuevo Código
                </h3>
                
                <form method="POST" class="space-y-4">
                    <input type="hidden" name="action" value="create" />
                    
                    <div>
                        <label class="block text-sm font-medium text-zinc-700 mb-1.5">Código *</label>
                        <input
                            type="text"
                            name="code"
                            required
                            placeholder="VERANO20"
                            class="w-full px-4 py-2.5 bg-zinc-50 border border-zinc-200 rounded-xl text-zinc-900 uppercase placeholder:normal-case focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20"
                        />
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-zinc-700 mb-1.5">Descripción</label>
                        <input
                            type="text"
                            name="description"
                            placeholder="Promoción de verano"
                            class="w-full px-4 py-2.5 bg-zinc-50 border border-zinc-200 rounded-xl text-zinc-900 focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20"
                        />
                    </div>
                    
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-sm font-medium text-zinc-700 mb-1.5">Tipo *</label>
                            <select
                                name="discount_type"
                                required
                                class="w-full px-4 py-2.5 bg-zinc-50 border border-zinc-200 rounded-xl text-zinc-900 focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20"
                            >
                                <option value="percentage">Porcentaje %</option>
                                <option value="fixed">Cantidad fija €</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-zinc-700 mb-1.5">Valor *</label>
                            <input
                                type="number"
                                name="discount_value"
                                required
                                min="1"
                                step="0.01"
                                placeholder="20"
                                class="w-full px-4 py-2.5 bg-zinc-50 border border-zinc-200 rounded-xl text-zinc-900 focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20"
                            />
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-sm font-medium text-zinc-700 mb-1.5">Compra mínima (€)</label>
                            <input
                                type="number"
                                name="min_purchase"
                                min="0"
                                step="0.01"
                                placeholder="0"
                                class="w-full px-4 py-2.5 bg-zinc-50 border border-zinc-200 rounded-xl text-zinc-900 focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20"
                            />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-zinc-700 mb-1.5">Máx. descuento (€)</label>
                            <input
                                type="number"
                                name="max_discount"
                                min="0"
                                step="0.01"
                                placeholder="Sin límite"
                                class="w-full px-4 py-2.5 bg-zinc-50 border border-zinc-200 rounded-xl text-zinc-900 focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20"
                            />
                        </div>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-zinc-700 mb-1.5">Límite de usos</label>
                        <input
                            type="number"
                            name="usage_limit"
                            min="1"
                            placeholder="Sin límite"
                            class="w-full px-4 py-2.5 bg-zinc-50 border border-zinc-200 rounded-xl text-zinc-900 focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20"
                        />
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-zinc-700 mb-1.5">Fecha de expiración</label>
                        <input
                            type="date"
                            name="expires_at"
                            class="w-full px-4 py-2.5 bg-zinc-50 border border-zinc-200 rounded-xl text-zinc-900 focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20"
                        />
                    </div>
                    
                    <div class="flex items-center gap-3 p-3 bg-zinc-50 rounded-xl">
                        <input
                            type="checkbox"
                            name="single_use"
                            id="single_use"
                            class="w-4 h-4 text-cyan-600 bg-white border-zinc-300 rounded focus:ring-cyan-500"
                        />
                        <label for="single_use" class="text-sm text-zinc-700">
                            Uso único por cliente
                        </label>
                    </div>
                    
                    <button
                        type="submit"
                        class="w-full px-4 py-3 bg-cyan-600 text-white font-semibold rounded-xl hover:bg-cyan-700 transition-colors"
                    >
                        Crear Código
                    </button>
                </form>
            </div>

            <!-- Quick Tips -->
            <div class="bg-amber-50 rounded-2xl border border-amber-200 p-5">
                <h4 class="font-semibold text-amber-800 mb-3 flex items-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                    </svg>
                    Consejos
                </h4>
                <ul class="text-sm text-amber-700 space-y-2">
                    <li class="flex items-start gap-2">
                        <span class="text-amber-500 mt-0.5">•</span>
                        Usa códigos cortos y memorables
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="text-amber-500 mt-0.5">•</span>
                        Incluye códigos en el newsletter
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="text-amber-500 mt-0.5">•</span>
                        NEWSLETTER10 está listo para enviar
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <script>
        // Copy code to clipboard
        document.querySelectorAll('.copy-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                const code = (btn as HTMLElement).dataset.code;
                if (code) {
                    await navigator.clipboard.writeText(code);
                    
                    // Show feedback
                    const originalHTML = btn.innerHTML;
                    btn.innerHTML = '<svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>';
                    
                    setTimeout(() => {
                        btn.innerHTML = originalHTML;
                    }, 1500);
                }
            });
        });
    </script>
</AdminLayout>
