---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import {
    getAllFacturacion,
    formatPrice,
    type Facturacion,
} from "../../../lib/supabase";

const invoices: Facturacion[] = await getAllFacturacion();

// Simple stats
const stats = {
    total: invoices.length,
    totalAmount: invoices.reduce(
        (sum, i) => sum + Number(i.orders?.total_price || 0),
        0,
    ),
};

function formatDate(dateStr: string) {
    return new Date(dateStr).toLocaleDateString("es-ES", {
        day: "2-digit",
        month: "short",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
    });
}
---

<AdminLayout title="Gestión de Facturas">
    <!-- Stats Cards -->
    <div class="grid grid-cols-2 gap-4 mb-8">
        <div class="bg-dark-400 rounded-xl border border-white/10 p-4">
            <div class="text-2xl font-bold text-zinc-100">{stats.total}</div>
            <div class="text-sm text-zinc-400">Total Facturas</div>
        </div>
        <div class="bg-gradient-to-br from-neon-cyan to-neon-purple rounded-xl p-4">
            <div class="text-2xl font-bold text-white">
                {formatPrice(stats.totalAmount)}
            </div>
            <div class="text-sm text-white/80">Total Facturado</div>
        </div>
    </div>

    <!-- Invoices List -->
    <div class="bg-dark-400 rounded-2xl border border-white/10 overflow-hidden">
        <div class="p-6 border-b border-white/10">
            <h2 class="text-lg font-semibold text-zinc-100">
                Todas las Facturas
            </h2>
            <p class="text-sm text-zinc-400 mt-1">Historial de facturación</p>
        </div>

        {
            invoices.length === 0 ? (
                <div class="p-12 text-center">
                    <div class="w-16 h-16 bg-dark-300 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg
                            class="w-8 h-8 text-zinc-500"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                            />
                        </svg>
                    </div>
                    <p class="text-zinc-500">
                        No hay facturas generadas todavía
                    </p>
                </div>
            ) : (
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-dark-300 border-b border-white/10">
                            <tr>
                                <th class="text-left px-6 py-3 text-xs font-semibold text-zinc-400 uppercase tracking-wider">
                                    ID Factura
                                </th>
                                <th class="text-left px-6 py-3 text-xs font-semibold text-zinc-400 uppercase tracking-wider">
                                    Pedido
                                </th>
                                <th class="text-left px-6 py-3 text-xs font-semibold text-zinc-400 uppercase tracking-wider">
                                    Cliente
                                </th>
                                <th class="text-left px-6 py-3 text-xs font-semibold text-zinc-400 uppercase tracking-wider">
                                    Total
                                </th>
                                <th class="text-left px-6 py-3 text-xs font-semibold text-zinc-400 uppercase tracking-wider">
                                    Fecha
                                </th>
                                <th class="text-right px-6 py-3 text-xs font-semibold text-zinc-400 uppercase tracking-wider">
                                    Acciones
                                </th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5">
                            {invoices.map((invoice) => {
                                const orderNumber =
                                    invoice.orders?.order_number || "-";
                                const customerName =
                                    invoice.orders?.customer_name || "Cliente";
                                const total = invoice.orders?.total_price || 0;

                                return (
                                    <tr class="hover:bg-white/5 transition-colors">
                                        <td class="px-6 py-4">
                                            <span class="font-mono text-sm font-medium text-zinc-100">
                                                #{invoice.id}
                                            </span>
                                        </td>
                                        <td class="px-6 py-4">
                                            <a
                                                href={`/admin/pedidos/${invoice.order_id}`}
                                                class="text-sm text-neon-cyan hover:underline"
                                            >
                                                #{orderNumber}
                                            </a>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="text-sm font-medium text-zinc-100">
                                                {customerName}
                                            </div>
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="font-semibold text-zinc-100">
                                                {formatPrice(total)}
                                            </span>
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="text-sm text-zinc-400">
                                                {formatDate(invoice.created_at)}
                                            </span>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="flex items-center justify-end gap-2">
                                                <!-- Ver Factura -->
                                                <a
                                                    href={`/api/invoice/${invoice.order_id}`}
                                                    target="_blank"
                                                    class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-neon-cyan bg-neon-cyan/10 rounded-lg hover:bg-neon-cyan/20 border border-neon-cyan/30 transition-colors"
                                                    title="Ver Factura"
                                                >
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                                    </svg>
                                                    Ver
                                                </a>
                                                <!-- Enviar Factura -->
                                                <button
                                                    type="button"
                                                    data-order-id={invoice.order_id}
                                                    data-invoice-number={invoice.invoice_number || invoice.id}
                                                    class="send-invoice-btn inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-emerald-400 bg-emerald-500/10 rounded-lg hover:bg-emerald-500/20 border border-emerald-500/30 transition-colors"
                                                    title="Enviar por Email"
                                                >
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                                    </svg>
                                                    Enviar
                                                </button>
                                                <!-- Ver Pedido -->
                                                <a
                                                    href={`/admin/pedidos/${invoice.order_id}`}
                                                    class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-zinc-400 bg-dark-300 rounded-lg hover:bg-dark-200 border border-white/10 transition-colors"
                                                    title="Ver Pedido"
                                                >
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                                    </svg>
                                                    Pedido
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                );
                            })}
                        </tbody>
                    </table>
                </div>
            )
        }
    </div>
</AdminLayout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Send invoice buttons
        document.querySelectorAll('.send-invoice-btn').forEach(btn => {
            btn.addEventListener('click', async (e) => {
                const button = e.currentTarget as HTMLButtonElement;
                const orderId = button.dataset.orderId;
                const invoiceNumber = button.dataset.invoiceNumber;
                
                if (!confirm(`¿Enviar factura ${invoiceNumber} por email al cliente?`)) {
                    return;
                }
                
                // Disable button and show loading
                button.disabled = true;
                const originalContent = button.innerHTML;
                button.innerHTML = `
                    <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    Enviando...
                `;
                
                try {
                    const response = await fetch('/api/invoice/send', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ orderId })
                    });
                    
                    const result = await response.json();
                    
                    if (response.ok) {
                        button.innerHTML = `
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            Enviada
                        `;
                        button.classList.remove('bg-emerald-50', 'text-emerald-700', 'hover:bg-emerald-100');
                        button.classList.add('bg-green-100', 'text-green-700');
                        
                        setTimeout(() => {
                            button.innerHTML = originalContent;
                            button.classList.remove('bg-green-100', 'text-green-700');
                            button.classList.add('bg-emerald-50', 'text-emerald-700', 'hover:bg-emerald-100');
                            button.disabled = false;
                        }, 3000);
                    } else {
                        alert('Error: ' + (result.error || 'No se pudo enviar la factura'));
                        button.innerHTML = originalContent;
                        button.disabled = false;
                    }
                } catch (error) {
                    console.error('Error sending invoice:', error);
                    alert('Error al enviar la factura');
                    button.innerHTML = originalContent;
                    button.disabled = false;
                }
            });
        });
    });
</script>

