---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import {
    getAllFacturacion,
    formatPrice,
    type Facturacion,
} from "../../../lib/supabase";

const invoices: Facturacion[] = await getAllFacturacion();

// Simple stats
const stats = {
    total: invoices.length,
    totalAmount: invoices.reduce(
        (sum, i) => sum + Number(i.orders?.total_price || 0),
        0,
    ),
};

function formatDate(dateStr: string) {
    return new Date(dateStr).toLocaleDateString("es-ES", {
        day: "2-digit",
        month: "short",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
    });
}
---

<AdminLayout title="Gestión de Facturas">
    <!-- Stats Cards -->
    <div class="grid grid-cols-2 gap-4 mb-8">
        <div class="bg-white rounded-xl border border-zinc-200 p-4">
            <div class="text-2xl font-bold text-zinc-900">{stats.total}</div>
            <div class="text-sm text-zinc-500">Total Facturas</div>
        </div>
        <div class="bg-zinc-900 rounded-xl p-4">
            <div class="text-2xl font-bold text-white">
                {formatPrice(stats.totalAmount)}
            </div>
            <div class="text-sm text-zinc-400">Total Facturado</div>
        </div>
    </div>

    <!-- Invoices List -->
    <div class="bg-white rounded-2xl border border-zinc-200 overflow-hidden">
        <div class="p-6 border-b border-zinc-200">
            <h2 class="text-lg font-semibold text-zinc-900">
                Todas las Facturas
            </h2>
            <p class="text-sm text-zinc-500 mt-1">Historial de facturación</p>
        </div>

        {
            invoices.length === 0 ? (
                <div class="p-12 text-center">
                    <div class="w-16 h-16 bg-zinc-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg
                            class="w-8 h-8 text-zinc-400"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                            />
                        </svg>
                    </div>
                    <p class="text-zinc-500">
                        No hay facturas generadas todavía
                    </p>
                </div>
            ) : (
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-zinc-50 border-b border-zinc-200">
                            <tr>
                                <th class="text-left px-6 py-3 text-xs font-semibold text-zinc-500 uppercase tracking-wider">
                                    ID Factura
                                </th>
                                <th class="text-left px-6 py-3 text-xs font-semibold text-zinc-500 uppercase tracking-wider">
                                    Pedido
                                </th>
                                <th class="text-left px-6 py-3 text-xs font-semibold text-zinc-500 uppercase tracking-wider">
                                    Cliente
                                </th>
                                <th class="text-left px-6 py-3 text-xs font-semibold text-zinc-500 uppercase tracking-wider">
                                    Total
                                </th>
                                <th class="text-left px-6 py-3 text-xs font-semibold text-zinc-500 uppercase tracking-wider">
                                    Fecha
                                </th>
                                <th class="text-right px-6 py-3 text-xs font-semibold text-zinc-500 uppercase tracking-wider">
                                    Acciones
                                </th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-zinc-100">
                            {invoices.map((invoice) => {
                                const orderNumber =
                                    invoice.orders?.order_number || "-";
                                const customerName =
                                    invoice.orders?.customer_name || "Cliente";
                                const total = invoice.orders?.total_price || 0;

                                return (
                                    <tr class="hover:bg-zinc-50 transition-colors">
                                        <td class="px-6 py-4">
                                            <span class="font-mono text-sm font-medium text-zinc-900">
                                                #{invoice.id}
                                            </span>
                                        </td>
                                        <td class="px-6 py-4">
                                            <a
                                                href={`/admin/pedidos/${invoice.order_id}`}
                                                class="text-sm text-cyan-600 hover:underline"
                                            >
                                                #{orderNumber}
                                            </a>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="text-sm font-medium text-zinc-900">
                                                {customerName}
                                            </div>
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="font-semibold text-zinc-900">
                                                {formatPrice(total)}
                                            </span>
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="text-sm text-zinc-500">
                                                {formatDate(invoice.created_at)}
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 text-right">
                                            <a
                                                href={`/admin/pedidos/${invoice.order_id}`}
                                                class="inline-flex items-center gap-1 text-sm text-cyan-600 hover:text-cyan-700 font-medium"
                                            >
                                                Ver Pedido
                                                <svg
                                                    class="w-4 h-4"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    viewBox="0 0 24 24"
                                                >
                                                    <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M9 5l7 7-7 7"
                                                    />
                                                </svg>
                                            </a>
                                        </td>
                                    </tr>
                                );
                            })}
                        </tbody>
                    </table>
                </div>
            )
        }
    </div>
</AdminLayout>
