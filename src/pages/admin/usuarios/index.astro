---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getCustomers, formatPrice } from "../../../lib/supabase";

const customers = await getCustomers();

const newsletterCount = customers.filter(c => c.newsletter).length;

function formatDate(dateStr: string) {
    return new Date(dateStr).toLocaleDateString('es-ES', {
        day: '2-digit',
        month: 'short',
        year: 'numeric'
    });
}
---

<AdminLayout title="Gestión de Usuarios">
    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
        <div class="bg-dark-400 rounded-xl border border-neon-cyan/20 p-5">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-neon-cyan/10 rounded-xl flex items-center justify-center">
                    <svg class="w-6 h-6 text-neon-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                </div>
                <div>
                    <div class="text-2xl font-bold text-neon-cyan">{customers.length}</div>
                    <div class="text-sm text-zinc-500">Total Clientes</div>
                </div>
            </div>
        </div>
        <div class="bg-dark-400 rounded-xl border border-emerald-500/20 p-5">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-emerald-500/10 rounded-xl flex items-center justify-center">
                    <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                </div>
                <div>
                    <div class="text-2xl font-bold text-emerald-400">{newsletterCount}</div>
                    <div class="text-sm text-zinc-500">Suscritos Newsletter</div>
                </div>
            </div>
        </div>
        <div class="bg-gradient-to-br from-neon-fuchsia/20 to-neon-purple/20 rounded-xl border border-neon-fuchsia/30 p-5">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-white/5 rounded-xl flex items-center justify-center">
                    <svg class="w-6 h-6 text-neon-fuchsia" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div>
                    <div class="text-2xl font-bold text-neon-fuchsia">{Math.round((newsletterCount / (customers.length || 1)) * 100)}%</div>
                    <div class="text-sm text-zinc-400">Tasa Suscripción</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search Bar -->
    <div class="relative mb-6">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input type="text" id="user-search" class="w-full pl-10 pr-4 py-3 bg-dark-400 border border-white/10 rounded-xl text-zinc-100 text-sm placeholder-zinc-600 focus:outline-none focus:border-neon-cyan focus:shadow-[0_0_20px_rgba(6,182,212,0.15)] transition-all" placeholder="Buscar por nombre, email o teléfono..." />
    </div>
    <div id="no-results" class="hidden text-center py-10 text-zinc-500 text-sm">No se encontraron clientes</div>

    <!-- Users List -->
    <div id="users-table" class="bg-dark-400 rounded-2xl border border-white/10 overflow-hidden">
        <div class="p-6 border-b border-white/10 flex items-center justify-between">
            <div>
                <h2 class="text-lg font-semibold text-zinc-100">Todos los Clientes</h2>
                <p class="text-sm text-zinc-500 mt-1">Lista de clientes registrados en la tienda</p>
            </div>
            <a
                href="/admin/comunicaciones"
                class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-neon-cyan to-neon-purple text-white rounded-lg text-sm font-medium hover:shadow-glow-cyan transition-all"
            >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                Enviar Comunicación
            </a>
        </div>

        {customers.length === 0 ? (
            <div class="p-12 text-center">
                <div class="w-16 h-16 bg-dark-300 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-zinc-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                </div>
                <p class="text-zinc-500">No hay clientes registrados todavía</p>
            </div>
        ) : (
            <div class="overflow-x-auto">
                <table class="w-full min-w-[700px]">
                    <thead class="bg-dark-300 border-b border-white/10">
                        <tr>
                            <th class="px-6 py-3 text-left">
                                <button data-sort="name" class="sort-btn inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wider hover:text-neon-cyan transition-colors text-neon-cyan">
                                    Cliente <span class="sort-icon">↑</span>
                                </button>
                            </th>
                            <th class="text-left px-6 py-3 text-xs font-semibold text-zinc-500 uppercase tracking-wider">Teléfono</th>
                            <th class="px-6 py-3 text-left">
                                <button data-sort="newsletter" class="sort-btn inline-flex items-center gap-1 text-xs font-semibold text-zinc-500 uppercase tracking-wider hover:text-neon-cyan transition-colors">
                                    Newsletter <span class="sort-icon text-zinc-600">↕</span>
                                </button>
                            </th>
                            <th class="px-6 py-3 text-left">
                                <button data-sort="date" class="sort-btn inline-flex items-center gap-1 text-xs font-semibold text-zinc-500 uppercase tracking-wider hover:text-neon-cyan transition-colors">
                                    Registrado <span class="sort-icon text-zinc-600">↕</span>
                                </button>
                            </th>
                            <th class="text-right px-6 py-3 text-xs font-semibold text-zinc-500 uppercase tracking-wider">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5">
                        {customers.map((customer) => (
                            <tr
                                class="customer-row hover:bg-white/5 transition-colors"
                                data-name={(customer.full_name || customer.email || '').toLowerCase()}
                                data-newsletter={customer.newsletter ? '1' : '0'}
                                data-date={customer.created_at}
                            >
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-neon-cyan to-neon-purple flex items-center justify-center text-white font-medium">
                                            {customer.avatar_url ? (
                                                <img src={customer.avatar_url} alt={customer.full_name || ''} class="w-full h-full rounded-full object-cover" />
                                            ) : (
                                                customer.full_name?.charAt(0).toUpperCase() || customer.email.charAt(0).toUpperCase()
                                            )}
                                        </div>
                                        <div>
                                            <div class="font-medium text-zinc-100">{customer.full_name || 'Sin nombre'}</div>
                                            <div class="text-sm text-zinc-500">{customer.email}</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="text-sm text-zinc-400">{customer.phone || '-'}</span>
                                </td>
                                <td class="px-6 py-4">
                                    {customer.newsletter ? (
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-emerald-500/10 text-emerald-400 rounded-full text-xs font-medium border border-emerald-500/30">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                            </svg>
                                            Suscrito
                                        </span>
                                    ) : (
                                        <span class="inline-flex px-2.5 py-1 bg-white/5 text-zinc-500 rounded-full text-xs font-medium">
                                            No suscrito
                                        </span>
                                    )}
                                </td>
                                <td class="px-6 py-4">
                                    <span class="text-sm text-zinc-500">{formatDate(customer.created_at)}</span>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <a
                                        href={`/admin/usuarios/${customer.id}`}
                                        class="inline-flex items-center gap-1 text-sm text-neon-cyan hover:text-neon-cyan-light font-medium"
                                    >
                                        Ver perfil
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                        </svg>
                                    </a>
                                </td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        )}
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('user-search') as HTMLInputElement;
            const noResults = document.getElementById('no-results');
            const tableContainer = document.getElementById('users-table') as HTMLElement;
            const tbody = tableContainer?.querySelector('tbody');

            // ── Search ──────────────────────────────────────────────
            function applySearch() {
                const query = searchInput?.value.toLowerCase().trim() ?? '';
                const rows = tableContainer?.querySelectorAll('tbody tr.customer-row');
                let visible = 0;
                rows?.forEach(row => {
                    const text = (row as HTMLElement).innerText.toLowerCase();
                    const match = !query || text.includes(query);
                    (row as HTMLElement).style.display = match ? '' : 'none';
                    if (match) visible++;
                });
                if (noResults) noResults.classList.toggle('hidden', visible > 0 || !query);
                if (tableContainer) tableContainer.style.display = visible === 0 && query ? 'none' : '';
            }
            searchInput?.addEventListener('input', applySearch);

            // ── Sort ────────────────────────────────────────────────
            let sortCol = 'name';
            let sortDir: 'asc' | 'desc' = 'asc';

            function applySort(col: string) {
                if (sortCol === col) {
                    sortDir = sortDir === 'asc' ? 'desc' : 'asc';
                } else {
                    sortCol = col;
                    sortDir = col === 'date' ? 'desc' : 'asc';
                }

                tableContainer?.querySelectorAll('button[data-sort]').forEach(btn => {
                    const icon = btn.querySelector('.sort-icon') as HTMLElement;
                    if (!icon) return;
                    const isActive = (btn as HTMLElement).dataset.sort === col;
                    icon.textContent = isActive ? (sortDir === 'asc' ? '↑' : '↓') : '↕';
                    btn.classList.toggle('text-neon-cyan', isActive);
                    btn.classList.toggle('text-zinc-500', !isActive);
                });

                if (!tbody) return;
                const rows = Array.from(tbody.querySelectorAll('tr.customer-row'));
                rows.sort((a, b) => {
                    const aEl = a as HTMLElement;
                    const bEl = b as HTMLElement;
                    const aRaw = aEl.dataset[col] ?? '';
                    const bRaw = bEl.dataset[col] ?? '';

                    if (col === 'newsletter') {
                        const aNum = parseInt(aRaw) || 0;
                        const bNum = parseInt(bRaw) || 0;
                        return sortDir === 'asc' ? aNum - bNum : bNum - aNum;
                    }
                    if (col === 'date') {
                        const aTime = new Date(aRaw).getTime() || 0;
                        const bTime = new Date(bRaw).getTime() || 0;
                        return sortDir === 'asc' ? aTime - bTime : bTime - aTime;
                    }
                    return sortDir === 'asc'
                        ? aRaw.localeCompare(bRaw, 'es')
                        : bRaw.localeCompare(aRaw, 'es');
                });
                rows.forEach(row => tbody.appendChild(row));
            }

            tableContainer?.querySelectorAll('button[data-sort]').forEach(btn => {
                btn.addEventListener('click', () => applySort((btn as HTMLElement).dataset.sort ?? ''));
            });
        });
    </script>
</AdminLayout>
