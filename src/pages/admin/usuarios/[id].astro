---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import {
    getCustomerById,
    getCustomerOrders,
    formatPrice,
} from "../../../lib/supabase";

const { id } = Astro.params;

if (!id) {
    return Astro.redirect("/admin/usuarios");
}

const customer = await getCustomerById(id);
const orders = await getCustomerOrders(id);

if (!customer) {
    return Astro.redirect("/admin/usuarios");
}

const statusLabels: Record<
    string,
    { label: string; color: string; bg: string }
> = {
    pending: {
        label: "Pendiente",
        color: "text-amber-700",
        bg: "bg-amber-50 border-amber-200",
    },
    paid: {
        label: "Pagado",
        color: "text-blue-700",
        bg: "bg-blue-50 border-blue-200",
    },
    shipped: {
        label: "Enviado",
        color: "text-purple-700",
        bg: "bg-purple-50 border-purple-200",
    },
    delivered: {
        label: "Entregado",
        color: "text-emerald-700",
        bg: "bg-emerald-50 border-emerald-200",
    },
    cancelled: {
        label: "Cancelado",
        color: "text-red-700",
        bg: "bg-red-50 border-red-200",
    },
};

function formatDate(dateStr: string) {
    return new Date(dateStr).toLocaleDateString("es-ES", {
        day: "2-digit",
        month: "short",
        year: "numeric",
    });
}

const totalSpent = orders
    .filter((o) => o.status !== "cancelled")
    .reduce((sum, o) => sum + Number(o.total_price), 0);
---

<AdminLayout title={`Cliente: ${customer.full_name || customer.email}`}>
    <div class="max-w-4xl">
        <!-- Header -->
        <div class="flex items-center gap-4 mb-8">
            <a
                href="/admin/usuarios"
                class="p-2 text-zinc-400 hover:text-zinc-900 hover:bg-zinc-100 rounded-lg transition-colors"
            >
                <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15 19l-7-7 7-7"></path>
                </svg>
            </a>
            <div class="flex items-center gap-4">
                <div
                    class="w-14 h-14 rounded-full bg-zinc-200 flex items-center justify-center text-zinc-600 text-xl font-semibold"
                >
                    {
                        customer.avatar_url ? (
                            <img
                                src={customer.avatar_url}
                                alt={customer.full_name || ""}
                                class="w-full h-full rounded-full object-cover"
                            />
                        ) : (
                            customer.full_name?.charAt(0).toUpperCase() ||
                            customer.email.charAt(0).toUpperCase()
                        )
                    }
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-zinc-900">
                        {customer.full_name || "Sin nombre"}
                    </h1>
                    <p class="text-zinc-500">{customer.email}</p>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Main Content -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Stats -->
                <div class="grid grid-cols-3 gap-4">
                    <div
                        class="bg-white rounded-xl border border-zinc-200 p-4 text-center"
                    >
                        <div class="text-2xl font-bold text-zinc-900">
                            {orders.length}
                        </div>
                        <div class="text-sm text-zinc-500">Pedidos</div>
                    </div>
                    <div
                        class="bg-white rounded-xl border border-zinc-200 p-4 text-center"
                    >
                        <div class="text-2xl font-bold text-zinc-900">
                            {formatPrice(totalSpent)}
                        </div>
                        <div class="text-sm text-zinc-500">Total Gastado</div>
                    </div>
                    <div
                        class="bg-white rounded-xl border border-zinc-200 p-4 text-center"
                    >
                        <div class="text-2xl font-bold text-zinc-900">
                            {formatDate(customer.created_at)}
                        </div>
                        <div class="text-sm text-zinc-500">Cliente desde</div>
                    </div>
                </div>

                <!-- Orders History -->
                <div
                    class="bg-white rounded-2xl border border-zinc-200 overflow-hidden"
                >
                    <div class="p-5 border-b border-zinc-200">
                        <h2 class="font-semibold text-zinc-900">
                            Historial de Pedidos
                        </h2>
                    </div>

                    {
                        orders.length === 0 ? (
                            <div class="p-8 text-center">
                                <div class="w-12 h-12 bg-zinc-100 rounded-full flex items-center justify-center mx-auto mb-3">
                                    <svg
                                        class="w-6 h-6 text-zinc-400"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="1.5"
                                            d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"
                                        />
                                    </svg>
                                </div>
                                <p class="text-zinc-500">
                                    Este cliente no ha realizado pedidos
                                </p>
                            </div>
                        ) : (
                            <div class="divide-y divide-zinc-100">
                                {orders.map((order) => {
                                    const status =
                                        statusLabels[order.status] ||
                                        statusLabels.pending;
                                    return (
                                        <a
                                            href={`/admin/pedidos/${order.id}`}
                                            class="block p-5 hover:bg-zinc-50 transition-colors"
                                        >
                                            <div class="flex items-center justify-between">
                                                <div class="flex items-center gap-4">
                                                    <div class="w-10 h-10 bg-zinc-100 rounded-lg flex items-center justify-center">
                                                        <svg
                                                            class="w-5 h-5 text-zinc-500"
                                                            fill="none"
                                                            stroke="currentColor"
                                                            viewBox="0 0 24 24"
                                                        >
                                                            <path
                                                                stroke-linecap="round"
                                                                stroke-linejoin="round"
                                                                stroke-width="1.5"
                                                                d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"
                                                            />
                                                        </svg>
                                                    </div>
                                                    <div>
                                                        <div class="font-medium text-zinc-900">
                                                            Pedido #
                                                            {order.order_number
                                                                ? order.order_number
                                                                : order.id.slice(
                                                                      0,
                                                                      8,
                                                                  )}
                                                        </div>
                                                        <div class="text-sm text-zinc-500">
                                                            {formatDate(
                                                                order.created_at,
                                                            )}{" "}
                                                            •{" "}
                                                            {order.items
                                                                ?.length ||
                                                                0}{" "}
                                                            productos
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="text-right flex items-center gap-4">
                                                    <span
                                                        class={`inline-flex px-2.5 py-1 rounded-full text-xs font-medium border ${status.bg} ${status.color}`}
                                                    >
                                                        {status.label}
                                                    </span>
                                                    <span class="font-semibold text-zinc-900">
                                                        {formatPrice(
                                                            order.total_price,
                                                        )}
                                                    </span>
                                                </div>
                                            </div>
                                        </a>
                                    );
                                })}
                            </div>
                        )
                    }
                </div>
            </div>

            <!-- Sidebar -->
            <div class="space-y-6">
                <!-- Contact Info -->
                <div class="bg-white rounded-2xl border border-zinc-200 p-5">
                    <h2
                        class="font-semibold text-zinc-900 mb-4 flex items-center gap-2"
                    >
                        <svg
                            class="w-5 h-5 text-zinc-400"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                            ></path>
                        </svg>
                        Información de Contacto
                    </h2>
                    <div class="space-y-4">
                        <div>
                            <div
                                class="text-xs text-zinc-500 uppercase tracking-wider mb-1"
                            >
                                Email
                            </div>
                            <div class="text-zinc-900">{customer.email}</div>
                        </div>
                        <div>
                            <div
                                class="text-xs text-zinc-500 uppercase tracking-wider mb-1"
                            >
                                Teléfono
                            </div>
                            <div class="text-zinc-900">
                                {customer.phone || "No registrado"}
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Newsletter Status -->
                <div class="bg-white rounded-2xl border border-zinc-200 p-5">
                    <h2
                        class="font-semibold text-zinc-900 mb-4 flex items-center gap-2"
                    >
                        <svg
                            class="w-5 h-5 text-zinc-400"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
                            ></path>
                        </svg>
                        Comunicaciones
                    </h2>
                    {
                        customer.newsletter ? (
                            <div class="flex items-center gap-3 p-3 bg-emerald-50 border border-emerald-200 rounded-xl">
                                <div class="w-10 h-10 bg-emerald-100 rounded-full flex items-center justify-center">
                                    <svg
                                        class="w-5 h-5 text-emerald-600"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M5 13l4 4L19 7"
                                        />
                                    </svg>
                                </div>
                                <div>
                                    <div class="font-medium text-emerald-900">
                                        Suscrito al Newsletter
                                    </div>
                                    <div class="text-sm text-emerald-700">
                                        Acepta recibir comunicaciones
                                    </div>
                                </div>
                            </div>
                        ) : (
                            <div class="flex items-center gap-3 p-3 bg-zinc-50 border border-zinc-200 rounded-xl">
                                <div class="w-10 h-10 bg-zinc-200 rounded-full flex items-center justify-center">
                                    <svg
                                        class="w-5 h-5 text-zinc-500"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M6 18L18 6M6 6l12 12"
                                        />
                                    </svg>
                                </div>
                                <div>
                                    <div class="font-medium text-zinc-700">
                                        No suscrito
                                    </div>
                                    <div class="text-sm text-zinc-500">
                                        No desea recibir comunicaciones
                                    </div>
                                </div>
                            </div>
                        )
                    }
                </div>

                <!-- Default Address -->
                {
                    customer.default_address &&
                        Object.keys(customer.default_address).length > 0 && (
                            <div class="bg-white rounded-2xl border border-zinc-200 p-5">
                                <h2 class="font-semibold text-zinc-900 mb-4 flex items-center gap-2">
                                    <svg
                                        class="w-5 h-5 text-zinc-400"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="1.5"
                                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                        />
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="1.5"
                                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                        />
                                    </svg>
                                    Dirección por Defecto
                                </h2>
                                <div class="text-zinc-600 text-sm space-y-1">
                                    {customer.default_address.street && (
                                        <p>{customer.default_address.street}</p>
                                    )}
                                    {customer.default_address.city && (
                                        <p>
                                            {customer.default_address.city},{" "}
                                            {
                                                customer.default_address
                                                    .postal_code
                                            }
                                        </p>
                                    )}
                                    {customer.default_address.province && (
                                        <p>
                                            {customer.default_address.province}
                                        </p>
                                    )}
                                    {customer.default_address.country && (
                                        <p>
                                            {customer.default_address.country}
                                        </p>
                                    )}
                                </div>
                            </div>
                        )
                }
            </div>
        </div>
    </div>
</AdminLayout>
