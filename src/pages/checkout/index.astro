---
import PublicLayout from "../../layouts/PublicLayout.astro";

export const prerender = false;
---

<PublicLayout
    title="Checkout - Finalizar Compra"
    description="Completa tu pedido"
>
    <!-- Loading state -->
    <section id="loading-state" class="py-12 md:py-16 min-h-[70vh] flex items-center justify-center">
        <div class="text-center">
            <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-gradient-to-br from-neon-cyan to-neon-fuchsia flex items-center justify-center animate-pulse">
                <svg class="w-8 h-8 text-dark-500 animate-spin" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                </svg>
            </div>
            <p class="text-zinc-400">Cargando checkout...</p>
        </div>
    </section>

    <!-- Main checkout content -->
    <section id="checkout-content" class="hidden py-12 md:py-16 min-h-[70vh]">
        <div class="container-custom max-w-4xl">
            <h1 class="text-3xl md:text-4xl font-display font-bold text-white mb-8">
                Finalizar Compra
            </h1>

            <form id="checkout-form" class="space-y-6">
                <!-- Email Section -->
                <div class="bg-dark-400/50 backdrop-blur-xl border border-white/10 rounded-2xl p-6">
                    <h2 class="font-display text-xl text-white mb-4">Información de Contacto</h2>
                    
                    <div class="space-y-4">
                        <div>
                            <label for="email" class="block text-sm font-medium text-zinc-300 mb-2">
                                Correo Electrónico *
                            </label>
                            <input
                                type="email"
                                id="email"
                                name="email"
                                required
                                class="w-full px-4 py-3 bg-dark-500 border border-white/10 rounded-xl text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-neon-cyan/50 disabled:opacity-50"
                                placeholder="tu@email.com"
                            />
                        </div>

                        <div>
                            <label for="phone" class="block text-sm font-medium text-zinc-300 mb-2">
                                Teléfono *
                            </label>
                            <input
                                type="tel"
                                id="phone"
                                name="phone"
                                required
                                class="w-full px-4 py-3 bg-dark-500 border border-white/10 rounded-xl text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-neon-cyan/50"
                                placeholder="+34 600 000 000"
                            />
                        </div>
                    </div>
                </div>

                <!-- Shipping Address Section -->
                <div class="bg-dark-400/50 backdrop-blur-xl border border-white/10 rounded-2xl p-6">
                    <h2 class="font-display text-xl text-white mb-4">Dirección de Envío</h2>
                    
                    <!-- Saved addresses container (populated by JS) -->
                    <div id="saved-addresses-container" class="hidden mb-6">
                        <label class="block text-sm font-medium text-zinc-300 mb-3">
                            Direcciones guardadas
                        </label>
                        <div id="saved-addresses-list" class="space-y-2">
                            <!-- Addresses will be inserted here -->
                        </div>
                    </div>

                    <div id="address-fields" class="space-y-4">
                        <div>
                            <label for="full_name" class="block text-sm font-medium text-zinc-300 mb-2">
                                Nombre Completo *
                            </label>
                            <input
                                type="text"
                                id="full_name"
                                name="full_name"
                                required
                                class="w-full px-4 py-3 bg-dark-500 border border-white/10 rounded-xl text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-neon-cyan/50"
                                placeholder="Juan Pérez"
                            />
                        </div>

                        <div>
                            <label for="street" class="block text-sm font-medium text-zinc-300 mb-2">
                                Dirección *
                            </label>
                            <input
                                type="text"
                                id="street"
                                name="street"
                                required
                                class="w-full px-4 py-3 bg-dark-500 border border-white/10 rounded-xl text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-neon-cyan/50"
                                placeholder="Calle Principal, 123"
                            />
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label for="city" class="block text-sm font-medium text-zinc-300 mb-2">
                                    Ciudad *
                                </label>
                                <input
                                    type="text"
                                    id="city"
                                    name="city"
                                    required
                                    class="w-full px-4 py-3 bg-dark-500 border border-white/10 rounded-xl text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-neon-cyan/50"
                                    placeholder="Madrid"
                                />
                            </div>

                            <div>
                                <label for="postal_code" class="block text-sm font-medium text-zinc-300 mb-2">
                                    Código Postal *
                                </label>
                                <input
                                    type="text"
                                    id="postal_code"
                                    name="postal_code"
                                    required
                                    class="w-full px-4 py-3 bg-dark-500 border border-white/10 rounded-xl text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-neon-cyan/50"
                                    placeholder="28001"
                                />
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label for="province" class="block text-sm font-medium text-zinc-300 mb-2">
                                    Provincia *
                                </label>
                                <input
                                    type="text"
                                    id="province"
                                    name="province"
                                    required
                                    class="w-full px-4 py-3 bg-dark-500 border border-white/10 rounded-xl text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-neon-cyan/50"
                                    placeholder="Madrid"
                                />
                            </div>

                            <div>
                                <label for="country" class="block text-sm font-medium text-zinc-300 mb-2">
                                    País *
                                </label>
                                <select
                                    id="country"
                                    name="country"
                                    required
                                    class="w-full px-4 py-3 bg-dark-500 border border-white/10 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-neon-cyan/50"
                                >
                                    <option value="ES" selected>España</option>
                                    <option value="FR">Francia</option>
                                    <option value="IT">Italia</option>
                                    <option value="PT">Portugal</option>
                                    <option value="DE">Alemania</option>
                                    <option value="NL">Países Bajos</option>
                                    <option value="BE">Bélgica</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Order Summary -->
                <div class="bg-dark-400/50 backdrop-blur-xl border border-white/10 rounded-2xl p-6">
                    <h2 class="font-display text-xl text-white mb-4">Resumen del Pedido</h2>
                    
                    <div id="order-items" class="space-y-3 mb-4">
                        <!-- Will be populated by JS -->
                    </div>

                    <!-- Discount Code Section -->
                    <div class="border-t border-white/10 pt-4 mb-4">
                        <div class="flex gap-2">
                            <input
                                type="text"
                                id="discount-code"
                                placeholder="Código de descuento"
                                class="flex-1 px-4 py-2.5 bg-dark-500 border border-white/10 rounded-xl text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-neon-cyan/50 text-sm"
                            />
                            <button
                                type="button"
                                id="apply-discount-btn"
                                class="px-4 py-2.5 bg-dark-500 border border-white/10 text-white rounded-xl hover:border-neon-cyan/50 hover:text-neon-cyan transition-all text-sm font-medium"
                            >
                                Aplicar
                            </button>
                        </div>
                        <div id="discount-message" class="hidden mt-2 text-sm"></div>
                        <div id="applied-discount" class="hidden mt-3 p-3 bg-green-500/10 border border-green-500/30 rounded-xl flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <span class="text-green-400 text-sm">
                                    <span id="discount-code-display" class="font-semibold"></span> aplicado
                                </span>
                            </div>
                            <button
                                type="button"
                                id="remove-discount-btn"
                                class="text-green-400 hover:text-green-300 text-sm"
                            >
                                Eliminar
                            </button>
                        </div>
                    </div>

                    <div class="border-t border-white/10 pt-4 space-y-2">
                        <div class="flex justify-between text-zinc-400">
                            <span>Subtotal</span>
                            <span id="subtotal">€0,00</span>
                        </div>
                        <div id="discount-row" class="hidden flex justify-between text-green-400">
                            <span>Descuento (<span id="discount-percent"></span>)</span>
                            <span id="discount-amount">-€0,00</span>
                        </div>
                        <div class="flex justify-between text-zinc-400">
                            <span>Envío</span>
                            <span>Gratis</span>
                        </div>
                        <div class="flex justify-between items-center pt-2 border-t border-white/10">
                            <span class="font-medium text-white">Total</span>
                            <span id="total" class="font-display text-2xl text-neon-cyan">€0,00</span>
                        </div>
                    </div>
                </div>

                <!-- Submit Buttons -->
                <div class="flex flex-col sm:flex-row gap-4">
                    <button
                        type="submit"
                        id="submit-btn"
                        class="flex-1 py-4 px-6 bg-gradient-to-r from-neon-cyan to-neon-cyan-light text-dark-500 font-semibold rounded-xl hover:shadow-lg hover:shadow-neon-cyan/25 transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed"
                    >
                        <span id="submit-text">Proceder al Pago</span>
                        <svg id="submit-spinner" class="hidden animate-spin w-5 h-5 mx-auto" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                        </svg>
                    </button>
                    <a
                        href="/carrito"
                        class="py-4 px-6 border border-white/10 text-white font-semibold rounded-xl hover:border-neon-cyan/50 transition-all duration-200 text-center"
                    >
                        Volver al Carrito
                    </a>
                </div>
            </form>
        </div>
    </section>

    <script>
        import { createClient } from '@supabase/supabase-js';
        
        const supabase = createClient(
            import.meta.env.PUBLIC_SUPABASE_URL || '',
            import.meta.env.PUBLIC_SUPABASE_ANON_KEY || ''
        );

        let appliedDiscount = null;
        let currentUser = null;
        let customerData = null;
        let savedAddresses = [];

        // Format price
        function formatPrice(price) {
            return new Intl.NumberFormat("es-ES", {
                style: "currency",
                currency: "EUR",
            }).format(price);
        }

        // Get cart from localStorage
        function getCart() {
            try {
                const saved = localStorage.getItem("fashionmarket-cart");
                return saved ? JSON.parse(saved) : [];
            } catch {
                return [];
            }
        }

        // Render saved addresses
        function renderSavedAddresses() {
            const container = document.getElementById('saved-addresses-container');
            const list = document.getElementById('saved-addresses-list');
            
            if (!container || !list) return;
            
            if (savedAddresses.length === 0) {
                container.classList.add('hidden');
                return;
            }

            container.classList.remove('hidden');
            
            let html = savedAddresses.map((address, index) => `
                <label class="flex items-start gap-3 p-4 bg-dark-500 rounded-xl cursor-pointer hover:bg-dark-500/70 transition-colors border border-transparent has-[:checked]:border-neon-cyan has-[:checked]:bg-neon-cyan/5">
                    <input
                        type="radio"
                        name="saved-address"
                        value="${address.id}"
                        data-fullname="${address.full_name}"
                        data-phone="${address.phone || ''}"
                        data-street="${address.street}"
                        data-city="${address.city}"
                        data-postal="${address.postal_code}"
                        data-province="${address.province}"
                        data-country="${address.country}"
                        class="saved-address-radio w-4 h-4 mt-1 text-neon-cyan bg-dark-400 border-white/20 focus:ring-neon-cyan/50"
                        ${index === 0 ? 'checked' : ''}
                    />
                    <div class="flex-1">
                        <div class="flex items-center gap-2 mb-1">
                            <span class="text-white font-medium">${address.label}</span>
                            ${address.is_default ? '<span class="px-2 py-0.5 bg-neon-cyan/20 text-neon-cyan text-xs rounded-full">Predeterminada</span>' : ''}
                        </div>
                        <p class="text-zinc-300 text-sm">${address.full_name}</p>
                        <p class="text-zinc-400 text-sm">
                            ${address.street}<br/>
                            ${address.postal_code} ${address.city}, ${address.province}
                        </p>
                    </div>
                </label>
            `).join('');

            // Add manual option
            html += `
                <label class="flex items-center gap-3 p-4 bg-dark-500 rounded-xl cursor-pointer hover:bg-dark-500/70 transition-colors border border-transparent has-[:checked]:border-neon-cyan">
                    <input
                        type="radio"
                        name="saved-address"
                        value="manual"
                        id="manual-address-radio"
                        class="saved-address-radio w-4 h-4 text-neon-cyan bg-dark-400 border-white/20 focus:ring-neon-cyan/50"
                    />
                    <span class="text-zinc-300">
                        Usar una dirección diferente
                    </span>
                </label>
            `;

            list.innerHTML = html;

            // Attach event listeners
            const radios = list.querySelectorAll('.saved-address-radio');
            radios.forEach(radio => {
                radio.addEventListener('change', handleAddressSelection);
            });

            // Auto-fill first address
            if (savedAddresses.length > 0) {
                const firstRadio = radios[0] as HTMLInputElement;
                if (firstRadio) {
                    fillAddressFields(firstRadio);
                }
            }
        }

        // Handle address selection
        function handleAddressSelection(e: Event) {
            const radio = e.target as HTMLInputElement;
            fillAddressFields(radio);
        }

        // Fill address fields from radio data
        function fillAddressFields(radio: HTMLInputElement) {
            if (radio.value === 'manual') {
                // Clear to defaults
                (document.getElementById('full_name') as HTMLInputElement).value = customerData?.full_name || '';
                (document.getElementById('phone') as HTMLInputElement).value = customerData?.phone || '';
                (document.getElementById('street') as HTMLInputElement).value = '';
                (document.getElementById('city') as HTMLInputElement).value = '';
                (document.getElementById('postal_code') as HTMLInputElement).value = '';
                (document.getElementById('province') as HTMLInputElement).value = '';
                (document.getElementById('country') as HTMLSelectElement).value = 'ES';
            } else {
                // Fill from selected address
                (document.getElementById('full_name') as HTMLInputElement).value = radio.dataset.fullname || '';
                if (radio.dataset.phone) {
                    (document.getElementById('phone') as HTMLInputElement).value = radio.dataset.phone;
                }
                (document.getElementById('street') as HTMLInputElement).value = radio.dataset.street || '';
                (document.getElementById('city') as HTMLInputElement).value = radio.dataset.city || '';
                (document.getElementById('postal_code') as HTMLInputElement).value = radio.dataset.postal || '';
                (document.getElementById('province') as HTMLInputElement).value = radio.dataset.province || '';
                (document.getElementById('country') as HTMLSelectElement).value = radio.dataset.country || 'ES';
            }
        }

        // Calculate discount amount
        function calculateDiscount(subtotal, discount) {
            if (!discount) return 0;
            
            if (discount.type === 'percentage') {
                return (subtotal * discount.value) / 100;
            } else if (discount.type === 'fixed') {
                return Math.min(discount.value, subtotal);
            }
            return 0;
        }

        // Update order summary
        function updateOrderSummary() {
            const cart = getCart();
            const subtotalEl = document.getElementById('subtotal');
            const totalEl = document.getElementById('total');
            const discountRow = document.getElementById('discount-row');
            const discountAmount = document.getElementById('discount-amount');
            const discountPercent = document.getElementById('discount-percent');

            if (!cart || cart.length === 0) {
                window.location.href = '/carrito';
                return;
            }

            const subtotal = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);
            const discount = appliedDiscount ? calculateDiscount(subtotal, appliedDiscount) : 0;
            const total = subtotal - discount;

            if (subtotalEl) subtotalEl.textContent = formatPrice(subtotal);
            
            if (discount > 0 && discountRow && discountAmount && discountPercent) {
                discountRow.classList.remove('hidden');
                discountAmount.textContent = `-${formatPrice(discount)}`;
                discountPercent.textContent = appliedDiscount.type === 'percentage' 
                    ? `${appliedDiscount.value}%` 
                    : appliedDiscount.description;
            } else if (discountRow) {
                discountRow.classList.add('hidden');
            }

            if (totalEl) totalEl.textContent = formatPrice(total);
        }

        // Render order summary
        function renderOrderSummary() {
            const cart = getCart();
            const orderItems = document.getElementById('order-items');

            if (!cart || cart.length === 0) {
                window.location.href = '/carrito';
                return;
            }

            if (orderItems) {
                orderItems.innerHTML = cart.map(item => `
                    <div class="flex justify-between text-sm">
                        <span class="text-zinc-400">${item.name} x${item.quantity} (${item.size})</span>
                        <span class="text-white">${formatPrice(item.price * item.quantity)}</span>
                    </div>
                `).join('');
            }

            updateOrderSummary();
        }

        // Apply discount code
        async function applyDiscount() {
            const codeInput = document.getElementById('discount-code') as HTMLInputElement;
            const code = codeInput?.value.trim().toUpperCase();
            const messageDiv = document.getElementById('discount-message');
            const appliedDiv = document.getElementById('applied-discount');
            const codeDisplay = document.getElementById('discount-code-display');
            const applyBtn = document.getElementById('apply-discount-btn') as HTMLButtonElement;

            if (!code) {
                if (messageDiv) {
                    messageDiv.textContent = 'Por favor, introduce un código de descuento';
                    messageDiv.className = 'mt-2 text-sm text-red-400';
                    messageDiv.classList.remove('hidden');
                }
                return;
            }

            if (applyBtn) {
                applyBtn.disabled = true;
                applyBtn.textContent = '...';
            }

            try {
                const emailInput = document.getElementById('email') as HTMLInputElement;
                const customerEmail = emailInput?.value || null;

                const response = await fetch('/api/discount/validate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ code, customerEmail })
                });

                const result = await response.json();

                if (!result.valid) {
                    if (messageDiv) {
                        messageDiv.textContent = result.error || 'Código de descuento inválido';
                        messageDiv.className = 'mt-2 text-sm text-red-400';
                        messageDiv.classList.remove('hidden');
                    }
                    return;
                }

                const cart = getCart();
                const subtotal = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);
                
                if (result.discount.minPurchase && subtotal < result.discount.minPurchase) {
                    if (messageDiv) {
                        messageDiv.textContent = `Este código requiere una compra mínima de ${formatPrice(result.discount.minPurchase)}`;
                        messageDiv.className = 'mt-2 text-sm text-red-400';
                        messageDiv.classList.remove('hidden');
                    }
                    return;
                }

                appliedDiscount = {
                    id: result.discount.id,
                    code: result.discount.code,
                    type: result.discount.type,
                    value: result.discount.value,
                    description: result.discount.description,
                    maxDiscount: result.discount.maxDiscount
                };

                if (codeInput) codeInput.value = '';
                messageDiv?.classList.add('hidden');
                appliedDiv?.classList.remove('hidden');
                if (codeDisplay) codeDisplay.textContent = code;
                
                updateOrderSummary();
            } catch (error) {
                console.error('Error validating discount:', error);
                if (messageDiv) {
                    messageDiv.textContent = 'Error al validar el código. Inténtalo de nuevo.';
                    messageDiv.className = 'mt-2 text-sm text-red-400';
                    messageDiv.classList.remove('hidden');
                }
            } finally {
                if (applyBtn) {
                    applyBtn.disabled = false;
                    applyBtn.textContent = 'Aplicar';
                }
            }
        }

        // Remove discount
        function removeDiscount() {
            appliedDiscount = null;
            document.getElementById('applied-discount')?.classList.add('hidden');
            updateOrderSummary();
        }

        // Initialize checkout
        async function initCheckout() {
            const loadingState = document.getElementById('loading-state');
            const checkoutContent = document.getElementById('checkout-content');

            try {
                // Get session
                const { data: { session }, error: sessionError } = await supabase.auth.getSession();
                
                if (session?.user) {
                    currentUser = session.user;
                    console.log('✅ User logged in:', currentUser.email);

                    // Set email and make it readonly
                    const emailInput = document.getElementById('email') as HTMLInputElement;
                    if (emailInput) {
                        emailInput.value = currentUser.email || '';
                        emailInput.readOnly = true;
                    }

                    // Load customer data
                    const { data: customer, error: customerError } = await supabase
                        .from('customers')
                        .select('*')
                        .eq('id', currentUser.id)
                        .single();

                    if (customer) {
                        customerData = customer;
                        console.log('✅ Customer data loaded:', customer);
                        
                        // Pre-fill phone if available
                        if (customer.phone) {
                            const phoneInput = document.getElementById('phone') as HTMLInputElement;
                            if (phoneInput) phoneInput.value = customer.phone;
                        }
                        
                        // Pre-fill name if available
                        if (customer.full_name) {
                            const nameInput = document.getElementById('full_name') as HTMLInputElement;
                            if (nameInput) nameInput.value = customer.full_name;
                        }
                    }

                    // Load saved addresses
                    const { data: addresses, error: addressError } = await supabase
                        .from('customer_addresses')
                        .select('*')
                        .eq('customer_id', currentUser.id)
                        .order('is_default', { ascending: false })
                        .order('created_at', { ascending: false });

                    if (addresses && addresses.length > 0) {
                        savedAddresses = addresses;
                        console.log('✅ Saved addresses loaded:', addresses.length);
                        renderSavedAddresses();
                    } else {
                        console.log('ℹ️ No saved addresses found');
                    }
                } else {
                    console.log('ℹ️ User not logged in, checkout as guest');
                }

                // Show checkout content
                loadingState?.classList.add('hidden');
                checkoutContent?.classList.remove('hidden');
                
                // Initialize order summary
                renderOrderSummary();

            } catch (error) {
                console.error('Error initializing checkout:', error);
                loadingState?.classList.add('hidden');
                checkoutContent?.classList.remove('hidden');
                renderOrderSummary();
            }
        }

        // Handle form submission
        const form = document.getElementById('checkout-form');
        form?.addEventListener('submit', async (e) => {
            e.preventDefault();

            const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
            const submitText = document.getElementById('submit-text');
            const submitSpinner = document.getElementById('submit-spinner');

            try {
                if (submitBtn) submitBtn.disabled = true;
                submitText?.classList.add('hidden');
                submitSpinner?.classList.remove('hidden');

                const cart = getCart();
                if (!cart || cart.length === 0) {
                    alert('Tu carrito está vacío');
                    return;
                }

                const formData = new FormData(form as HTMLFormElement);
                const customerInfo = {
                    email: formData.get('email'),
                    phone: formData.get('phone'),
                    full_name: formData.get('full_name'),
                    address: {
                        line1: formData.get('street'),
                        city: formData.get('city'),
                        postal_code: formData.get('postal_code'),
                        state: formData.get('province'),
                        country: formData.get('country')
                    }
                };

                sessionStorage.setItem('checkout_email', String(customerInfo.email));
                sessionStorage.setItem('checkout_name', String(customerInfo.full_name));
                sessionStorage.setItem('checkout_address', JSON.stringify(customerInfo.address));

                const response = await fetch('/api/checkout/create-session', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        items: cart,
                        customerEmail: customerInfo.email,
                        customerPhone: customerInfo.phone,
                        customerName: customerInfo.full_name,
                        shippingAddress: customerInfo.address,
                        discount: appliedDiscount
                    }),
                });

                const data = await response.json();

                if (!response.ok) {
                    throw new Error(data.error || 'Error al crear la sesión de pago');
                }

                if (data.url) {
                    window.location.href = data.url;
                } else {
                    throw new Error('No se recibió URL de checkout');
                }
            } catch (error: any) {
                console.error('Error during checkout:', error);
                alert(`Error: ${error.message || 'Hubo un error al procesar tu pago. Por favor, intenta de nuevo.'}`);
                
                if (submitBtn) submitBtn.disabled = false;
                submitText?.classList.remove('hidden');
                submitSpinner?.classList.add('hidden');
            }
        });

        // Event listeners
        document.getElementById('apply-discount-btn')?.addEventListener('click', applyDiscount);
        document.getElementById('remove-discount-btn')?.addEventListener('click', removeDiscount);
        document.getElementById('discount-code')?.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                applyDiscount();
            }
        });

        // Initialize
        initCheckout();
    </script>
</PublicLayout>
