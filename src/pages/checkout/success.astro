---
import PublicLayout from "../../layouts/PublicLayout.astro";

export const prerender = false;

const { url } = Astro;
const sessionId = url.searchParams.get("session_id");
---

<PublicLayout
    title="Pago Exitoso"
    description="Tu pedido ha sido procesado correctamente"
>
    <section class="py-12 md:py-20 min-h-[60vh] flex items-center">
        <div class="container-custom max-w-2xl mx-auto text-center">
            <div
                class="bg-dark-400/50 backdrop-blur-xl border border-white/10 rounded-3xl p-12"
            >
                <!-- Loading State -->
                <div id="loading-state">
                    <div
                        class="w-24 h-24 mx-auto mb-6 rounded-full bg-gradient-to-br from-neon-cyan to-neon-fuchsia flex items-center justify-center animate-pulse"
                    >
                        <svg
                            class="w-12 h-12 text-dark-500 animate-spin"
                            fill="none"
                            viewBox="0 0 24 24"
                        >
                            <circle
                                class="opacity-25"
                                cx="12"
                                cy="12"
                                r="10"
                                stroke="currentColor"
                                stroke-width="4"></circle>
                            <path
                                class="opacity-75"
                                fill="currentColor"
                                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
                            ></path>
                        </svg>
                    </div>
                    <h1 class="text-2xl font-display font-bold text-white mb-4">
                        Procesando tu pedido...
                    </h1>
                    <p class="text-zinc-400">Por favor espera un momento</p>
                </div>

                <!-- Success State -->
                <div id="success-state" class="hidden">
                    <div
                        class="w-24 h-24 mx-auto mb-6 rounded-full bg-gradient-to-r from-green-400 to-emerald-500 flex items-center justify-center"
                    >
                        <svg
                            class="w-12 h-12 text-white"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                    </div>

                    <h1
                        class="text-3xl md:text-4xl font-display font-bold text-white mb-4"
                    >
                        ¡Pago Exitoso!
                    </h1>
                    <p class="text-lg text-zinc-300 mb-2">
                        Tu pedido ha sido procesado correctamente
                    </p>
                    <p
                        id="order-number"
                        class="text-neon-cyan font-medium mb-8"
                    >
                    </p>

                    <div class="bg-dark-500/50 rounded-xl p-6 mb-8">
                        <p class="text-zinc-400 mb-4">
                            Recibirás un correo electrónico con los detalles de
                            tu pedido y el seguimiento de envío.
                        </p>
                        <p class="text-zinc-400">
                            Si tienes alguna pregunta, no dudes en contactarnos.
                        </p>
                    </div>

                    <div class="flex flex-col sm:flex-row gap-4 justify-center">
                        <a
                            href="/cuenta/pedidos"
                            class="px-8 py-4 bg-gradient-to-r from-neon-cyan to-neon-cyan-light text-dark-500 font-semibold rounded-xl hover:shadow-lg hover:shadow-neon-cyan/25 transition-all duration-200"
                        >
                            Ver mis Pedidos
                        </a>
                        <a
                            href="/productos"
                            class="px-8 py-4 border border-white/10 text-white font-semibold rounded-xl hover:border-neon-cyan/50 transition-all duration-200"
                        >
                            Seguir Comprando
                        </a>
                    </div>
                </div>

                <!-- Error State -->
                <div id="error-state" class="hidden">
                    <div
                        class="w-24 h-24 mx-auto mb-6 rounded-full bg-gradient-to-r from-yellow-400 to-orange-500 flex items-center justify-center"
                    >
                        <svg
                            class="w-12 h-12 text-white"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                            ></path>
                        </svg>
                    </div>
                    <h1 class="text-2xl font-display font-bold text-white mb-4">
                        Pago Procesado
                    </h1>
                    <p class="text-zinc-400 mb-8">
                        Tu pago se ha realizado, pero hubo un problema al crear
                        el pedido. Por favor contacta con soporte.
                    </p>
                    <a
                        href="/"
                        class="px-8 py-4 bg-gradient-to-r from-neon-cyan to-neon-cyan-light text-dark-500 font-semibold rounded-xl"
                    >
                        Volver al Inicio
                    </a>
                </div>
            </div>
        </div>
    </section>

    <script define:vars={{ sessionId }}>
        async function processOrder() {
            const loadingState = document.getElementById("loading-state");
            const successState = document.getElementById("success-state");
            const errorState = document.getElementById("error-state");
            const orderNumberEl = document.getElementById("order-number");

            try {
                // Clear cart first
                localStorage.removeItem("fashionmarket-cart");
                sessionStorage.removeItem("checkout_email");
                sessionStorage.removeItem("checkout_name");
                sessionStorage.removeItem("checkout_address");
                window.dispatchEvent(new CustomEvent("cart-updated"));

                if (!sessionId) {
                    throw new Error("No session ID");
                }

                // Check if we already processed this session
                const processedSessions = JSON.parse(
                    localStorage.getItem("processed-sessions") || "[]",
                );
                if (processedSessions.includes(sessionId)) {
                    console.log("Session already processed, showing success");
                    loadingState?.classList.add("hidden");
                    successState?.classList.remove("hidden");
                    return;
                }

                // Call API to verify payment and create order if not exists
                const response = await fetch("/api/checkout/verify-session", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ sessionId }),
                });

                const result = await response.json();

                if (!response.ok) {
                    throw new Error(result.error || "Error verifying session");
                }

                // Mark session as processed
                processedSessions.push(sessionId);
                localStorage.setItem(
                    "processed-sessions",
                    JSON.stringify(processedSessions.slice(-10)),
                ); // Keep last 10

                // Show success
                loadingState?.classList.add("hidden");
                successState?.classList.remove("hidden");

                if (orderNumberEl && result.orderId) {
                    orderNumberEl.textContent = `Pedido #${result.orderNumber ? result.orderNumber : result.orderId.slice(0, 8).toUpperCase()}`;
                }
            } catch (error) {
                console.error("Error processing order:", error);
                loadingState?.classList.add("hidden");

                // Show error state
                errorState?.classList.remove("hidden");
            }
        }

        processOrder();
    </script>
</PublicLayout>
