---
import BaseLayout from "./BaseLayout.astro";
import CartIcon from "../components/islands/CartIcon";
import CartSlideOver from "../components/islands/CartSlideOver";
import { getCategories } from "../lib/supabase";

export interface Props {
    title: string;
    description?: string;
}

const { title, description } = Astro.props;

// Fetch categories
let categories: { id: string; name: string; slug: string }[] = [];

try {
    categories = await getCategories();
} catch (e) {
    console.error("Error fetching categories:", e);
}

// Define search tags for each category
const categoryTags: Record<string, string[]> = {
    camisas: [
        "Manga corta",
        "Manga larga",
        "Slim fit",
        "Casual",
        "Formal",
        "Lino",
        "Algodón",
    ],
    pantalones: [
        "Chinos",
        "Vaqueros",
        "Cargo",
        "Slim fit",
        "Regular",
        "Cortos",
        "Deportivos",
    ],
    trajes: [
        "Clásico",
        "Slim fit",
        "Blazer",
        "Completo",
        "Casual",
        "Formal",
        "Boda",
    ],
};

// Seasonal tags
const seasonalTags = ["Verano", "Invierno", "Primavera", "Otoño"];
---

<BaseLayout title={title} description={description}>
    <!-- Header - Glassmorphism -->
    <header
        class="sticky top-0 z-30 bg-dark-500/80 backdrop-blur-xl border-b border-white/5"
    >
        <div class="container-custom">
            <div class="flex items-center justify-between h-16 md:h-20 gap-4">
                <!-- Logo -->
                <a href="/" class="flex items-center gap-3 group flex-shrink-0">
                    <div
                        class="w-10 h-10 rounded-lg bg-gradient-to-br from-neon-cyan to-neon-fuchsia flex items-center justify-center"
                    >
                        <span class="text-dark-500 font-bold text-lg">FM</span>
                    </div>
                    <span
                        class="font-display text-xl md:text-2xl font-semibold text-white group-hover:text-neon-cyan transition-colors hidden sm:block"
                    >
                        FashionMarket
                    </span>
                </a>

                <!-- Desktop Navigation with Mega Menu -->
                <nav class="hidden lg:flex items-center gap-1">
                    <!-- Productos Dropdown -->
                    <div class="relative group/menu">
                        <a
                            href="/productos"
                            class="px-4 py-2 text-zinc-300 hover:text-white font-medium transition-colors flex items-center gap-1"
                        >
                            Productos
                            <svg
                                class="w-4 h-4 transition-transform group-hover/menu:rotate-180"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </a>

                        <!-- Mega Menu Dropdown -->
                        <div
                            class="absolute left-1/2 -translate-x-1/2 top-full pt-4 opacity-0 invisible group-hover/menu:opacity-100 group-hover/menu:visible transition-all duration-300"
                        >
                            <div
                                class="w-[900px] bg-dark-400/95 backdrop-blur-xl border border-white/10 rounded-2xl shadow-2xl overflow-hidden"
                            >
                                <!-- Gradient top border -->
                                <div
                                    class="h-px bg-gradient-to-r from-transparent via-neon-cyan to-transparent"
                                >
                                </div>

                                <div class="p-8">
                                    <div class="grid grid-cols-4 gap-8">
                                        <!-- Categories with Tags -->
                                        {
                                            categories.map((category) => (
                                                <div class="space-y-4">
                                                    <a
                                                        href={`/categoria/${category.slug}`}
                                                        class="font-display text-white hover:text-neon-cyan transition-colors flex items-center gap-2"
                                                    >
                                                        <span class="w-8 h-8 rounded-lg bg-neon-cyan/10 flex items-center justify-center">
                                                            {category.slug ===
                                                                "camisas" && (
                                                                <svg
                                                                    class="w-4 h-4 text-neon-cyan"
                                                                    fill="none"
                                                                    stroke="currentColor"
                                                                    viewBox="0 0 24 24"
                                                                >
                                                                    <path
                                                                        stroke-linecap="round"
                                                                        stroke-linejoin="round"
                                                                        stroke-width="1.5"
                                                                        d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"
                                                                    />
                                                                </svg>
                                                            )}
                                                            {category.slug ===
                                                                "pantalones" && (
                                                                <svg
                                                                    class="w-4 h-4 text-neon-cyan"
                                                                    fill="none"
                                                                    stroke="currentColor"
                                                                    viewBox="0 0 24 24"
                                                                >
                                                                    <path
                                                                        stroke-linecap="round"
                                                                        stroke-linejoin="round"
                                                                        stroke-width="1.5"
                                                                        d="M4 5h16v3l-3 12H7L4 8V5z"
                                                                    />
                                                                </svg>
                                                            )}
                                                            {category.slug ===
                                                                "trajes" && (
                                                                <svg
                                                                    class="w-4 h-4 text-neon-cyan"
                                                                    fill="none"
                                                                    stroke="currentColor"
                                                                    viewBox="0 0 24 24"
                                                                >
                                                                    <path
                                                                        stroke-linecap="round"
                                                                        stroke-linejoin="round"
                                                                        stroke-width="1.5"
                                                                        d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                                                    />
                                                                </svg>
                                                            )}
                                                        </span>
                                                        {category.name}
                                                    </a>

                                                    <ul class="space-y-1.5">
                                                        <li>
                                                            <a
                                                                href={`/categoria/${category.slug}`}
                                                                class="text-sm text-neon-cyan hover:text-neon-cyan-light transition-colors"
                                                            >
                                                                Ver todo
                                                            </a>
                                                        </li>
                                                        {categoryTags[
                                                            category.slug
                                                        ]
                                                            ?.slice(0, 6)
                                                            .map((tag) => (
                                                                <li>
                                                                    <a
                                                                        href={`/productos?buscar=${encodeURIComponent(tag)}`}
                                                                        class="text-sm text-zinc-500 hover:text-white transition-colors flex items-center gap-2"
                                                                    >
                                                                        <span class="w-1 h-1 rounded-full bg-zinc-700" />
                                                                        {tag}
                                                                    </a>
                                                                </li>
                                                            ))}
                                                    </ul>
                                                </div>
                                            ))
                                        }

                                        <!-- Seasonal/Featured Column -->
                                        <div class="space-y-4">
                                            <span
                                                class="font-display text-neon-fuchsia flex items-center gap-2"
                                            >
                                                <span
                                                    class="w-8 h-8 rounded-lg bg-neon-fuchsia/10 flex items-center justify-center"
                                                >
                                                    <svg
                                                        class="w-4 h-4 text-neon-fuchsia"
                                                        fill="none"
                                                        stroke="currentColor"
                                                        viewBox="0 0 24 24"
                                                    >
                                                        <path
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                            stroke-width="1.5"
                                                            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
                                                        ></path>
                                                    </svg>
                                                </span>
                                                Temporada
                                            </span>

                                            <ul class="space-y-1.5">
                                                {
                                                    seasonalTags.map((tag) => (
                                                        <li>
                                                            <a
                                                                href={`/productos?buscar=${encodeURIComponent(tag)}`}
                                                                class="text-sm text-zinc-400 hover:text-white transition-colors flex items-center gap-2"
                                                            >
                                                                <span class="w-1 h-1 rounded-full bg-zinc-600" />
                                                                {tag}
                                                            </a>
                                                        </li>
                                                    ))
                                                }
                                            </ul>

                                            <div
                                                class="pt-4 border-t border-white/5"
                                            >
                                                <span
                                                    class="font-display text-neon-fuchsia text-sm"
                                                    >Destacado</span
                                                >
                                                <ul class="space-y-1.5 mt-2">
                                                    <li>
                                                        <a
                                                            href="/ofertas"
                                                            class="text-sm text-neon-fuchsia hover:text-neon-fuchsia-light transition-colors flex items-center gap-2"
                                                        >
                                                            <span
                                                                class="w-2 h-2 rounded-full bg-neon-fuchsia animate-pulse"
                                                            ></span>
                                                            Ofertas Flash
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a
                                                            href="/productos?buscar=novedades"
                                                            class="text-sm text-zinc-400 hover:text-white transition-colors flex items-center gap-2"
                                                        >
                                                            <span
                                                                class="w-1 h-1 rounded-full bg-zinc-600"
                                                            ></span>
                                                            Novedades
                                                        </a>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Bottom CTA with Search -->
                                    <div
                                        class="mt-8 pt-6 border-t border-white/5 flex items-center justify-between"
                                    >
                                        <p class="text-sm text-zinc-500">
                                            Descubre nuestra colección completa
                                        </p>
                                        <a
                                            href="/productos"
                                            class="px-4 py-2 bg-neon-cyan/10 border border-neon-cyan/30 text-neon-cyan text-sm font-medium rounded-lg hover:bg-neon-cyan/20 transition-colors flex items-center gap-2"
                                        >
                                            Ver todos los productos
                                            <svg
                                                class="w-4 h-4"
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M9 5l7 7-7 7"></path>
                                            </svg>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Ofertas Link -->
                    <a
                        href="/ofertas"
                        class="px-4 py-2 text-neon-fuchsia hover:text-neon-fuchsia-light transition-colors font-medium flex items-center gap-1"
                    >
                        <span
                            class="w-1.5 h-1.5 rounded-full bg-neon-fuchsia animate-pulse"
                        ></span>
                        Ofertas
                    </a>
                </nav>

                <!-- Actions -->
                <div class="flex items-center gap-3">
                    <!-- Cart Button -->
                    <div id="cart-trigger" class="relative">
                        <CartIcon client:load />
                    </div>

                    <!-- Mobile Menu Button -->
                    <button
                        id="mobile-menu-btn"
                        class="lg:hidden p-2 text-zinc-400 hover:text-white transition-colors"
                        aria-label="Abrir menú"
                    >
                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Navigation -->
        <nav
            id="mobile-nav"
            class="hidden lg:hidden bg-dark-400/95 backdrop-blur-xl border-t border-white/5"
        >
            <div class="container-custom py-4 space-y-1">
                <a
                    href="/productos"
                    class="block py-3 px-4 text-zinc-300 hover:text-white hover:bg-white/5 rounded-lg transition-colors font-medium"
                >
                    Todos los Productos
                </a>
                {
                    categories.map((cat) => (
                        <a
                            href={`/categoria/${cat.slug}`}
                            class="block py-3 px-4 text-zinc-400 hover:text-white hover:bg-white/5 rounded-lg transition-colors"
                        >
                            {cat.name}
                        </a>
                    ))
                }
                <a
                    href="/ofertas"
                    class="block py-3 px-4 text-neon-fuchsia hover:bg-neon-fuchsia/10 rounded-lg transition-colors font-medium"
                >
                    🔥 Ofertas Flash
                </a>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
        <slot />
    </main>

    <!-- Footer - Dark with Gradient Accent -->
    <footer class="bg-dark-600 border-t border-white/5 mt-auto">
        <!-- Gradient Line -->
        <div
            class="h-px bg-gradient-to-r from-transparent via-neon-cyan/50 to-transparent"
        >
        </div>

        <div class="container-custom py-16">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
                <!-- Brand -->
                <div class="md:col-span-2">
                    <div class="flex items-center gap-3 mb-4">
                        <div
                            class="w-10 h-10 rounded-lg bg-gradient-to-br from-neon-cyan to-neon-fuchsia flex items-center justify-center"
                        >
                            <span class="text-dark-500 font-bold text-lg"
                                >FM</span
                            >
                        </div>
                        <span
                            class="font-display text-2xl font-semibold text-white"
                            >FashionMarket</span
                        >
                    </div>
                    <p class="text-zinc-500 max-w-md leading-relaxed">
                        Moda masculina premium. Diseño futurista y elegancia
                        sofisticada para el hombre moderno.
                    </p>

                    <!-- Social Icons -->
                    <div class="flex gap-4 mt-6">
                        <a
                            href="#"
                            class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-zinc-400 hover:text-neon-cyan hover:bg-neon-cyan/10 transition-all"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"
                                ></path></svg
                            >
                        </a>
                        <a
                            href="#"
                            class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-zinc-400 hover:text-neon-fuchsia hover:bg-neon-fuchsia/10 transition-all"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                                ></path></svg
                            >
                        </a>
                    </div>
                </div>

                <!-- Links -->
                <div>
                    <h4 class="font-display text-white text-lg mb-4">Tienda</h4>
                    <ul class="space-y-3 text-zinc-500">
                        <li>
                            <a
                                href="/productos"
                                class="hover:text-neon-cyan transition-colors"
                                >Productos</a
                            >
                        </li>
                        {
                            categories.map((cat) => (
                                <li>
                                    <a
                                        href={`/categoria/${cat.slug}`}
                                        class="hover:text-neon-cyan transition-colors"
                                    >
                                        {cat.name}
                                    </a>
                                </li>
                            ))
                        }
                        <li>
                            <a
                                href="/ofertas"
                                class="hover:text-neon-fuchsia transition-colors"
                                >Ofertas</a
                            >
                        </li>
                    </ul>
                </div>

                <!-- Contact -->
                <div>
                    <h4 class="font-display text-white text-lg mb-4">
                        Contacto
                    </h4>
                    <ul class="space-y-3 text-zinc-500">
                        <li class="flex items-center gap-2">
                            <svg
                                class="w-4 h-4 text-neon-cyan"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                ></path>
                            </svg>
                            info@fashionmarket.es
                        </li>
                        <li class="flex items-center gap-2">
                            <svg
                                class="w-4 h-4 text-neon-cyan"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                ></path>
                            </svg>
                            +34 900 123 456
                        </li>
                    </ul>
                </div>
            </div>

            <div
                class="border-t border-white/5 mt-12 pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-zinc-600 text-sm"
            >
                <span
                    >© {new Date().getFullYear()} FashionMarket. Todos los derechos
                    reservados.</span
                >
                <div class="flex gap-6">
                    <a href="#" class="hover:text-zinc-400 transition-colors"
                        >Privacidad</a
                    >
                    <a href="#" class="hover:text-zinc-400 transition-colors"
                        >Términos</a
                    >
                </div>
            </div>
        </div>
    </footer>

    <!-- Cart Slide Over (React Island) -->
    <div id="cart-slideover">
        <CartSlideOver client:load isOpen={false} onClose={() => {}} />
    </div>

    <!-- Scripts -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            // Cart toggle
            const cartTrigger = document.getElementById("cart-trigger");
            cartTrigger?.addEventListener("click", () => {
                window.dispatchEvent(new CustomEvent("toggle-cart"));
            });

            // Mobile menu toggle
            const mobileBtn = document.getElementById("mobile-menu-btn");
            const mobileNav = document.getElementById("mobile-nav");
            mobileBtn?.addEventListener("click", () => {
                mobileNav?.classList.toggle("hidden");
            });

            // Mobile search toggle
            const mobileSearchBtn =
                document.getElementById("mobile-search-btn");
            const mobileSearch = document.getElementById("mobile-search");
            mobileSearchBtn?.addEventListener("click", () => {
                mobileSearch?.classList.toggle("hidden");
            });

            // Search tags - fill search input and redirect
            const searchTags = document.querySelectorAll(".search-tag");
            const searchInput = document.getElementById(
                "search-input",
            ) as HTMLInputElement;

            searchTags.forEach((tag) => {
                tag.addEventListener("click", () => {
                    const searchTerm =
                        (tag as HTMLElement).dataset.search || "";
                    if (searchInput) {
                        searchInput.value = searchTerm;
                    }
                    // Redirect to products with search
                    window.location.href = `/productos?buscar=${encodeURIComponent(searchTerm)}`;
                });
            });
        });
    </script>
</BaseLayout>
