---
import BaseLayout from "./BaseLayout.astro";
import { supabase } from "../lib/supabase";

export interface Props {
    title: string;
}

const { title } = Astro.props;

// Check authentication - this runs on the server
const accessToken = Astro.cookies.get("sb-access-token")?.value;
const refreshToken = Astro.cookies.get("sb-refresh-token")?.value;

let user = null;
if (accessToken && refreshToken) {
    const { data } = await supabase.auth.setSession({
        access_token: accessToken,
        refresh_token: refreshToken,
    });
    user = data?.user;
}

// If not authenticated, redirect to login
if (!user) {
    return Astro.redirect("/admin/login");
}
---

<BaseLayout title={`Admin - ${title}`}>
    <div class="min-h-screen bg-cream-100 flex">
        <!-- Sidebar -->
        <aside class="w-64 bg-brand-navy-500 text-white flex-shrink-0">
            <div class="p-6">
                <a href="/admin" class="font-serif text-xl font-semibold">
                    FashionMarket
                </a>
                <span class="block text-brand-navy-300 text-sm mt-1"
                    >Panel de Administración</span
                >
            </div>

            <nav class="mt-4 px-4 space-y-1">
                <a
                    href="/admin"
                    class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-brand-navy-600 transition-colors"
                >
                    <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.5"
                            d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
                        ></path>
                    </svg>
                    <span>Dashboard</span>
                </a>

                <a
                    href="/admin/productos"
                    class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-brand-navy-600 transition-colors"
                >
                    <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.5"
                            d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
                        ></path>
                    </svg>
                    <span>Productos</span>
                </a>

                <a
                    href="/"
                    class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-brand-navy-600 transition-colors mt-8"
                >
                    <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.5"
                            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                        ></path>
                    </svg>
                    <span>Ver Tienda</span>
                </a>
            </nav>

            <!-- User Info & Logout -->
            <div
                class="absolute bottom-0 left-0 w-64 p-4 border-t border-brand-navy-600"
            >
                <div class="flex items-center gap-3 px-4 py-2">
                    <div
                        class="w-8 h-8 rounded-full bg-accent-leather flex items-center justify-center text-white font-medium text-sm"
                    >
                        {user.email?.charAt(0).toUpperCase()}
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium truncate">{user.email}</p>
                    </div>
                </div>
                <form action="/api/auth/logout" method="POST" class="mt-2">
                    <button
                        type="submit"
                        class="w-full flex items-center gap-3 px-4 py-2 text-brand-navy-300 hover:text-white transition-colors text-sm"
                    >
                        <svg
                            class="w-4 h-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
                            ></path>
                        </svg>
                        Cerrar Sesión
                    </button>
                </form>
            </div>
        </aside>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col">
            <!-- Top Bar -->
            <header
                class="h-16 bg-white border-b border-brand-charcoal-100 flex items-center px-6"
            >
                <h1 class="font-serif text-xl text-brand-navy-500">{title}</h1>
            </header>

            <!-- Page Content -->
            <main class="flex-1 p-6 overflow-auto">
                <slot />
            </main>
        </div>
    </div>
</BaseLayout>
