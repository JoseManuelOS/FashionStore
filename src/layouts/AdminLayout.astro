---
import "../styles/global.css";
import AdminAnimations from "../components/islands/AdminAnimations";

export interface Props {
    title: string;
}

const { title } = Astro.props;

// Check admin authentication
let adminSession = null;

// Get cookie from request header directly
const cookieHeader = Astro.request.headers.get("cookie") || "";

if (cookieHeader.includes("admin-session=")) {
    try {
        const match = cookieHeader.match(/admin-session=([^;]+)/);
        if (match) {
            const decoded = decodeURIComponent(match[1]);
            adminSession = JSON.parse(decoded);
            // Check if session is still valid (8 hours)
            if (Date.now() - adminSession.timestamp > 8 * 60 * 60 * 1000) {
                adminSession = null;
            }
        }
    } catch (e) {
        adminSession = null;
    }
}

// If not authenticated, redirect to admin login
if (!adminSession) {
    return Astro.redirect("/admin/login");
}

const currentPath = Astro.url.pathname;
